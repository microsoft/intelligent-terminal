<script>
document.addEventListener('DOMContentLoaded', function() {
  if (window.location.pathname.includes('/translated-resources')) {

    // Add ID to interpreter_link link
    var interpreter_link = document.querySelector('a[href="https://www.farmers.gov/translated-resources/interpret"]');      
    if (interpreter_link) interpreter_link.id = 'language-interpreter';

    // Check if the dropdown exists on page load
    var dropdown = document.querySelector('select.shs-select.form-select');
    if (dropdown) addOptionIds(dropdown);

    // Use MutationObserver to watch for the dropdown being added if not found
    var observer = new MutationObserver(function(mutationsList, observer) {          
        var dropdown = document.getElementById('edit-term-node-tid-depth-shs-0-0');
        if (dropdown) {
            addOptionIds(dropdown);
            addIdsToLanguageSections();         
            observer.disconnect();
        }
    });

    // Start observing the document for added nodes
    observer.observe(document.body, { childList: true, subtree: true });

    // Initialize the observer
    observeLanguageChange();
  }
});

// Add IDs to languages in the dropdown
function addOptionIds(dropdown) {
    var options = dropdown.querySelectorAll('option');
    
    options.forEach(function(option) {
        // Extract text within parentheses
        var match = option.textContent.match(/\((.*?)\)/);
                      
        if (match && match[1]) {
            var textInBrackets = match[1].trim(); // Extracted text inside parentheses
            option.id = 'select_lang_' + textInBrackets.toLowerCase();
        }
    });
}   

// Add IDs to language containers/sections
function addIdsToLanguageSections(){
  var h2Elements = document.querySelectorAll('h2');
  
  h2Elements.forEach(function(h2) {
      // Extract text inside parentheses (language)
      var match = h2.textContent.match(/\((.*?)\)/);

      if (match && match[1]) {
          var textInBrackets = match[1].trim().toLowerCase();

          // Find the parent div element of the h2
          var parentDiv = h2.closest('div');
          
          if (parentDiv) {
              parentDiv.id = 'select_lang_container_' + textInBrackets;
          }
      }
  });
}

// Get the 'language' query parameter from the URL (to check if the language has changed in the form)
function getLanguageFromQuery() {
    const urlParams = new URLSearchParams(window.location.search);
    return urlParams.get('language');
}

// Observe changes in the 'language' query parameter
function observeLanguageChange() {
    let currentLanguage = getLanguageFromQuery();

    // Function to handle query parameter changes
    const checkForLanguageChange = () => {
        const newLanguage = getLanguageFromQuery();
        if (newLanguage !== currentLanguage) {
            setTimeout(
              function() {
                addIdsToLanguageSections();
                addOptionIds(document.querySelectorAll('select.shs-select.form-select')[1]);
              }
            , 1500);
            currentLanguage = newLanguage; // Update current language
        }
    };

    // Listen to popstate event (triggered by browser history changes)
    window.addEventListener('popstate', checkForLanguageChange);

    // Optionally, listen to 'pushState' and 'replaceState' 
    // This will allow the detection of changes even when using JavaScript to manipulate the history
    const originalPushState = history.pushState;
    history.pushState = function(state, title, url) {
        originalPushState.apply(history, arguments);
        checkForLanguageChange();
    };

    const originalReplaceState = history.replaceState;
    history.replaceState = function(state, title, url) {
        originalReplaceState.apply(history, arguments);
        checkForLanguageChange();
    };
}
</script>
