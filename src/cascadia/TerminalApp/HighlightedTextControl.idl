namespace TerminalApp
{
    enum TextHighlightColor
    {
        None = 0,
        Success = 1,
        Caution = 2,
        Critical = 3
    };

    struct HighlightedRun
    {
        UInt64 Start;
        UInt64 End;
    };

    enum TextEllipsisKind
    {
        None = 0,
        Path = 1,
        Middle = 2,
        Branch = 3
    };

    struct TextEllipsisRange
    {
        UInt64 Start;
        UInt64 End;
        TextEllipsisKind Kind;
    };

    [default_interface] runtimeclass HighlightedTextControl : Windows.UI.Xaml.Controls.Control
    {
        HighlightedTextControl();

        String Text;
        Windows.UI.Xaml.DependencyProperty TextProperty { get; };

        String SearchText;
        Windows.UI.Xaml.DependencyProperty SearchTextProperty { get; };

        IVector<HighlightedRun> HighlightedRuns;
        Windows.UI.Xaml.DependencyProperty HighlightedRunsProperty { get; };

        Windows.UI.Xaml.Style TextBlockStyle;
        Windows.UI.Xaml.DependencyProperty TextBlockStyleProperty { get; };

        Windows.UI.Xaml.Style HighlightedRunStyle;
        Windows.UI.Xaml.DependencyProperty HighlightedRunStyleProperty { get; };

        Boolean UsePathEllipsis;
        Windows.UI.Xaml.DependencyProperty UsePathEllipsisProperty { get; };

        IVector<TextEllipsisRange> EllipsisRanges;
        Windows.UI.Xaml.DependencyProperty EllipsisRangesProperty { get; };

        TextHighlightColor ColorHighlight;
        static Windows.UI.Xaml.DependencyProperty ColorHighlightProperty { get; };

        IVector<HighlightedRun> ColorHighlightRanges;
        static Windows.UI.Xaml.DependencyProperty ColorHighlightRangesProperty { get; };

        Windows.UI.Xaml.Media.Brush SuccessHighlightBrush;
        static Windows.UI.Xaml.DependencyProperty SuccessHighlightBrushProperty { get; };

        Windows.UI.Xaml.Media.Brush CautionHighlightBrush;
        static Windows.UI.Xaml.DependencyProperty CautionHighlightBrushProperty { get; };

        Windows.UI.Xaml.Media.Brush CriticalHighlightBrush;
        static Windows.UI.Xaml.DependencyProperty CriticalHighlightBrushProperty { get; };

        Double TextOpacity;
        static Windows.UI.Xaml.DependencyProperty TextOpacityProperty { get; };

        void SetTextAndColor(String text, TextHighlightColor color, IVector<HighlightedRun> ranges);
        void SetMetadata(String text, TextHighlightColor color, IVector<HighlightedRun> ranges, IVector<TextEllipsisRange> ellipsisRanges);
    }
}
