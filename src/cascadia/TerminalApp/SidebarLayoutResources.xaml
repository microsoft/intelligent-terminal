<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Thickness x:Key="SidebarSectionPadding">12,0,0,0</Thickness>
    <StaticResource x:Key="SidebarToolbarPadding"
                    ResourceKey="SidebarSectionPadding" />
    <Thickness x:Key="SidebarTrailingActionMargin">0</Thickness>
    <Thickness x:Key="SidebarLiveRowMargin">6,4</Thickness>
    <x:Double x:Key="SidebarToolbarActionExtent">40</x:Double>
    <x:Double x:Key="SidebarActionCellExtent">46.02</x:Double>
    <GridLength x:Key="SidebarActionCellWidth">46.02</GridLength>
    <x:Double x:Key="SidebarNewTabHeight">36.81</x:Double>
    <x:Double x:Key="SidebarNewTabGlyphSize">16</x:Double>
    <!--  Center a forty-DIP action on the live-row icon axis: 6 + 20 = 26.  -->
    <GridLength x:Key="SidebarExpandedLeadingColumnWidth">52</GridLength>
    <GridLength x:Key="SidebarCompactLeadingColumnWidth">40</GridLength>
    <Thickness x:Key="SidebarPaneFocusInset">7,0,33,0</Thickness>
    <!--  Match the native SplitButton's separator column.  -->
    <x:Double x:Key="SidebarActionColumnSpacing">1</x:Double>
    <Style x:Key="SidebarCloseSlotStyle"
           TargetType="Grid">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="0,8,9,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
</ResourceDictionary>
