    FRE (First Run Experience) two-step wizard.
    Full-screen content that replaces the terminal window during first run.
    Page 1: Welcome — feature highlights
    Page 2: Settings — agent selection + configuration

    Both pages share the same 3-zone layout (Top / Content / Bottom) so
    title, content, and button areas stay aligned across pages.
-->
<UserControl x:Class="TerminalApp.FreOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:TerminalApp"
             xmlns:mux="using:Microsoft.UI.Xaml.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             TabFocusNavigation="Cycle">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Microsoft.Terminal.Settings.Editor/CommonResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Matches TerminalSettingsEditor's StandardControlMaxWidth  -->
            <x:Double x:Key="StandardControlMaxWidth">1000</x:Double>
            <!--  Welcome page has two side-by-side cards (1.5× the standard width)  -->
            <x:Double x:Key="WelcomeContentMaxWidth">1500</x:Double>

            <DataTemplate x:Key="FreErrorDetectionOptionTemplate">
                <TextBlock Text="{Binding}"
                           TextWrapping="WrapWholeWords" />
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--  Full-screen dark background  -->
    <Grid x:Name="RootGrid" Background="#FF1E1E1E"
          RequestedTheme="Dark"
          HighContrastAdjustment="Auto">
        <Grid.RowDefinitions>
            <!--  Title bar space  -->
            <RowDefinition Height="32" />
            <!--  Content  -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="Transparent" />

        <!--  Shared 3-zone layout: Top (title) / Content / Bottom (button)
              Both pages are stacked in the same Grid so they share identical
              row proportions. Only one page is Visible at a time.  -->
        <Grid Grid.Row="1" Margin="40,8,40,16">
            <Grid.RowDefinitions>
                <!--  Top zone: title + subtitle  -->
                <RowDefinition Height="Auto" />
                <!--  Content zone: cards or settings form  -->
                <RowDefinition Height="*" />
                <!--  Bottom zone: button  -->
                <RowDefinition Height="48" />
            </Grid.RowDefinitions>

            <!--  ================================================================  -->
            <!--  PAGE 1: Welcome                                                  -->
            <!--  ================================================================  -->
            <Grid x:Name="WelcomePage" Grid.Row="0" Grid.RowSpan="3" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="48" />
                </Grid.RowDefinitions>

                <!--  Content: Title + Cards grouped together, centered vertically  -->
                <StackPanel Grid.Row="0"
                            VerticalAlignment="Center"
                            MaxWidth="{StaticResource WelcomeContentMaxWidth}"
                            HorizontalAlignment="Center">

                    <!--  Title + Subtitle  -->
                    <StackPanel Spacing="8" Margin="0,8,0,16" HorizontalAlignment="Center">
                        <TextBlock x:Uid="FreOverlay_WelcomeTitle"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="20" FontWeight="SemiBold"
                                   Foreground="White" TextAlignment="Center"
                                   LineHeight="28" />
                        <TextBlock x:Name="WelcomeSubtitle"
                                   FontFamily="Segoe UI Variable Small, Segoe UI"
                                   FontSize="13" Foreground="#B3FFFFFF"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   LineHeight="18" MaxWidth="480"
                                   Margin="0,4,0,0">
                            <Run x:Name="WelcomeSubtitlePrefix" Text="" />
                            <Hyperlink NavigateUri="https://aka.ms/intelligent-terminal"
                                       Foreground="#FF99EBFF">
                                <Run x:Name="WelcomeSubtitleLink" Text="" />
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>

                    <!--  Feature Cards  -->
                    <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  Card 1: Error Detection  -->
                    <Border Grid.Column="0" Background="#FF2D2D2D" CornerRadius="7">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#FF0C0C0C" CornerRadius="7,7,0,0"
                                    Margin="6,6,6,0">
                                <Image Source="ms-appx:///FREAssets/FRE_Asset1.png"
                                       Stretch="Uniform" />
                            </Border>
                            <StackPanel Grid.Row="1" Margin="16,14,16,16" Spacing="6">
                                <TextBlock x:Uid="FreOverlay_Card1Title"
                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="White" LineHeight="18" />
                                <TextBlock x:Uid="FreOverlay_Card1Description"
                                           FontFamily="Segoe UI Variable Small, Segoe UI"
                                           FontSize="12" Foreground="#8AFFFFFF"
                                           TextWrapping="Wrap" LineHeight="16" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  Card 2: Session Management  -->
                    <Border Grid.Column="2" Background="#FF2D2D2D" CornerRadius="7">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#FF0C0C0C" CornerRadius="7,7,0,0"
                                    Margin="6,6,6,0">
                                <Image Source="ms-appx:///FREAssets/FRE_Asset2.png"
                                       Stretch="Uniform" />
                            </Border>
                            <StackPanel Grid.Row="1" Margin="16,14,16,16" Spacing="6">
                                <TextBlock x:Uid="FreOverlay_Card2Title"
                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="White" LineHeight="18" />
                                <TextBlock x:Uid="FreOverlay_Card2Description"
                                           FontFamily="Segoe UI Variable Small, Segoe UI"
                                           FontSize="12" Foreground="#8AFFFFFF"
                                           TextWrapping="Wrap" LineHeight="16" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    </Grid>
                </StackPanel>

                <!--  Bottom: Next Button  -->
                <Grid Grid.Row="1">
                    <Button x:Uid="FreOverlay_NextButton"
                            x:Name="NextButton"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="120" Height="32"
                            Style="{ThemeResource AccentButtonStyle}"
                            Click="_OnNextButtonClick" />
                </Grid>
            </Grid>

            <!--  ================================================================  -->
            <!--  PAGE 2: Settings                                                 -->
            <!--  ================================================================  -->
            <Grid x:Name="SettingsPage" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <!--  Bottom zone grows to fit a two-line error (message +
                          manual-fix link) without clipping; MinHeight keeps the
                          Save button area stable when there's no error.  -->
                    <RowDefinition Height="Auto" MinHeight="48" />
                </Grid.RowDefinitions>

                <!--  Top: Title + Subtitle  -->
                <StackPanel Grid.Row="0" Spacing="8" Margin="0,8,0,16" HorizontalAlignment="Center">
                    <TextBlock x:Uid="FreOverlay_SettingsTitle"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="White" TextAlignment="Center"
                               LineHeight="28" />
                    <TextBlock x:Name="SettingsSubtitle"
                               FontFamily="Segoe UI Variable Small, Segoe UI"
                               FontSize="13" Foreground="#B3FFFFFF"
                               TextAlignment="Center" TextWrapping="Wrap"
                               LineHeight="18"
                               Margin="0,4,0,0">
                        <Run x:Name="SettingsSubtitlePrefix" Text="" />
                        <Hyperlink NavigateUri="https://aka.ms/intelligent-terminal-privacy"
                                   Foreground="#FF99EBFF">
                            <Run x:Name="SettingsSubtitleLink" Text="" />
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>

                <!--  Content: Settings Form. Named so we can disable it as
                      a group while a save/install is in progress
                      (keyboard input blocking — see
                      FreOverlay::_SetSavingState). A SavingOverlay
                      sibling sits on top for the visual + spinner.  -->
                <ScrollViewer x:Name="SettingsFormScroller"
                              Grid.Row="1"
                              HorizontalAlignment="Stretch"
                              SizeChanged="_OnSettingsFormScrollerSizeChanged"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SettingsFormStack"
                                Spacing="4"
                                MaxWidth="{StaticResource StandardControlMaxWidth}"
                                HorizontalAlignment="Center">
                        <!--  Agent  -->
                        <Border Background="{ThemeResource ExpanderHeaderBackground}"
                                BorderBrush="{ThemeResource ExpanderHeaderBorderBrush}"
                                BorderThickness="{ThemeResource ExpanderHeaderBorderThickness}"
                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                MinHeight="64"
                                Padding="16,12">
                            <!--  ColumnSpacing="24" matches SettingContainer's
                                  standard 24px gap between the title column
                                  and the right-side control. Without it, long
                                  wrapped descriptions visually butt up
                                  against the ComboBox / ToggleSwitch.  -->
                            <Grid ColumnSpacing="24" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock x:Uid="FreOverlay_AgentLabel"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="White" />
                                    <!--  Run.Text values populated from code-behind by splitting on "ACP".  -->
                                    <TextBlock x:Name="AgentDescriptionText"
                                               FontSize="12" Foreground="#99FFFFFF"
                                               TextWrapping="Wrap">
                                        <Run x:Name="AgentDescriptionBefore" />
                                        <Hyperlink NavigateUri="https://aka.ms/intelligent-terminal-dependency#agent-clis"
                                                   Foreground="#FF99EBFF">
                                            <Run x:Name="AgentDescriptionAcpToken" />
                                        </Hyperlink>
                                        <Run x:Name="AgentDescriptionAfter" />
                                    </TextBlock>
                                    <TextBlock x:Name="AgentPolicyNotice"
                                               FontSize="12" FontStyle="Italic"
                                               Foreground="#CCFFA500" TextWrapping="Wrap"
                                               Visibility="Collapsed"
                                               AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                                <ComboBox x:Name="AgentComboBox"
                                          Grid.Column="1"
                                          AutomationProperties.AccessibilityView="Content"
                                          SelectionChanged="_OnAgentSelectionChanged"
                                          Style="{StaticResource ComboBoxSettingStyle}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="local:FreAgentEntry">
                                            <TextBlock Text="{x:Bind DisplayLabel}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <mux:InfoBar x:Name="AgentProbeWarning"
                                             Grid.Row="1"
                                             Grid.ColumnSpan="2"
                                             IsClosable="False"
                                             IsIconVisible="True"
                                             IsOpen="False"
                                             Severity="Warning"
                                             AutomationProperties.LiveSetting="Polite" />
                            </Grid>
                        </Border>

                        <!--  Pane position  -->
                        <Border Background="{ThemeResource ExpanderHeaderBackground}"
                                BorderBrush="{ThemeResource ExpanderHeaderBorderBrush}"
                                BorderThickness="{ThemeResource ExpanderHeaderBorderThickness}"
                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                MinHeight="64"
                                Padding="16,12">
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock x:Uid="FreOverlay_PanePositionLabel"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="White" />
                                    <TextBlock x:Name="PanePositionDescriptionText"
                                               x:Uid="FreOverlay_PanePositionDescription"
                                               FontSize="12" Foreground="#99FFFFFF"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox x:Name="PanePositionComboBox"
                                          Grid.Column="1"
                                          AutomationProperties.AccessibilityView="Content"
                                          Style="{StaticResource ComboBoxSettingStyle}" />
                            </Grid>
                        </Border>

                        <!--  Error detection  -->
                        <Border Background="{ThemeResource ExpanderHeaderBackground}"
                                BorderBrush="{ThemeResource ExpanderHeaderBorderBrush}"
                                BorderThickness="{ThemeResource ExpanderHeaderBorderThickness}"
                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                MinHeight="64"
                                Padding="16,12">
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock x:Uid="FreOverlay_ErrorDetectionLabel"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="White" />
                                    <TextBlock x:Name="ErrorDetectionDescriptionText"
                                               x:Uid="FreOverlay_ErrorDetectionDescription"
                                               FontSize="12" Foreground="#99FFFFFF"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="ErrorDetectionPolicyNotice"
                                               FontSize="12" FontStyle="Italic"
                                               Foreground="#CCFFA500" TextWrapping="Wrap"
                                               Visibility="Collapsed"
                                               AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                                <ComboBox x:Name="ErrorDetectionComboBox"
                                          Grid.Column="1"
                                          AutomationProperties.AccessibilityView="Content"
                                          Style="{StaticResource ComboBoxSettingStyle}"
                                          Width="{StaticResource StandardBoxMinWidth}">
                                    <ComboBoxItem x:Uid="FreOverlay_ErrorDetectionDetectOption"
                                                  ContentTemplate="{StaticResource FreErrorDetectionOptionTemplate}" />
                                    <ComboBoxItem x:Name="ErrorDetectionAutoFixOption"
                                                  x:Uid="FreOverlay_ErrorDetectionAutoFixOption"
                                                  ContentTemplate="{StaticResource FreErrorDetectionOptionTemplate}" />
                                    <ComboBoxItem x:Uid="FreOverlay_ErrorDetectionOffOption"
                                                  ContentTemplate="{StaticResource FreErrorDetectionOptionTemplate}" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!--  Session management  -->
                        <Border Background="{ThemeResource ExpanderHeaderBackground}"
                                BorderBrush="{ThemeResource ExpanderHeaderBorderBrush}"
                                BorderThickness="{ThemeResource ExpanderHeaderBorderThickness}"
                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                MinHeight="64"
                                Padding="16,12">
                            <StackPanel Spacing="4">
                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock x:Uid="FreOverlay_SessionLabel"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="White" />
                                        <TextBlock x:Name="SessionDescriptionText"
                                                   x:Uid="FreOverlay_SessionDescription"
                                                   FontSize="12" Foreground="#99FFFFFF"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="SessionManagementToggle"
                                                  Grid.Column="1"
                                                  AutomationProperties.AccessibilityView="Content"
                                                  IsOn="True"
                                                  Style="{StaticResource ToggleSwitchInExpanderStyle}" />
                                </Grid>
                                <TextBlock x:Name="SessionHooksPolicyNotice"
                                           FontSize="12" FontStyle="Italic"
                                           Foreground="#CCFFA500" TextWrapping="Wrap"
                                           Visibility="Collapsed"
                                           AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>

                        <!--  Usage and cost visibility  -->
                        <Border Background="{ThemeResource ExpanderHeaderBackground}"
                                BorderBrush="{ThemeResource ExpanderHeaderBorderBrush}"
                                BorderThickness="{ThemeResource ExpanderHeaderBorderThickness}"
                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                MinHeight="64"
                                Padding="16,12">
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock x:Uid="FreOverlay_ShowTokenUsageAndCostLabel"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="White" />
                                    <TextBlock x:Name="TokenUsageDescriptionText"
                                               x:Uid="FreOverlay_ShowTokenUsageAndCostDescription"
                                               FontSize="12" Foreground="#99FFFFFF"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="ShowTokenUsageAndCostToggle"
                                              Grid.Column="1"
                                              AutomationProperties.AccessibilityView="Content"
                                              IsOn="False"
                                              Style="{StaticResource ToggleSwitchInExpanderStyle}" />
                            </Grid>
                        </Border>

                        <!--  Automatic approval. Copy comes from the SettingsEditor
                              resource scope so Settings and FRE cannot drift.  -->
                        <Border x:Name="AutomaticApprovalSetting"
                                AutomationProperties.AutomationId="AutomaticApprovalSetting"
                                Background="{ThemeResource ExpanderHeaderBackground}"
                                BorderBrush="{ThemeResource ExpanderHeaderBorderBrush}"
                                BorderThickness="{ThemeResource ExpanderHeaderBorderThickness}"
                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                MinHeight="64"
                                Padding="16,12"
                                Visibility="Collapsed">
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock x:Name="AutomaticApprovalTitle"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="White" />
                                    <TextBlock x:Name="AutomaticApprovalDescription"
                                               FontSize="12"
                                               Foreground="#99FFFFFF"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="AutomaticApprovalToggle"
                                              Grid.Column="1"
                                              AutomationProperties.AutomationId="AutomaticApprovalToggle"
                                              AutomationProperties.AccessibilityView="Content"
                                              IsEnabled="False"
                                              IsOn="False"
                                              Style="{StaticResource ToggleSwitchInExpanderStyle}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!--
                    "Saving / installing in progress" overlay. Sits in
                    the same Grid cell as SettingsFormScroller and is
                    rendered after it, so it z-stacks on top. While
                    visible:
                    - The opaque-ish Background blocks pointer input
                      to the form below.
                    - SettingsFormScroller.IsEnabled is also set to
                      false in code, which blocks keyboard input
                      (overlays don't intercept keyboard on their
                      own — focus would still tab into the form).
                    - One persistent ProgressRing moves through the
                      rows as setup advances. Completed rows retain
                      their result glyph.
                    Collapsed when idle so it doesn't intercept input
                    or paint pixels.
                -->
                <Border x:Name="SavingOverlay"
                        Grid.Row="1"
                        Padding="32"
                        Background="#CC1E1E1E"
                        Visibility="Collapsed">
                    <!--
                        Background is the same RGB as RootGrid (#FF1E1E1E
                        on line 31) with 80 % alpha, by design: the
                        overlay reads as "FRE dims itself" rather than
                        an independent panel. Keep these two in sync
                        if the FRE backdrop ever changes — extracting
                        both into shared SolidColorBrush resources is
                        left for a broader FRE theming pass.
                    -->
                    <Grid MinHeight="216"
                          MaxWidth="560"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Grid x:Name="SavingProgressGrid"
                              VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid x:Name="SetupProgressRow"
                                  Grid.Row="0"
                                  Grid.ColumnSpan="2"
                                  MinHeight="48"
                                  Margin="0,0,0,8"
                                  Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="SetupProgressIcon"
                                          Grid.Column="0"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          FontSize="18"
                                          Foreground="White"
                                          Visibility="Collapsed" />
                                <TextBlock x:Name="SavingStatusText"
                                           Grid.Column="1"
                                           Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                           FontSize="14"
                                           Foreground="White"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <Grid x:Name="AgentProgressRow"
                                  Grid.Row="1"
                                  Grid.ColumnSpan="2"
                                  MinHeight="48"
                                  Margin="0,0,0,8"
                                  Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="AgentProgressIcon"
                                          Grid.Column="0"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          FontSize="18"
                                          Foreground="White"
                                          Visibility="Collapsed" />
                                <TextBlock x:Name="AgentProgressText"
                                           Grid.Column="1"
                                           Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                           FontSize="14"
                                           Foreground="White"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <Grid x:Name="ErrorDetectionProgressRow"
                                  Grid.Row="2"
                                  Grid.ColumnSpan="2"
                                  MinHeight="48"
                                  Margin="0,0,0,8"
                                  Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="ErrorDetectionProgressIcon"
                                          Grid.Column="0"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          FontSize="18"
                                          Foreground="White"
                                          Visibility="Collapsed" />
                                <TextBlock x:Name="ErrorDetectionProgressText"
                                           Grid.Column="1"
                                           Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                           FontSize="14"
                                           Foreground="White"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <Grid x:Name="SessionsProgressRow"
                                  Grid.Row="3"
                                  Grid.ColumnSpan="2"
                                  MinHeight="48"
                                  Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="SessionsProgressIcon"
                                          Grid.Column="0"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          FontSize="18"
                                          Foreground="White"
                                          Visibility="Collapsed" />
                                <TextBlock x:Name="SessionsProgressText"
                                           Grid.Column="1"
                                           Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                           FontSize="14"
                                           Foreground="White"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <mux:ProgressRing x:Name="SavingProgressRing"
                                              Grid.Row="0"
                                              Grid.Column="0"
                                              Width="48"
                                              Height="48"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              IsActive="False"
                                              IsTabStop="True" />
                        </Grid>
                    </Grid>
                </Border>

                <!--  Bottom: Error text + Save Button  -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!--  Single prioritized error: message + a manual-fix
                          hyperlink line. Only the highest-priority problem is
                          shown at a time (see FreOverlay::_ShowProblem), so the
                          bottom row stays compact.  -->
                    <StackPanel x:Name="ErrorPanel"
                                Grid.Column="0"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                MaxWidth="440" Spacing="2"
                                Visibility="Collapsed">
                        <Grid ColumnSpacing="6">
                            <Grid.Resources>
                                <SolidColorBrush x:Key="ErrorForegroundBrush"
                                                 Color="#FFFF6B6B" />
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE7BA;"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      FontSize="13"
                                      Foreground="{StaticResource ErrorForegroundBrush}"
                                      VerticalAlignment="Top"
                                      Margin="0,1,0,0" />
                            <TextBlock Grid.Column="1"
                                       x:Name="ErrorText"
                                       Foreground="{StaticResource ErrorForegroundBrush}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Assertive" />
                        </Grid>
                        <TextBlock FontSize="12" TextWrapping="Wrap">
                            <Hyperlink x:Name="ErrorHelpLink"
                                       NavigateUri="https://aka.ms/intelligent-terminal-dependency"
                                       Foreground="#FF99EBFF">
                                <Run x:Name="ErrorHelpRun" Text="" />
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                    <!--  Save button. Disabled while a save/install is
                          in progress; the SavingOverlay above the form
                          carries the progressive checklist. The
                          "Get Started" label stays unchanged — no
                          in-button text swap is needed since the overlay
                          communicates the in-progress state.  -->
                    <Button x:Uid="FreOverlay_SaveButton"
                            x:Name="SaveButton"
                            Grid.Column="1"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="120" Height="32"
                            Style="{ThemeResource AccentButtonStyle}"
                            Click="_OnSaveButtonClick" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
