    PROTOTYPE — see investigation-vertical-tabs.md. Not shipped.

    ListView-backed strip that renders TabViewItem instances. Vertical for the
    prototype; the control is named neutrally so C (single-strip end-state) can
    reuse it with a public Orientation property.
-->
<UserControl x:Class="TerminalApp.TabStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:TerminalApp"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mux="using:Microsoft.UI.Xaml.Controls"
             MinWidth="40"
             Background="{ThemeResource TabViewBackground}"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TopChrome"
              Grid.Row="0"
              MinHeight="40"
              Visibility="Collapsed">
            <!--
                Hosts the complete vertical chrome when a non-client titlebar
                is unavailable. Otherwise, the same element is hosted by the
                window titlebar.
            -->
            <ContentPresenter x:Name="TopChromeContentPresenter"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Center" />
        </Grid>

        <Grid x:Name="CompactNewTabToolbar"
              Grid.Row="1"
              Width="40"
              Height="80"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>

            <Button x:Name="CompactNewTabButton"
                    x:Uid="CompactNewTabButton"
                    Width="40"
                    Height="40"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnCompactNewTabClick">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          FontSize="10"
                          Glyph="&#xE710;" />
            </Button>

            <Button x:Name="CompactNewTabMenuButton"
                    x:Uid="CompactNewTabMenuButton"
                    Grid.Row="1"
                    Width="40"
                    Height="40"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnCompactNewTabMenuClick">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          FontSize="8"
                          Glyph="&#xE70D;" />
            </Button>
        </Grid>

        <Grid x:Name="TabsToolbar"
              Grid.Row="2"
              Height="44"
              Padding="12,0,8,0"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="VerticalTabsHeader"
                       x:Uid="VerticalTabsHeader"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold" />

            <Button x:Name="SearchTabsButton"
                    x:Uid="VerticalTabsSearchButton"
                    Grid.Column="1"
                    Width="32"
                    Height="32"
                    Padding="0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    IsTabStop="False">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          FontSize="12"
                          Glyph="&#xE721;" />
            </Button>

            <!--  Reserved for the Filter and History buttons shown in the target design.  -->
            <Button x:Name="FilterTabsButton"
                    Grid.Column="2"
                    Width="32"
                    Height="32"
                    Visibility="Collapsed" />
            <Button x:Name="TabHistoryButton"
                    Grid.Column="3"
                    Width="32"
                    Height="32"
                    Visibility="Collapsed" />
        </Grid>

        <!--
            The strip proper. ListView holds TabViewItem instances directly via
            a passthrough item template. ListViewItem chrome is stripped so the
            TabViewItem owns all visual state; selection is synced in code-behind.
        -->
        <ListView x:Name="ItemsList"
                  Grid.Row="3"
                  Padding="0"
                  AllowDrop="True"
                  CanDragItems="True"
                  CanReorderItems="True"
                  DragOver="OnListDragOver"
                  Drop="OnListDrop"
                  DragItemsStarting="OnDragItemsStarting"
                  DragItemsCompleted="OnDragItemsCompleted"
                  IsItemClickEnabled="False"
                  ReorderMode="Enabled"
                  SelectionChanged="OnListSelectionChanged"
                  SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ContentPresenter HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      Content="{Binding}" />
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="MinHeight" Value="32" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
        </ListView>
    </Grid>
</UserControl>
