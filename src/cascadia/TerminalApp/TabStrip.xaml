    PROTOTYPE — see investigation-vertical-tabs.md. Not shipped.

    ListView-backed strip that renders TabViewItem instances. Vertical for the
    prototype; the control is named neutrally so C (single-strip end-state) can
    reuse it with a public Orientation property.
-->
<UserControl x:Class="TerminalApp.TabStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:TerminalApp"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mtu="using:Microsoft.Terminal.UI"
             xmlns:mux="using:Microsoft.UI.Xaml.Controls"
             MinWidth="40"
             Background="{ThemeResource TabViewBackground}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-resource:///Files/TerminalApp/AgentIconResources.xaml" />
                <ResourceDictionary Source="ms-resource:///Files/TerminalApp/IndeterminateProgressResources.xaml" />
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Light">
                            <SolidColorBrush x:Key="AgentsOnlyIndicatorBrush" Color="#005FB7" />
                            <StaticResource x:Key="PaneActiveIndicatorBrush"
                                            ResourceKey="SystemControlForegroundBaseHighBrush" />
                            <StaticResource x:Key="PaneProgressAccentBrush"
                                            ResourceKey="SystemControlForegroundAccentBrush" />
                            <StaticResource x:Key="PaneProgressCriticalBrush"
                                            ResourceKey="SystemFillColorCriticalBrush" />
                            <StaticResource x:Key="PaneProgressCautionBrush"
                                            ResourceKey="SystemFillColorCautionBrush" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Dark">
                            <SolidColorBrush x:Key="AgentsOnlyIndicatorBrush" Color="#60CDFF" />
                            <StaticResource x:Key="PaneActiveIndicatorBrush"
                                            ResourceKey="SystemControlForegroundBaseHighBrush" />
                            <StaticResource x:Key="PaneProgressAccentBrush"
                                            ResourceKey="SystemControlForegroundAccentBrush" />
                            <StaticResource x:Key="PaneProgressCriticalBrush"
                                            ResourceKey="SystemFillColorCriticalBrush" />
                            <StaticResource x:Key="PaneProgressCautionBrush"
                                            ResourceKey="SystemFillColorCautionBrush" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="HighContrast">
                            <StaticResource x:Key="AgentsOnlyIndicatorBrush"
                                            ResourceKey="SystemColorWindowTextColorBrush" />
                            <StaticResource x:Key="PaneActiveIndicatorBrush"
                                            ResourceKey="SystemColorWindowTextColorBrush" />
                            <StaticResource x:Key="PaneProgressAccentBrush"
                                            ResourceKey="SystemControlForegroundAccentBrush" />
                            <StaticResource x:Key="PaneProgressCriticalBrush"
                                            ResourceKey="SystemFillColorCriticalBrush" />
                            <StaticResource x:Key="PaneProgressCautionBrush"
                                            ResourceKey="SystemFillColorCautionBrush" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
            <!--  Remove the native horizontal tab border within this vertical-only scope.  -->
            <Thickness x:Key="TabViewItemBorderThickness">0</Thickness>
            <CornerRadius x:Key="SidebarTabCornerRadius">6</CornerRadius>
            <Style x:Key="HistoryTitleTextStyle"
                   TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="MaxLines" Value="1" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>
            <Style x:Key="HistorySubtitleTextStyle"
                   TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Opacity" Value="0.72" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="HistoryAttentionTextStyle"
                   BasedOn="{StaticResource HistorySubtitleTextStyle}"
                   TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
                <Setter Property="Opacity" Value="1" />
            </Style>
            <Style x:Key="HistoryActiveTextStyle"
                   BasedOn="{StaticResource HistorySubtitleTextStyle}"
                   TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                <Setter Property="Opacity" Value="1" />
            </Style>
            <Style x:Key="RichTabMetadataSectionStyle"
                   TargetType="MenuFlyoutItem">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuFlyoutItem">
                            <Grid MinHeight="32">
                                <TextBlock Margin="12,0"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                           Text="{TemplateBinding Text}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="HistoryErrorTextStyle"
                   BasedOn="{StaticResource HistorySubtitleTextStyle}"
                   TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                <Setter Property="Opacity" Value="1" />
            </Style>
            <DataTemplate x:Key="HistoryHeaderTemplate">
                <Grid x:Name="HistorySection"
                      Background="Transparent"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="0,1,0,0"
                      Loaded="OnHistorySectionLoaded"
                      Unloaded="OnHistorySectionUnloaded">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <local:TabStripHistoryHeader x:Name="HistoryHeaderButton"
                                                AutomationProperties.AutomationId="HistoryHeaderButton"
                                                MinHeight="44"
                                                Padding="12,0"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                IsChecked="True"
                                                Checked="OnHistoryExpandedChanged"
                                                Unchecked="OnHistoryExpandedChanged">
                        <local:TabStripHistoryHeader.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.ThemeDictionaries>
                                    <ResourceDictionary x:Key="Default">
                                        <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="ToggleButtonBackgroundPointerOver" />
                                        <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="ToggleButtonBackgroundPressed" />
                                        <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="ToggleButtonForeground" />
                                        <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="ToggleButtonForegroundPointerOver" />
                                        <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="ToggleButtonForegroundPressed" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="Light">
                                        <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="ToggleButtonBackgroundPointerOver" />
                                        <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="ToggleButtonBackgroundPressed" />
                                        <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="ToggleButtonForeground" />
                                        <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="ToggleButtonForegroundPointerOver" />
                                        <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="ToggleButtonForegroundPressed" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="HighContrast">
                                        <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="ToggleButtonBackgroundPointerOver" />
                                        <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="ToggleButtonBackgroundPressed" />
                                        <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="ToggleButtonForeground" />
                                        <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="ToggleButtonForegroundPointerOver" />
                                        <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="ToggleButtonForegroundPressed" />
                                    </ResourceDictionary>
                                </ResourceDictionary.ThemeDictionaries>
                                <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent" />
                            </ResourceDictionary>
                        </local:TabStripHistoryHeader.Resources>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="HistoryHeader"
                                       x:Uid="VerticalTabsSessionHistoryHeader"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold" />
                            <FontIcon x:Name="HistoryChevron"
                                      Grid.Column="1"
                                      FontSize="10"
                                      Glyph="&#xE70D;"
                                      AutomationProperties.AccessibilityView="Raw" />
                        </Grid>
                    </local:TabStripHistoryHeader>
                    <Grid x:Name="HistoryStatusPanel" Grid.Row="1">
                        <ProgressRing x:Name="HistoryLoadingIndicator"
                                      Width="24"
                                      Height="24"
                                      Margin="0,8"
                                      HorizontalAlignment="Center"
                                      IsActive="False"
                                      Visibility="Collapsed" />
                        <TextBlock x:Name="HistoryMessage"
                                   Margin="16,0"
                                   HorizontalAlignment="Center"
                                   LineHeight="20"
                                   LineStackingStrategy="BlockLineHeight"
                                   MaxLines="3"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="Wrap"
                                   ToolTipService.ToolTip="{Binding Text, ElementName=HistoryMessage}"
                                   Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="HistoryRowTemplate"
                          x:DataType="local:TabStripHistoryItem">
                <Grid x:Name="HistoryRowGrid"
                      Padding="12,8"
                      Background="Transparent"
                      ColumnSpacing="10"
                      GotFocus="OnSidebarRowGotFocus"
                      Loaded="OnHistoryRowLoaded"
                      PointerEntered="OnSidebarRowPointerEntered"
                      SizeChanged="OnSidebarRowSizeChanged">
                    <ToolTipService.ToolTip>
                        <ToolTip FlowDirection="LeftToRight">
                            <StackPanel MaxWidth="480"
                                        FlowDirection="{Binding FlowDirection, ElementName=HistoryRowGrid, Mode=OneWay}"
                                        Spacing="4">
                                <TextBlock FontWeight="SemiBold"
                                           Text="{x:Bind Title}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ProviderDisplayName}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Cwd}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           Visibility="{x:Bind IsHistorical, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           Visibility="{x:Bind mtu:Converters.InvertedBooleanToVisibility(IsHistorical), Mode=OneWay}" />
                                <TextBlock x:Name="HistoryInUseTooltipText" TextWrapping="Wrap" />
                                <TextBlock x:Name="HistoryKeepRunningTooltipText"
                                           TextWrapping="Wrap"
                                           Visibility="{x:Bind IsKeepRunning, Mode=OneWay}" />
                            </StackPanel>
                        </ToolTip>
                    </ToolTipService.ToolTip>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto"
                                       MinHeight="16" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border x:Name="HistorySelectionBackground"
                            Grid.RowSpan="3"
                            Grid.ColumnSpan="2"
                            Margin="-12,-8"
                            Background="{ThemeResource ListViewItemBackgroundSelected}"
                            CornerRadius="{StaticResource SidebarTabCornerRadius}"
                            IsHitTestVisible="False"
                            Visibility="{x:Bind IsCurrent, Mode=OneWay}">
                        <ContentControl x:Name="HistorySelectionPalette"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        AutomationProperties.AccessibilityView="Raw"
                                        Foreground="{ThemeResource ListViewItemForegroundSelected}"
                                        IsTabStop="False">
                            <Border Background="{x:Bind CurrentBackground, Mode=OneWay}"
                                    CornerRadius="{StaticResource SidebarTabCornerRadius}" />
                        </ContentControl>
                    </Border>
                    <ContentControl x:Name="HistoryProviderIcon"
                                    Grid.RowSpan="3"
                                    Width="16"
                                    Height="16"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    AutomationProperties.AccessibilityView="Raw"
                                    AutomationProperties.Name="{x:Bind ProviderDisplayName}"
                                    Content="{Binding Foreground, ElementName=HistoryTitleText}"
                                    ContentTemplate="{x:Bind IconTemplate}"
                                    IsTabStop="False" />
                    <Grid Grid.Column="1"
                          HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <local:HighlightedTextControl x:Name="HistoryTitleText"
                                                      SearchText="{x:Bind SearchQuery}"
                                                      Text="{x:Bind Title}"
                                                      TextBlockStyle="{StaticResource HistoryTitleTextStyle}" />
                        <FontIcon x:Name="HistoryKeepRunningIcon"
                                  Grid.Column="1"
                                  Margin="12,0,0,0"
                                  VerticalAlignment="Center"
                                  FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                  FontSize="12"
                                  Foreground="{Binding Foreground, ElementName=HistoryTitleText}"
                                  Glyph="&#xE8EE;"
                                  Visibility="{x:Bind IsKeepRunning, Mode=OneWay}" />
                    </Grid>
                    <local:HighlightedTextControl x:Name="HistoryCwdText"
                                                  Grid.Row="1"
                                                  Grid.Column="1"
                                                  Margin="0,2,0,0"
                                                  SearchText="{x:Bind SearchQuery}"
                                                  Text="{x:Bind Cwd}"
                                                  TextBlockStyle="{StaticResource HistorySubtitleTextStyle}" />
                    <Grid x:Name="HistoryMetadata"
                          Grid.Row="2"
                          Grid.Column="1"
                          Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <local:HighlightedTextControl x:Name="HistorySubtitleText"
                                                      Grid.ColumnSpan="2"
                                                      SearchText="{x:Bind SearchQuery}"
                                                      Text="{x:Bind Subtitle, Mode=OneWay}"
                                                      TextBlockStyle="{StaticResource HistorySubtitleTextStyle}"
                                                      Visibility="{x:Bind IsHistorical, Mode=OneWay}" />
                        <local:HighlightedTextControl x:Name="HistoryStatusText"
                                                      SearchText="{x:Bind SearchQuery}"
                                                      Text="{x:Bind StatusLabelText, Mode=OneWay}"
                                                      TextBlockStyle="{x:Bind StatusTextStyle, Mode=OneWay}"
                                                      Visibility="{x:Bind mtu:Converters.InvertedBooleanToVisibility(IsHistorical), Mode=OneWay}" />
                        <local:HighlightedTextControl x:Name="HistoryWindowHintText"
                                                      Grid.Column="1"
                                                      SearchText="{x:Bind SearchQuery}"
                                                      Text="{x:Bind WindowHintText, Mode=OneWay}"
                                                      TextBlockStyle="{StaticResource HistorySubtitleTextStyle}"
                                                      Visibility="{x:Bind mtu:Converters.InvertedBooleanToVisibility(IsHistorical), Mode=OneWay}" />
                    </Grid>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--  Keep an explicit painted surface for the background in XAML Islands.  -->
    <Grid x:Name="ContentGrid" Background="{x:Bind Background, Mode=OneWay}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border x:Name="SidebarDefaultHoverBrush"
                Background="{ThemeResource TabViewItemHeaderBackgroundPointerOver}"
                IsHitTestVisible="False"
                Visibility="Collapsed" />

        <Grid x:Name="TopChrome"
              Grid.Row="0"
              MinHeight="40"
              Visibility="Collapsed">
            <!--
                Hosts the complete vertical chrome when a non-client titlebar
                is unavailable. Otherwise, the same element is hosted by the
                window titlebar.
            -->
            <ContentPresenter x:Name="TopChromeContentPresenter"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Center" />
        </Grid>

        <Grid x:Name="CompactNewTabToolbar"
              Grid.Row="1"
              Width="40"
              Height="80"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>

            <Button x:Name="CompactNewTabButton"
                    x:Uid="CompactNewTabButton"
                    Width="40"
                    Height="40"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnCompactNewTabClick">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          FontSize="10"
                          Glyph="&#xE710;" />
            </Button>

            <Button x:Name="CompactNewTabMenuButton"
                    x:Uid="CompactNewTabMenuButton"
                    Grid.Row="1"
                    Width="40"
                    Height="40"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnCompactNewTabMenuClick">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          FontSize="8"
                          Glyph="&#xE70D;" />
            </Button>
        </Grid>

        <Grid x:Name="TabsToolbar"
              Grid.Row="2"
              Height="44"
              Padding="12,0,8,0"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="VerticalTabsHeader"
                       x:Uid="VerticalTabsHeader"
                       Margin="8,4"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold" />

            <ToggleButton x:Name="SearchTabsButton"
                          x:Uid="VerticalTabsSearchButton"
                          Grid.Column="1"
                          Width="40"
                          Height="40"
                          Padding="0"
                          VerticalAlignment="Center"
                          Background="Transparent"
                          BorderThickness="0"
                          PointerPressed="OnSearchPointerPressed"
                          Click="OnSearchToggleClick">
                <PathIcon Width="16"
                          Height="16"
                          Data="M11.0195 11.7266C10.0658 12.5217 8.83875 13 7.5 13C4.46243 13 2 10.5376 2 7.5C2 4.46243 4.46243 2 7.5 2C10.5376 2 13 4.46243 13 7.5C13 8.83875 12.5217 10.0658 11.7266 11.0195L14.8535 14.1464C15.0488 14.3417 15.0488 14.6583 14.8535 14.8536C14.6583 15.0488 14.3417 15.0488 14.1464 14.8536L11.0195 11.7266ZM12 7.5C12 5.01472 9.98528 3 7.5 3C5.01472 3 3 5.01472 3 7.5C3 9.98528 5.01472 12 7.5 12C9.98528 12 12 9.98528 12 7.5Z" />
            </ToggleButton>

            <Button x:Name="FilterTabsButton"
                    x:Uid="VerticalTabsFilterButton"
                    Grid.Column="2"
                    Width="40"
                    Height="40"
                    Padding="0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0">
                <Button.Content>
                    <Grid Width="40"
                          Height="40">
                        <PathIcon Width="16"
                                  Height="16"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M6 9.5C6.93191 9.5 7.71496 10.1374 7.93699 11L13.5 11C13.7761 11 14 11.2239 14 11.5C14 11.7455 13.8231 11.9496 13.5899 11.9919L13.5 12L7.93673 12.001C7.71435 12.8631 6.93155 13.5 6 13.5C5.06845 13.5 4.28565 12.8631 4.06327 12.001L2.5 12C2.22386 12 2 11.7761 2 11.5C2 11.2545 2.17688 11.0504 2.41012 11.0081L2.5 11L4.06301 11C4.28504 10.1374 5.06809 9.5 6 9.5ZM6 10.5C5.44772 10.5 5 10.9477 5 11.5C5 12.0523 5.44772 12.5 6 12.5C6.55228 12.5 7 12.0523 7 11.5C7 10.9477 6.55228 10.5 6 10.5ZM10 2.5C10.9319 2.5 11.715 3.13738 11.937 3.99998L13.5 4C13.7761 4 14 4.22386 14 4.5C14 4.74546 13.8231 4.94961 13.5899 4.99194L13.5 5L11.9367 5.00102C11.7144 5.86312 10.9316 6.5 10 6.5C9.06845 6.5 8.28565 5.86312 8.06327 5.00102L2.5 5C2.22386 5 2 4.77614 2 4.5C2 4.25454 2.17688 4.05039 2.41012 4.00806L2.5 4L8.06301 3.99998C8.28504 3.13738 9.06809 2.5 10 2.5ZM10 3.5C9.44772 3.5 9 3.94772 9 4.5C9 5.05228 9.44772 5.5 10 5.5C10.5523 5.5 11 5.05228 11 4.5C11 3.94772 10.5523 3.5 10 3.5Z" />
                        <Ellipse x:Name="AgentsOnlyIndicator"
                                 Width="4"
                                 Height="4"
                                 Margin="0,9,11,0"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Fill="{ThemeResource AgentsOnlyIndicatorBrush}"
                                 IsHitTestVisible="False"
                                 Visibility="Collapsed" />
                    </Grid>
                </Button.Content>
                <Button.Flyout>
                    <MenuFlyout Closed="OnDisplayOptionsClosed"
                                Closing="OnRichTabMetadataFlyoutClosing"
                                Opened="OnDisplayOptionsOpened"
                                Placement="BottomEdgeAlignedLeft">
                        <MenuFlyoutItem x:Uid="VerticalTabsFilterSection"
                                        IsEnabled="False"
                                        Style="{StaticResource RichTabMetadataSectionStyle}" />
                        <ToggleMenuFlyoutItem x:Name="AgentsOnlyFilterMenuItem"
                                              x:Uid="VerticalTabsFilterAgentsOnly"
                                              IsChecked="{x:Bind SidebarFilters.ShowAgentsOnly, Mode=TwoWay}" />
                        <ToggleMenuFlyoutItem x:Name="RecentAgentSessionsFilterMenuItem"
                                              x:Uid="VerticalTabsSessionHistoryHeader"
                                              IsChecked="{x:Bind SidebarFilters.ShowRecentAgentSessions, Mode=TwoWay}" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="RichTabMetadataSectionItem"
                                        x:Uid="VerticalTabsMetadataSection"
                                        IsEnabled="False"
                                        Style="{StaticResource RichTabMetadataSectionStyle}" />
                        <ToggleMenuFlyoutItem x:Name="RichTabAgentStatusVisibleItem"
                                              x:Uid="VerticalTabsMetadataAgentStatus"
                                              IsChecked="True"
                                              Click="OnRichTabAgentStatusVisibleClick" />
                        <ToggleMenuFlyoutItem x:Name="RichTabWorkingDirectoryVisibleItem"
                                              x:Uid="VerticalTabsMetadataWorkingDirectory"
                                              IsChecked="True"
                                              Click="OnRichTabWorkingDirectoryVisibleClick" />
                        <ToggleMenuFlyoutItem x:Name="RichTabRepositoryVisibleItem"
                                              x:Uid="VerticalTabsMetadataRepository"
                                              Click="OnRichTabRepositoryVisibleClick" />
                        <ToggleMenuFlyoutItem x:Name="RichTabBranchVisibleItem"
                                              x:Uid="VerticalTabsMetadataBranch"
                                              Click="OnRichTabBranchVisibleClick" />
                        <ToggleMenuFlyoutItem x:Name="RichTabChangesVisibleItem"
                                              x:Uid="VerticalTabsMetadataChanges"
                                              Click="OnRichTabChangesVisibleClick" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

        </Grid>

        <Grid x:Name="SearchPanel"
              Grid.Row="3"
              Height="0"
              Opacity="0"
              Visibility="Collapsed">
            <Grid Margin="6,4">
                <TextBox x:Name="SearchTextBox"
                         x:Uid="VerticalTabsSearchBox"
                         Height="32"
                         Padding="8,6,8,0"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         KeyDown="OnSearchBoxKeyDown"
                         TextChanged="OnSearchTextChanged" />
            </Grid>
        </Grid>

        <!-- One display descriptor per canonical tab. The hosted TabViewItem
             remains the real tab; pane rows are a vertical-only projection. -->
        <ListView x:Name="ItemsList"
                  AutomationProperties.AutomationId="ItemsList"
                  Grid.Row="4"
                  Padding="0"
                  AllowDrop="False"
                  CanDragItems="False"
                  CanReorderItems="False"
                  ContainerContentChanging="OnContainerContentChanging"
                  DragOver="OnListDragOver"
                  Drop="OnListDrop"
                  DragItemsStarting="OnDragItemsStarting"
                  DragItemsCompleted="OnDragItemsCompleted"
                  GotFocus="OnSidebarListFocusChanged"
                  IsItemClickEnabled="False"
                  ItemClick="OnHistoryItemClick"
                  LostFocus="OnSidebarListFocusChanged"
                  ReorderMode="Disabled"
                  SelectionChanged="OnListSelectionChanged"
                  SelectionMode="Single"
                  ScrollViewer.VerticalScrollMode="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  SingleSelectionFollowsFocus="False">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:TabStripDisplayItem">
                    <StackPanel HorizontalAlignment="Stretch">
                        <Grid x:Name="TabHeaderGrid"
                              MinHeight="{x:Bind HeaderMinHeight, Mode=OneWay}"
                              Background="Transparent"
                              ContextFlyout="{x:Bind ContextFlyout, Mode=OneWay}"
                              CornerRadius="{StaticResource SidebarTabCornerRadius}"
                              DoubleTapped="OnTabHeaderDoubleTapped"
                              GotFocus="OnSidebarRowGotFocus"
                              Loaded="OnTabHeaderLoaded"
                              PointerEntered="OnSidebarRowPointerEntered"
                              PointerExited="OnSidebarRowPointerExited"
                              PointerPressed="OnTabHeaderPointerPressed"
                              SizeChanged="OnSidebarRowSizeChanged"
                              Tapped="OnTabHeaderTapped"
                              Unloaded="OnTabHeaderUnloaded">
                            <ToolTipService.ToolTip>
                                <ToolTip AutomationProperties.Name="{x:Bind ToolTipText, Mode=OneWay}"
                                         FlowDirection="LeftToRight">
                                    <TextBlock FlowDirection="{Binding FlowDirection, ElementName=TabHeaderGrid, Mode=OneWay}"
                                               Text="{x:Bind ToolTipText, Mode=OneWay}"
                                               TextWrapping="Wrap" />
                                </ToolTip>
                            </ToolTipService.ToolTip>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="TabHoverBackground"
                                    Grid.ColumnSpan="3"
                                    Background="{ThemeResource TabViewItemHeaderBackgroundPointerOver}"
                                    CornerRadius="{StaticResource SidebarTabCornerRadius}"
                                    IsHitTestVisible="False"
                                    Opacity="0" />
                            <Border x:Name="TabColorHoverBackground"
                                    Grid.ColumnSpan="3"
                                    CornerRadius="{StaticResource SidebarTabCornerRadius}"
                                    IsHitTestVisible="False"
                                    Opacity="0" />
                            <Border x:Name="TabSelectionBackground"
                                    Grid.ColumnSpan="3"
                                    Background="{ThemeResource ListViewItemBackgroundSelected}"
                                    CornerRadius="{StaticResource SidebarTabCornerRadius}"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed" />
                            <Border x:Name="TabColorSelectionBackground"
                                    Grid.ColumnSpan="3"
                                    Background="Transparent"
                                    CornerRadius="{StaticResource SidebarTabCornerRadius}"
                                    IsHitTestVisible="False" />
                            <Grid Grid.ColumnSpan="{x:Bind LeadingContentColumnSpan, Mode=OneWay}"
                                  Width="28"
                                  Margin="{x:Bind LeadingContentMargin, Mode=OneWay}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <Button x:Name="TabGroupToggleButton"
                                        Width="28"
                                        Height="28"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="OnGroupToggleClick"
                                        Visibility="{x:Bind GroupVisibility, Mode=OneWay}">
                                    <FontIcon x:Name="TabGroupChevronIcon"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              FontSize="10"
                                              Glyph="{x:Bind ChevronGlyph, Mode=OneWay}"
                                              Visibility="{x:Bind mtu:Converters.InvertedBooleanToVisibility(ShowStatusIcon), Mode=OneWay}" />
                                </Button>
                                <ContentPresenter x:Name="TabIconPresenter"
                                                  Width="16"
                                                  Height="16"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Content="{x:Bind CreateIcon(IconSource), Mode=OneWay}"
                                                  Visibility="{x:Bind IconVisibility, Mode=OneWay}" />
                                <FontIcon x:Name="TabBellIndicator"
                                          Width="16"
                                          Height="16"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          FontSize="12"
                                          Foreground="{Binding Foreground, ElementName=TabHeaderPresenter, Mode=OneWay}"
                                          Glyph="&#xEA8F;"
                                          IsHitTestVisible="False"
                                          Visibility="{x:Bind Presentation.TabStatus.BellIndicator, Mode=OneWay}" />
                                <Grid IsHitTestVisible="False"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Visibility="{x:Bind ShowProgressRing, Mode=OneWay}">
                                    <mux:ProgressRing x:Name="TabProgressRing"
                                                      Width="15"
                                                      Height="15"
                                                      MinWidth="0"
                                                      MinHeight="0"
                                                      AutomationProperties.Name="{x:Bind Presentation.AutomationName, Mode=OneWay}"
                                                      IsActive="{x:Bind ShowProgressRing, Mode=OneWay}"
                                                      IsIndeterminate="False"
                                                      Visibility="{x:Bind mtu:Converters.InvertedBooleanToVisibility(Presentation.TabStatus.IsProgressRingIndeterminate), Mode=OneWay}"
                                                      Value="{x:Bind Presentation.TabStatus.ProgressValue, Mode=OneWay}" />
                                    <local:IndeterminateProgressRing x:Name="TabIndeterminateProgressRing"
                                                                     Style="{StaticResource DeclarativeSpinner}"
                                                                     Width="15"
                                                                     Height="15"
                                                                     MinWidth="0"
                                                                     MinHeight="0"
                                                                     AutomationProperties.Name="{x:Bind Presentation.AutomationName, Mode=OneWay}"
                                                                     Foreground="{Binding Foreground, ElementName=TabProgressRing, Mode=OneWay}"
                                                                     IsActive="{x:Bind ShowProgressRing, Mode=OneWay}"
                                                                     Visibility="{x:Bind Presentation.TabStatus.IsProgressRingIndeterminate, Mode=OneWay}" />
                                </Grid>
                                <PathIcon x:Name="CollapsedPinnedTabIcon"
                                          x:Uid="CollapsedPinnedTabIcon"
                                          Width="9"
                                          Height="9"
                                          Data="M8.05892 0.441444C7.34701 -0.273032 6.14697 -0.0953711 5.67261 0.794731L3.6526 4.58511L0.841896 5.52202C0.6775 5.57681 0.553199 5.71283 0.513385 5.88148C0.473572 6.05013 0.523923 6.22738 0.646457 6.34991L2.79287 8.49632L0.146371 11.1428L0 11.9964L0.853478 11.8499L3.49998 9.20343L5.64646 11.3499C5.76899 11.4724 5.94623 11.5228 6.11489 11.483C6.28354 11.4432 6.41955 11.3189 6.47435 11.1545L7.41143 8.34325L11.1897 6.32057C12.0759 5.84616 12.2538 4.65144 11.5443 3.93939L8.05892 0.441444Z"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Bottom"
                                          IsHitTestVisible="False"
                                          Visibility="{x:Bind PinnedIconVisibility, Mode=OneWay}" />
                            </Grid>
                            <local:TabHeaderControl x:Name="TabHeaderPresenter"
                                                    Grid.Column="1"
                                                    Margin="0,3"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Center"
                                                    Loaded="OnRowHeaderLoaded"
                                                    Presentation="{x:Bind Presentation, Mode=OneWay}"
                                                    IsMetadataVisible="{x:Bind IsMetadataVisible, Mode=OneWay}"
                                                    ShowProgressRing="False"
                                                    Visibility="{x:Bind HeaderVisibility, Mode=OneWay}" />
                            <Button x:Name="TabCloseButton"
                                    Grid.Column="2"
                                    Width="28"
                                    Height="28"
                                    MinWidth="0"
                                    MinHeight="0"
                                    Margin="0,4,4,0"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="4"
                                    Click="OnTabCloseClick"
                                    VerticalAlignment="Top"
                                    Visibility="{x:Bind CloseVisibility, Mode=OneWay}">
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          FontSize="10"
                                          Glyph="&#xE711;" />
                            </Button>
                        </Grid>
                        <ItemsControl x:Name="TabPaneItems"
                                      Margin="10,0,0,0"
                                      ItemsSource="{x:Bind PaneItems, Mode=OneWay}"
                                      Visibility="{x:Bind ChildrenVisibility, Mode=OneWay}">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <Grid>
                                        <Border x:Name="PaneGroupIndicator"
                                                Width="3"
                                                Margin="0,5"
                                                HorizontalAlignment="Left"
                                                Background="{ThemeResource PaneActiveIndicatorBrush}"
                                                CornerRadius="2"
                                                IsHitTestVisible="False" />
                                        <ItemsPresenter />
                                    </Grid>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:TabStripPaneItem">
                                    <Grid MinHeight="30"
                                          Margin="0,1,0,1"
                                          Background="Transparent"
                                          DoubleTapped="OnPaneDoubleTapped"
                                          GotFocus="OnPaneRowFocusChanged"
                                          Loaded="OnPaneRowLoaded"
                                          LostFocus="OnPaneRowFocusChanged"
                                          PointerEntered="OnPanePointerEntered"
                                          PointerExited="OnPanePointerExited"
                                          PointerPressed="OnPanePointerPressed"
                                          RightTapped="OnPaneRightTapped"
                                          Unloaded="OnPaneRowUnloaded">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <!-- The pane dismiss button remains wired below; its collapsed state makes this Auto column zero-width. -->
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="PaneActiveBackground"
                                                Grid.ColumnSpan="2"
                                                Margin="10,0,0,0"
                                                Background="{ThemeResource ListViewItemBackgroundSelected}"
                                                CornerRadius="{StaticResource SidebarTabCornerRadius}"
                                                IsHitTestVisible="False"
                                                Visibility="Collapsed" />
                                        <Border x:Name="PaneColorSelectionBackground"
                                                Grid.ColumnSpan="2"
                                                Margin="10,0,0,0"
                                                Background="Transparent"
                                                CornerRadius="{StaticResource SidebarTabCornerRadius}"
                                                IsHitTestVisible="False"
                                                Visibility="{x:Bind ActiveIndicatorVisibility, Mode=OneWay}" />
                                        <Border x:Name="PaneHoverBackground"
                                                Grid.ColumnSpan="2"
                                                Margin="10,0,0,0"
                                                Background="{ThemeResource TabViewItemHeaderBackgroundPointerOver}"
                                                CornerRadius="{StaticResource SidebarTabCornerRadius}"
                                                IsHitTestVisible="False"
                                                Opacity="0" />
                                        <Border x:Name="PaneColorHoverBackground"
                                                Grid.ColumnSpan="2"
                                                Margin="10,0,0,0"
                                                CornerRadius="{StaticResource SidebarTabCornerRadius}"
                                                IsHitTestVisible="False"
                                                Opacity="0" />
                                        <Button x:Name="PaneActivateButton"
                                                Grid.Column="0"
                                                Padding="0"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="OnPaneActivateClick"
                                                ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}">
                                            <Button.Resources>
                                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                                                                 Color="Transparent" />
                                                <SolidColorBrush x:Key="ButtonBackgroundPressed"
                                                                 Color="Transparent" />
                                            </Button.Resources>
                                            <Grid Margin="12,0,0,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3" />
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter x:Name="PaneIconPresenter"
                                                                  Grid.Column="1"
                                                                  Grid.RowSpan="2"
                                                                  Width="16"
                                                                  Height="16"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Content="{x:Bind CreateIcon(IconSource), Mode=OneWay}"
                                                                  Visibility="{x:Bind mtu:Converters.InvertedBooleanToVisibility(IsProgressRingActive), Mode=OneWay}" />
                                                <Grid Grid.RowSpan="2"
                                                      Grid.Column="1"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Visibility="{x:Bind IsProgressRingActive, Mode=OneWay}">
                                                    <mux:ProgressRing x:Name="PaneProgressRing"
                                                                      Width="15"
                                                                      Height="15"
                                                                      MinWidth="0"
                                                                      MinHeight="0"
                                                                      VerticalAlignment="Center"
                                                                      IsActive="{x:Bind IsProgressRingActive, Mode=OneWay}"
                                                                      IsIndeterminate="False"
                                                                      Visibility="{x:Bind mtu:Converters.InvertedBooleanToVisibility(IsProgressRingIndeterminate), Mode=OneWay}"
                                                                      Value="{x:Bind ProgressValue, Mode=OneWay}" />
                                                    <local:IndeterminateProgressRing x:Name="PaneIndeterminateProgressRing"
                                                                  Style="{StaticResource DeclarativeSpinner}"
                                                                  Width="15"
                                                                  Height="15"
                                                                  MinWidth="0"
                                                                  MinHeight="0"
                                                                  VerticalAlignment="Center"
                                                                  AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                                                                  IsActive="{x:Bind IsProgressRingActive, Mode=OneWay}"
                                                                  Visibility="{x:Bind IsProgressRingIndeterminate, Mode=OneWay}" />
                                                </Grid>
                                                <local:HighlightedTextControl x:Name="PaneTitleText"
                                                                              Grid.Column="2"
                                                                              Margin="2,3,0,0"
                                                                              VerticalAlignment="Center"
                                                                              SearchText="{x:Bind HighlightQuery, Mode=OneWay}"
                                                                              Text="{x:Bind Title, Mode=OneWay}">
                                                    <local:HighlightedTextControl.TextBlockStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                        </Style>
                                                    </local:HighlightedTextControl.TextBlockStyle>
                                                </local:HighlightedTextControl>
                                                <local:HighlightedTextControl x:Name="PaneMetadataText"
                                                                              Grid.Row="1"
                                                                              Grid.Column="2"
                                                                              Margin="2,1,0,3"
                                                                              TextOpacity="0.72"
                                                                              ColorHighlight="{x:Bind MetadataHighlightColor, Mode=OneWay}"
                                                                              ColorHighlightRanges="{x:Bind MetadataHighlightRanges, Mode=OneWay}"
                                                                              SuccessHighlightBrush="{ThemeResource SystemFillColorSuccessBrush}"
                                                                              CautionHighlightBrush="{ThemeResource SystemFillColorCautionBrush}"
                                                                              CriticalHighlightBrush="{ThemeResource SystemFillColorCriticalBrush}"
                                                                              SearchText="{x:Bind HighlightQuery, Mode=OneWay}"
                                                                              Text="{x:Bind MetadataText, Mode=OneWay}"
                                                                              Visibility="{x:Bind MetadataVisibility, Mode=OneWay}"
                                                                              AutomationProperties.AccessibilityView="Raw">
                                                    <local:HighlightedTextControl.TextBlockStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="MaxLines" Value="2" />
                                                            <Setter Property="FontSize" Value="10" />
                                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                        </Style>
                                                    </local:HighlightedTextControl.TextBlockStyle>
                                                </local:HighlightedTextControl>
                                            </Grid>
                                        </Button>
                                        <Button x:Name="PaneCloseButton"
                                                Grid.Column="1"
                                                Width="26"
                                                Height="26"
                                                MinWidth="0"
                                                MinHeight="0"
                                                Margin="0,4,4,0"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                CornerRadius="4"
                                                Click="OnPaneCloseClick"
                                                VerticalAlignment="Top"
                                                Visibility="{x:Bind CloseVisibility, Mode=OneWay}">
                                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                      FontSize="10"
                                                      Glyph="&#xE711;" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}"
                       TargetType="ListViewItem">
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="6,4" />
                    <Setter Property="MinHeight" Value="32" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="CornerRadius" Value="{StaticResource SidebarTabCornerRadius}" />
                    <Setter Property="UseSystemFocusVisuals" Value="True" />
                    <!--  Keep the native presenter and state brushes, but forward the row's corner radius.  -->
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <ListViewItemPresenter x:Name="SidebarItemPresenter"
                                                       CheckBoxBrush="{ThemeResource ListViewItemCheckBoxBrush}"
                                                       CheckBrush="{ThemeResource ListViewItemCheckBrush}"
                                                       CheckMode="{ThemeResource ListViewItemCheckMode}"
                                                       Content="{TemplateBinding Content}"
                                                       ContentMargin="{TemplateBinding Padding}"
                                                       ContentTemplate="{TemplateBinding ContentTemplate}"
                                                       ContentTransitions="{TemplateBinding ContentTransitions}"
                                                       Control.IsTemplateFocusTarget="True"
                                                       CornerRadius="{TemplateBinding CornerRadius}"
                                                       DisabledOpacity="{ThemeResource ListViewItemDisabledThemeOpacity}"
                                                       DragBackground="{ThemeResource ListViewItemDragBackground}"
                                                       DragForeground="{ThemeResource ListViewItemDragForeground}"
                                                       DragOpacity="{ThemeResource ListViewItemDragThemeOpacity}"
                                                       FocusBorderBrush="{ThemeResource ListViewItemFocusBorderBrush}"
                                                       FocusSecondaryBorderBrush="{ThemeResource ListViewItemFocusSecondaryBorderBrush}"
                                                       FocusVisualMargin="{TemplateBinding FocusVisualMargin}"
                                                       FocusVisualPrimaryBrush="{TemplateBinding FocusVisualPrimaryBrush}"
                                                       FocusVisualPrimaryThickness="{TemplateBinding FocusVisualPrimaryThickness}"
                                                       FocusVisualSecondaryBrush="{TemplateBinding FocusVisualSecondaryBrush}"
                                                       FocusVisualSecondaryThickness="{TemplateBinding FocusVisualSecondaryThickness}"
                                                       HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                       PlaceholderBackground="{ThemeResource ListViewItemPlaceholderBackground}"
                                                       PointerOverBackground="{ThemeResource TabViewItemHeaderBackgroundPointerOver}"
                                                       PointerOverForeground="{ThemeResource ListViewItemForegroundPointerOver}"
                                                       PressedBackground="{ThemeResource ListViewItemBackgroundPressed}"
                                                       ReorderHintOffset="{ThemeResource ListViewItemReorderHintThemeOffset}"
                                                       SelectedBackground="Transparent"
                                                       SelectedForeground="{ThemeResource ListViewItemForegroundSelected}"
                                                       SelectedPointerOverBackground="Transparent"
                                                       SelectedPressedBackground="Transparent"
                                                       SelectionCheckMarkVisualEnabled="{ThemeResource ListViewItemSelectionCheckMarkVisualEnabled}"
                                                       VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel Orientation="Vertical" ItemsUpdatingScrollMode="KeepScrollOffset" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
        </ListView>
        <!-- The TeachingTip's top aligns with this target, 71 DIPs below the rail's top. -->
        <Border x:Name="SidebarIntroductionTarget"
                Grid.RowSpan="5"
                Width="1"
                Height="1"
                Margin="0,70,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                IsHitTestVisible="False" />
    </Grid>
</UserControl>
