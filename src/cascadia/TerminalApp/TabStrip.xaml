    PROTOTYPE — see investigation-vertical-tabs.md. Not shipped.

    ListView-backed strip that renders TabViewItem instances. Vertical for the
    prototype; the control is named neutrally so C (single-strip end-state) can
    reuse it with a public Orientation property.
-->
<UserControl x:Class="TerminalApp.TabStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:TerminalApp"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mux="using:Microsoft.UI.Xaml.Controls"
             MinWidth="40"
             Background="{ThemeResource TabViewBackground}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!--  Remove the native horizontal tab border within this vertical-only scope.  -->
        <Thickness x:Key="TabViewItemBorderThickness">0</Thickness>
        <Style x:Key="HistoryTitleTextStyle"
               TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="HistorySubtitleTextStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.72" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{ThemeResource TabViewBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="TopChrome"
              Grid.Row="0"
              MinHeight="40"
              Visibility="Collapsed">
            <!--
                Hosts the complete vertical chrome when a non-client titlebar
                is unavailable. Otherwise, the same element is hosted by the
                window titlebar.
            -->
            <ContentPresenter x:Name="TopChromeContentPresenter"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Center" />
        </Grid>

        <Grid x:Name="CompactNewTabToolbar"
              Grid.Row="1"
              Width="40"
              Height="80"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>

            <Button x:Name="CompactNewTabButton"
                    x:Uid="CompactNewTabButton"
                    Width="40"
                    Height="40"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnCompactNewTabClick">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          FontSize="10"
                          Glyph="&#xE710;" />
            </Button>

            <Button x:Name="CompactNewTabMenuButton"
                    x:Uid="CompactNewTabMenuButton"
                    Grid.Row="1"
                    Width="40"
                    Height="40"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnCompactNewTabMenuClick">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          FontSize="8"
                          Glyph="&#xE70D;" />
            </Button>
        </Grid>

        <Grid x:Name="TabsToolbar"
              Grid.Row="2"
              Height="44"
              Padding="12,0,8,0"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="VerticalTabsHeader"
                       x:Uid="VerticalTabsHeader"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold" />

            <ToggleButton x:Name="SearchTabsButton"
                          x:Uid="VerticalTabsSearchButton"
                          Grid.Column="1"
                          Width="40"
                          Height="40"
                          Padding="0"
                          VerticalAlignment="Center"
                          Background="Transparent"
                          BorderThickness="0"
                          PointerPressed="OnSearchPointerPressed"
                          Click="OnSearchToggleClick">
                <PathIcon Width="16"
                          Height="16"
                          Data="M11.0195 11.7266C10.0658 12.5217 8.83875 13 7.5 13C4.46243 13 2 10.5376 2 7.5C2 4.46243 4.46243 2 7.5 2C10.5376 2 13 4.46243 13 7.5C13 8.83875 12.5217 10.0658 11.7266 11.0195L14.8535 14.1464C15.0488 14.3417 15.0488 14.6583 14.8535 14.8536C14.6583 15.0488 14.3417 15.0488 14.1464 14.8536L11.0195 11.7266ZM12 7.5C12 5.01472 9.98528 3 7.5 3C5.01472 3 3 5.01472 3 7.5C3 9.98528 5.01472 12 7.5 12C9.98528 12 12 9.98528 12 7.5Z" />
            </ToggleButton>

            <!--  Reserved for the Filter and History buttons shown in the target design.  -->
            <Button x:Name="FilterTabsButton"
                    x:Uid="VerticalTabsFilterButton"
                    Grid.Column="2"
                    Width="40"
                    Height="40"
                    Padding="0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0">
                <Button.Content>
                        <PathIcon Width="16"
                                  Height="16"
                                  Data="M2 3.5C2 3.22386 2.22386 3 2.5 3H13.5C13.7761 3 14 3.22386 14 3.5C14 3.77614 13.7761 4 13.5 4H2.5C2.22386 4 2 3.77614 2 3.5ZM4 7.5C4 7.22386 4.22386 7 4.5 7H11.5C11.7761 7 12 7.22386 12 7.5C12 7.77614 11.7761 8 11.5 8H4.5C4.22386 8 4 7.77614 4 7.5ZM6 11.5C6 11.2239 6.22386 11 6.5 11H9.5C9.77614 11 10 11.2239 10 11.5C10 11.7761 9.77614 12 9.5 12H6.5C6.22386 12 6 11.7761 6 11.5Z" />
                </Button.Content>
                <Button.Flyout>
                    <MenuFlyout>
                        <ToggleMenuFlyoutItem x:Name="AllTabsFilterItem"
                                              x:Uid="VerticalTabsFilterAllTabs"
                                              IsChecked="True"
                                              Click="OnAllTabsFilterClick" />
                        <ToggleMenuFlyoutItem x:Name="AgentsOnlyFilterItem"
                                              x:Uid="VerticalTabsFilterAgentsOnly"
                                              Click="OnAgentsOnlyFilterClick" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <Button x:Name="TabHistoryButton"
                    x:Uid="VerticalTabsHistoryButton"
                    Grid.Column="3"
                    Width="40"
                    Height="40"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnHistoryClick">
                <PathIcon Width="16"
                          Height="16"
                          Data="M7.99909 3C10.7605 3 12.9991 5.23858 12.9991 8C12.9991 10.7614 10.7605 13 7.99909 13C5.39117 13 3.2491 11.003 3.0195 8.45512C2.99471 8.1801 2.75167 7.97723 2.47664 8.00202C2.20161 8.0268 1.99875 8.26985 2.02353 8.54488C2.29916 11.6035 4.86898 14 7.99909 14C11.3128 14 13.9991 11.3137 13.9991 8C13.9991 4.68629 11.3128 2 7.99909 2C6.20656 2 4.59815 2.78613 3.49909 4.03138V2.5C3.49909 2.22386 3.27524 2 2.99909 2C2.72295 2 2.49909 2.22386 2.49909 2.5V5.5C2.49909 5.77614 2.72295 6 2.99909 6H3.08812C3.09498 6.00014 3.10184 6.00014 3.10868 6H5.99909C6.27524 6 6.49909 5.77614 6.49909 5.5C6.49909 5.22386 6.27524 5 5.99909 5H3.99863C4.91128 3.78495 6.36382 3 7.99909 3ZM7.99909 5.5C7.99909 5.22386 7.77524 5 7.49909 5C7.22295 5 6.99909 5.22386 6.99909 5.5V8.5C6.99909 8.77614 7.22295 9 7.49909 9H9.49909C9.77524 9 9.99909 8.77614 9.99909 8.5C9.99909 8.22386 9.77524 8 9.49909 8H7.99909V5.5Z" />
            </Button>
        </Grid>

        <Grid x:Name="SearchPanel"
              Grid.Row="3"
              Height="0"
              Opacity="0"
              Visibility="Collapsed">
            <Grid Margin="6,4">
                <TextBox x:Name="SearchTextBox"
                         x:Uid="VerticalTabsSearchBox"
                         Height="32"
                         Padding="8,6,8,0"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         KeyDown="OnSearchBoxKeyDown"
                         TextChanged="OnSearchTextChanged" />
            </Grid>
        </Grid>

        <!--
            The strip proper. ListView holds TabViewItem instances directly via
            a passthrough item template. Code-behind adds vertical selection
            chrome to the hosted TabViewItem without replacing its template.
        -->
        <ListView x:Name="ItemsList"
                  Grid.Row="4"
                  Padding="0"
                  AllowDrop="True"
                  CanDragItems="True"
                  CanReorderItems="True"
                  ContainerContentChanging="OnContainerContentChanging"
                  DragOver="OnListDragOver"
                  Drop="OnListDrop"
                  DragItemsStarting="OnDragItemsStarting"
                  DragItemsCompleted="OnDragItemsCompleted"
                  IsItemClickEnabled="False"
                  ReorderMode="Enabled"
                  SelectionChanged="OnListSelectionChanged"
                  SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ContentPresenter HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      Content="{Binding}" />
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="6,4" />
                    <Setter Property="Height" Value="32" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="CornerRadius" Value="6" />
                    <Setter Property="UseSystemFocusVisuals" Value="True" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
        </ListView>

        <Border x:Name="FilterStatusBar"
                Grid.Row="5"
                Height="32"
                Padding="12,0,4,0"
                Background="{ThemeResource TabViewBackground}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FilterStatusText"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Opacity="0.72"
                           TextTrimming="CharacterEllipsis" />
                <FontIcon x:Name="HiddenCurrentTabIndicator"
                          x:Uid="VerticalTabsFilterCurrentHidden"
                          Grid.Column="1"
                          Margin="4,0"
                          VerticalAlignment="Center"
                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          FontSize="12"
                          Glyph="&#xE7BA;"
                          Visibility="Collapsed" />
                <Button x:Uid="VerticalTabsFilterShowAll"
                        Grid.Column="2"
                        Width="28"
                        Height="28"
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnShowAllTabsClick">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="10"
                              Glyph="&#xE711;" />
                </Button>
            </Grid>
        </Border>

        <Grid x:Name="HistoryPanel"
              Grid.Row="2"
              Grid.RowSpan="4"
              Background="{ThemeResource TabViewBackground}"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Padding="12,0,8,0"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="0,1,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Uid="VerticalTabsHistoryHeader"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />
                <Button x:Uid="VerticalTabsHistoryCloseButton"
                        Grid.Column="1"
                        Width="40"
                        Height="40"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnHistoryCloseClick">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="12"
                              Glyph="&#xE711;" />
                </Button>
            </Grid>
            <TextBox x:Name="HistorySearchTextBox"
                     x:Uid="VerticalTabsHistorySearchBox"
                     Grid.Row="1"
                     Height="32"
                     Margin="6,4"
                     Padding="8,6,8,0"
                     VerticalAlignment="Center"
                     VerticalContentAlignment="Center"
                     KeyDown="OnHistorySearchBoxKeyDown"
                     TextChanged="OnHistorySearchTextChanged" />
            <Grid Grid.Row="2">
                <ListView x:Name="HistoryList"
                          ItemsSource="{x:Bind HistoryItems}"
                          IsItemClickEnabled="True"
                          ItemClick="OnHistoryItemClick"
                          SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:TabStripHistoryItem">
                            <Grid Padding="12,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <local:HighlightedTextControl Text="{x:Bind Title}"
                                                              SearchText="{x:Bind SearchQuery}"
                                                              TextBlockStyle="{StaticResource HistoryTitleTextStyle}" />
                                <local:HighlightedTextControl Grid.Row="1"
                                                              Margin="0,2,0,0"
                                                              Text="{x:Bind Subtitle}"
                                                              SearchText="{x:Bind SearchQuery}"
                                                              TextBlockStyle="{StaticResource HistorySubtitleTextStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <ProgressRing x:Name="HistoryLoadingIndicator"
                              Width="24"
                              Height="24"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              IsActive="False"
                              Visibility="Collapsed" />
                <TextBlock x:Name="HistoryMessage"
                           Margin="16"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
