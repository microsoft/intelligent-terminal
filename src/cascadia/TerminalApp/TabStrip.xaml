    PROTOTYPE — see investigation-vertical-tabs.md. Not shipped.

    ListView-backed strip that renders TabViewItem instances. Vertical for the
    prototype; the control is named neutrally so C (single-strip end-state) can
    reuse it with a public Orientation property.
-->
<UserControl x:Class="TerminalApp.TabStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:TerminalApp"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mux="using:Microsoft.UI.Xaml.Controls"
             MinWidth="40"
             Background="{ThemeResource TabViewBackground}"
             mc:Ignorable="d">

    <Grid Background="{ThemeResource TabViewBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="TopChrome"
              Grid.Row="0"
              MinHeight="40"
              Visibility="Collapsed">
            <!--
                Hosts the complete vertical chrome when a non-client titlebar
                is unavailable. Otherwise, the same element is hosted by the
                window titlebar.
            -->
            <ContentPresenter x:Name="TopChromeContentPresenter"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Center" />
        </Grid>

        <Grid x:Name="CompactNewTabToolbar"
              Grid.Row="1"
              Width="40"
              Height="80"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>

            <Button x:Name="CompactNewTabButton"
                    x:Uid="CompactNewTabButton"
                    Width="40"
                    Height="40"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnCompactNewTabClick">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          FontSize="10"
                          Glyph="&#xE710;" />
            </Button>

            <Button x:Name="CompactNewTabMenuButton"
                    x:Uid="CompactNewTabMenuButton"
                    Grid.Row="1"
                    Width="40"
                    Height="40"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnCompactNewTabMenuClick">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          FontSize="8"
                          Glyph="&#xE70D;" />
            </Button>
        </Grid>

        <Grid x:Name="TabsToolbar"
              Grid.Row="2"
              Height="44"
              Padding="12,0,8,0"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="VerticalTabsHeader"
                       x:Uid="VerticalTabsHeader"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold" />

            <Button x:Name="SearchTabsButton"
                    x:Uid="VerticalTabsSearchButton"
                    Grid.Column="1"
                    Width="32"
                    Height="32"
                    Padding="0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    IsTabStop="False">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          FontSize="12"
                          Glyph="&#xE721;" />
            </Button>

            <!--  Reserved for the Filter and History buttons shown in the target design.  -->
            <Button x:Name="FilterTabsButton"
                    x:Uid="VerticalTabsFilterButton"
                    Grid.Column="2"
                    Width="32"
                    Height="32"
                    Padding="0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    IsTabStop="False">
                <Button.Content>
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="12"
                              Glyph="&#xE71C;" />
                </Button.Content>
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Uid="VerticalTabsFilterSection"
                                        IsEnabled="False" />
                        <ToggleMenuFlyoutItem x:Name="AllTabsFilterItem"
                                              x:Uid="VerticalTabsFilterAllTabs"
                                              IsChecked="True"
                                              Click="OnAllTabsFilterClick" />
                        <ToggleMenuFlyoutItem x:Name="AgentsOnlyFilterItem"
                                              x:Uid="VerticalTabsFilterAgentsOnly"
                                              Click="OnAgentsOnlyFilterClick" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="VerticalTabsVisibleSection"
                                        IsEnabled="False" />
                        <ToggleMenuFlyoutItem x:Name="RichTabStatusVisibleItem"
                                              x:Uid="VerticalTabsVisibleStatus"
                                              IsChecked="True"
                                              Click="OnRichTabStatusVisibleClick" />
                        <ToggleMenuFlyoutItem x:Name="RichTabWorkingDirectoryVisibleItem"
                                              x:Uid="VerticalTabsVisibleWorkingDirectory"
                                              IsChecked="True"
                                              Click="OnRichTabWorkingDirectoryVisibleClick" />
                        <ToggleMenuFlyoutItem x:Name="RichTabRepositoryVisibleItem"
                                              x:Uid="VerticalTabsVisibleRepository"
                                              IsChecked="True"
                                              Click="OnRichTabRepositoryVisibleClick" />
                        <ToggleMenuFlyoutItem x:Name="RichTabBranchVisibleItem"
                                              x:Uid="VerticalTabsVisibleBranch"
                                              IsChecked="True"
                                              Click="OnRichTabBranchVisibleClick" />
                        <ToggleMenuFlyoutItem x:Name="RichTabAgentUsageCostVisibleItem"
                                              x:Uid="VerticalTabsVisibleAgentUsageCost"
                                              IsChecked="True"
                                              Click="OnRichTabAgentUsageCostVisibleClick" />
                        <ToggleMenuFlyoutItem x:Name="RichTabAgentContextWindowVisibleItem"
                                              x:Uid="VerticalTabsVisibleAgentContextWindow"
                                              IsChecked="True"
                                              Click="OnRichTabAgentContextWindowVisibleClick" />
                        <ToggleMenuFlyoutItem x:Name="RichTabAgentModelVisibleItem"
                                              x:Uid="VerticalTabsVisibleAgentModel"
                                              IsChecked="True"
                                              Click="OnRichTabAgentModelVisibleClick" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <Button x:Name="TabHistoryButton"
                    Grid.Column="3"
                    Width="32"
                    Height="32"
                    Visibility="Collapsed" />
        </Grid>

        <!--
            The strip proper. ListView holds TabViewItem instances directly via
            a passthrough item template. ListViewItem chrome is stripped so the
            TabViewItem owns all visual state; selection is synced in code-behind.
        -->
        <ListView x:Name="ItemsList"
                  Grid.Row="3"
                  Padding="0"
                  AllowDrop="True"
                  CanDragItems="True"
                  CanReorderItems="True"
                  DragOver="OnListDragOver"
                  Drop="OnListDrop"
                  DragItemsStarting="OnDragItemsStarting"
                  DragItemsCompleted="OnDragItemsCompleted"
                  IsItemClickEnabled="False"
                  ReorderMode="Enabled"
                  SelectionChanged="OnListSelectionChanged"
                  SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ContentPresenter HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      Content="{Binding}" />
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="MinHeight" Value="32" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
        </ListView>

        <Border x:Name="FilterStatusBar"
                Grid.Row="4"
                Height="32"
                Padding="12,0,4,0"
                Background="{ThemeResource TabViewBackground}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FilterStatusText"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Opacity="0.72"
                           TextTrimming="CharacterEllipsis" />
                <FontIcon x:Name="HiddenCurrentTabIndicator"
                          x:Uid="VerticalTabsFilterCurrentHidden"
                          Grid.Column="1"
                          Margin="4,0"
                          VerticalAlignment="Center"
                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          FontSize="12"
                          Glyph="&#xE7BA;"
                          Visibility="Collapsed" />
                <Button x:Uid="VerticalTabsFilterShowAll"
                        Grid.Column="2"
                        Width="28"
                        Height="28"
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnShowAllTabsClick">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="10"
                              Glyph="&#xE711;" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
