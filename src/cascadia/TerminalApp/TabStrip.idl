// PROTOTYPE — see investigation-vertical-tabs.md. Not shipped.
//
// TabStrip is a ListView-backed alternative to Microsoft.UI.Xaml.Controls.TabView.
// It exposes the subset of TabView's public surface that TerminalPage +
// TabManagement.cpp call, so those call sites don't have to branch on which
// strip is live. Orientation is a public property (per the B→C migration
// rules in the investigation doc); the prototype only implements Vertical.

namespace TerminalApp
{
    enum TabStripOrientation
    {
        Horizontal = 0,
        Vertical = 1,
    };

    enum TabStripFilterMode
    {
        AllTabs = 0,
        AgentsOnly = 1,
    };

    [default_interface] runtimeclass TabStripHistoryItem : Windows.UI.Xaml.Data.INotifyPropertyChanged
    {
        String SessionId;
        String Title;
        String Subtitle;
        String Cwd;
        String PaneSessionId;
        String AgentId;
        String ProviderDisplayName;
        String AgentSource;
        String WslDistro;
        String SessionUniverse;
        String Status;
        String SearchQuery;
        Boolean IsLive;
        Boolean IsAgentPane;
        Boolean IsHistorical;
        String StatusText;
        Windows.UI.Xaml.Style StatusTextStyle;
        Windows.UI.Xaml.DataTemplate IconTemplate;
        Boolean IsCurrent;
        Windows.UI.Xaml.Media.Brush CurrentBackground;
        Windows.UI.Xaml.Media.Brush CurrentForeground;
    };

    [default_interface] runtimeclass TabStripHistoryActivationEventArgs
    {
        TabStripHistoryItem Item { get; };
    };

    [default_interface] runtimeclass TabStripPaneItem : Windows.UI.Xaml.Data.INotifyPropertyChanged
    {
        Microsoft.UI.Xaml.Controls.TabViewItem Tab { get; };
        UInt32 ContentId { get; };
        String Title;
        Boolean IsActive;
        Windows.UI.Xaml.Visibility ActiveIndicatorVisibility;
        String MetadataText;
        String AutomationName;
        Windows.UI.Xaml.Visibility MetadataVisibility;
        Windows.UI.Xaml.Controls.IconElement Icon;
        String HighlightQuery;
    };

    [default_interface] runtimeclass TabStripDisplayItem : Windows.UI.Xaml.Data.INotifyPropertyChanged
    {
        Microsoft.UI.Xaml.Controls.TabViewItem Tab { get; };
        Windows.Foundation.Collections.IObservableVector<TabStripPaneItem> PaneItems { get; };
        Object Header;
        String Title;
        String SearchText;
        Windows.UI.Xaml.Controls.IconElement Icon;
        Windows.UI.Xaml.Controls.Primitives.FlyoutBase ContextFlyout;
        Boolean IsExpanded;
        Boolean IsGroup;
        Windows.UI.Xaml.Visibility HeaderVisibility;
        Windows.UI.Xaml.Visibility CloseVisibility;
        Windows.UI.Xaml.Visibility SelectionVisibility;
        Windows.UI.Xaml.Visibility GroupVisibility;
        Windows.UI.Xaml.Visibility ChildrenVisibility;
        String ChevronGlyph;
        Windows.UI.Xaml.Visibility IconVisibility;
        Double HeaderMinHeight;
        Windows.UI.Xaml.Thickness LeadingContentMargin;
    };

    [default_interface] runtimeclass TabStripPaneEventArgs
    {
        Microsoft.UI.Xaml.Controls.TabViewItem Tab { get; };
        UInt32 ContentId { get; };
    };

    [default_interface] runtimeclass TabStripSelectionChangedEventArgs
    {
        Object AddedItem { get; };
        Object RemovedItem { get; };
    };

    [default_interface] runtimeclass TabStripCloseRequestedEventArgs
    {
        Microsoft.UI.Xaml.Controls.TabViewItem Tab { get; };
    };

    [default_interface] runtimeclass TabStripDragStartingEventArgs
    {
        Microsoft.UI.Xaml.Controls.TabViewItem Tab { get; };
        Object Item { get; };
        Windows.ApplicationModel.DataTransfer.DataPackage Data { get; };
        Boolean Cancel;
    };

    [default_interface] runtimeclass TabStripDroppedOutsideEventArgs
    {
        Microsoft.UI.Xaml.Controls.TabViewItem Tab { get; };
        Object Item { get; };
    };

    [default_interface] runtimeclass TabStrip : Windows.UI.Xaml.Controls.UserControl
    {
        TabStrip();

        TabStripOrientation Orientation;

        // Mirrors TabView.TabItems — TabManagement.cpp calls InsertAt/RemoveAt/
        // IndexOf/Size/GetAt on this collection, so the signature must match.
        Windows.Foundation.Collections.IObservableVector<Object> TabItems { get; };

        Object SelectedItem;
        Int32 SelectedIndex;

        // Mirrors TabView.ContainerFromIndex — used by tearoff drop-position math.
        Windows.UI.Xaml.DependencyObject ContainerFromIndex(Int32 index);
        void SetTabItemVisibility(Object item, Boolean visible);
        void SetFilterStatus(UInt32 visibleTabCount, Boolean selectedTabVisible);

        Boolean CanReorderTabs;
        Boolean CanDragTabs;
        Boolean TabsVisible;
        Boolean IsRailCollapsed;
        TabStripFilterMode FilterMode;
        Boolean SearchActive;
        String SearchQuery;
        Windows.Foundation.Collections.IObservableVector<TabStripHistoryItem> HistoryItems { get; };
        Boolean HistoryActive;
        Boolean HistoryLoading;
        String HistoryError;

        // Hosts the complete vertical chrome when no titlebar is available.
        Windows.UI.Xaml.UIElement TopChromeContent;

        event Windows.Foundation.TypedEventHandler<TabStrip, TabStripSelectionChangedEventArgs> SelectionChanged;
        event Windows.Foundation.TypedEventHandler<TabStrip, TabStripCloseRequestedEventArgs> TabCloseRequested;
        event Windows.Foundation.TypedEventHandler<TabStrip, Windows.Foundation.Collections.IVectorChangedEventArgs> TabItemsChanged;
        event Windows.Foundation.TypedEventHandler<TabStrip, TabStripDragStartingEventArgs> TabDragStarting;
        event Windows.Foundation.TypedEventHandler<TabStrip, Object> TabDragCompleted;
        event Windows.Foundation.TypedEventHandler<TabStrip, Windows.UI.Xaml.DragEventArgs> TabStripDragOver;
        event Windows.Foundation.TypedEventHandler<TabStrip, Windows.UI.Xaml.DragEventArgs> TabStripDrop;
        event Windows.Foundation.TypedEventHandler<TabStrip, TabStripDroppedOutsideEventArgs> TabDroppedOutside;
        event Windows.Foundation.TypedEventHandler<TabStrip, Object> RailCollapseRequested;
        event Windows.Foundation.TypedEventHandler<TabStrip, Object> CompactNewTabRequested;
        event Windows.Foundation.TypedEventHandler<TabStrip, Object> CompactNewTabMenuRequested;
        event Windows.Foundation.TypedEventHandler<TabStrip, Object> FilterChanged;
        event Windows.Foundation.TypedEventHandler<TabStrip, Object> SearchActivationRequested;
        event Windows.Foundation.TypedEventHandler<TabStrip, Object> SearchChanged;
        event Windows.Foundation.TypedEventHandler<TabStrip, Object> HistoryRequested;
        event Windows.Foundation.TypedEventHandler<TabStrip, Object> HistoryClosed;
        event Windows.Foundation.TypedEventHandler<TabStrip, TabStripHistoryActivationEventArgs> HistoryActivationRequested;

        void SetTabPresentation(Object item, String title, String iconPath);
        void SetPaneItems(Object item, Windows.Foundation.Collections.IVector<TabStripPaneItem> panes, Boolean isGroup);
        event Windows.Foundation.TypedEventHandler<TabStrip, TabStripPaneEventArgs> PaneActivationRequested;
        event Windows.Foundation.TypedEventHandler<TabStrip, TabStripPaneEventArgs> PaneCloseRequested;
        event Windows.Foundation.TypedEventHandler<TabStrip, TabStripCloseRequestedEventArgs> TabRenameRequested;
        event Windows.Foundation.TypedEventHandler<TabStrip, TabStripCloseRequestedEventArgs> TabFocusRequested;

        Boolean HistoryActivating;
        Boolean RichTabRepositoryVisible;
        Boolean RichTabBranchVisible;
        Boolean RichTabAgentStatusVisible;
        Boolean RichTabChangesVisible;
        Boolean RichTabWorkingDirectoryVisible;
        event Windows.Foundation.TypedEventHandler<TabStrip, Object> VisibleFieldsChanged;
    };
}
