<UserControl x:Class="TerminalApp.TabHeaderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:TerminalApp"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mtu="using:Microsoft.Terminal.UI"
             xmlns:mux="using:Microsoft.UI.Xaml.Controls"
             MinHeight="16"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-resource:///Files/TerminalApp/IndeterminateProgressResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="HeaderLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel x:Name="HeaderStackPanel"
                    Orientation="Horizontal">
            <Grid x:Name="HeaderProgressRingPresenter"
                  Visibility="{x:Bind ShowProgressRing, Mode=OneWay}">
                <Grid Visibility="{x:Bind mtu:Converters.InvertedBooleanToVisibility(TabStatus.BellIndicator), Mode=OneWay}">
                    <Grid Width="{ThemeResource TabViewItemHeaderIconSize}"
                          Height="{ThemeResource TabViewItemHeaderIconSize}"
                          Visibility="{x:Bind TabStatus.IsProgressRingActive, Mode=OneWay}">
                        <mux:ProgressRing x:Name="HeaderProgressRing"
                                          Width="15"
                                          Height="15"
                                          MinWidth="0"
                                          MinHeight="0"
                                          IsActive="{x:Bind TabStatus.IsProgressRingActive, Mode=OneWay}"
                                          IsIndeterminate="False"
                                          Visibility="{x:Bind mtu:Converters.InvertedBooleanToVisibility(TabStatus.IsProgressRingIndeterminate), Mode=OneWay}"
                                          Value="{x:Bind TabStatus.ProgressValue, Mode=OneWay}" />
                        <local:IndeterminateProgressRing x:Name="HeaderIndeterminateProgressRing"
                                                         Width="15"
                                                         Height="15"
                                                         MinWidth="0"
                                                         MinHeight="0"
                                                         Foreground="{Binding Foreground, ElementName=HeaderProgressRing, Mode=OneWay}"
                                                         IsActive="{x:Bind TabStatus.IsProgressRingActive, Mode=OneWay}"
                                                         Style="{StaticResource DeclarativeSpinner}"
                                                         Visibility="{x:Bind TabStatus.IsProgressRingIndeterminate, Mode=OneWay}" />
                    </Grid>
                </Grid>
                <FontIcon x:Name="HeaderBellIndicator"
                          Width="{ThemeResource TabViewItemHeaderIconSize}"
                          Height="{ThemeResource TabViewItemHeaderIconSize}"
                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          FontSize="12"
                          Glyph="&#xEA8F;"
                          Visibility="{x:Bind TabStatus.BellIndicator, Mode=OneWay}" />
            </Grid>
            <FontIcon x:Name="HeaderZoomIcon"
                      Margin="0,0,8,0"
                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                      FontSize="12"
                      Glyph="&#xE8A3;"
                      Visibility="{x:Bind TabStatus.IsPaneZoomed, Mode=OneWay}" />
            <FontIcon x:Name="HeaderLockIcon"
                      Margin="0,0,8,0"
                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                      FontSize="12"
                      Glyph="&#xE72E;"
                      Visibility="{x:Bind TabStatus.IsReadOnlyActive, Mode=OneWay}" />
            <FontIcon x:Name="HeaderClosedIcon"
                      Margin="0,0,8,0"
                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                      FontSize="12"
                      Glyph="&#xEA39;"
                      Visibility="{x:Bind TabStatus.IsConnectionClosed, Mode=OneWay}" />
            <FontIcon x:Name="HeaderBroadcastIcon"
                      Margin="0,0,8,0"
                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                      FontSize="12"
                      Glyph="&#xEC05;"
                      Visibility="{x:Bind TabStatus.IsInputBroadcastActive, Mode=OneWay}" />
        </StackPanel>
        <Grid Grid.Column="1"
              MinWidth="0"
              HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <local:HighlightedTextControl x:Name="HeaderTextBlock"
                                          MinWidth="0"
                                          SearchText="{x:Bind SearchText, Mode=OneWay}"
                                          Text="{x:Bind Title, Mode=OneWay}"
                                          Visibility="Visible">
                <local:HighlightedTextControl.TextBlockStyle>
                    <Style TargetType="TextBlock">
                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    </Style>
                </local:HighlightedTextControl.TextBlockStyle>
            </local:HighlightedTextControl>
            <TextBox x:Name="HeaderRenamerTextBox"
                     Height="24"
                     MinHeight="0"
                     MaxWidth="{x:Bind RenamerMaxWidth, Mode=OneWay}"
                     Padding="4,4,4,3"
                     HorizontalAlignment="Left"
                     FontSize="12"
                     IsSpellCheckEnabled="False"
                     LostFocus="RenameBoxLostFocusHandler"
                     MaxLength="1024"
                     Visibility="Collapsed">
                <TextBox.ContextFlyout>
                    <mtu:TextMenuFlyout />
                </TextBox.ContextFlyout>
            </TextBox>
            <Grid Grid.Column="1"
                  VerticalAlignment="Center"
                  Visibility="{x:Bind ShowPinnedIcon, Mode=OneWay}">
                <PathIcon x:Name="HeaderPinnedIcon"
                          Width="12"
                          Height="12"
                          Margin="8,0,0,0"
                          Data="M8.05892 0.441444C7.34701 -0.273032 6.14697 -0.0953711 5.67261 0.794731L3.6526 4.58511L0.841896 5.52202C0.6775 5.57681 0.553199 5.71283 0.513385 5.88148C0.473572 6.05013 0.523923 6.22738 0.646457 6.34991L2.79287 8.49632L0.146371 11.1428L0 11.9964L0.853478 11.8499L3.49998 9.20343L5.64646 11.3499C5.76899 11.4724 5.94623 11.5228 6.11489 11.483C6.28354 11.4432 6.41955 11.3189 6.47435 11.1545L7.41143 8.34325L11.1897 6.32057C12.0759 5.84616 12.2538 4.65144 11.5443 3.93939L8.05892 0.441444Z"
                          Visibility="{x:Bind TabStatus.IsPinned, Mode=OneWay}" />
            </Grid>
            <FontIcon x:Name="HeaderKeepRunningIcon"
                      Grid.Column="2"
                      Margin="12,0,0,0"
                      VerticalAlignment="Center"
                      FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                      FontSize="12"
                      Glyph="&#xE8EE;"
                      Visibility="{x:Bind TabStatus.IsKeepRunning, Mode=OneWay}" />
        </Grid>
        <local:HighlightedTextControl x:Name="HeaderMetadataTextBlock"
                                      Grid.Row="1"
                                      Grid.ColumnSpan="2"
                                      Margin="0,1,0,0"
                                      AutomationProperties.Name="{x:Bind MetadataAutomationName, Mode=OneWay}"
                                      CautionHighlightBrush="{ThemeResource SystemFillColorCautionBrush}"
                                      ColorHighlight="{x:Bind MetadataHighlightColor, Mode=OneWay}"
                                      ColorHighlightRanges="{x:Bind MetadataHighlightRanges, Mode=OneWay}"
                                      CriticalHighlightBrush="{ThemeResource SystemFillColorCriticalBrush}"
                                      SearchText="{x:Bind SearchText, Mode=OneWay}"
                                      SuccessHighlightBrush="{ThemeResource SystemFillColorSuccessBrush}"
                                      Text="{x:Bind MetadataText, Mode=OneWay}"
                                      TextOpacity="0.72"
                                      Visibility="Collapsed">
            <local:HighlightedTextControl.TextBlockStyle>
                <Style TargetType="TextBlock">
                    <Setter Property="MaxLines" Value="2" />
                    <Setter Property="FontSize" Value="10" />
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                </Style>
            </local:HighlightedTextControl.TextBlockStyle>
        </local:HighlightedTextControl>
    </Grid>
</UserControl>
