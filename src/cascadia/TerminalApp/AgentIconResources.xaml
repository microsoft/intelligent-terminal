<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  Template content is the foreground brush supplied by the hosting label.  -->
    <DataTemplate x:Key="AgentIcon.copilot">
        <Viewbox>
            <BitmapIcon Width="16"
                        Height="16"
                        Foreground="{Binding}"
                        ShowAsMonochrome="True"
                        UriSource="ms-appx:///AgentIcons/Masks/copilot.png" />
        </Viewbox>
    </DataTemplate>
    <DataTemplate x:Key="AgentIcon.claude">
