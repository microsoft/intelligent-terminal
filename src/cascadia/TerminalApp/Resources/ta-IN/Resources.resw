  <!-- ═══ FRE Welcome Page ═══ -->
  <data name="FreOverlay_WelcomeTitle.Text" xml:space="preserve">
    <value>அறிவாண் முனையம்-க்கு வரவேற்கிறோம்</value>
    <comment>{Locked=qps-ploc,qps-ploca,qps-plocm} "Intelligent Terminal" is the product name.</comment>
  </data>
  <data name="FreOverlay_WelcomeSubtitlePrefix" xml:space="preserve">
    <value>பிழைகளை விளக்கவும், கட்டளைகளை வரையவும், பணிகளை முடக்கம் நீக்கவும் உதவ உங்கள் உள்ளிணைந்த உதவியாளரை அமைக்கவும், நீங்கள் பணிபுரியும் இடத்திலேயே. </value>
  </data>
  <data name="FreOverlay_WelcomeSubtitleLink" xml:space="preserve">
    <value>அறிவாண் முனையம் பற்றி மேலும் அறிக</value>
    <comment>{Locked=qps-ploc,qps-ploca,qps-plocm} "Intelligent Terminal" is the product name.</comment>
  </data>
  <data name="FreOverlay_Card1Title.Text" xml:space="preserve">
    <value>உங்கள் உள்ளிணைந்த AI முகவருடன் பணிப்பாய்வில் இருங்கள்</value>
    <comment>In this context, "agent" refers to an AI agent (e.g. Copilot, Claude, Gemini), not a human agent or representative.</comment>
  </data>
  <data name="FreOverlay_Card1Description.Text" xml:space="preserve">
    <value>உங்கள் முகவர் உங்கள் முனையத்தில் என்ன நடக்கிறது என்பதை அறிந்திருக்கும், பிழைகளைப் புரிந்துகொள்ளவும் சரிசெய்யவும் உதவ முடியும்.</value>
    <comment>In this context, "agent" refers to an AI agent (e.g. Copilot, Claude, Gemini), not a human agent or representative.</comment>
  </data>
  <data name="FreOverlay_Card2Title.Text" xml:space="preserve">
    <value>நீங்கள் நிறுத்திய இடத்திலிருந்தே தொடரவும்</value>
  </data>
  <data name="FreOverlay_Card2Description.Text" xml:space="preserve">
    <value>உங்கள் செயலில் உள்ள மற்றும் முந்தைய முகவர் அமர்வுகளைக் கண்காணிக்கவும், சில நொடிகளில் உங்கள் வேலையில் மீண்டும் இணையவும். முன்னேற்றத்தில் என்ன உள்ளது என்பதை மதிப்பாய்வு செய்யவும் அல்லது உங்கள் இடத்தை இழக்காமல் முந்தைய வேலையை மீண்டும் பார்க்கவும்.</value>
    <comment>In this context, "agent" refers to an AI agent (e.g. Copilot, Claude, Gemini), not a human agent or representative.</comment>
  </data>
  <data name="FreOverlay_NextButton.Content" xml:space="preserve">
    <value>அடுத்து</value>
  </data>
  <!-- ═══ FRE Settings Page ═══ -->
  <data name="FreOverlay_SettingsTitle.Text" xml:space="preserve">
    <value>உங்கள் முனையத்திற்கான AI முகவரை அமைக்கவும்</value>
    <comment>{Locked="Copilot","Claude","Gemini"} In this context, "agent" refers to an AI agent (e.g. Copilot, Claude, Gemini), not a human agent or representative.</comment>
  </data>
  <data name="FreOverlay_SettingsSubtitlePrefix" xml:space="preserve">
    <value>இப்போது என்ன அமைக்க வேண்டும் என்பதைத் தேர்வு செய்யுங்கள். இவற்றை எப்போது வேண்டுமானாலும் மாற்றலாம். </value>
  </data>
  <data name="FreOverlay_SettingsSubtitleLink" xml:space="preserve">
    <value>தரவு எவ்வாறு பயன்படுத்தப்படுகிறது என்பதைப் பற்றி அறிக</value>
  </data>
  <data name="FreOverlay_AgentLabel.Text" xml:space="preserve">
    <value>முகவர்</value>
    <comment>In this context, "agent" refers to an AI agent (e.g. Copilot, Claude, Gemini), not a human agent or representative.</comment>
  </data>
  <data name="FreOverlay_AgentDescription.Text" xml:space="preserve">
    <value>உங்கள் முகவர் பலகத்திற்கான முகவரைத் தேர்ந்தெடுக்கவும். ACP பற்றி மேலும் அறிக.</value>
    <comment>{Locked="ACP"} Here "agent" refers to an AI agent (e.g. Copilot, Claude, Gemini), not a proxy, human agent, or representative. ACP is displayed as a hyperlink.</comment>
  </data>
  <data name="FreOverlay_AgentInstallHint.Text" xml:space="preserve">
    <value>உங்கள் கணினியில் Node.js இயக்க நேரம் ஏற்கனவே இல்லை என்றால் அதை நிறுவும்.</value>
    <comment>{Locked="Node.js"} This hint appears when selecting an AI agent whose Node.js runtime may need to be installed automatically.</comment>
  </data>
  <data name="FreOverlay_SessionLabel.Text" xml:space="preserve">
    <value>அமர்வு மேலாண்மை</value>
  </data>
  <data name="FreOverlay_SessionDescription.Text" xml:space="preserve">
    <value>உங்கள் இயங்கும் மற்றும் கடந்த முகவர் அமர்வுகளைக் கண்காணிக்கவும்.</value>
    <comment>Description for session tracking in the first-run wizard. In this context, "agent" refers to an AI agent (e.g. Copilot, Claude, Gemini), not a human agent or representative.</comment>
  </data>
  <data name="FreOverlay_SessionHint.Text" xml:space="preserve">
    <value>இதை இயக்குவது உங்கள் முகவர்களெங்கும் அமர்வுகளைக் கண்காணிக்க ஒருங்கிணைப்பு hooks-ஐ நிறுவும்.</value>
    <comment>{Locked="hooks"} In this context, "agent" refers to an AI agent (e.g. Copilot, Claude, Gemini), not a human agent or representative.</comment>
  </data>
  <data name="FreOverlay_ShowTokenUsageAndCostLabel.Text" xml:space="preserve"><value>சூழல் பயன்பாடு மற்றும் அமர்வு செலவைக் காட்டு</value><comment>Header for a first-run toggle that shows available context-window usage and session cost in the terminal bottom bar. Session cost is reported for the active AI session. Keep 'session cost' generic and do not add a specific unit. Either value may be unavailable.</comment></data>
  <data name="FreOverlay_ShowTokenUsageAndCostDescription.Text" xml:space="preserve"><value>டெர்மினலின் கீழ்ப்பட்டியில் கிடைக்கக்கூடிய சூழல் சாளரப் பயன்பாட்டையும் அமர்வு செலவையும் காட்டவும்.</value><comment>Description for the usage visibility toggle in the first-run wizard. Session cost is reported for the active AI session. Keep 'session cost' generic and do not add a specific unit. Either value may be unavailable.</comment></data>
  <data name="FreOverlay_PanePositionLabel.Text" xml:space="preserve">
    <value>பலக நிலை</value>
  </data>
  <data name="FreOverlay_PanePositionDescription.Text" xml:space="preserve">
    <value>உங்கள் முனையத்திற்கு சார்பாக முகவர் பலகம் எங்கே திறக்கிறது.</value>
    <comment>In this context, "agent" refers to an AI agent (e.g. Copilot, Claude, Gemini), not a human agent or representative.</comment>
  </data>
  <data name="FreOverlay_SaveButton.Content" xml:space="preserve">
    <value>சேமி</value>
  </data>
  <!-- ═══ FRE Dynamic strings (used from C++ code-behind) ═══ -->
