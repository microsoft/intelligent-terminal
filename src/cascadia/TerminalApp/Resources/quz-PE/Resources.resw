  <!-- ═══ FRE Welcome Page ═══ -->
  <data name="FreOverlay_WelcomeTitle.Text" xml:space="preserve">
    <value>Allillanchu Yuyaysapa Terminal</value>
    <comment>{Locked=qps-ploc,qps-ploca,qps-plocm} "Intelligent Terminal" is the product name.</comment>
  </data>
  <data name="FreOverlay_WelcomeSubtitlePrefix" xml:space="preserve">
    <value>Churay yanapaqniykita llamk'anaykipaq huchhakunata sut'inchinapaq, kamachikunata ruwanapaq, chaymanta llamk'aykunata kicharinapaq llamk'achkasqayki ukhupi. </value>
  </data>
  <data name="FreOverlay_WelcomeSubtitleLink" xml:space="preserve">
    <value>Yuyaysapa Terminal nisqamanta aswan yachay</value>
    <comment>{Locked=qps-ploc,qps-ploca,qps-plocm} "Intelligent Terminal" is the product name.</comment>
  </data>
  <data name="FreOverlay_Card1Title.Text" xml:space="preserve">
    <value>Puriypi qhipay AI agentiykiwan</value>
    <comment>In this context, "agent" refers to an AI agent (e.g. Copilot, Claude, Gemini), not a human agent or representative.</comment>
  </data>
  <data name="FreOverlay_Card1Description.Text" xml:space="preserve">
    <value>Agentiyki terminal nisqaykipi imakunata rikuspa yanapasunki huchhakunata hamut'anapaq chaymanta allinchanapaq rikhurimuptin.</value>
    <comment>In this context, "agent" refers to an AI agent (e.g. Copilot, Claude, Gemini), not a human agent or representative.</comment>
  </data>
  <data name="FreOverlay_Card2Title.Text" xml:space="preserve">
    <value>Hinallata qhipay sayanki chaymanta</value>
  </data>
  <data name="FreOverlay_Card2Description.Text" xml:space="preserve">
    <value>Kawsaq chaymanta ñawpaq agente hunt'akunata qhaway, chaymanta llamk'anaykiman kutiripuy waranqa kama. Qhaway imakunata rurachkan chaymanta ñawpaq llamk'aykunaman kutiy mana chinkachispa.</value>
    <comment>In this context, "agent" refers to an AI agent (e.g. Copilot, Claude, Gemini), not a human agent or representative.</comment>
  </data>
  <data name="FreOverlay_NextButton.Content" xml:space="preserve">
    <value>Qatiy</value>
  </data>
  <!-- ═══ FRE Settings Page ═══ -->
  <data name="FreOverlay_SettingsTitle.Text" xml:space="preserve">
    <value>Allillanchu Yuyaysapa Terminal</value>
    <comment>{Locked=qps-ploc,qps-ploca,qps-plocm} "Intelligent Terminal" is the product name.</comment>
  </data>
  <data name="FreOverlay_SettingsSubtitlePrefix" xml:space="preserve">
    <value>Kunan imata churanata akllay. Kay churanakunata mayk'aqpipas tikrayta atinki. </value>
  </data>
  <data name="FreOverlay_SettingsSubtitleLink" xml:space="preserve">
    <value>Yachay imaynatas datokunata llamk'achinku</value>
  </data>
  <data name="FreOverlay_AgentLabel.Text" xml:space="preserve">
    <value>Agente</value>
    <comment>In this context, "agent" refers to an AI agent (e.g. Copilot, Claude, Gemini), not a human agent or representative.</comment>
  </data>
  <data name="FreOverlay_AgentDescription.Text" xml:space="preserve">
    <value>Agente k’itiykipaq agente nisqata akllay. ACP nisqamanta aswan yachay.</value>
    <comment>{Locked="ACP"} Here "agent" refers to an AI agent (e.g. Copilot, Claude, Gemini), not a proxy, human agent, or representative. ACP is displayed as a hyperlink.</comment>
  </data>
  <data name="FreOverlay_AgentInstallHint.Text" xml:space="preserve">
    <value>Node.js purichina mana makinaykipiña kaptinqa churan.</value>
    <comment>{Locked="Node.js"} This hint appears when selecting an AI agent whose Node.js runtime may need to be installed automatically.</comment>
  </data>
  <data name="FreOverlay_SessionLabel.Text" xml:space="preserve">
    <value>Hunt'a kamachiy</value>
  </data>
  <data name="FreOverlay_SessionDescription.Text" xml:space="preserve">
    <value>Purichkaq hinaspa ñawpaq agente sesiónkunaykita qhawariy.</value>
    <comment>Description for session tracking in the first-run wizard. In this context, "agent" refers to an AI agent (e.g. Copilot, Claude, Gemini), not a human agent or representative.</comment>
  </data>
  <data name="FreOverlay_SessionHint.Text" xml:space="preserve">
    <value>Kayta hurquqtiyki integración hooks nisqakunata churanqa agente nisqakunaykipi hunt'akunata qhawarinapaq.</value>
    <comment>{Locked="hooks"} In this context, "agent" refers to an AI agent (e.g. Copilot, Claude, Gemini), not a human agent or representative.</comment>
  </data>
  <data name="FreOverlay_ShowTokenUsageAndCostLabel.Text" xml:space="preserve"><value>Contexto llamk'achiyta chaymanta sesión qullqita rikuchiy</value><comment>Header for a first-run toggle that shows available context-window usage and session cost in the terminal bottom bar. Session cost is reported for the active AI session. Keep 'session cost' generic and do not add a specific unit. Either value may be unavailable.</comment></data>
  <data name="FreOverlay_ShowTokenUsageAndCostDescription.Text" xml:space="preserve"><value>Kaptin, contexto-ventana llamk'achiyta chaymanta sesión qullqita terminal uray barra kaqpi rikuchiy.</value><comment>Description for the usage visibility toggle in the first-run wizard. Session cost is reported for the active AI session. Keep 'session cost' generic and do not add a specific unit. Either value may be unavailable.</comment></data>
  <data name="FreOverlay_PanePositionLabel.Text" xml:space="preserve">
    <value>K'iti k'iti</value>
  </data>
  <data name="FreOverlay_PanePositionDescription.Text" xml:space="preserve">
    <value>Maypi agente k'itiqa kichakapun terminal nisqaykipa ladunpi.</value>
    <comment>In this context, "agent" refers to an AI agent (e.g. Copilot, Claude, Gemini), not a human agent or representative.</comment>
  </data>
  <data name="FreOverlay_SaveButton.Content" xml:space="preserve">
    <value>Waqaychay</value>
  </data>
