  <!-- ═══ FRE Welcome Page ═══ -->
  <data name="FreOverlay_WelcomeTitle.Text" xml:space="preserve">
    <value>Vítejte v Inteligentní Terminál</value>
    <comment>{Locked=qps-ploc,qps-ploca,qps-plocm} "Intelligent Terminal" is the product name.</comment>
  </data>
  <data name="FreOverlay_WelcomeSubtitlePrefix" xml:space="preserve">
    <value>Nastavte si vestavěného asistenta, který vám pomůže vysvětlovat chyby, navrhovat příkazy a odblokovat úkoly přímo tam, kde pracujete. </value>
  </data>
  <data name="FreOverlay_WelcomeSubtitleLink" xml:space="preserve">
    <value>Další informace o Inteligentní Terminál</value>
    <comment>{Locked=qps-ploc,qps-ploca,qps-plocm} "Intelligent Terminal" is the product name.</comment>
  </data>
  <data name="FreOverlay_Card1Title.Text" xml:space="preserve">
    <value>Zůstaňte v proudu s vestavěným AI agentem</value>
    <comment>In this context, "agent" refers to an AI agent (e.g. Copilot, Claude, Gemini), not a human agent or representative.</comment>
  </data>
  <data name="FreOverlay_Card1Description.Text" xml:space="preserve">
    <value>Váš agent sleduje, co se děje ve vašem terminálu, a může vám pomoci pochopit a opravit chyby hned, jak se objeví.</value>
    <comment>In this context, "agent" refers to an AI agent (e.g. Copilot, Claude, Gemini), not a human agent or representative.</comment>
  </data>
  <data name="FreOverlay_Card2Title.Text" xml:space="preserve">
    <value>Pokračujte přesně tam, kde jste skončili</value>
  </data>
  <data name="FreOverlay_Card2Description.Text" xml:space="preserve">
    <value>Sledujte své aktivní a minulé relace agenta a vraťte se k práci během několika sekund. Projděte si rozpracované úkoly nebo se vraťte k dřívější práci, aniž byste ztratili přehled.</value>
    <comment>In this context, "agent" refers to an AI agent (e.g. Copilot, Claude, Gemini), not a human agent or representative.</comment>
  </data>
  <data name="FreOverlay_NextButton.Content" xml:space="preserve">
    <value>Další</value>
  </data>
  <!-- ═══ FRE Settings Page ═══ -->
  <data name="FreOverlay_SettingsTitle.Text" xml:space="preserve">
    <value>Vítejte v Inteligentní Terminál</value>
    <comment>{Locked=qps-ploc,qps-ploca,qps-plocm} "Intelligent Terminal" is the product name.</comment>
  </data>
  <data name="FreOverlay_SettingsSubtitlePrefix" xml:space="preserve">
    <value>Vyberte, co chcete nyní nastavit. Tato nastavení můžete kdykoli změnit. </value>
  </data>
  <data name="FreOverlay_SettingsSubtitleLink" xml:space="preserve">
    <value>Zjistěte, jak se data používají</value>
  </data>
  <data name="FreOverlay_AgentLabel.Text" xml:space="preserve">
    <value>Agent</value>
    <comment>In this context, "agent" refers to an AI agent (e.g. Copilot, Claude, Gemini), not a human agent or representative.</comment>
  </data>
  <data name="FreOverlay_AgentDescription.Text" xml:space="preserve">
    <value>Zvolte agenta pro panel agenta. Další informace o ACP.</value>
    <comment>{Locked="ACP"} Here "agent" refers to an AI agent (e.g. Copilot, Claude, Gemini), not a proxy, human agent, or representative. ACP is displayed as a hyperlink.</comment>
  </data>
  <data name="FreOverlay_AgentInstallHint.Text" xml:space="preserve">
    <value>Nainstaluje běhové prostředí Node.js, pokud ho ještě nemáte na počítači.</value>
    <comment>{Locked="Node.js"} This hint appears when selecting an AI agent whose Node.js runtime may need to be installed automatically.</comment>
  </data>
  <data name="FreOverlay_SessionLabel.Text" xml:space="preserve">
    <value>Správa relací</value>
  </data>
  <data name="FreOverlay_SessionDescription.Text" xml:space="preserve">
    <value>Sledujte probíhající a minulé relace agenta.</value>
    <comment>Description for session tracking in the first-run wizard. In this context, "agent" refers to an AI agent (e.g. Copilot, Claude, Gemini), not a human agent or representative.</comment>
  </data>
  <data name="FreOverlay_SessionHint.Text" xml:space="preserve">
    <value>Povolením této funkce se nainstalují integrační hooks pro sledování relací napříč vašimi agenty.</value>
    <comment>{Locked="hooks"} In this context, "agent" refers to an AI agent (e.g. Copilot, Claude, Gemini), not a human agent or representative.</comment>
  </data>
  <data name="FreOverlay_ShowTokenUsageAndCostLabel.Text" xml:space="preserve"><value>Zobrazit využití kontextu a cenu relace</value><comment>Header for a first-run toggle that shows available context-window usage and session cost in the terminal bottom bar. Session cost is reported for the active AI session. Keep 'session cost' generic and do not add a specific unit. Either value may be unavailable.</comment></data>
  <data name="FreOverlay_ShowTokenUsageAndCostDescription.Text" xml:space="preserve"><value>Je-li k dispozici, zobrazit využití kontextového okna a cenu relace na spodní liště terminálu.</value><comment>Description for the usage visibility toggle in the first-run wizard. Session cost is reported for the active AI session. Keep 'session cost' generic and do not add a specific unit. Either value may be unavailable.</comment></data>
  <data name="FreOverlay_PanePositionLabel.Text" xml:space="preserve">
    <value>Pozice panelu</value>
  </data>
  <data name="FreOverlay_PanePositionDescription.Text" xml:space="preserve">
    <value>Kde se panel agenta otevře vzhledem k vašemu terminálu.</value>
    <comment>In this context, "agent" refers to an AI agent (e.g. Copilot, Claude, Gemini), not a human agent or representative.</comment>
  </data>
  <data name="FreOverlay_SaveButton.Content" xml:space="preserve">
    <value>Uložit</value>
  </data>
