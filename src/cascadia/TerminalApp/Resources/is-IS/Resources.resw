  <!-- ═══ FRE Welcome Page ═══ -->
  <data name="FreOverlay_WelcomeTitle.Text" xml:space="preserve">
    <value>Velkomin í Snjallútstöð</value>
    <comment>{Locked=qps-ploc,qps-ploca,qps-plocm} "Intelligent Terminal" is the product name.</comment>
  </data>
  <data name="FreOverlay_WelcomeSubtitlePrefix" xml:space="preserve">
    <value>Settu upp innbyggða aðstoðina þína til að hjálpa þér að útskýra villur, semja skipanir og leysa verkefni beint þar sem þú vinnur. </value>
  </data>
  <data name="FreOverlay_WelcomeSubtitleLink" xml:space="preserve">
    <value>Frekari upplýsingar um Snjallútstöð</value>
    <comment>{Locked=qps-ploc,qps-ploca,qps-plocm} "Intelligent Terminal" is the product name.</comment>
  </data>
  <data name="FreOverlay_Card1Title.Text" xml:space="preserve">
    <value>Haltu flæðinu með innbyggða AI-agentinum þínum</value>
    <comment>In this context, "agent" refers to an AI agent (e.g. Copilot, Claude, Gemini), not a human agent or representative.</comment>
  </data>
  <data name="FreOverlay_Card1Description.Text" xml:space="preserve">
    <value>Agentinn þinn fylgist með því sem gerist í skjáherminum þínum og getur hjálpað þér að skilja og laga villur um leið og þær koma upp.</value>
    <comment>In this context, "agent" refers to an AI agent (e.g. Copilot, Claude, Gemini), not a human agent or representative.</comment>
  </data>
  <data name="FreOverlay_Card2Title.Text" xml:space="preserve">
    <value>Haltu áfram þar sem frá var horfið</value>
  </data>
  <data name="FreOverlay_Card2Description.Text" xml:space="preserve">
    <value>Fylgstu með virkum og fyrri agentlotum og hoppaðu aftur í vinnu þína á nokkrum sekúndum. Skoðaðu hvað er í gangi eða endurskoðaðu fyrri vinnu án þess að missa staðinn.</value>
    <comment>In this context, "agent" refers to an AI agent (e.g. Copilot, Claude, Gemini), not a human agent or representative.</comment>
  </data>
  <data name="FreOverlay_NextButton.Content" xml:space="preserve">
    <value>Næst</value>
  </data>
  <!-- ═══ FRE Settings Page ═══ -->
  <data name="FreOverlay_SettingsTitle.Text" xml:space="preserve">
    <value>Velkomin í Snjallútstöð</value>
    <comment>{Locked=qps-ploc,qps-ploca,qps-plocm} "Intelligent Terminal" is the product name.</comment>
  </data>
  <data name="FreOverlay_SettingsSubtitlePrefix" xml:space="preserve">
    <value>Veldu hvað á að setja upp núna. Þú getur breytt þessu hvenær sem er. </value>
  </data>
  <data name="FreOverlay_SettingsSubtitleLink" xml:space="preserve">
    <value>Fræðist um hvernig gögn eru notuð</value>
  </data>
  <data name="FreOverlay_AgentLabel.Text" xml:space="preserve">
    <value>Agent</value>
    <comment>In this context, "agent" refers to an AI agent (e.g. Copilot, Claude, Gemini), not a human agent or representative.</comment>
  </data>
  <data name="FreOverlay_AgentDescription.Text" xml:space="preserve">
    <value>Veldu agentinn fyrir agentspjaldið þitt. Frekari upplýsingar um ACP.</value>
    <comment>{Locked="ACP"} Here "agent" refers to an AI agent (e.g. Copilot, Claude, Gemini), not a proxy, human agent, or representative. ACP is displayed as a hyperlink.</comment>
  </data>
  <data name="FreOverlay_AgentInstallHint.Text" xml:space="preserve">
    <value>Setur upp Node.js-keyrsluumhverfið ef það er ekki þegar á tölvunni þinni.</value>
    <comment>{Locked="Node.js"} This hint appears when selecting an AI agent whose Node.js runtime may need to be installed automatically.</comment>
  </data>
  <data name="FreOverlay_SessionLabel.Text" xml:space="preserve">
    <value>Lotustjórnun</value>
  </data>
  <data name="FreOverlay_SessionDescription.Text" xml:space="preserve">
    <value>Fylgstu með yfirstandandi og fyrri umboðsmannslotum þínum.</value>
    <comment>Description for session tracking in the first-run wizard. In this context, "agent" refers to an AI agent (e.g. Copilot, Claude, Gemini), not a human agent or representative.</comment>
  </data>
  <data name="FreOverlay_SessionHint.Text" xml:space="preserve">
    <value>Virkjun þessa mun setja upp samþættingar-hooks til að rekja lotur þvert á agentana þína.</value>
    <comment>{Locked="hooks"} In this context, "agent" refers to an AI agent (e.g. Copilot, Claude, Gemini), not a human agent or representative.</comment>
  </data>
  <data name="FreOverlay_ShowTokenUsageAndCostLabel.Text" xml:space="preserve"><value>Sýna samhengisnotkun og lotukostnað</value><comment>Header for a first-run toggle that shows available context-window usage and session cost in the terminal bottom bar. Session cost is reported for the active AI session. Keep 'session cost' generic and do not add a specific unit. Either value may be unavailable.</comment></data>
  <data name="FreOverlay_ShowTokenUsageAndCostDescription.Text" xml:space="preserve"><value>Sýndu notkun samhengisglugga og lotukostnað í neðstu stikunni þegar það er tiltækt.</value><comment>Description for the usage visibility toggle in the first-run wizard. Session cost is reported for the active AI session. Keep 'session cost' generic and do not add a specific unit. Either value may be unavailable.</comment></data>
