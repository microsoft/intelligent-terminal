  <data name="Usage_ContextWindowLabel" xml:space="preserve"><value>Tieqa tal-kuntest</value><comment>Label for the AI agent context-window usage percentage shown in the terminal bottom bar.</comment></data>
  <data name="AgentPane_DefaultTitle" xml:space="preserve">
