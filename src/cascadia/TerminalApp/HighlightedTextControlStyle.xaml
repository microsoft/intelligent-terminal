<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:local="using:TerminalApp"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="d">

    <Style x:Key="DefaultHighlightedTextControlStyle"
           TargetType="local:HighlightedTextControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:HighlightedTextControl">
                    <TextBlock x:Name="TextView"
                               Style="{TemplateBinding TextBlockStyle}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource DefaultHighlightedTextControlStyle}"
           TargetType="local:HighlightedTextControl" />

    <Style x:Key="SidebarCaptionTextStyle"
           TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="SidebarCaptionControlStyle"
           BasedOn="{StaticResource DefaultHighlightedTextControlStyle}"
           TargetType="local:HighlightedTextControl">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

</ResourceDictionary>
