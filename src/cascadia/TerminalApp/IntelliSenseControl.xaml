<UserControl x:Class="TerminalApp.IntelliSenseControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:model="using:Microsoft.Terminal.Settings.Model"
             xmlns:mtu="using:Microsoft.Terminal.UI"
             MinWidth="300"
             MaxWidth="420"
             MaxHeight="320"
             IsTabStop="True"
             LostFocus="_lostFocusHandler"
             SizeChanged="_sizeChangedHandler"
             PreviewKeyDown="_previewKeyDownHandler">

    <Border Padding="4"
            Background="{ThemeResource FlyoutPresenterBackground}"
            BorderBrush="{ThemeResource FlyoutBorderThemeBrush}"
            BorderThickness="{ThemeResource FlyoutBorderThemeThickness}"
            CornerRadius="{ThemeResource OverlayCornerRadius}"
            Shadow="{StaticResource SharedShadow}"
            Translation="0,0,32">
        <ListView x:Name="_itemsView"
                  IsItemClickEnabled="True"
                  ItemClick="_itemClicked"
                  ItemsSource="{x:Bind Items}"
                  SelectionMode="Single"
                  Style="{StaticResource NoAnimationsPlease}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="model:CompletionItem">
                    <Grid MinHeight="36"
                          Padding="8,3"
                          ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0"
                                  VerticalAlignment="Center"
                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  FontSize="14"
                                  Glyph="{x:Bind IconGlyph}" />

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{x:Bind DisplayText}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock MaxLines="2"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind Description}"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{x:Bind mtu:Converters.StringNotEmptyToVisibility(Description), Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Border>
</UserControl>
