#include "ViewModelHelpers.idl.h"

namespace Microsoft.Terminal.Settings.Editor
{
    enum RichTabProviderSourceKind
    {
        BuiltIn = 0,
        Managed = 1,
        Development = 2
    };

    runtimeclass RichTabFieldDescriptor
    {
        RichTabFieldDescriptor(String id, String displayName, Boolean defaultVisible);
        String Id { get; };
        String DisplayName { get; };
        Boolean DefaultVisible { get; };
    }

    runtimeclass RichTabProviderDescriptor
    {
        RichTabProviderDescriptor(
            String id,
            String displayName,
            RichTabProviderSourceKind source,
            Boolean consentEnabled,
            Boolean integrityValid,
            Boolean eligible,
            Boolean effectiveEnabled,
            Boolean shadowed,
            Windows.Foundation.Collections.IVectorView<RichTabFieldDescriptor> fields);

        String Id { get; };
        String DisplayName { get; };
        RichTabProviderSourceKind Source { get; };
        Boolean ConsentEnabled { get; };
        Boolean IntegrityValid { get; };
        Boolean Eligible { get; };
        Boolean EffectiveEnabled { get; };
        Boolean Shadowed { get; };
        Windows.Foundation.Collections.IVectorView<RichTabFieldDescriptor> Fields { get; };
    }

    runtimeclass RichTabFieldViewModel : Windows.UI.Xaml.Data.INotifyPropertyChanged
    {
        String Id { get; };
        String DisplayName { get; };
        Boolean IsVisible;
        Boolean CanEdit { get; };
        Boolean CanMoveUp { get; };
        Boolean CanMoveDown { get; };
        void MoveUp();
        void MoveDown();
    }

    runtimeclass RichTabProviderViewModel : Windows.UI.Xaml.Data.INotifyPropertyChanged
    {
        String Id { get; };
        String DisplayName { get; };
        String SourceLabel { get; };
        String StatusLabel { get; };
        Boolean IsEnabled;
        Boolean CanToggle { get; };
        Boolean CanMoveUp { get; };
        Boolean CanMoveDown { get; };
        Windows.Foundation.Collections.IObservableVector<RichTabFieldViewModel> Fields { get; };
        void MoveFieldUp(RichTabFieldViewModel field);
        void MoveFieldDown(RichTabFieldViewModel field);
    }

    runtimeclass RichTabsViewModel : Windows.UI.Xaml.Data.INotifyPropertyChanged
    {
        RichTabsViewModel(
            Microsoft.Terminal.Settings.Model.GlobalAppSettings globalSettings,
            Windows.Foundation.Collections.IVectorView<RichTabProviderDescriptor> descriptors);

        Windows.Foundation.Collections.IObservableVector<RichTabProviderViewModel> Providers { get; };
        void MoveProviderUp(RichTabProviderViewModel provider);
        void MoveProviderDown(RichTabProviderViewModel provider);
        event Windows.Foundation.TypedEventHandler<RichTabsViewModel, Microsoft.Terminal.Settings.Model.GlobalAppSettings> PreferencesChanged;
    }

    [default_interface] runtimeclass RichTabs : Windows.UI.Xaml.Controls.Page
    {
        RichTabs();
        RichTabsViewModel ViewModel { get; };
    }
}
