    padding: 0 15px 15px;
    display: none
}

.checkout-section .section-summary {
    padding: 0 20px 20px 15px;
    display: none
}

.checkout-section .summary-row {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 10px;
    margin-bottom: 12px;
    font-size: 1rem;
    font-weight: 400;
    color: #1d1d20
}

.checkout-section .summary-address-line {
    display: block
}

.checkout-section .summary-value {
    word-break: break-all
}

