    font-weight: 600;
    margin-bottom: 8px;
    display: block;
    color: #333
}

.checkout-section .field .control input,.checkout-section .field .control select {
    width: 100%;
    padding: 12px;
    border: 1px solid #ccc;
    border-radius: 4px;
    font-size: 14px
}

.checkout-section .field .control input:focus,.checkout-section .field .control select:focus {
    border-color: #007bff;
    outline: none;
    box-shadow: 0 0 0 3px rgba(0,123,255,.1)
}

.checkout-section .section-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 25px
}

.checkout-section .action-previous {
    background: #fff;
    color: #0c0f12;
    border: none;
    padding: 12px 30px;
    font-size: 16px;
