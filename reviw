    <script>
    document.addEventListener('DOMContentLoaded', function () {
        const downArrow = "https://shiftcare.com/wp-content/uploads/2025/07/Vector-45.svg";
        const upArrow = "https://shiftcare.com/wp-content/uploads/2025/07/Vector-46.svg";

        // Function to get country from current URL (same logic as PHP)
        function getCountryFromUrl() {
            const path = window.location.pathname;
            if (path.includes('/us/') || path === '/us' || path === '/us/') {
                return 'US';
            } else if (path.includes('/ca/') || path === '/ca' || path === '/ca/') {
                return 'CA';
            } else if (path.includes('/uk/') || path === '/uk' || path === '/uk/') {
                return 'UK';
            }
            return 'AU';
        }

        // Function to update a selector's display
        function updateSelectorDisplay(selector, countryCode, flagUrl) {
            const flagImg = selector.querySelector('.country-flag');
            const countrySpan = selector.querySelector('.country-code');
            const arrowImg = selector.querySelector('.arrow-img');
            
            if (flagImg) flagImg.src = flagUrl;
            if (countrySpan) countrySpan.textContent = countryCode;
            if (arrowImg) arrowImg.src = downArrow;
            
            selector.setAttribute('data-selected-country', countryCode);
        }

        // Function to sync all selectors on the page
        function syncAllSelectors(countryCode, flagUrl) {
            document.querySelectorAll('.country-selector').forEach(function(selector) {
                updateSelectorDisplay(selector, countryCode, flagUrl);
            });
        }

        // Initialize selectors based on URL (not cookie, since URL is source of truth)
        const urlCountry = getCountryFromUrl();
        const flags = {
            'AU': 'https://shiftcare.com/wp-content/uploads/2025/06/flag-au.svg',
            'US': 'https://shiftcare.com/wp-content/uploads/2025/06/flag-us.svg',
            'CA': 'https://shiftcare.com/wp-content/uploads/2025/06/flag-ca.svg',
            'UK': 'https://shiftcare.com/wp-content/uploads/2025/10/flag-uk.svg'
        };
        
        // Sync all selectors to match URL on page load
        if (flags[urlCountry]) {
            syncAllSelectors(urlCountry, flags[urlCountry]);
        }

        document.querySelectorAll('.country-selector').forEach(function(selector) {
            const selected = selector.querySelector('.selected-country');
            const dropdown = selector.querySelector('.country-dropdown');

            selected.addEventListener('click', function(e) {
                e.stopPropagation();
                const isOpen = dropdown.style.display === 'block';
                dropdown.style.display = isOpen ? 'none' : 'block';
                
                const arrowImg = selector.querySelector('.arrow-img');
                if (arrowImg) {
                    arrowImg.src = isOpen ? downArrow : upArrow;
                }
            });

            dropdown.querySelectorAll('li').forEach(item => {
                item.addEventListener('click', function(e) {
                    e.stopPropagation();
                    const countryCode = item.getAttribute('data-country');
                    const flagUrl = item.getAttribute('data-flag');

                    // Update all selectors on the page
                    syncAllSelectors(countryCode, flagUrl);
                    
                    // Close all dropdowns
                    document.querySelectorAll('.country-dropdown').forEach(function(dd) {
                        dd.style.display = 'none';
                    });

                    // Determine redirect URL
                    let redirectUrl = '';
                    if (countryCode === 'AU') {
                        redirectUrl = 'https://shiftcare.com';
                    } else if (countryCode === 'US') {
                        redirectUrl = 'https://shiftcare.com/us';
                    } else if (countryCode === 'CA') {
                        redirectUrl = 'https://shiftcare.com/ca';
                    } else if (countryCode === 'UK') {
                        redirectUrl = 'https://shiftcare.com/uk';
                    }

                    // Save selection in cookie for 30 days (user's manual choice)
                    document.cookie = `selected_country=${countryCode}; path=/; max-age=${30*24*60*60}`;
                    
                    // Redirect to the selected country URL
                    if (redirectUrl && redirectUrl !== window.location.href) {
                        window.location.href = redirectUrl;
                    }
                });
            });
        });

        // Close dropdown when clicking outside
        document.addEventListener('click', function (e) {
            if (!e.target.closest('.country-selector')) {
                document.querySelectorAll('.country-dropdown').forEach(function(dropdown) {
                    dropdown.style.display = 'none';
                });
                document.querySelectorAll('.arrow-img').forEach(function(arrowImg) {
                    arrowImg.src = downArrow;
                });
            }
        });
    });
    </script>

