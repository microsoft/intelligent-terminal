				let cost_roster     = hrs_roster_mo * rate_admin;
				let cost_notes      = hrs_notes_mo * rate_careg;
				let current_total   = cost_payroll + cost_roster + cost_notes;

				// ShiftCare reductions
				let red_payroll = 0.63; // 63% reduction
				let red_roster  = 0.41; // 41% reduction
				let red_notes   = 0.53; // 53% reduction

				let cost_payroll_new = cost_payroll * (1 - red_payroll);
				let cost_roster_new  = cost_roster  * (1 - red_roster);
				let cost_notes_new   = cost_notes   * (1 - red_notes);

				let plan_cost        = 75; // ShiftCare plan fixed monthly
				let new_total        = cost_payroll_new + cost_roster_new + cost_notes_new + plan_cost;

				let monthly_saving   = current_total - new_total;
				let annual_saving    = monthly_saving * 12;

				resultsDiv.innerHTML = `
						<div class="results-header">
							<div>
								<h3 class="results-title">
									Annual Savings
								</h3>
								<p class="results-subtitle">by using ShiftCare</p>
							</div>
							<div>
								<p class="results-amount">$${annual_saving.toLocaleString()}</p>
							</div>
						</div>
						<div>
							<table class="results-table">
								<tbody>
									<tr>
										<td class="table-cell">
											Current monthly costs
											<div class="table-cell-subtitle">
												Payroll<br>
												Rostering<br>
												Caregiving
											</div>
										</td>
										<td class="table-cell text-right">
											<span>$${current_total.toLocaleString()}</span>
											<div class="table-cell-subtitle">
												<span>$${cost_payroll.toLocaleString()}</span><br> 
												<span>$${cost_roster.toLocaleString()}</span><br>
												<span>$${cost_notes.toLocaleString()}</span>
											</div>
										</td>
									</tr>
									<tr>
										<td class="table-cell">
											Monthly costs using ShiftCare
											<div class="table-cell-subtitle">
												ShiftCare Professional plan<br>
												Payroll<br>
												Rostering<br>
												Caregiving
											</div>
										</td>
										<td class="table-cell text-right">
											<span>$${new_total.toLocaleString()}</span>
											<div class="table-cell-subtitle">
												<span>$${plan_cost}</span><br>
												<span>$${cost_payroll_new.toLocaleString()}</span><br> 
												<span>$${cost_roster_new.toLocaleString()}</span><br>
												<span>$${cost_notes_new.toLocaleString()}</span>
											</div>
										</td>
									</tr>
									<tr>
										<td class="table-cell">
											Total monthly savings
										</td>
										<td class="table-cell text-right">
											<span>$${monthly_saving.toLocaleString()}</span>
										</td>
									</tr>
								</tbody>
							</table>
						</div>
				`;
			}

			inputs.forEach(input => input.addEventListener("input", calculate));
			calculate(); // Run on load with defaults
		}
    });
