        <ul class="country-dropdown" style="position: absolute; display: none; top: 100%; left: 0; background: #fff; border: 1px solid #ccc; padding: 5px; margin: 0; list-style: none; width: 160px; z-index: 9999999999;">
            <li data-country="AU" style="color:#333333;" data-flag="https://shiftcare.com/wp-content/uploads/2025/06/flag-au.svg">Australia</li>
            <li data-country="US" style="color:#333333;" data-flag="https://shiftcare.com/wp-content/uploads/2025/06/flag-us.svg">United States</li>
            <li data-country="CA" style="color:#333333;" data-flag="https://shiftcare.com/wp-content/uploads/2025/06/flag-ca.svg">Canada</li>
