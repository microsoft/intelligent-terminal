{
  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [{
          "type": "command",
          "command": "wtcli.exe agent-hook --cli-source claude --event agent.session.start"
        }]
      }
    ],
    "SessionEnd": [
      {
        "matcher": ".*",
        "hooks": [{
          "type": "command",
          "command": "wtcli.exe agent-hook --cli-source claude --event agent.session.end"
        }]
      }
    ],
    "Notification": [
      {
        "matcher": ".*",
        "hooks": [{
          "type": "command",
          "command": "wtcli.exe agent-hook --cli-source claude --event agent.notification"
        }]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [{
          "type": "command",
          "command": "wtcli.exe agent-hook --cli-source claude --event agent.prompt.submit"
        }]
      }
    ],
    "StopFailure": [
      {
        "matcher": ".*",
        "hooks": [{
          "type": "command",
          "command": "wtcli.exe agent-hook --cli-source claude --event agent.error"
        }]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [{
          "type": "command",
          "command": "wtcli.exe agent-hook --cli-source claude --event agent.stop"
        }]
      }
    ]
  }
}
