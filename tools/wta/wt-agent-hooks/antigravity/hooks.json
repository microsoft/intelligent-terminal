{
  "wt-agent-hooks": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand ",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand ",
        "timeout": 5
      }
    ]
  }
}
