{
  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [{
          "type": "command",
          "exec": "wtcli.exe",
          "args": ["agent-hook", "--cli-source", "copilot", "--event", "agent.session.start"],
          "timeoutSec": 5
        }]
      }
    ],
    "SessionEnd": [
      {
        "matcher": ".*",
        "hooks": [{
          "type": "command",
          "exec": "wtcli.exe",
          "args": ["agent-hook", "--cli-source", "copilot", "--event", "agent.session.end"],
          "timeoutSec": 5
        }]
      }
    ],
    "Notification": [
      {
        "matcher": ".*",
        "hooks": [{
          "type": "command",
          "exec": "wtcli.exe",
          "args": ["agent-hook", "--cli-source", "copilot", "--event", "agent.notification"],
          "timeoutSec": 5
        }]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [{
          "type": "command",
          "exec": "wtcli.exe",
          "args": ["agent-hook", "--cli-source", "copilot", "--event", "agent.prompt.submit"],
          "timeoutSec": 5
        }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [{
          "type": "command",
          "exec": "wtcli.exe",
          "args": ["agent-hook", "--cli-source", "copilot", "--event", "agent.tool.finished"],
          "timeoutSec": 5
        }]
      }
    ],
    "StopFailure": [
      {
        "matcher": ".*",
        "hooks": [{
          "type": "command",
          "exec": "wtcli.exe",
          "args": ["agent-hook", "--cli-source", "copilot", "--event", "agent.error"],
          "timeoutSec": 5
        }]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [{
          "type": "command",
          "exec": "wtcli.exe",
          "args": ["agent-hook", "--cli-source", "copilot", "--event", "agent.stop"],
          "timeoutSec": 5
        }]
      }
    ]
  }
}
