{
  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [{
          "type": "command",
          "command": "\"${extensionPath}/hooks/agent-hook.cmd\" --cli-source gemini --event agent.session.start"
        }]
      }
    ],
    "SessionEnd": [
      {
        "matcher": ".*",
        "hooks": [{
          "type": "command",
          "command": "\"${extensionPath}/hooks/agent-hook.cmd\" --cli-source gemini --event agent.session.end"
        }]
      }
    ],
     "BeforeAgent": [
      {
        "matcher": ".*",
        "hooks": [{
          "type": "command",
          "command": "\"${extensionPath}/hooks/agent-hook.cmd\" --cli-source gemini --event agent.prompt.submit"
        }]
      }
    ],
    "BeforeTool": [
      {
        "matcher": ".*",
        "hooks": [{
          "type": "command",
          "command": "\"${extensionPath}/hooks/agent-hook.cmd\" --cli-source gemini --event agent.tool.starting"
        }]
      }
    ],
    "AfterTool": [
      {
        "matcher": ".*",
        "hooks": [{
          "type": "command",
          "command": "\"${extensionPath}/hooks/agent-hook.cmd\" --cli-source gemini --event agent.tool.finished"
        }]
      }
    ],
    "Notification": [
      {
        "matcher": ".*",
        "hooks": [{
          "type": "command",
          "command": "\"${extensionPath}/hooks/agent-hook.cmd\" --cli-source gemini --event agent.notification"
        }]
      }
    ],
    "AfterAgent": [
      {
        "matcher": ".*",
        "hooks": [{
          "type": "command",
          "command": "\"${extensionPath}/hooks/agent-hook.cmd\" --cli-source gemini --event agent.stop"
        }]
      }
    ]
  }
}
