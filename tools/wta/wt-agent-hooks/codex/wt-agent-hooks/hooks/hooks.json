{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "command -v wtcli.exe >/dev/null 2>&1 && wtcli.exe agent-hook --cli-source codex --event agent.session.start; exit 0",
            "commandWindows": "cmd.exe /d /s /c \"wtcli.exe agent-hook --cli-source codex --event agent.session.start >nul 2>&1 & exit /b 0\""
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v wtcli.exe >/dev/null 2>&1 && wtcli.exe agent-hook --cli-source codex --event agent.notification; exit 0",
            "commandWindows": "cmd.exe /d /s /c \"wtcli.exe agent-hook --cli-source codex --event agent.notification >nul 2>&1 & exit /b 0\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v wtcli.exe >/dev/null 2>&1 && wtcli.exe agent-hook --cli-source codex --event agent.prompt.submit; exit 0",
            "commandWindows": "cmd.exe /d /s /c \"wtcli.exe agent-hook --cli-source codex --event agent.prompt.submit >nul 2>&1 & exit /b 0\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v wtcli.exe >/dev/null 2>&1 && wtcli.exe agent-hook --cli-source codex --event agent.stop; exit 0",
            "commandWindows": "cmd.exe /d /s /c \"wtcli.exe agent-hook --cli-source codex --event agent.stop >nul 2>&1 & exit /b 0\""
          }
        ]
      }
    ]
  }
}
