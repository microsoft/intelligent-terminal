    // Hack for older SCORM 1.2 packages that dont commit automatically.
    var FAST_INTERVAL = 12000;
    var SLOW_INTERVAL = 120000;
    var BLUR_GRACE_MS = 1500; // second-monitor detection window

    var commitTimer = null;
    var currentInterval = null;
    var blurTimer = null;

    function startCommitTimer(interval) {
        if (currentInterval === interval) return;

        if (commitTimer) clearInterval(commitTimer);
        currentInterval = interval;

        commitTimer = setInterval(function () {
            if (window.API && typeof window.API.LMSCommit === "function") {
                window.API.LMSCommit("");
            }
        }, interval);

        console.log("SCORM commit interval:", interval / 1000 + "s");
    }

    function setFast() {
        clearTimeout(blurTimer);
        blurTimer = null;
        startCommitTimer(FAST_INTERVAL);
    }

    function setSlow() {
        startCommitTimer(SLOW_INTERVAL);
    }

    // ---- Primary: tab visibility (authoritative)
    document.addEventListener("visibilitychange", function () {
        if (document.hidden) {
            setSlow();
        } else {
            setFast();
        }
    }, true);

    // ---- Secondary: blur fallback (multi-monitor)
    window.addEventListener("blur", function () {
        // Only apply blur if the tab did NOT become hidden
        if (!document.hidden) {
            blurTimer = setTimeout(function () {
                setSlow();
            }, BLUR_GRACE_MS);
        }
    }, true);

    // ---- Recovery: focus OR any user interaction
    var MOUSEMOVE_THROTTLE_MS = 250;
    var lastMouseMoveSetFastAt = 0;

    function handleMouseMoveSetFast() {
        var now = Date.now();
        if (now - lastMouseMoveSetFastAt >= MOUSEMOVE_THROTTLE_MS) {
            lastMouseMoveSetFastAt = now;
            setFast();
        }
    }

    window.addEventListener("focus", setFast, true);
    document.addEventListener("click", setFast, true);
    document.addEventListener("keydown", setFast, true);
    document.addEventListener("mousemove", handleMouseMoveSetFast, true);

    // Initial state
    if (document.hidden) {
        setSlow();
    } else {
        setFast();
    }

