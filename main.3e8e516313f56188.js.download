c \uc5b4\ub5bb\uac8c \uc218\uc9d1, \uc0ac\uc6a9, \ubcf4\uc548 \ubc0f \uc561\uc138\uc2a4\ud558\ub294\uc9c0\uc5d0 \ub300\ud574 \uc815\ubcf4 \uc81c\uacf5\uc790\uc5d0\uac8c \uc54c\ub9ac\ub3c4\ub85d \ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ubcf8 \uc6f9 \uc0ac\uc774\ud2b8\ub97c \ubc29\ubb38\ud568\uc73c\ub85c\uc368 \uadc0\ud558\ub294 \ubcf8 \ud1b5\ubcf4\uc5d0 \uae30\uc220\ub41c \uc815\ucc45 \ubc0f \uaddc\uce59\uc744 \uc218\ub77d\ud558\uac8c \ub429\ub2c8\ub2e4. \ubcf8 \ud1b5\ubcf4\uc5d0\uc11c \uc124\uba85\ud558\ub294 \ud56d\ubaa9\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: "),l())}function ddt(e,n){1&e&&(c(0,"div")(1,"h1",9),u(2,"\u4f7f\u7528\u6761\u4ef6"),l(),u(3," \u30ab\u30ea\u30d5\u30a9\u30eb\u30cb\u30a2\u30fb\u30e9\u30a4\u30d5\u30e9\u30a4\u30f3\u306e\u30a6\u30a7\u30d6\u30b5\u30a4\u30c8\u306b\u3066\u5f53\u793e\u306e\u4f7f\u7528\u898f\u5b9a\u3092\u3054\u89a7\u3044\u305f\u3060\u304d\u3001\u8aa0\u306b\u3042\u308a\u304c\u3068\u3046\u3054\u3056\u3044\u307e\u3059\u3002 \u30ab\u30ea\u30d5\u30a9\u30eb\u30cb\u30a2\u30fb\u30e9\u30a4\u30d5\u30e9\u30a4\u30f3\u306f\u3001\u30ab\u30ea\u30d5\u30a9\u30eb\u30cb\u30a2\u5dde\u304c\u5b9a\u3081\u308b\u4f7f\u7528\u6761\u4ef6\u3068\u3001\u30d7\u30e9\u30a4\u30d0\u30b7\u30fc\u306b\u95a2\u3059\u308b\u898f\u5b9a\u3092\u9806\u5b88\u3057\u307e\u3059\u3002."),S(4,"br")(5,"br"),u(6," \u304a\u5ba2\u69d8\u306f\u5dde\u304c\u5b9a\u3081\u308b\u30d7\u30e9\u30a4\u30d0\u30b7\u30fc\u306b\u95a2\u3059\u308b\u898f\u5b9a\u306b\u3082\u3054\u6ce8\u610f\u304f\u3060\u3055\u3044\u3002\u3053\u306e\u30a6\u30a7\u30d6\u30b5\u30a4\u30c8\u306b\u3066\u5185\u5bb9\u3092\u3054\u89a7\u306b\u306a\u308c\u307e\u3059\u3002 \u30ab\u30ea\u30d5\u30a9\u30eb\u30cb\u30a2\u5dde\u306f\u3001\u5dde\u306e\u30a6\u30a7\u30d6\u30dd\u30fc\u30bf\u30eb\u3092\u4f7f\u7528\u3057\u3066\u5165\u624b\u3067\u304d\u308b\u60c5\u5831\u306e\u53ce\u96c6\u3001\u4f7f\u7528\u3001\u30bb\u30ad\u30e5\u30ea\u30c6\u30a3\u3001\u304a\u3088\u3073\u30a2\u30af\u30bb\u30b9\u306b\u3064\u3044\u3066\u3001\u304a\u5ba2\u69d8\u304c\u8a8d\u8b58\u3057\u3066\u3044\u305f\u3060\u304f\u3053\u3068\u3092\u671b\u3093\u3067\u3044\u307e\u3059\u3002 \u3053\u306e\u30a6\u30a7\u30d6\u30b5\u30a4\u30c8\u3092\u3054\u89a7\u306b\u306a\u308b\u3053\u3068\u3067\u3001\u304a\u5ba2\u69d8\u306f\u3053\u306e\u901a\u77e5\u306b\u8a18\u8f09\u3055\u308c\u3066\u3044\u308b\u898f\u5b9a\u3068\u305d\u306e\u5c65\u884c\u3092\u53d7\u3051\u5165\u308c\u305f\u3053\u3068\u306b\u306a\u308a\u307e\u3059\u3002 \u3053\u306e\u901a\u77e5\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u5185\u5bb9\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u3059: "),l())}function pdt(e,n){1&e&&(c(0,"div")(1,"h1",9),u(2,"C\xe1c \u0110i\u1ec1u ki\u1ec7n S\u1eed d\u1ee5ng"),l(),u(3," C\xe1m \u01a1n qu\xfd v\u1ecb \u0111\xe3 truy c\u1eadp v\xe0o trang web c\u1ee7a ch\u01b0\u01a1ng tr\xecnh gi\xe1 b\xecnh d\xe2n California v\xe0 xem x\xe9t Ch\xednh s\xe1ch S\u1eed d\u1ee5ng c\u1ee7a ch\xfang t\xf4i. ch\u01b0\u01a1ng tr\xecnh gi\xe1 b\xecnh d\xe2n California tu\xe2n th\u1ee7 tri\u1ec7t \u0111\u1ec3 c\xe1c \u0110i\u1ec1u ki\u1ec7n S\u1eed d\u1ee5ng v\xe0 c\xe1c Ch\xednh s\xe1ch Quy\u1ec1n Ri\xeang t\u01b0 \u0111\u01b0\u1ee3c l\u1eadp ra b\u1edfi Ti\u1ec3u Bang California.."),S(4,"br")(5,"br"),u(6," Qu\xfd v\u1ecb c\u0169ng n\xean nh\u1eadn th\u1ee9c \u0111\u01b0\u1ee3c r\u1eb1ng Ti\u1ec3u Bang n\xe0y c\xf3 m\u1ed9t ch\xednh s\xe1ch quy\u1ec1n ri\xeang t\u01b0, c\u0169ng c\xf3 s\u1eb5n tr\xean trang web n\xe0y. Ti\u1ec3u Bang mu\u1ed1n qu\xfd v\u1ecb bi\u1ebft \u0111\u01b0\u1ee3c v\u1ec1 vi\u1ec7c thu th\u1eadp, s\u1eed d\u1ee5ng, an ninh, v\xe0 truy c\u1eadp v\xe0o nh\u1eefng th\xf4ng tin c\xf3 th\u1ec3 c\xf3 \u0111\u01b0\u1ee3c qua c\u1ed5ng th\xf4ng tin \u0111i\u1ec7n t\u1eed c\u1ee7a Ti\u1ec3u Bang. B\u1eb1ng c\xe1ch truy c\u1eadp v\xe0o trang web, qu\xfd v\u1ecb ch\u1ea5p nh\u1eadn c\xe1c ch\xednh s\xe1ch v\xe0 c\xe1c th\xf4ng \u01b0\u1edbc \u0111\u01b0\u1ee3c m\xf4 t\u1ea3 trong Th\xf4ng b\xe1o n\xe0y. Th\xf4ng b\xe1o n\xe0y bao g\u1ed3m nh\u1eefng ch\u1ee7 \u0111\u1ec1 sau: "),l())}function hdt(e,n){1&e&&(c(0,"div")(1,"h1",9),u(2,"Mga Kondisyon ng Paggagamit"),l(),u(3," Maraming salamat sa pagbisita mo sa website ng California LifeLine at sa pagbabasa ng aming Patakaran sa Paggamit. Naninindigan ang California Life Line sa mga Kondisyon ng Paggamit at Mga Patakaran na itinakda ng Estado ng California."),S(4,"br")(5,"br"),u(6," Kailangan mo ding malaman na ang Estado ay may patakaran sa paglilihim, na makikita sa website na ito. Nais ipabatid sa iyo ng Estado ang tungkol sa pangangalap, paggamit, seguridad, at pagkuha ng mga impormasyon na makukuha sa pamamagitan ng web portal ng Estado. Sa pamamagitan ng pagbisita sa website na ito, iyong tinatanggap ang mga patakaran at gawi na ipinaliwanag sa Paunawa. Sinasakop ng paunawang ito ang mga sumusunod na mga paksa: "),l())}function fdt(e,n){1&e&&(c(0,"div")(1,"h4",10),u(2,"Personal Information and Choice"),l(),u(3,' "Personal information" is information about a natural person that identifies or describes an individual, including, but not limited to, his or her name, social security number, physical description, home address, home telephone number, education, financial matters, and medical or employment history, readily identifiable to that specific individual. A domain name or Internet Protocol address is not considered personal information, however, it is considered "electronically collected personal information". '),S(4,"br")(5,"br"),u(6,' According to Government Code \xa7 11015.5, "Electronically collected personal information" means any information that is maintained by an agency that identifies or describes an individual user, including, but not limited to, his or her name, social security number, physical description, home address, home telephone number, education, financial matters, medical or employment history, password, electronic mail address, and information that reveals any network location or identity, but excludes any information manually submitted to a state agency by a user, whether electronically or in written form, and information on or relating to individuals who are users, serving in a business capacity, including, but not limited to, business owners, officers, or principals of that business. '),S(7,"br")(8,"br"),u(9,' "Electronically collected personal information" we automatically collect includes your domain name or Internet Protocol address, and statistical information about which web pages you visit. If you voluntarily participate in an activity that asks for specific information (i.e. completing a request for assistance, personalizing the content of the website, sending an e-mail or participating in a survey) more detailed data will be collected. If you choose not to participate in these activities, your choice will in no way affect your ability to use any other feature of the website. '),S(10,"br")(11,"br"),u(12," If any type of personal information is requested on the website or volunteered by the user, state law, including Information Practices Act of 1977, Government Code Section 11015.5, and the Federal Privacy Act of 1974 may protect it. However, this information may be a public record once you provide it, and may be subject to public inspection and copying if not otherwise protected by Federal or state law. "),S(13,"br")(14,"br"),u(15," Additionally, departments and agencies of the State of California are required to adhere to the Privacy Policy which is also accessible on this website. Please see Department of General Services Management Memo 00-14, effective January 1, 2001. "),S(16,"br")(17,"br")(18,"hr"),c(19,"h4",11),u(20,"A Special Note About Children"),l(),u(21," Children are not eligible to use services that require submission of personal information and we require that minors (under the age of 18) do not submit any personal information to us. This includes submitting personal information to the State as part of a user profile or personalization profile. If you are a minor, you can use these services only if used together with your parents or guardians. If you are a minor you should seek guidance from your parents."),S(22,"br")(23,"br"),u(24," If the state decides to begin collecting personal information from children, it will notify parents that it is being requested, disclose the reasons for collecting it, and disclose our intended use for it. The state will seek parental consent before collecting any personally identifiable information. If it does collect it, parents may request information on the type of data being collected, view their child's information and, if they choose, prohibit the state from making further use of their child's information. The state will not provide personal information about children to third parties."),S(25,"br")(26,"br")(27,"hr"),c(28,"h4",12),u(29,"Information Collected and How It Is Used"),l(),u(30," We do collect personal information directly from individuals who volunteer to use some of our services. Collection of this information is required to deliver the specific services, but use of these services is voluntary."),S(31,"br")(32,"br"),u(33," If you do nothing during your visit to the website, but browse or download information, we automatically collect and store the following information about your visit:"),S(34,"br")(35,"br"),c(36,"ol")(37,"li"),u(38,"The Internet Protocol Address and domain name used but not the e-mail address. The Internet Protocol address is a numerical identifier assigned either to your Internet service provider or directly to your computer. We use the Internet Protocol Address to direct Internet traffic to you and generate statistics used in the management of this site;"),l(),c(39,"li"),u(40,"The type of browser and operating system you used;"),l(),c(41,"li"),u(42,"The date and time you visited this site;"),l(),c(43,"li"),u(44,"The web pages or services you accessed at this site;"),l(),c(45,"li"),u(46,"The website you visited prior to coming to this website;"),l(),c(47,"li"),u(48,"The website you visit as you leave this website;"),l(),c(49,"li"),u(50,"If you downloaded a form, the form that was downloaded."),l()(),S(51,"br")(52,"br"),u(53," The information we automatically collect or store is used to improve the content of our web services and to help us understand how people are using our services. This information does not identify you personally and is used for gathering website statistics. The information we automatically collect and store in our logs about your visit helps us to analyze our website to continually improve the value of the materials available. Our website logs do not identify a visitor by personal information, and we make no attempt to link other websites with the individuals that browse the State's website. "),S(54,"br")(55,"br"),u(56,' Government Code \xa7 11015.5 (6) prohibits all state agencies from distributing or selling any electronically collected personal information as defined above, about users to any third party without the permission of the user. The State does not sell any "electronically collected personal information". Any distribution of "electronically collected personal information" will be solely for the purposes for which it was provided to us. '),S(57,"br")(58,"br"),u(59," The State may provide or distribute certain lists and statistical reports of regulatory information as provided by law, but no personal information is sold or distributed and all relevant legal protections still apply to the State's websites. "),S(60,"br")(61,"br")(62,"hr"),c(63,"h4",13),u(64,"What Happens To Information You Submit To Us?"),l(),u(65," If you choose to submit information to us the information will be transmitted through secure lines to our departmental database. Any private information will only be used for the purposes for which it was provided and will not be shared with another entity except as prescribed by law. Please see our Privacy Policy for additional information."),S(66,"br")(67,"br")(68,"hr"),c(69,"h4",14),u(70,"Use of Internet Request for Assistance From Information"),l(),u(71," Any information you provide to us will only be shared with entities involved in your case as necessary. Information you provide may be included with other consumers' information to be used for statistical reporting, trending data, and/or investigative actions. For example, we may need to retain information that becomes part of an enforcement action or consumer complaint case for a period of time after the closing date of the case."),S(72,"br")(73,"br"),u(74," If you provide us with information regarding an issue that does not fall within our regulatory jurisdiction, we may refer your information to the appropriate local, state, or federal agency on your behalf."),S(75,"br")(76,"br")(77,"hr"),c(78,"h4",15),u(79,"Surveys"),l(),u(80," If during your visit to the State's website you participate in a survey or send an e-mail, the following additional information will be collected:"),S(81,"br")(82,"br"),c(83,"ol")(84,"li"),u(85,"The e-mail address and contents of the e-mail; and"),l(),c(86,"li"),u(87,"Information volunteered in response to the survey."),l()(),u(88," The information collected is not limited to text characters and may include audio, video, and graphic information formats you send us."),S(89,"br")(90,"br"),u(91," The information is retained in accordance with Government Code \xa7 11015.5."),S(92,"br")(93,"br")(94,"hr"),c(95,"h4",16),u(96,"If you send us E-Mail"),l(),u(97," You may choose to provide us with personal information, as in e-mail with a comment or question. We use the information to improve our service to you or to respond to your request. Sometimes we forward your e-mail to other State employees who may be better able to help you, and this staff may be employed by a different agency within the State. Except for authorized law enforcement investigations or as required by law, we do not share our e-mail with any other organizations."),S(98,"br")(99,"br"),u(100," We use your e-mail to respond appropriately. This may be to respond to you, to address issues you identify, to further improve our website, or to forward the e-mail to another agency for appropriate action."),S(101,"br")(102,"br")(103,"hr"),c(104,"h4",17),u(105,"Order Forms"),l(),u(106," If you place an order with us, we request information from the user on our order form. A user must provide contact information (like name and shipping address) and financial information (like credit card number, expiration date]. This information is used for billing purposes and to fill your order/request. If we have trouble processing an order, this contact information is used to get in touch with you."),S(107,"br")(108,"br")(109,"hr"),c(110,"h4",18),u(111,"Public Disclosure"),l(),u(112," In the State of California, laws exist to ensure that government is open and that the public has a right to access appropriate records and information possessed by state government. At the same time, there are exceptions to the public's right to access public records. These exceptions serve various needs including maintaining the privacy of individuals. Both state and federal laws provide exceptions."),S(113,"br")(114,"br"),u(115," All information collected at this site becomes public record that may be subject to inspection and copying by the public, unless an exemption in law exists. In the event of a conflict between this Use Policy and the Public Records Act, the Information Practices Act or other law governing the disclosure of records, the Public Records Act, the Information Practices Act or other applicable law will control."),S(116,"br")(117,"br")(118,"hr"),c(119,"h4",19),u(120,"Personal Information"),l(),u(121," Under Government Code \xa7 11015.5, if you choose you may have any personal information collected about you discarded without reuse or distribution, provided we are contacted in a timely fashion."),S(122,"br")(123,"br")(124,"hr"),c(125,"h4",20),u(126,"Automatic Collection of Information / Cookies"),l(),u(127," Cookies are simple text files stored on your computer by your web browser. The main State portal does not use cookies to maintain personalization, however some departmental applications may."),S(128,"br")(129,"br"),u(130," The State makes every attempt to avoid the use of cookies. When needed to maintain the functionality of an application, unlike the common usage of cookies, the State only uses cookies during the session in which you access our interactive applications ."),S(131,"br")(132,"br"),u(133,' Cookies created on your computer by using this website do not contain "personal information" and do not compromise your privacy or security. We use the cookie feature only to store a randomly generated identifying temporary tag on your computer. You can refuse the cookie or delete the cookie file from your computer by using any of the widely available methods. However, if you turn your cookie option off you may not be able to access some of the features in our interactive applications .'),S(134,"br")(135,"br")(136,"hr"),c(137,"h4",21),u(138,"Security"),l(),u(139," The State, as developer and manager of this website, has taken several steps to safeguard the integrity of its telecommunications and computing infrastructure, including but not limited to authentication, monitoring, auditing, and encryption. Security measures have been integrated into the design, implementation and day-to-day practices of the entire State operating environment as part of its continuing commitment to risk management. This information should not be construed in any way as giving business, legal, or other advice, or warranting as fail proof, the security of information provided via the State's supported website. The technical standards governing security are enforced by the Department of Information Technology."),S(140,"br")(141,"br")(142,"hr"),c(143,"h4",22),u(144,"Links to Other Sites"),l(),u(145," Our website has links to sites we felt might be useful to you and which may provide services. When you link to another site, you are no longer on our site and are subject to the privacy policy of the new site."),S(146,"br")(147,"br"),u(148," This website and the information it contains are provided as a public service by the State of California. This system is monitored to ensure proper operation, to verify the functioning of applicable security features, and for comparable purposes. Anyone using this system expressly consents to such monitoring. Unauthorized attempts to modify any information stored on this system, to defeat or circumvent security features, or to utilize this system for other than its intended purposes are prohibited and may result in criminal prosecution."),S(149,"br")(150,"br")(151,"hr"),c(152,"h4",23),u(153,"Limitation of Liability"),l(),u(154," The State attempts to maintain the highest accuracy of content on its website. Any errors, or omissions should be reported for investigation."),S(155,"br")(156,"br"),u(157," The State makes no claims, promises or guarantees about the absolute accuracy, completeness, or adequacy of the contents of this website and expressly disclaims liability for errors and omissions in the contents of this website. No warranty of any kind, implied, expressed or statutory, including but not limited to the warranties of non-infringement of third party rights, title, merchantability, fitness for a particular purpose and freedom from computer virus, is given with respect to the contents of this website or its hyperlinks to other Internet resources. Reference in this website to any specific commercial products, processes, or services, or the use of any trade, firm or corporation name is for the information and convenience of the public, and does not constitute endorsement, recommendation, or favoring by the State of California, or their employees or agents."),S(158,"br")(159,"br"),u(160," This Use Policy is subject to change without notice."),S(161,"br")(162,"br")(163,"hr"),c(164,"h4",24),u(165,"Ownership"),l(),u(166," In general, information presented on this website, unless otherwise indicated, is considered in the public domain. It may be distributed or copied as permitted by law. However, the State does make use of copyrighted data (e.g., photographs) which may require additional permissions prior to your use. Furthermore, the unique branding of the site and various official seals and marks may not be used without permission of the State. In order to use any information on this website not owned or created by the State you must seek permission directly from the owning (or holding) sources. The State shall have the unlimited right to use for any purpose, free of any charge, all information submitted via this site except those submissions made under separate legal contract. The State shall be free to use, for any purpose, any ideas, concepts, or techniques contained in information provided through this site."),S(167,"br")(168,"br"),l())}function gdt(e,n){1&e&&(c(0,"div")(1,"h4",10),u(2,"Informaci\xf3n personal y opciones"),l(),u(3,' La "informaci\xf3n personal" es informaci\xf3n relacionada con una persona f\xedsica que identifica o describe a un individuo, incluidos, entre otros, el nombre, el n\xfamero de seguro social, la descripci\xf3n f\xedsica, la direcci\xf3n particular, el n\xfamero telef\xf3nico del hogar, la educaci\xf3n, los asuntos financieros y los antecedentes m\xe9dicos o de empleo, que f\xe1cilmente identifican a ese individuo en particular. Un nombre de dominio o un protocolo de Internet no se considera informaci\xf3n personal; sin embargo, se considera "informaci\xf3n personal recolectada de manera electr\xf3nica". '),S(4,"br")(5,"br"),u(6,' De acuerdo con el art\xedculo \xa7 11015.5 del C\xf3digo Gubernamental, "Informaci\xf3n personal recolectada de manera electr\xf3nica" incluye cualquier informaci\xf3n conservada por un organismo que identifica o describe a un usuario individual, incluidos, entre otros, el nombre, el n\xfamero de seguro social, la descripci\xf3n f\xedsica, la direcci\xf3n particular, el n\xfamero telef\xf3nico del hogar, la educaci\xf3n, los asuntos financieros, los antecedentes m\xe9dicos o de empleo, la contrase\xf1a, la direcci\xf3n de correo electr\xf3nico e informaci\xf3n que revela cualquier ubicaci\xf3n o identidad dentro de la red, pero que excluye la informaci\xf3n proporcionada en forma manual a un organismo estatal por parte de un usuario, ya sea de forma electr\xf3nica o escrita, e informaci\xf3n sobre individuos o relacionada con \xe9stos que son usuarios y poseen un cargo comercial que incluye, entre otros, propietarios de una empresa, funcionarios o directores de dicha empresa. '),S(7,"br")(8,"br"),u(9,' "La "informaci\xf3n personal recolectada de manera electr\xf3nica" que almacenamos autom\xe1ticamente incluye su nombre de dominio o direcci\xf3n IP (protocolo de Internet) e informaci\xf3n estad\xedstica relacionada con las p\xe1ginas web que usted visita. En caso de que usted participe de forma voluntaria en una actividad que le solicita informaci\xf3n espec\xedfica (por ejemplo, completar una solicitud de asistencia, personalizar el contenido de un sitio web, enviar un correo electr\xf3nico o participar en una encuesta), se recolectar\xe1 informaci\xf3n m\xe1s detallada. En caso de que usted decida no participar en estas actividades, su decisi\xf3n no afectar\xe1, de ning\xfan modo, su capacidad para utilizar cualquier otra funci\xf3n del sitio web. '),S(10,"br")(11,"br"),u(12," En caso de que se solicite cualquier tipo de informaci\xf3n personal en el sitio web o el usuario la ofrezca de forma voluntaria, la ley estatal, que incluye la Ley de Pr\xe1cticas de Informaci\xf3n de 1977, el art\xedculo 11015.5 del C\xf3digo Gubernamental y la Ley Federal de Privacidad de 1974, proteger\xe1 esta informaci\xf3n. Sin embargo, esta informaci\xf3n puede convertirse en un registro p\xfablico una vez que la haya proporcionado y podr\xe1 estar sujeta a inspecci\xf3n y reproducci\xf3n p\xfablica en caso de no estar protegida por una ley federal o estatal. "),S(13,"br")(14,"br"),u(15," Adem\xe1s, se solicita a los departamentos y los organismos del Estado de California que cumplan con la Pol\xedtica de privacidad a la que tambi\xe9n se puede acceder en este sitio web. Consulte el memorando 00-14 del Departamento de Gesti\xf3n de Servicios Generales que entr\xf3 en vigencia el 1 de enero de 2001. "),S(16,"br")(17,"br")(18,"hr"),c(19,"h4",11),u(20,"Un aviso especial relacionado con los ni\xf1os"),l(),u(21," Los ni\xf1os no son elegibles para utilizar servicios que requieren brindar informaci\xf3n personal y solicitamos que los menores de 18 a\xf1os no nos brinden este tipo de informaci\xf3n. Esto incluye brindar informaci\xf3n personal al Estado como parte de un perfil de usuario o un perfil de personalizaci\xf3n. En caso de ser menor, puede utilizar estos servicios s\xf3lo junto con sus padres o tutores o solicitar su orientaci\xf3n."),S(22,"br")(23,"br"),u(24," En caso de que el Estado decida recolectar informaci\xf3n personal de ni\xf1os, se notificar\xe1 a los padres sobre esta recolecci\xf3n y se divulgar\xe1n los motivos y el uso que se dar\xe1 a la informaci\xf3n. El Estado necesitar\xe1 el consentimiento de los padres antes de recolectar cualquier tipo de informaci\xf3n de identificaci\xf3n personal. En caso de que el Estado decida realizar la recolecci\xf3n, los padres pueden solicitar datos relacionados con el tipo de informaci\xf3n que ser\xe1 recolectada, ver la informaci\xf3n de sus hijos y, si as\xed lo desean, prohibir que el Estado realice otro uso de la informaci\xf3n de sus hijos. El Estado no proporcionar\xe1 informaci\xf3n personal de sus hijos a terceros. "),S(25,"hr"),c(26,"h4",12),u(27,"Recolecci\xf3n y uso de la informaci\xf3n"),l(),u(28," Recolectamos informaci\xf3n personal directamente de individuos que se ofrecen como voluntarios para utilizar algunos de nuestros servicios. Solicitamos la recolecci\xf3n de esta informaci\xf3n para prestar servicios espec\xedficos, pero el uso de estos servicios es voluntario."),S(29,"br")(30,"br"),u(31," En caso de que solamente navegue o descargue informaci\xf3n durante su visita al sitio web, recolectamos y almacenamos de forma autom\xe1tica la siguiente informaci\xf3n relacionada con su visita: "),c(32,"ol")(33,"li"),u(34,"La direcci\xf3n IP y el nombre de dominio utilizados, no la direcci\xf3n de correo electr\xf3nico. La direcci\xf3n IP es un identificador num\xe9rico asignado a su proveedor de servicio de Internet o directamente a su computadora. Utilizamos la direcci\xf3n IP para dirigir el tr\xe1fico de Internet hacia usted y generar estad\xedsticas que se utilizar\xe1n en la gesti\xf3n de este sitio."),l(),c(35,"li"),u(36,"El tipo de buscador y de sistema operativo que usted utiliza."),l(),c(37,"li"),u(38,"La fecha y la hora de su visita a este sitio."),l(),c(39,"li"),u(40,"Las p\xe1ginas web o los servicios a los que accedi\xf3 en este sitio."),l(),c(41,"li"),u(42,"El sitio web que visit\xf3 antes de ingresar a este sitio."),l(),c(43,"li"),u(44,"El sitio web que visit\xf3 al salir de este sitio."),l(),c(45,"li"),u(46,"En caso de que haya descargado un formulario, dicho formulario."),l()(),S(47,"br")(48,"br"),u(49," La informaci\xf3n que recolectamos y almacenamos de manera autom\xe1tica se utiliza para mejorar el contenido de nuestros servicios web y para ayudarnos a entender c\xf3mo la gente utiliza nuestros servicios. Esta informaci\xf3n no lo identifica personalmente y se utiliza para reunir estad\xedsticas de los sitios web. La informaci\xf3n que recolectamos y almacenamos autom\xe1ticamente en nuestros registros sobre su visita nos ayuda a analizar nuestro sitio web para mejorar de forma continua el valor de los materiales disponibles. Los registros de nuestro sitio web no identifican a un visitante mediante su informaci\xf3n personal: y no intentamos relacionar otros sitios web con el individuo que ha navegado en el sitio web del Estado. "),S(50,"br")(51,"br"),u(52,' El art\xedculo \xa7 11015.5 del C\xf3digo Gubernamental (6) proh\xedbe a todos los organismos estatales la distribuci\xf3n o la venta de cualquier informaci\xf3n personal de los usuarios recolectada de forma electr\xf3nica, como se define anteriormente, a ning\xfan tercero sin el permiso del usuario. El Estado no vende ninguna "informaci\xf3n personal recolectada de forma electr\xf3nica". Cualquier distribuci\xf3n de "informaci\xf3n personal recolectada de forma electr\xf3nica" se realizar\xe1 con el \xfanico prop\xf3sito para el que nos fue proporcionada. '),S(53,"br")(54,"br"),u(55," El Estado podr\xe1 brindar o distribuir determinadas listas e informes estad\xedsticos de informaci\xf3n seg\xfan lo permite la ley, pero no podr\xe1 vender ni distribuir informaci\xf3n personal, y todas las protecciones legales relevantes tambi\xe9n se aplican a los sitios web del Estado. "),S(56,"br")(57,"br")(58,"hr"),c(59,"h4",13),u(60,"\xbfQu\xe9 sucede con la informaci\xf3n que usted nos brinda?"),l(),u(61," En caso de que decida proporcionarnos informaci\xf3n, \xe9sta se transmitir\xe1 a trav\xe9s de l\xedneas seguras a nuestra base de datos departamental. Toda informaci\xf3n privada s\xf3lo se utilizar\xe1 con el prop\xf3sito para el que fue proporcionada y no se compartir\xe1 con otra entidad, excepto que la ley disponga lo contrario. Consulte nuestra Pol\xedtica de privacidad para obtener m\xe1s informaci\xf3n."),S(62,"br")(63,"br")(64,"hr"),c(65,"h4",14),u(66,"Uso de informaci\xf3n consignada en el formulario para solicitar asistencia por Internet"),l(),u(67," AToda informaci\xf3n que nos brinde s\xf3lo se compartir\xe1 con las entidades involucradas en su caso, seg\xfan corresponda. La informaci\xf3n que usted nos brinde puede agruparse con la informaci\xf3n de otros consumidores y utilizarse para informes estad\xedsticos, informaci\xf3n de tendencias o acciones de investigaci\xf3n. Por ejemplo, quiz\xe1 debamos retener informaci\xf3n que est\xe9 relacionada con una acci\xf3n judicial o con un caso de reclamo de un consumidor durante un per\xedodo de tiempo posterior a la fecha de cierre del caso."),S(68,"br")(69,"br"),u(70," En caso de que nos brinde informaci\xf3n relacionada con un asunto que no se encuentre dentro de nuestra jurisdicci\xf3n reglamentaria, podemos enviar en su nombre su informaci\xf3n al organismo local, estatal o federal apropiado."),S(71,"br")(72,"br")(73,"hr"),c(74,"h4",15),u(75,"Encuestas"),l(),u(76," Si durante su visita al sitio web del Estado participa en una encuesta o env\xeda un correo electr\xf3nico, se recolectar\xe1 la siguiente informaci\xf3n adicional:"),S(77,"br")(78,"br"),c(79,"ol")(80,"li"),u(81,"La direcci\xf3n de correo electr\xf3nico y el contenido del correo electr\xf3nico; y"),l(),c(82,"li"),u(83,"la informaci\xf3n ofrecida de forma voluntaria en respuesta a la encuesta."),l()(),u(84," La informaci\xf3n recolectada no se limita a caracteres de texto y puede incluir los formatos gr\xe1ficos, de audio y de video que usted nos env\xede. "),S(85,"br")(86,"br"),u(87," La informaci\xf3n es retenida de acuerdo con el art\xedculo \xa7 11015.5 del C\xf3digo Gubernamental."),S(88,"br")(89,"br")(90,"hr"),c(91,"h4",16),u(92,"Si nos env\xeda un correo electr\xf3nico"),l(),u(93," Puede optar por brindarnos informaci\xf3n personal mediante, por ejemplo, un correo electr\xf3nico con comentarios o preguntas. Utilizamos la informaci\xf3n para mejorar el servicio que le brindamos o para responder a su solicitud. En algunas ocasiones, reenviamos su correo electr\xf3nico a otros empleados estatales que probablemente est\xe9n mejor capacitados para ayudarlo. Este personal puede estar contratado por un organismo diferente dentro del Estado. No enviaremos el correo electr\xf3nico a otra organizaci\xf3n, excepto que se realicen investigaciones autorizadas para cumplir con la ley o en caso de que la ley as\xed lo disponga. "),S(94,"br")(95,"br"),u(96," Utilizaremos su correo electr\xf3nico para responder de forma apropiada. Esto puede utilizarse para responderle, para tratar temas que usted identifique, para mejorar a\xfan m\xe1s nuestro sitio web o para reenviar el correo electr\xf3nico a otro organismo para que tome la medida correspondiente. "),S(97,"hr"),c(98,"h4",17),u(99,"Formularios de pedidos"),l(),u(100," En caso de que nos haga un pedido, solicitamos informaci\xf3n del usuario en nuestro formulario de pedido. Un usuario debe brindar informaci\xf3n de contacto (por ejemplo, nombre y domicilio de env\xedo) e informaci\xf3n financiera (por ejemplo, n\xfamero de tarjeta de cr\xe9dito y fecha de vencimiento). Esta informaci\xf3n se utiliza con prop\xf3sitos de facturaci\xf3n y para completar su pedido o solicitud. En caso de tener alg\xfan problema con el procesamiento de un pedido, la informaci\xf3n de contacto se utiliza para ponerse en contacto con usted."),S(101,"br")(102,"br")(103,"hr"),c(104,"h4",18),u(105,"Divulgaci\xf3n p\xfablica"),l(),u(106," En el Estado de California, las leyes existen para garantizar que el gobierno sea accesible y para que el p\xfablico tenga derecho a acceder a los registros y a la informaci\xf3n apropiados que posee el gobierno estatal. Al mismo tiempo, existen excepciones en los derechos de la gente para acceder a los registros p\xfablicos. Estas excepciones satisfacen varias necesidades que incluyen mantener la privacidad de los individuos. Tanto las leyes federales como las estatales presentan excepciones."),S(107,"br")(108,"br"),u(109," Toda la informaci\xf3n recolectada en este sitio se convierte en registro p\xfablico que puede encontrarse sujeto a inspecci\xf3n y reproducci\xf3n de las personas en general, a menos que exista una exenci\xf3n en la ley. En caso de que exista un conflicto entre esta Pol\xedtica de uso y la Ley de Registros P\xfablicos, la Ley de Pr\xe1cticas de Informaci\xf3n u otra ley que controle la divulgaci\xf3n de registros, regir\xe1 la Ley de Registros P\xfablicos, la Ley de Pr\xe1cticas de Informaci\xf3n u otra ley pertinente."),S(110,"br")(111,"br")(112,"hr"),c(113,"h4",19),u(114,"Informaci\xf3n personal"),l(),u(115," Seg\xfan lo estipulado por el art\xedculo \xa7 11015.5 del C\xf3digo Gubernamental, si usted lo desea, su informaci\xf3n personal recolectada puede descartarse sin reutilizaci\xf3n ni distribuci\xf3n, siempre y cuando se comunique con nosotros oportunamente."),S(116,"br")(117,"br")(118,"hr"),c(119,"h4",20),u(120,"Recolecci\xf3n autom\xe1tica de informaci\xf3n/Cookies"),l(),u(121," Las cookies son documentos de texto simples que se almacenan en su computadora a trav\xe9s de su navegador de Internet. El portal principal del Estado no utiliza cookies para mantener la personalizaci\xf3n; sin embargo, algunas aplicaciones departamentales pueden hacerlo."),S(122,"br")(123,"br"),u(124," El Estado realiza todo lo que se encuentra a su alcance para evitar el uso de cookies. Cuando es necesario mantener la funcionalidad de una aplicaci\xf3n, a diferencia del uso habitual de las cookies, el Estado s\xf3lo utiliza las cookies durante la sesi\xf3n en la que usted accede a nuestras aplicaciones interactivas. "),S(125,"br")(126,"br"),u(127,' Las cookies que se crean en su computadora al utilizar este sitio web no contienen "informaci\xf3n personal" ni comprometen su privacidad o seguridad. Utilizamos la funci\xf3n de cookies s\xf3lo para almacenar una etiqueta temporal identificada que se genera de forma aleatoria en su computadora. Puede rechazar la cookie o descartar el documento cookie de su computadora mediante cualquiera de los m\xe9todos ampliamente disponibles. Sin embargo, en caso de desactivar la opci\xf3n cookie, probablemente no tenga acceso a algunas de las funciones de nuestras aplicaciones interactivas. '),S(128,"br")(129,"br")(130,"hr"),c(131,"h4",21),u(132,"Seguridad"),l(),u(133," El Estado, como creador y administrador de este sitio web, ha tomado varios recaudos para asegurar la integridad de sus telecomunicaciones y de su infraestructura inform\xe1tica que incluye, entre otros, autenticaci\xf3n, control, autor\xeda y encriptaci\xf3n. Las medidas de seguridad se han integrado al dise\xf1o, la implementaci\xf3n y las pr\xe1cticas diarias de todo el entorno operativo del Estado como parte de su compromiso continuo hacia la administraci\xf3n de riesgos. Esta informaci\xf3n no debe, de ning\xfan modo, interpretarse como asesoramiento comercial, legal o de otro tipo, ni debe interpretarse que la seguridad de la informaci\xf3n proporcionada mediante el sitio web del Estado es a prueba de fallas. El Departamento de Tecnolog\xedas de la Informaci\xf3n implementa los est\xe1ndares t\xe9cnicos que controlan la seguridad."),S(134,"br")(135,"br")(136,"hr"),c(137,"h4",22),u(138,"Enlaces a otros sitios"),l(),u(139," Nuestro sitio web posee enlaces a otros sitios que creemos que pueden serle \xfatiles o brindarle servicios. Cuando se conecta a otro sitio web, ya no se encuentra en nuestro sitio y est\xe1 sujeto a las pol\xedticas de privacidad del sitio nuevo."),S(140,"br")(141,"br"),u(142," El Estado de California proporciona este sitio web y la informaci\xf3n que se incluye en \xe9ste como servicio de car\xe1cter p\xfablico. Este sistema se controla para asegurar su operaci\xf3n apropiada, para verificar el funcionamiento de las caracter\xedsticas de seguridad correspondientes y para llevar a cabo otros prop\xf3sitos similares. Cualquier persona que utilice este sistema acepta expresamente dicho control. Se proh\xedben los intentos no autorizados de modificar cualquier informaci\xf3n almacenada en este sistema, de violar o evadir las caracter\xedsticas de seguridad o de utilizar este sistema con prop\xf3sitos diferentes de los establecidos. Dichos intentos pueden resultar en un proceso judicial."),S(143,"br")(144,"br")(145,"hr"),c(146,"h4",23),u(147,"Responsabilidad limitada"),l(),u(148," El Estado trata de mantener la mayor precisi\xf3n en el contenido de su sitio web. Todo error u omisi\xf3n debe informarse para su investigaci\xf3n."),S(149,"br")(150,"br"),u(151," El Estado no declara, promete ni garantiza la precisi\xf3n, la integridad o la adecuaci\xf3n absolutas del contenido de este sitio web; adem\xe1s, renuncia de forma expresa a la responsabilidad por errores u omisiones en el contenido de este sitio web. No se otorga ning\xfan tipo de garant\xeda impl\xedcita, expresa o establecida por ley, incluidas, entre otras, garant\xedas de no violaci\xf3n de derechos de terceros, t\xedtulos, capacidad de comercializaci\xf3n, aptitud para un prop\xf3sito en particular y ausencia de virus inform\xe1ticos, con respecto al contenido de este sitio web o a sus hiperv\xednculos a otros recursos de Internet. La referencia en este sitio web a cualquier producto, proceso o servicio comercial espec\xedfico, o el uso de cualquier nombre comercial o de empresa, se utilizan para brindar informaci\xf3n al p\xfablico y para su conveniencia, y no constituye aprobaci\xf3n, recomendaci\xf3n ni privilegio del Estado de California, ni de sus empleados o agentes."),S(152,"br")(153,"br"),u(154," Esta Pol\xedtica de uso est\xe1 sujeta a cambios sin aviso."),S(155,"br")(156,"br")(157,"hr"),c(158,"h4",24),u(159,"Propiedad"),l(),u(160," En general, la informaci\xf3n que se presenta en este sitio web, a menos que se consigne lo contrario, se considera informaci\xf3n de dominio p\xfablico. Puede distribuirse o reproducirse seg\xfan lo estipule la ley. Sin embargo, el Estado utiliza la informaci\xf3n con derechos de autor (por ejemplo, fotograf\xedas) que puede requerir permisos adicionales antes de su uso. Adem\xe1s, la marca exclusiva del sitio, as\xed como tambi\xe9n varios sellos e impresiones oficiales, no pueden utilizarse sin permiso del Estado. Para utilizar cualquier informaci\xf3n de este sitio web que no pertenezca al Estado o que el Estado no haya creado, debe solicitar permiso directamente de las fuentes propietarias (o tenedoras). El Estado tendr\xe1 derechos ilimitados para utilizar, con cualquier prop\xf3sito y libre de todo cargo, cualquier informaci\xf3n que se env\xede mediante este sitio, excepto los env\xedos que se realicen seg\xfan otros contratos legales. El Estado tendr\xe1 la libertad de utilizar, con cualquier prop\xf3sito, cualquier idea, concepto o t\xe9cnica que contenga la informaci\xf3n que se proporciona a trav\xe9s de este sitio."),S(161,"br")(162,"br"),l())}function mdt(e,n){1&e&&(c(0,"div")(1,"h4",10),u(2,"\u500b\u4eba\u8cc7\u6599\u8207\u9078\u64c7"),l(),u(3," L\u300c\u500b\u4eba\u8cc7\u6599\u300d\u4fc2\u6307\u53ef\u8b58\u5225\u6216\u63cf\u8ff0\u70ba\u500b\u4eba\u4e4b\u81ea\u7136\u4eba\u8cc7\u6599\uff0c\u5305\u62ec\uff08\u4f46\u4e0d\u9650\u65bc\uff09\u5176\u59d3\u540d\u3001\u793e\u6703\u4fdd\u96aa\u865f\u78bc\u3001\u7279\u5fb5\u63cf\u8ff0\u3001\u4f4f\u5bb6\u5730\u5740\u3001\u4f4f\u5bb6\u96fb\u8a71\u865f\u78bc\u3001\u6559\u80b2\u7a0b\u5ea6\u3001\u8ca1\u52d9\u72c0\u6cc1\u53ca\u75c5\u53f2\u6216\u5de5\u4f5c\u7d93\u6b77\u7b49\u5f97\u8b58\u5225\u8a72\u7279\u5b9a\u500b\u4eba\u4e4b\u8cc7\u6599\u3002 \u7db2\u57df\u540d\u7a31\u6216\u7db2\u969b\u7db2\u8def\u901a\u8a0a\u5354\u5b9a\u4f4d\u5740\u4e0d\u8996\u70ba\u500b\u4eba\u8cc7\u6599\uff0c\u4f46\u8996\u70ba\u300c\u96fb\u5b50\u6536\u96c6\u4e4b\u500b\u4eba\u8cc7\u6599\u300d\u3002 "),S(4,"br")(5,"br"),u(6," \u6839\u64da\u653f\u5e9c\u6cd5\u898f \xa7 11015.5 \u4e4b\u898f\u5b9a\uff0c\u300c\u96fb\u5b50\u6536\u96c6\u4e4b\u500b\u4eba\u8cc7\u6599\u300d\u4fc2\u6307\u7531\u6a5f\u69cb\u4fdd\u5b58\u4e4b\u4efb\u4f55\u5f97\u8b58\u5225\u6216\u63cf\u8ff0\u500b\u5225\u4f7f\u7528\u8005\u4e4b\u8cc7\u6599\uff0c\u5305\u62ec\uff08\u4f46\u4e0d\u9650\u65bc\uff09\u5176\u59d3\u540d\u3001\u793e\u6703\u4fdd\u96aa\u865f\u78bc\u3001\u7279\u5fb5\u63cf\u8ff0\u3001\u4f4f\u5bb6\u5730\u5740\u3001\u4f4f\u5bb6\u96fb\u8a71\u865f\u78bc\u3001\u6559\u80b2\u7a0b\u5ea6\u3001\u75c5\u6b77\u6216\u5de5\u4f5c\u7d93\u6b77\u3001\u5bc6\u78bc\u3001\u96fb\u5b50\u90f5\u4ef6\u5730\u5740\uff0c\u4ee5\u53ca\u900f\u9732\u4efb\u4f55\u7db2\u8def\u4f4d\u7f6e\u6216\u8eab\u5206\u4e4b\u8cc7\u6599\uff0c\u4f46\u4e0d\u5305\u62ec\u7531\u4f7f\u7528\u8005\u624b\u52d5\u63d0\u4ea4\u7d66\u5dde\u653f\u5e9c\u6a5f\u69cb\u4e4b\u4efb\u4f55\u8cc7\u6599\uff0c\u7121\u8ad6\u5176\u70ba\u96fb\u5b50\u6216\u66f8\u9762\u5f62\u5f0f\uff0c\u4ee5\u53ca\u4f7f\u7528\u8005\u500b\u4eba\u670d\u52d9\u65bc\u5546\u696d\u8077\u4f4d\u4e4b\u76f8\u95dc\u8cc7\u6599\uff0c\u5305\u62ec\uff08\u4f46\u4e0d\u9650\u65bc\uff09\u8a72\u7b49\u4f01\u696d\u4e4b\u696d\u4e3b\u3001\u9ad8\u7d1a\u8077\u54e1\u6216\u8ca0\u8cac\u4eba\u3002 "),S(7,"br")(8,"br"),u(9," \u81ea\u52d5\u6536\u96c6\u4e4b\u300c\u96fb\u5b50\u6536\u96c6\u4e4b\u500b\u4eba\u8cc7\u6599\u300d\u5305\u62ec\u7db2\u57df\u540d\u7a31\u6216\u7db2\u969b\u7db2\u8def\u901a\u8a0a\u5354\u5b9a\u4f4d\u5740\uff0c\u4ee5\u53ca\u95dc\u65bc\u700f\u89bd\u7db2\u9801\u4e4b\u7d71\u8a08\u8cc7\u6599\u3002 \u5982\u60a8\u81ea\u9858\u53c3\u8207\u67d0\u9805\u8a62\u554f\u7279\u5b9a\u8cc7\u6599\u4e4b\u6d3b\u52d5\uff08\u4ea6\u5373\u586b\u5beb\u88dc\u52a9\u7533\u8acb\u8868\u3001\u500b\u4eba\u5316\u7db2\u7ad9\u5167\u5bb9\u3001\u50b3\u9001\u96fb\u5b50\u90f5\u4ef6\u6216\u53c3\u8207\u554f\u5377\u8abf\u67e5\uff09\uff0c\u5247\u6703\u6536\u96c6\u66f4\u8a73\u7d30\u4e4b\u8cc7\u6599\u3002 \u5982\u60a8\u9078\u64c7\u4e0d\u53c3\u8207\u9019\u4e9b\u6d3b\u52d5\uff0c\u9019\u9805\u6c7a\u5b9a\u7d55\u4e0d\u6703\u5f71\u97ff\u4f7f\u7528\u672c\u7db2\u7ad9\u4e4b\u4efb\u4f55\u5176\u4ed6\u529f\u80fd\u3002 "),S(10,"br")(11,"br"),u(12," \u5982\u679c\u7db2\u7ad9\u8981\u6c42\u4efb\u4f55\u985e\u578b\u4e4b\u500b\u4eba\u8cc7\u6599\uff0c\u6216\u4f7f\u7528\u8005\u81ea\u9858\u63d0\u4f9b\u500b\u4eba\u8cc7\u6599\uff0c\u9019\u4e9b\u8cc7\u6599\u5c07\u53d7\u52a0\u5dde\u6cd5\u5f8b\u4fdd\u8b77\uff0c\u5305\u62ec 1977 \u5e74\u8cc7\u8a0a\u8655\u7406\u6cd5\u6848 (Information Practices Act)\u3001\u653f\u5e9c\u6cd5\u898f\u7b2c 11015.5 \u6b3e\u4ee5\u53ca\u806f\u90a6 1974 \u5e74\u96b1\u79c1\u6b0a\u6cd5\u6848 (Privacy Act)\u3002 \u4e0d\u904e\uff0c\u8a72\u7b49\u8cc7\u6599\u53ef\u80fd\