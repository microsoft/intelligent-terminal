xe1c"),l(),u(139," Trang web c\u1ee7a ch\xfang t\xf4i li\xean k\u1ebft v\u1edbi c\xe1c trang web kh\xe1c m\xe0 ch\xfang t\xf4i c\u1ea3m th\u1ea5y c\xf3 \xedch cho qu\xfd v\u1ecb v\xe0 c\xf3 th\u1ec3 cung c\u1ea5p c\xe1c d\u1ecbch v\u1ee5. Khi qu\xfd v\u1ecb li\xean k\u1ebft v\u1edbi trang web kh\xe1c, qu\xfd v\u1ecb kh\xf4ng c\xf2n \u1edf tr\xean trang web c\u1ee7a ch\xfang t\xf4i v\xe0 ph\u1ee5 thu\u1ed9c v\xe0o ch\xednh s\xe1ch quy\u1ec1n ri\xeang t\u01b0 c\u1ee7a trang web m\u1edbi. "),S(140,"br")(141,"br"),u(142," Trang web n\xe0y v\xe0 th\xf4ng tin tr\xean \u0111\xf3 \u0111\u01b0\u1ee3c cung c\u1ea5p nh\u01b0 l\xe0 m\u1ed9t d\u1ecbch v\u1ee5 c\xf4ng c\u1ed9ng c\u1ee7a Ti\u1ec3u Bang California. H\u1ec7 th\u1ed1ng n\xe0y \u0111\u01b0\u1ee3c gi\xe1m s\xe1t \u0111\u1ec3 \u0111\u1ea3m b\u1ea3o v\u1eadn h\xe0nh \u0111\xfang \u0111\u1eafn, x\xe1c nh\u1eadn s\u1ef1 ho\u1ea1t \u0111\u1ed9ng c\u1ee7a c\xe1c t\xednh n\u0103ng b\u1ea3o m\u1eadt c\xf3 th\u1ec3 \xe1p d\u1ee5ng, v\xe0 c\xe1c m\u1ee5c \u0111\xedch c\xf3 th\u1ec3 so s\xe1nh. B\u1ea5t c\u1ee9 ai s\u1eed d\u1ee5ng h\u1ec7 th\u1ed1ng n\xe0y \u0111\u1ec1u ph\u1ea3i ch\u1ea5p thu\u1eadn s\u1ef1 gi\xe1m s\xe1t \u0111\xf3. Nh\u1eefng n\u1ed7 l\u1ef1c ch\u1ec9nh s\u1eeda tr\xe1i ph\xe9p b\u1ea5t k\u1ef3 th\xf4ng tin n\xe0o \u0111\u01b0\u1ee3c l\u01b0u gi\u1eef tr\xean h\u1ec7 th\u1ed1ng n\xe0y, nh\u1eb1m h\u1ee7y ho\u1ea1i ho\u1eb7c ph\xe1 h\u1ecfng c\xe1c t\xednh n\u0103ng b\u1ea3o m\u1eadt ho\u1eb7c s\u1eed d\u1ee5ng h\u1ec7 th\u1ed1ng n\xe0y cho m\u1ee5c \u0111\xedch kh\xe1c v\u1edbi nh\u1eefng m\u1ee5c \u0111\xedch \u0111\xe3 \u0111\u1ecbnh \u0111\u1ec1u b\u1ecb nghi\xeam c\u1ea5m v\xe0 c\xf3 th\u1ec3 b\u1ecb truy t\u1ed1 h\xecnh s\u1ef1. "),S(143,"br")(144,"br")(145,"hr"),c(146,"h4",23),u(147,"Gi\u1edbi h\u1ea1n Tr\xe1ch nhi\u1ec7m"),l(),u(148," Ti\u1ec3u Bang c\u1ed1 g\u1eafng duy tr\xec t\xednh ch\xednh x\xe1c cao nh\u1ea5t c\u1ee7a n\u1ed9i dung tr\xean trang web c\u1ee7a m\xecnh. B\u1ea5t k\u1ef3 l\u1ed7i, ho\u1eb7c thi\u1ebfu s\xf3t n\xe0o \u0111\u1ec1u n\xean \u0111\u01b0\u1ee3c b\xe1o c\xe1o \u0111\u1ec3 ki\u1ec3m tra. "),S(149,"br")(150,"br"),u(151," Ti\u1ec3u Bang kh\xf4ng tuy\xean b\u1ed1, h\u1ee9a h\u1eb9n hay b\u1ea3o \u0111\u1ea3m v\u1ec1 t\xednh ch\xednh x\xe1c tuy\u1ec7t \u0111\u1ed1i, s\u1ef1 ho\xe0n thi\u1ec7n, ho\u1eb7c \u0111\u1ea7y \u0111\u1ee7 v\u1ec1 n\u1ed9i dung c\u1ee7a trang web n\xe0y v\xe0 ho\xe0n to\xe0n kh\xf4ng c\xf3 tr\xe1ch nhi\u1ec7m \u0111\u1ed1i v\u1edbi c\xe1c l\u1ed7i v\xe0 thi\u1ebfu s\xf3t v\u1ec1 n\u1ed9i dung c\u1ee7a trang web n\xe0y. Kh\xf4ng c\xf3 s\u1ef1 b\u1ea3o \u0111\u1ea3m d\u01b0\u1edbi b\u1ea5t k\u1ef3 h\xecnh th\u1ee9c n\xe0o, \u0111\u01b0\u1ee3c ng\u1ee5 \xfd, di\u1ec5n \u0111\u1ea1t hay quy \u0111\u1ecbnh theo lu\u1eadt, bao g\u1ed3m nh\u01b0ng kh\xf4ng gi\u1edbi h\u1ea1n s\u1ef1 b\u1ea3o \u0111\u1ea3m kh\xf4ng x\xe2m ph\u1ea1m \u0111\u1ebfn quy\u1ec1n, quy\u1ec1n l\u1ee3i, quy\u1ec1n s\u1edf h\u1eefu, kh\u1ea3 n\u0103ng b\xe1n \u0111\u01b0\u1ee3c, s\u1ef1 ph\xf9 h\u1ee3p c\u1ee7a b\xean th\u1ee9 3 v\xec m\u1ed9t m\u1ee5c \u0111\xedch c\u1ee5 th\u1ec3 v\xe0 kh\xf4ng c\xf3 virus m\xe1y t\xednh, \u0111\u01b0\u1ee3c \u0111\u01b0a ra \u0111\u1ed1i v\u1edbi c\xe1c n\u1ed9i dung c\u1ee7a trang web ho\u1eb7c c\xe1c si\xeau li\xean k\u1ebft c\u1ee7a n\xf3 t\u1edbi c\xe1c ngu\u1ed3n Internet kh\xe1c. Vi\u1ec7c tham chi\u1ebfu trong trang web n\xe0y \u0111\u1ed1i v\u1edbi b\u1ea5t k\u1ef3 s\u1ea3n ph\u1ea9m th\u01b0\u01a1ng m\u1ea1i, c\xe1c qu\xe1 tr\xecnh, ho\u1eb7c d\u1ecbch v\u1ee5 c\u1ee5 th\u1ec3 n\xe0o, ho\u1eb7c s\u1eed d\u1ee5ng b\u1ea5t k\u1ef3 t\xean th\u01b0\u01a1ng m\u1ea1i, t\xean h\xe3ng, t\xean c\xf4ng ty n\xe0o \u0111\u1ec1u nh\u1eb1m th\xf4ng tin v\xe0 ti\u1ec7n l\u1ee3i c\u1ee7a c\xf4ng ch\xfang, v\xe0 kh\xf4ng t\u1ea1o n\xean s\u1ef1 x\xe1c nh\u1eadn, \u0111\u1ec1 ngh\u1ecb, ho\u1eb7c \u1ee7ng h\u1ed9 c\u1ee7a Ti\u1ec3u Bang California, ho\u1eb7c c\xe1c nh\xe2n vi\xean hay \u0111\u1ea1i di\u1ec7n c\u1ee7a h\u1ecd. "),S(152,"br")(153,"br"),u(154," \u672cCh\xednh s\xe1ch S\u1eed d\u1ee5ng n\xe0y c\xf3 th\u1ec3 thay \u0111\u1ed5i m\xe0 kh\xf4ng c\u1ea7n th\xf4ng b\xe1o. "),S(155,"br")(156,"br")(157,"hr"),c(158,"h4",24),u(159,"Quy\u1ec1n S\u1edf h\u1eefu"),l(),u(160," N\xf3i chung, th\xf4ng tin \u0111\u01b0\u1ee3c tr\xecnh b\xe0y tr\xean trang web n\xe0y, tr\u1eeb khi \u0111\u01b0\u1ee3c n\xeau r\xf5 kh\xe1c, \u0111\u01b0\u1ee3c xem l\xe0 thu\u1ed9c v\u1ec1 c\xf4ng ch\xfang. C\xf3 th\u1ec3 \u0111\u01b0\u1ee3c ph\xe2n ph\xe1t ho\u1eb7c sao ch\xe9p v\u1edbi s\u1ef1 cho ph\xe9p c\u1ee7a lu\u1eadt ph\xe1p. Tuy nhi\xean, Ti\u1ec3u Bang t\u1eadn d\u1ee5ng c\xe1c d\u1eef li\u1ec7u c\xf3 b\u1ea3n quy\u1ec1n (v\xed d\u1ee5 nh\u01b0 c\xe1c t\u1ea5m \u1ea3nh) m\xe0 c\xf3 th\u1ec3 y\xeau c\u1ea7u s\u1ef1 cho ph\xe9p kh\xe1c tr\u01b0\u1edbc khi qu\xfd v\u1ecb s\u1eed d\u1ee5ng. H\u01a1n n\u1eefa, nh\xe3n hi\u1ec7u ri\xeang c\u1ee7a trang web n\xe0y v\xe0 c\xe1c con d\u1ea5u v\xe0 nh\xe3n ch\xednh th\u1ee9c kh\xe1c nhau c\xf3 th\u1ec3 kh\xf4ng \u0111\u01b0\u1ee3c s\u1eed d\u1ee5ng m\xe0 kh\xf4ng c\xf3 s\u1ef1 cho ph\xe9p c\u1ee7a Ti\u1ec3u Bang. \u0110\u1ec3 s\u1eed d\u1ee5ng b\u1ea5t k\u1ef3 th\xf4ng tin n\xe0o tr\xean trang web n\xe0y m\xe0 kh\xf4ng ph\u1ea3i do Ti\u1ec3u Bang s\u1edf h\u1eefu hay t\u1ea1o ra, qu\xfd v\u1ecb ph\u1ea3i xin ph\xe9p tr\u1ef1c ti\u1ebfp t\u1eeb c\xe1c ngu\u1ed3n s\u1edf h\u1eefu (hay n\u1eafm gi\u1eef). Ti\u1ec3u Bang s\u1ebd c\xf3 quy\u1ec1n s\u1eed d\u1ee5ng kh\xf4ng gi\u1edbi h\u1ea1n cho b\u1ea5t k\u1ef3 m\u1ee5c \u0111\xedch n\xe0o, ho\xe0n to\xe0n mi\u1ec5n ph\xed, t\u1ea5t c\u1ea3 c\xe1c th\xf4ng tin \u0111\u01b0\u1ee3c \u0111\u0103ng k\xfd qua trang web n\xe0y ngo\u1ea1i tr\u1eeb nh\u1eefng th\xf4ng tin \u0111\u0103ng k\xfd theo h\u1ee3p \u0111\u1ed3ng ph\xe1p l\xfd ri\xeang. Ti\u1ec3u Bang s\u1ebd to\xe0n quy\u1ec1n s\u1eed d\u1ee5ng, cho b\u1ea5t k\u1ef3 m\u1ee5c \u0111\xedch n\xe0o, b\u1ea5t k\u1ef3 \xfd t\u01b0\u1edfng, kh\xe1i ni\u1ec7m, ho\u1eb7c k\u1ef9 thu\u1eadt n\xe0o c\xf3 trong th\xf4ng tin \u0111\u01b0\u1ee3c cung c\u1ea5p th\xf4ng qua trang web n\xe0y. "),S(161,"br")(162,"br"),l())}function Mdt(e,n){1&e&&(c(0,"div")(1,"h4",10),u(2,"Personal na Impormasyon at Pagpili"),l(),u(3,' Ang "Personal na Impormasyon"ay impormasyon tungkol sa isang tao na kumikilala o naglalarawan ng indibwal, kabilang ang, ngunit di limitado sa, kanyang pangalan, numero ng social security, pisikal ng paglalarawan, tirahan, numero ng telepono sa bahay, edukasyon, pinansiyal na mga gabay, at kasaysayan na medikal o pagtrabaho, madaling maiuugnay sa mismong indibwal na iyon. A domain name o Internet Protocol address ay hindi itinuturing na personal na impormasyon, gayunman, ito ay itinuturing na isang personal na impormasyon na kinalap sa elektronikong paraan. '),S(4,"br")(5,"br"),u(6,' Ayon sa Government Code \xa7 11015.5 "Ang personal na impormasyong nakalap sa elektronikong paraan" ay nangunguhulugan na ang anumang impormasyon na itinatago ng isang ahensiya na kumikilala sa o naglalarawan ng indibidwal na gumagamit, kasama ang, pero hindi limitado sa, kanyang pangalan, numero ng social security, pisikal na kaanyuan, tirahan, telepono sa bahay, edukasyon, pinansyal na mga bagay, at kasaysayang medikal o rekord ng pagtatrabaho, password, e-mail address, at mga impormasyon na nagbubunyag sa lokasyon ng anumang network o pagkakakilanlan, pero hindi kasama ang anumang impormasyon na hindi idinaan sa e-mail kahit ito ay naka-computer o typewritten o sulat-kamay, at impormasyon tungkol sa o may kaugnayan sa mga gumagamit na indibidwal, na gumaganap para sa negosyo, kasama ang, pero hindi limitado sa, mga may-ari ng negosyo, mga opisyal, o mga mahahalagang tao ng naturang negosyo. '),S(7,"br")(8,"br"),u(9,' Ang "Mga personal na impormasyong nakalap sa elektronikong paran\u201d na aming awtomatikong kinokolekta ay ang inyong domain name o Internet Protocol address, at mga impormasyong istatistika tungkol sa mga binisita ninyong mga web page. Kung kayo ay boluntaryong pumayag na sumali sa isang aktibidad na humihingi ng inyong partikular na impormasyon (tulad ng, pagkumpleto sa isang paghingi ng tulong , gawing personal ang laman ng website, pagpapadala ng e-mail at pagsama sa isang pagsisiyasat o pag-aaral) mas maraming datos ang makokolekta. Kung magpasya kayong hindi sumali sa mga ganitong mga aktibidades, ang inyong pagpasya ay hindi makakaapekto sa anumang paraan sa inyong kakayahan para gamitin ang ibang bahagi ng website. '),S(10,"br")(11,"br"),u(12," Kung anumang uri ng personal na impormasyon ay hihilingin sa website o boluntaryong ibinigay ng gumagamit, ito may maaaring protektahan ng batas ng estado, kasama ang Information Practices Act ng 1977, Government Code Section 11015.5, at ang federal Privacy Act ng 1974. Gayunman, ang impormasyon ay maaaring maging pagmamay-ari ng publiko kapag ibinigay mo ito, at maaaring ipailalim sa pampublikong inspeksyon at pagkokopya maliban kung ito ay protektado ng batas ng federal o ng estado. "),S(13,"br")(14,"br"),u(15," Dagdag pa rito, ang mga departamento at mga ahensiya ng Estado ng California ay kinakailangang sumunod sa Patakan sa Paglilihim na maaari ring makita sa website na ito. Sumanguni sa Department of General Services Management Memo 00-14, may-bisa simuila Enero 1, 2001. "),S(16,"br")(17,"br")(18,"hr"),c(19,"h4",11),u(20,"Isang Natatanging Sulat Tungkol sa mga Bata"),l(),u(21," Ang mga bata ay hindi karapatdapat na gumamit ng mga serbisyong nangangailangan ng pagbibigay ng personal na impormasyon at aming hinihiling na ang mga menor de edad (na mas bata pa sa edad na 18 taon) na huwag magbigay ng personal ng impormasyon sa amin. Kasali dito ang pagbibigay ng personal na impormasyon sa Estado bilang bahagi ng profile ng gumagamit o personalization profile. Kung ikaw ay isang menor de edad, maaari mong gamitin ito kung kasama ang mga magulang o tagapatnubay mo. Kung ikaw ay menor de edad kinakailangan mong humingi ng gabay mula sa iyong mga magulang. "),S(22,"br")(23,"br"),u(24," Kung ang estado ay nagpasyang mag-umpisang mangalap ng mga personal na impormasyon na galing sa mga bata, ipapaalam nito sa mga magulang, sasabihin ang dahilan ng pagkokolekta nito, at sasabihin naming kung saan gagamitin ang mga ito. Ang estado ay hihingi ng pahintulot mula sa mga magulang bago mangalap ng mga personal na impormasyong tutukoy sa isang indibidwal. Kung sakaling mangangalap nito, maaaring humingi ng impormasyon ang mga magulang sa uri ng datos na kinokolekta, makita ang impormasyon tungkol sa kanilang anak at, kung gusto nila, maaari nilang pagpabawalan ang estado sa paggamit pa ng impormasyon tungkol sa kanilang anak. Hindi magbibigay ang estado ng personal na impormasyon tungkol sa mga bata sa mga tinatawag na mga pangatlong partido. "),S(25,"hr"),c(26,"h4",12),u(27,"Mga Impormasyong Nakalap At Ang Paggamit Nito"),l(),u(28," Kami ay nangongolekta ng personal na impormasyon ng tuwiran sa mga indibidwal na nagboluntaryong gagamit sa aming mga ibang serbisyo. Ang pangungulekta ng mga impormasyong ito ay kailangan upang makapagbigay ng isang natatanging serbisyo, pero ang paggamit sa mga serbisyong ito ay boluntaryo. "),S(29,"br")(30,"br"),u(31," Kung wala kayong ginawa sa pagbisita sa aming website, kundi tumingin lamang o magdownload ng mga impormasyon, kami ay awtomatikong kumakalap ng mga sumusunod na impormasyon tungkol sa iyong pagbisita: "),c(32,"ol")(33,"li"),u(34,"Ang Internet Protocal Address at domain name na ginagamit pero hindi ang e-mail address. Ang Internet Protocol address ay isang bilang na pananda na itinatakda sa iyong tagapaghatid ng serbisyong Internet o diretso sa iyong computer. Ginagamit namin ang Internet Protocol Address upang idirekta ang Internet na trapiko patungo sa iyo at gumawa ng mga estatistika na ginamit sa pamamahala ng site na ito;"),l(),c(35,"li"),u(36,"Ang uri ng browser at operating system na iyong ginamit;"),l(),c(37,"li"),u(38,"Ang petsa at oras na binisita mo ang site;"),l(),c(39,"li"),u(40,"Ang mga pahina ng web o serbisyo na iyong pinuntahan sa site na ito;"),l(),c(41,"li"),u(42,"Ang website na iyong binisita bago ka mapunta sa website na ito;"),l(),c(43,"li"),u(44,"Ang website na iyong pinupuntahan habang ikaw ay paalis mula sa website na ito;"),l(),c(45,"li"),u(46,"Kung ikaw ay nag-download ng form, ang form na na-download."),l()(),S(47,"br")(48,"br"),u(49," Ang mga impormasyong aming awtomatikong nakokolekta o tinatago ay ginagamit upang mapabuti ang nilalaman ng aming mga serbisyo sa web at upang makatulong sa aming maintindihan kung paano ginagamit ng mga tao ang aming mga serbisyo. Ang impormasyon ay hindi personal na pakakakilanlan mo at gagamitin ito sa paglikom ng istatistika ng website. Ang impormasyong aming awtomatikong nakokolekta at tinitipon sa aming listahan tungkol sa iyong pagbisita ay nakakatulong sa pagsusuri sa aming website para patuloy naming pagbutihin ang kalidad ng mga materyales na nandito. Ang aming listahan ay hindi kumikilala ng bisita sa pamamagitan ng personal na impormasyon, at hindi kami nangangahas na malaman ang mga website na nabisita na ng mga taong bumibisita sa website ng Estado. "),S(50,"br")(51,"br"),u(52,' Ang Government Code \xa7 11015.5 (6) ang nagbabawal sa lahat ng ahensiya ng estado sa pamimigay or pagbebenta ng anumang personal na impormasyong nakuha sa pamamagitang ng Internet tulad ng nakasaad sa itaas, tungkol sa mga gumagamit at sa mga tinatawag na ikatlong partido na walang pahintulot mula sa gumagamit. Ang Estado ay hindi nagbebenta ng anumang "personal na impormasyong nakalap sa elektronikong paraan". Ang anumang pamimigay ng personal na impormasyong nakalap sa pamamagitang ng elektonik ay para lamang sa layunin na ibinigay sa amin. '),S(53,"br")(54,"br"),u(55," Ang Estado ay maaaring magbigay o mamigay ng partikular na listahan at mga ulat na istatistikal na may pinapangasiwaang impormasyon na tulad ng nakasaad sa batas, subalit walang personal na impormasyon ang ibebenta or ipamimigay at lahat ng naaangkop na legal na proteksyon ay iiral pa rin sa mga website ng Estado. "),S(56,"br")(57,"br")(58,"hr"),c(59,"h4",13),u(60,"Ano ang Mangyayari Sa Impormasyong Ibinigay Ninyo Sa Amin"),l(),u(61," Kung pinili ninyong magbigay sa amin ng impormasyon, ang impormasyon ay ipapadaan sa isang mapagkakatiwalaang linya sa aming database na pangsangay. Anumang pribadong impormasyon ay gagamitin lamang sa layunin kung kung bakit ito ibinigay at hindi ipapamahagi sa ibang samahan maliban na lang kung nakasaad sa batas. Mangyari lamang na basahin ang aming Patakaran ng Paglilihim para sa karagdagang impormasyon. "),S(62,"br")(63,"br")(64,"hr"),c(65,"h4",14),u(66,"Paggamit ng Internet Request para sa Assistance Form Information"),l(),u(67," Anumang impormasyon na ibibigay ninyo sa amin ay maipapamahagi lamang sa ibang grupo na kasama sa iyong kaso kung kinakailangan. Ang impormasyong iyong ibinigay ay maaaring isama sa ibang impormasyon ng mga kustomer para magamit sa ulat pang-istatistikal, pagsasaayos ng datos, at/o mga masusing pagsisiyasat. Halimbawa, maaaring kailanganin naming magpanatili ng impormasyon para mapalakas ang puwersa ng isang kaso o reklamo para sa itinakdang oras bago magsara ang kaso. "),S(68,"br")(69,"br"),u(70," Kung ikaw ay nagbigay sa amin ng impormasyon tungkol sa isang isyu na hindi sakop ng aming hurisdiksyon, maaari naming isangguni ang iyong impormasyon sa tamang lokal, estado, o federal na ahensiya para sa inyo. "),S(71,"br")(72,"br")(73,"hr"),c(74,"h4",15),u(75,"Mga Sarbey"),l(),u(76," Kung sa iyong pagbisita sa website ng Estado ikaw ay sumali sa isang survey o nagpadala ng e-mail, ang mga karagdagang sumusunod na impormasyon ay makakakalap: "),S(77,"br")(78,"br"),c(79,"ol")(80,"li"),u(81,"Ang e-mail address at mga nilalaman ng e-mail; at"),l(),c(82,"li"),u(83,"Ang kusang loob na ibinigay na impormasyon bilang pagtugon sa survey."),l()(),u(84," Ang impormasyong nakalap ay hindi limitado sa text characters at maaaring may kasamang audio, video, at graphic information formats na ipinadala ninyo sa amin. "),S(85,"br")(86,"br"),u(87," Ang impormasyon ay pananatilihin ayon sa Government Code \xa7 11015.5. "),S(88,"br")(89,"br")(90,"hr"),c(91,"h4",16),u(92,"Kung magpapadala kayo ng E-mail sa amin"),l(),u(93," Maaaring piliin mong padalhan kami ng personal na impormasyon, tulad ng e-mail na may komentaryo o tanong. Ginagamit namin ang impormasyon para mapabuti ang aming serbisyo sa inyo o sagutin ang iyong mga tanong o upang tugunan ang inyong kahilingan. Kung minsan ipinapadala namin ang iyong e-mail sa ibang empleyado ng Estado na mas makakatulong sa iyo, at ang empleyadong ito ay maaaring nagtatrabaho sa ibang ahensiya sa loob ng Estado. Maliban sa awtorisadong mga imbestigasyon ng mga alagad ng batas o hinihiling ng batas, hindi namin ipinamamahagi ang aming e-mail sa anumang ibang organisasyon. "),S(94,"br")(95,"br"),u(96," Ginagamit namin ang iyong e-mail para makatugon ng naaangkop. Ito ay upang maaaring tumugon sa inyo, tugunan ang mga isyu ng iyong pakakakilanlan, upang mapabuti ang aming website, o upang ipadala ang e-mail sa ibang ahensiya para sa naaangkop na aksyon. "),S(97,"hr"),c(98,"h4",17),u(99,"Mga Order Forms"),l(),u(100," Kung oorder kayo sa amin, humihingi kami ng impormasyon sa gumagamit sa aming order form. Ang gumagamit ay kailangan magbigay ng mga impormasyon kung paano maaaring makontak (tulad ng pangalan at kung saan maaaring maipadala ang inorder) at mga impormasong pinansyal (tulad ng numero ng credit card, at petsa kung hanggang kailan maaaring magamit). Ang impormasyong ito ay para sa layunin ng paniningil at para matugunan ang inyong order/hiling. Kung kami ay may problema sa pagproseso ng order, ang impormasyong ito ang gagamitin upang makipag-ugnayan sa inyo. "),S(101,"br")(102,"br")(103,"hr"),c(104,"h4",18),u(105,"Pagbubunyag sa Publiko"),l(),u(106," Sa Estado ng California, ang mga batas ay umiiral upang siguraduhing bukas ang gobyerno at sinuman sa publiko ay maaaring makita ang mga record o dokumento at impormasyong nasa estado ng gobyerno. Gayunpaman, may mga ibinubukod sa karapatan ng publiko na makita ang ibang impormasyon. Ang mga ibinubukod ito ay ginagamit sa iba't-ibang pangangailangan kasama ang pagpapanatili ng paglilihim ng mga indibidwal. Kapwa nagbibigay ng mga ibinubukod ang batas ng estado at batas federal. "),S(107,"br")(108,"br"),u(109," Lahat ng impormasyon na nakalap sa site na ito ay nagiging pagmamay-ari ng pampublikong talaan na maaaring sumailalim sa pagsusuri at pagkopya ng publiko, maliban na lang kung may di pagsama ng isang batas na ipinapatupad. Kung sakaling mang may salungatan sa Patakaran ng Paggamit at ng Public Records Act, ang Information Practices Act o ibang mga batas na nangangasiwa sa pagbubunyag ng mga rekord, the Public Records Act, ang Information Practices Act o iba pang naaangkop na batas ang mangtatakda. "),S(110,"br")(111,"br")(112,"hr"),c(113,"h4",19),u(114,"Personal na Impormasyon"),l(),u(115," Sa ilalim ng Government Code \xa7 11015.5, maaari mong ipatanggal ang anumang personal na impormasyon na nakuha sa iyo nang walang paggamit at pamamahagi, sa kondisyon na kayo ay makipag-ugnayan sa amin nang maagap. "),S(116,"br")(117,"br")(118,"hr"),c(119,"h4",20),u(120,"Awtomatikong Pangangalap ng Impormasyon/ Cookies"),l(),u(121," Ang mga cookies ay mga simpleng text files na nakaimbak sa iyong computer sa tulong ng iyong web browser. Ang pangunahing portal ng Estado ay hindi gumagamit ng cookies para mapangalagaan ang personalisasyon, gayunman maaaring ginagamit ito ng ibang sangay. "),S(122,"br")(123,"br"),u(124," Nagsisikap ang Estado upang makaiwas sa paggamit ng cookies. Kapag kinakailangang pangalagaan ang paggamit ng aplikasyon, hindi katulad ng pangkaraniwang gamit ng cookies, ang Estado ay gumagamit lamang ng cookies sa panahon na ikaw ay gagamit sa aming application na interactive. "),S(125,"br")(126,"br"),u(127," Ang mga cookies na malilikha sa iyong computer sa paggamit sa website na ito ay walang \u201cpersonal na impormasyon\u201d at hindi nalalagay sa panganib ang iyong paglilihim o seguridad. Ginagamit namin ang cookie upang mai-imbak ang sapalarang-nalilikhang pansamantalang tag sa pagkakakilanlan (randomly generated identifying temporary tag) sa iyong computer. Maaari mong tanggihan ang cookie o burahin ang cookie file sa iyong computer sa pamamagitan ng anumang kilalang pamamaraang magagamit. Gayunman, kung nakapatay ang iyong cookie option posibleng hindi mo magamit ang ibang features ng iyong aplikasyon na interactive. "),S(128,"br")(129,"br")(130,"hr"),c(131,"h4",21),u(132,"Seguridad"),l(),u(133," Ang Estado, bilang tagalikha at tagapamahala ng website na ito, ay gumawa ng mga hakbangin upang siguraduhin ang integridad ng kanyang telecommunication at sistema ng pagkocompute (computing intrastructure), kasama ngunit hindi limitado sa pagpapatunay, pagsubayay, pagkuwenta at encryption. Kasama sa disenyo ang mga hakbanging pang-seguridad, implementasyon at pang-araw-araw na gawain ng buong operasyon ng Estado bilang bahagi ng patuloy na pagtupad sa mga pangako sa pagkontrol sa anumang problema. Ang impormasyon ay di dapat ipakahulugang sa anumang pamamaraang na pagbibigay ng negosyo, legal o iba pang pagpapayo, o garantiyang na ito ay di masisira, ang seguridad ng impormasyong ibinigay sa pamamagitan ng website na suportado ng Estado. Ang mga teknikal na pamantayan na namamahala ng seguridad ay ipinapatupad ng Department of Information Technology. "),S(134,"br")(135,"br")(136,"hr"),c(137,"h4",22),u(138,"Link sa mga Ibang Site"),l(),u(139," Ang aming website ay may koneksyon sa ibang site na alam naming makakatulong sa iyo at makakapagbigay serbisyo. Kapag ikaw ay kumunekta sa ibang site, ikaw ay wala na sa aming site at ikaw ay nasa ilalim na ng patakaran ng paglilihim ng bagong site. "),S(140,"br")(141,"br"),u(142," Ang website na ito at ang impormasyon na nilalaman dito ay inilalaan bilang serbisyong pampubliko ng Estado ng California. Ang system na ito ay minomonitor upang siguraduhing maayos ang operasyon, upang malaman ang naaangkop na mga tampok na pang-seguridad, at para maipaghambing sa iba. Ang sinumang gumagamit sa sistemang ito ay nagbibigay pahintulot sa naturang pagmomonitor. Ang walang pahintulot na pagsubok upang baguhin ang anumang impormasyon na nakaimbak sa sistema, upang mapawalang bisa ang mga tampok na pang-seguridad, o para gamitin ang sistema para sa ibang bagay, maliban sa tunay na layunin nito, ay ipinagbabawal at maaaring magresulta sa isang kriminal na pag-uusig. "),S(143,"br")(144,"br")(145,"hr"),c(146,"h4",23),u(147,"Limitasyon ng Pananagutan"),l(),u(148," Nagsisikap ang Estado upang mapanatili ang pinakawastong nilalaman ng website. Ang numang mga pagkakamali o pagkukulang ay dapat ipagbigay alam para sa masusing pagsusuri. "),S(149,"br")(150,"br"),u(151," Ang Estado ay hindi nag-aangkin, nangangako o nagbibigay garantiya tungkol sa tiyak na kawastuhan, kakumpletuhan, o kasapatan ng nilalaman ng website na ito at hayagang itinatanggi ang anuman pananagutan sa mga pagkakamali o pagkukulang ng mga nilalaman ng website na ito. Walang warranty ng anumang uri, pahiwatig man, hayagan o ayon sa batas, kasama ang pero hindi limitado sa mga warantiya ng di paglabag ng karapatan ng ikatlong partido, titulo, kakayahan ipangalakal, kasapatan para sa isang partikular na layunin at proteksiyon mula sa mga computer virus, ay ibinibigay ayon sa nilalaman ng website na ito o ang mga hyperlink sa ibang Internet resources. Ang pagtukoy sa website na ito sa anumang partikular na produktong pangkomersyal, proseso, or mga serbisyo, o paggamit ng anumang kalakalan, pangalan ng kumpanya o korporasyon ay para sa impormasyon at kaginhawaan ng publiko, at hindi nangangahulugan ng pag-eendorso, rekomendasyon, or kapaboran sa Estado ng California, o ng kanilang mga empleyado at mga ahente. "),S(152,"br")(153,"br"),u(154," Ang Polisiya sa Paggamit ay magbago ng walang paunang paalala. "),S(155,"br")(156,"br")(157,"hr"),c(158,"h4",24),u(159,"Pagmamay-ari"),l(),u(160," Sa pangkalahatan, ang mga impormasyon na ipinapakita sa website, maliban kung nakasaad, ay tinuturing na pampubliko. Maaari itong ipamigay o kopyahin tulad ng pagpapahintulot ng batas. Gayunman, ang Estado ay hindi gumagamit ng mga datos na saklaw ng karapatang-kopya (tulad ng mga litrato) na nangangailangan ng karagdagang pagpapahintulot bago mo magamit. Dagdag dito, ang katangitanging branding ng site ang iba't-ibang mga opisyal na selyo at marka ay hindi maaaring gamiting ng walang pahintulot ng Estado. Upang makagamit ng anumang impormasyon sa website na ito na hindi pagmamay-ari o gawa ng Estado, kailangan mong humingi ng pahintulot nang direkta sa nagmamay-ari o pinanggalingan ng impormasyon. Ang Estado ay may walang-limitasyong karapatan na gamitin sa anuman layunin, ng walang bayad, lahat ng mga impormasyong pinadala sa site na ito maliban sa mga ipinadala na gawa sa ilalim ng ibang ligal na kontrata o kasunduan. Malayang makakagamit ang Estado, para sa anumang layunin, anumang ideya, konsepto, o mga pamamaraan na nilalaman ng impormasyong ibinibigay ng website na ito. "),S(161,"br")(162,"br"),l())}let vdt=(()=>{class e{constructor(t,i,o,r,a,s,d){this.title=t,this.utils=i,this.router=o,this._global=a,this.activatedRoute=s,this.translate=d,this.Notification=r}ngOnInit(){}ngAfterViewInit(){}goToLink(t){this.utils.scrollToID(t)}static{this.\u0275fac=function(i){return new(i||e)(ge($r),ge(vr),ge(hi),ge(ur),ge(Wo),ge(zs),ge(zi))}}static{this.\u0275cmp=vt({type:e,selectors:[["app-conditionsofuse"]],standalone:!1,decls:68,vars:13,consts:[[1,"py-3"],[1,"container"],[3,"ngSwitch"],[4,"ngSwitchDefault"],[4,"ngSwitchCase"],[1,"row","mt-3"],[1,"col-md-6"],[1,"mb-2"],["translate","",3,"click"],[1,"text-custom-blue"],["id","link_1",1,"text-custom-blue"],["id","link_2",1,"text-custom-blue"],["id","link_3",1,"text-custom-blue"],["id","link_4",1,"text-custom-blue"],["id","link_5",1,"text-custom-blue"],["id","link_6",1,"text-custom-blue"],["id","link_7",1,"text-custom-blue"],["id","link_8",1,"text-custom-blue"],["id","link_9",1,"text-custom-blue"],["id","link_10",1,"text-custom-blue"],["id","link_11",1,"text-custom-blue"],["id","link_12",1,"text-custom-blue"],["id","link_13",1,"text-custom-blue"],["id","link_14",1,"text-custom-blue"],["id","link_15",1,"text-custom-blue"]],template:function(i,o){1&i&&(c(0,"section",0)(1,"div",1)(2,"div",2),ee(3,sdt,7,0,"div",3)(4,udt,7,0,"div",4)(5,ldt,7,0,"div",4)(6,cdt,7,0,"div",4)(7,ddt,7,0,"div",4)(8,pdt,7,0,"div",4)(9,hdt,7,0,"div",4),c(10,"div",5)(11,"div",6)(12,"ul",7)(13,"li",7)(14,"a",8),de("click",function(){return o.goToLink("link_1")}),u(15,"Personal Information and Choice"),l()(),c(16,"li",7)(17,"a",8),de("click",function(){return o.goToLink("link_2")}),u(18,"A Special Note about Children"),l()(),c(19,"li",7)(20,"a",8),de("click",function(){return o.goToLink("link_3")}),u(21,"Information Collected and How it is Used"),l()(),c(22,"li",7)(23,"a",8),de("click",function(){return o.goToLink("link_4")}),u(24,"What Happens to Information You Submit to Us"),l()(),c(25,"li",7)(26,"a",8),de("click",function(){return o.goToLink("link_5")}),u(27,"Use of Internet Request for Assistance Form Information"),l()(),c(28,"li",7)(29,"a",8),de("click",function(){return o.goToLink("link_6")}),u(30,"Surveys"),l()(),c(31,"li",7)(32,"a",8),de("click",function(){return o.goToLink("link_7")}),u(33,"If you send us E-Mail"),l()(),c(34,"li",7)(35,"a",8),de("click",function(){return o.goToLink("link_8")}),u(36,"Order Forms"),l()()()(),c(37,"div",6)(38,"ul",7)(39,"li",7)(40,"a",8),de("click",function(){return o.goToLink("link_9")}),u(41,"Public Disclosure"),l()(),c(42,"li",7)(43,"a",8),de("click",function(){return o.goToLink("link_10")}),u(44,"Personal Information"),l()(),c(45,"li",7)(46,"a",8),de("click",function(){return o.goToLink("link_11")}),u(47,"Automatic Collection of Information/Cookies"),l()(),c(48,"li",7)(49,"a",8),de("click",function(){return o.goToLink("link_12")}),u(50,"Security"),l()(),c(51,"li",7)(52,"a",8),de("click",function(){return o.goToLink("link_13")}),u(53,"Links to Other Sites"),l()(),c(54,"li",7)(55,"a",8),de("click",function(){return o.goToLink("link_14")}),u(56,"Limitation of Liability"),l()(),c(57,"li",7)(58,"a",8),de("click",function(){return o.goToLink("link_15")}),u(59,"Ownership"),l()()()()(),S(60,"hr"),ee(61,fdt,169,0,"div",3)(62,gdt,163,0,"div",4)(63,mdt,163,0,"div",4)(64,bdt,161,0,"div",4)(65,Cdt,163,0,"div",4)(66,_dt,163,0,"div",4)(67,Mdt,163,0,"div",4),l()()()),2&i&&(g(2),m("ngSwitch",o.translate.currentLang),g(2),m("ngSwitchCase","es"),g(),m("ngSwitchCase","zh"),g(),m("ngSwitchCase","ko"),g(),m("ngSwitchCase","ja"),g(),m("ngSwitchCase","vi"),g(),m("ngSwitchCase","tl"),g(53),m("ngSwitchCase","es"),g(),m("ngSwitchCase","zh"),g(),m("ngSwitchCase","ko"),g(),m("ngSwitchCase","ja"),g(),m("ngSwitchCase","vi"),g(),m("ngSwitchCase","tl"))},dependencies:[Po,rr,za,Zn],encapsulation:2})}}return e})();function Adt(e,n){1&e&&(c(0,"div"),u(1," Beginning July 1, 2009, new applicants for the California LifeLine home phone discounts must be approved before the California LifeLine discounts are received. If you apply to be in California LifeLine, you will pay the regular rates for basic home phone service until your application is approved. Please be sure to ask the home phone company what the charges are so you will be aware of these rates and fees. "),S(2,"br")(3,"br"),u(4," To help you pay the up-front costs of establishing your home phone service such as the service installation/connection fee, service conversion fee, and deposits, you can request to be placed on an interest-free payment plan. This will spread out your payments in more manageable amounts while you wait for your eligibility to be approved for California LifeLine. Payment plans can vary between the different home phone companies. "),S(5,"br")(6,"br"),u(7," After being approved by the California LifeLine Administrator you will be refunded the difference between the regular rates and the California LifeLine discounted rates for any applicable monthly service charges, service installation/connection fee, service conversion fee, and deposits for basic home phone service. "),S(8,"br")(9,"br"),u(10," You will receive a bill credit with the California LifeLine discounts retroactive to the date your service began or the date you requested to be enrolled, whichever is later. If your bill has a net credit balance of $10.00 or more, you may request a refund check from your home phone company. Otherwise, the refund will be a credit on your account. "),l())}function ydt(e,n){1&e&&(c(0,"div"),u(1," Desde el 1 de Julio del 2009, los nuevos solicitantes de California LifeLine descuento para tel\xe9fono de casa deben ser aprobados antes de comenzar a recibir los descuentos de California LifeLine. Si env\xeda la solicitud para el programa de California LifeLine, usted pagar\xe1 las tarifas regulares del servicio telef\xf3nico b\xe1sico hasta que su solicitud sea aprobada. Aseg\xfarese de preguntarle a su compa\xf1\xeda de tel\xe9fono de casa cu\xe1les ser\xe1n los cargos de su tarifa. "),S(2,"br")(3,"br"),u(4," Para ayudarlo a pagar el costo inicial de instalaci\xf3n de su servicio telef\xf3nico, como el cargo de conexi\xf3n/instalaci\xf3n de servicios, el cargo de conversi\xf3n de servicios y los dep\xf3sitos, puede solicitar un plan de pagos sin inter\xe9s. Esto le permitir\xe1 distribuir sus pagos en montos m\xe1s manejables, mientras usted espera ser aprobado en el programa de California LifeLine. Los planes de pago pueden variar entre las diferentes compa\xf1\xedas telef\xf3nicas. "),S(5,"br")(6,"br"),u(7," Luego de ser aprobado por el administrador de California LifeLine, se le reembolsar\xe1n la diferencia entre la tarifa habitual y la tarifa de descuento de California LifeLine por todos los cargos aplicables de servicios mensuales, el cargo de conexi\xf3n/instalaci\xf3n de servicios, el cargo de conversi\xf3n de servicios y los dep\xf3sitos para el servicio telef\xf3nico b\xe1sico. "),S(8,"br")(9,"br"),u(10," Recibir\xe1 un cr\xe9dito en su factura con los descuentos del programa California LifeLine retroactivo a la fecha en que comenz\xf3 su servicio o a la fecha en que solicit\xf3 la inscripci\xf3n, la que sea m\xe1s reciente. Si su factura tiene un saldo de cr\xe9dito neto de $10.00 o m\xe1s, puede solicitarle a su compa\xf1\xeda telef\xf3nica un cheque de reembolso. De lo contrario, el reembolso figurar\xe1 en su cuenta como un cr\xe9dito. "),l())}function Edt(e,n){1&e&&(c(0,"div"),u(1," \u81ea 2009 \u5e74\u4e03\u6708 1 \u65e5\u8d77\uff0c\u52a0\u5dde\u666e\u6fdf\u5bb6\u5ead\u96fb\u8a71\u6298\u6263\u670d\u52d9\u8a08\u5283\u7684\u65b0\u7533\u8acb\u8005\u5fc5\u9808\u5148\u7372\u5f97\u6838\u51c6\uff0c\u624d\u80fd\u4eab\u6709\u52a0\u5dde\u666e\u6fdf\u96fb\u8a71\u670d\u52d9\u6298\u6263\u3002 \u82e5\u60a8\u7533\u8acb\u52a0\u5165\u52a0\u5dde\u666e\u6fdf\u96fb\u8a71\u670d\u52d9\uff0c\u5728\u7533\u8acb\u6838\u51c6\u4e4b\u524d\uff0c\u9700\u6309\u7167\u4e00\u822c\u8cbb\u7387\u652f\u4ed8\u57fa\u672c\u5bb6\u5ead\u96fb\u8a71\u670d\u52d9\u3002 \u8acb\u52d9\u5fc5\u8a62\u554f\u5bb6\u5ead\u96fb\u8a71\u516c\u53f8\u6709\u95dc\u9019\u4e9b\u8cbb\u7387\u8207\u8cbb\u7528\u7684\u8a73\u7d30\u6536\u8cbb\u3002 \u70ba\u4e86\u5e6b\u52a9\u60a8\u652f\u4ed8\u67b6\u8a2d\u5bb6\u5ead\u96fb\u8a71\u670d\u52d9\u6240\u9700\u7684\u524d\u7f6e\u8cbb\u7528\uff0c\u4f8b\u5982\u670d\u52d9\u5b89\u88dd/\u9023\u7dda\u8cbb\u3001\u670d\u52d9\u8f49\u63db\u8cbb\u8207\u62bc\u91d1\uff0c\u60a8\u53ef\u4ee5\u8981\u6c42\u52a0\u5165\u514d\u606f\u4ed8\u6b3e\u8a08\u5283\u3002 \u9019\u6a23\u5728\u60a8\u7b49\u5f85\u52a0\u5dde\u666e\u6fdf\u96fb\u8a71\u670d\u52d9\u6838\u51c6\u7684\u671f\u9593\uff0c\u53ef\u4ee5\u8f03\u4f4e\u7684\u50f9\u683c\u5206\u671f\u652f\u4ed8\u8a72\u6b3e\u9805\u3002 \u4ed8\u6b3e\u8a08\u5283\u8996\u5404\u5bb6\u7528\u96fb\u8a71\u516c\u53f8\u800c\u6709\u6240\u4e0d\u540c\u3002\u7372\u5f97\u52a0\u5dde\u666e\u6fdf\u96fb\u8a71\u670d\u52d9\u7ba1\u7406\u54e1\u7684\u6838\u51c6\u5f8c\uff0c \u60a8\u53ef\u7372\u5f97\u9000\u8fd8\u4efb\u4f55\u9069\u7528\u4e4b\u6708\u79df\u8cbb\u3001\u670d\u52d9\u5b89\u88dd/\u9023\u7dda\u8cbb\u3001\u670d\u52d9\u8f49\u63db\u8cbb\u8207\u57fa\u672c\u5bb6\u5ead\u96fb\u8a71\u670d\u52d9\u62bc\u91d1\u7684\u4e00\u822c\u8cbb\u7387\u8207\u52a0\u5dde\u666e\u6fdf\u96fb\u8a71\u670d\u52d9\u6298\u6263\u8cbb\u7387\u9593\u7684\u5dee\u984d\u3002\u60a8\u53ef\u7372\u5f97\u7684\u52a0\u5dde\u666e\u6fdf\u96fb\u8a71\u670d\u52d9\u6298\u6263\u5c07\u56de\u6eaf\u81f3\u670d\u52d9\u958b\u59cb\u4e4b\u65e5\u6216\u60a8\u8981\u6c42\u52a0\u5165\u7576\u65e5\uff08\u4ee5\u8f03\u5f8c\u8005\u70ba\u6e96\uff09\u3002 \u82e5\u6de8\u7d50\u5b58\u91d1\u984d\u5728 10 \u7f8e\u5143\u6216\u4ee5\u4e0a\uff0c\u60a8\u53ef\u5411\u6240\u5728\u5bb6\u5ead\u96fb\u8a71\u516c\u53f8\u7533\u8acb\u9000\u6b3e\u652f\u7968\u3002 \u5426\u5247\uff0c\u8a72\u7b46\u9000\u6b3e\u5c07\u76f4\u63a5\u8a08\u5165\u60a8\u7684\u5e33\u6236\u3002 "),l())}function Odt(e,n){1&e&&(c(0,"div"),u(1," 2009\ub144 7\uc6d4 1\uc77c\ubd80\ud130 \uce98\ub9ac\ud3ec\ub2c8\uc544 \ub77c\uc774\ud504\ub77c\uc778 \uc9d1 \uc804\ud654 \ud560\uc778 \ud504\ub85c\uadf8\ub7a8\uc5d0 \ub300\ud55c \uc0c8\ub85c\uc6b4 \uc2e0\uccad\uc790\ub294 \ubc18\ub4dc\uc2dc \uba3c\uc800 \uc2b9\uc778\uc744 \ubc1b\uc544\uc57c \uce98\ub9ac\ud3ec\ub2c8\uc544 \ub77c\uc774\ud504\ub77c\uc778 \ud560\uc778\uc744 \ubc1b\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uce98\ub9ac\ud3ec\ub2c8\uc544 \ub77c\uc774\ud504\ub77c\uc778\uc5d0 \uc2e0\uccad\ud574\ub3c4 \uc2e0\uccad\uc774 \uc2b9\uc778\ub420 \ub54c\uae4c\uc9c0\ub294 \uc9d1 \uc804\ud654 \uae30\ubcf8 \uc11c\ube44\uc2a4\uc5d0 \ub300\ud55c \uc77c\ubc18 \uc694\uae08\uc744 \ub0a9\ubd80\ud558\uc2dc\uac8c \ub429\ub2c8\ub2e4. \uae30\ubcf8 \uc694\uae08 \ubc0f \uc218\uc218\ub8cc\uc5d0 \ub300\ud574 \ubbf8\ub9ac \ud30c\uc545\ud560 \uc218 \uc788\ub3c4\ub85d \uc9d1 \uc804\ud654 \ud68c\uc0ac\uc5d0 \ubb38\uc758\ud558\uc2ed\uc2dc\uc624. "),S(2,"br")(3,"br"),u(4," \uc11c\ube44\uc2a4 \uc124\uce58/\uc5f0\uacb0 \ube44\uc6a9, \uc11c\ube44\uc2a4 \uc804\ud658 \uc218\uc218\ub8cc, \ubcf4\uc99d\uae08 \ub4f1\uacfc \uac19\uc740 \uc9d1 \uc804\ud654 \uc11c\ube44\uc2a4\ub97c \uad6c\ucd95 \ud558\ub294 \uc120\ud589 \ube44\uc6a9 \uc5d0 \ub300\ud574 \ub3c4\uc6c0\uc774 \ub418\ub294 \ubb34\uc774\uc790 \uc9c0\ubd88 \uacc4\ud68d\uc744 \uc2e0\uccad\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uadf8\ub798\uc11c \uce98\ub9ac\ud3ec\ub2c8\uc544 \ub77c\uc774\ud504\ub77c\uc778\uc758 \uac00\uc785 \uc790\uaca9 \uc2b9\uc778\uc744 \ubc1b\uc744 \ub54c\uae4c\uc9c0 \uc804\ud654 \uc694\uae08 \uc9c0\ubd88\uc744 \ub354 \ud3b8\ub9ac\ud558\uac8c \uc870\uc808\ud560 \uc218 \uc788\uc744 \uac83\uc785\ub2c8\ub2e4. \uc9c0\ubd88 \uacc4\ud68d\uc740 \uc9d1 \uc804\ud654 \ud68c\uc0ac\ub9c8\ub2e4 \ub2e4\ub97c \uc218 \uc788\uc2b5\ub2c8\ub2e4. "),S(5,"br")(6,"br"),u(7," \uce98\ub9ac\ud3ec\ub2c8\uc544 \ub77c\uc774\ud504\ub77c\uc778 \uad00\ub9ac\uc790\ub85c\ubd80\ud130 \uc2b9\uc778\uc744 \ubc1b\uc740 \ud6c4\uc5d0\ub294 \ud574\ub2f9 \uc6d4\ub0a9 \uc11c\ube44\uc2a4 \uc694\uae08, \uc11c\ube44\uc2a4 \uc124\uce58/\uc5f0\uacb0 \uc218\uc218\ub8cc, \uc11c\ube44\uc2a4 \uc804\ud658 \uc218\uc218\ub8cc, \uc9d1 \uc804\ud654 \uae30\ubcf8 \uc11c\ube44\uc2a4 \ubcf4\uc99d\uae08 \ub4f1\uc5d0 \ub300\ud574 \uc77c\ubc18 \uc694\uae08\uacfc \uce98\ub9ac\ud3ec\ub2c8\uc544 \ub77c\uc774\ud504\ub77c\uc778 \ud560\uc778 \uc694\uae08 \uc0ac\uc774\uc758 \ucc28\uc561\uc744 \ud658\ubd88\ubc1b\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. "),S(8,"br")(9,"br"),u(10," \uc11c\ube44\uc2a4\uac00 \uc2dc\uc791\ub41c \ub0a0\uc9dc \ub610\ub294 \ub4f1\ub85d\uc744 \uc2e0\uccad\ud55c \ub0a0\uc9dc\uc911\uc5d0\uc11c \ub098\uc911\uc744 \uae30\uc900\uc73c\ub85c \uce98\ub9ac\ud3ec\ub2c8\uc544 \ub77c\uc774\ud504\ub77c\uc778 \ud560\uc778 \uae08\uc561\uc744 \uc18c\uae09 \uc801\uc6a9\ud55c \uae08\uc561\uc744 \ud06c\ub808\ub527\uc73c\ub85c \ud658\ubd88\ubc1b\uac8c \ub429\ub2c8\ub2e4. \uccad\uad6c\uc11c\uc5d0 10 \ub2ec\ub7ec \uc774\uc0c1\uc758 \ub300\ubcc0 \uc21c\uc794\uc561\uc774 \uc788\ub294 \uacbd\uc6b0\uc5d0\ub294 \uadc0\ud558\uc758 \uc9d1 \uc804\ud654 \ud68c\uc0ac\uc5d0 \ud658\ubd88 \uc218\ud45c\ub97c \uc694\uad6c\ud558\uc2e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uadf8\ub807\uc9c0 \uc54a\uc73c\uba74 \ud658\ubd88\uc561\uc740 \uadc0\ud558\uc758 \uacc4\uc815\uc5d0 \ud06c\ub808\ub527\uc73c\ub85c \ub098\ud0c0\ub0a0 \uac83\uc785\ub2c8\ub2e4. "),l())}function Ddt(e,n){1&e&&(c(0,"div"),u(1," 2009\u5e747\u67081\u65e5\u4ee5\u964d\u3001\u30ab\u30ea\u30d5\u30a9\u30eb\u30cb\u30a2\u30fb\u30e9\u30a4\u30d5\u30e9\u30a4\u30f3\u81ea\u5b85\u306e\u96fb\u8a71\u5272\u5f15\u3078\u306e\u65b0\u898f\u7533\u8fbc\u8005\u306f\u3001\u627f\u8a8d\u3092\u5f97\u3066\u304b\u3089\u30ab\u30ea\u30d5\u30a9\u30eb\u30cb\u30a2\u30fb\u30e9\u30a4\u30d5\u30e9\u30a4\u30f3\u5272\u5f15\u3092\u53d7\u3051\u308b\u3053\u3068\u306b\u306a\u308a\u307e\u3059\u3002 "),S(2,"br")(3,"br"),u(4," \u30ab\u30ea\u30d5\u30a9\u30eb\u30cb\u30a2\u30fb\u30e9\u30a4\u30d5\u30e9\u30a4\u30f3\u306b\u767b\u9332\u3055\u308c\u3066\u3082\u3001\u7533\u8fbc\u307f\u304c\u627f\u8a8d\u3055\u308c\u308b\u307e\u3067\u306f\u3001\u901a\u5e38\u306e\u57fa\u672c\u901a\u8a71\u6599\u3092\u304a\u652f\u6255\u3044\u3044\u305f\u3060\u304f\u3053\u3068\u306b\u306a\u308a\u307e\u3059\u3002 \u5fc5\u305a\u96fb\u8a71\u4f1a\u793e\u306b\u304a\u554f\u3044\u5408\u308f\u305b\u306e\u4e0a\u3001\u901a\u5e38\u306e\u6599\u91d1\u30fb\u624b\u6570\u6599\u3092\u3054\u78ba\u8a8d\u304f\u3060\u3055\u3044\u3002\u56de\u7dda\u8a2d\u7f6e\u30fb\u63a5\u7d9a\u6599\u91d1\u3001\u56de\u7dda\u5207\u66ff\u6599\u91d1\u3001\u9810\u5165\u91d1\u3068\u3044\u3063\u305f\u3001\u96fb\u8a71\u6577\u8a2d\u6642\u306e\u524d\u6255\u3044\u91d1\u3092\u6255\u3044\u3084\u3059\u304f\u3059\u308b\u305f\u3081\u306b\u3001\u7121\u5229\u5b50\u652f\u6255\u3044\u30d7\u30e9\u30f3\u3078\u306e\u767b\u9332\u3092\u7533\u3057\u8fbc\u3080\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002 "),S(5,"br")(6,"br"),u(7," \u3053\u3046\u3059\u308b\u3053\u3068\u3067\u3001\u30ab\u30ea\u30d5\u30a9\u30eb\u30cb\u30a2\u30fb\u30e9\u30a4\u30d5\u30e9\u30a4\u30f3\u306e\u8cc7\u683c\u627f\u8a8d\u3092\u5f85\u3064\u9593\u306b\u3001\u652f\u6255\u3044\u3092\u5c0f\u984d\u306b\u5206\u5272\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002 \u652f\u6255\u3044\u30d7\u30e9\u30f3\u306f\u96fb\u8a71\u4f1a\u793e\u3088\u308a\u69d8\u3005\u3067\u3059\u3002\u30ab\u30ea\u30d5\u30a9\u30eb\u30cb\u30a2\u30fb\u30e9\u30a4\u30d5\u30e9\u30a4\u30f3\u7ba1\u7406\u5c40\u304b\u3089\u627f\u8a8d\u3055\u308c\u305f\u5f8c\u306b\u3001\u8a72\u5f53\u3059\u308b\u6708\u984d\u5229\u7528\u6599\u3001\u56de\u7dda\u8a2d\u7f6e\u30fb\u63a5\u7d9a\u6599\u91d1\u3001\u56de\u7dda\u5207\u66ff\u6599\u91d1\u3001\u57fa\u672c\u96fb\u8a71\u6599\u91d1\u306e\u9810\u5165\u91d1\u306b\u5bfe\u3057\u3066\u3001\u901a\u5e38\u6599\u91d1\u3068\u30ab\u30ea\u30d5\u30a9\u30eb\u30cb\u30a2\u30fb\u30e9\u30a4\u30d5\u30e9\u30a4\u30f3\u5272\u5f15\u6599\u91d1\u3068\u306e\u5dee\u984d\u304c\u304a\u5ba2\u69d8\u306b\u8fd4\u91d1\u3055\u308c\u307e\u3059\u3002\u304a\u5ba2\u69d8\u306f\u3001\u901a\u8a71\u30b5\u30fc\u30d3\u30b9\u958b\u59cb\u65e5\u307e\u305f\u306f\u767b\u9332\u7533\u8acb\u65e5\u306e\u3044\u305a\u308c\u304b\u9045\u3044\u65b9\u306e\u65e5\u4ed8\u306b\u9061\u3063\u3066\u3001\u30ab\u30ea\u30d5\u30a9\u30eb\u30cb\u30a2\u30fb\u30e9\u30a4\u30d5\u30e9\u30a4\u30f3\u5272\u5f15\u306b\u5bfe\u3059\u308b\u624b\u5f62\u4fe1\u7528\u3092\u53d7\u3051\u308b\u3053\u3068\u306b\u306a\u308a\u307e\u3059\u3002 "),S(8,"br")(9,"br"),u(10," 10\u30c9\u30eb\u4ee5\u4e0a\u306e\u7d14\u8cb8\u51fa\u6b8b\u9ad8\u304c\u3042\u308b\u5834\u5408\u306f\u3001\u96fb\u8a71\u4f1a\u793e\u306b\u5bfe\u3057\u3066\u6255\u623b\u5c0f\u5207\u624b\u3092\u8acb\u6c42\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002 \u305d\u306e\u4ed6\u306e\u5834\u5408\u306f\u3001\u8fd4\u91d1\u5206\u304c\u53e3\u5ea7\u306b\u8cb8\u65b9\u3068\u3057\u3066\u793a\u3055\u308c\u307e\u3059\u3002 "),l())}function wdt(e,n){1&e&&(c(0,"div"),u(1," B\u1eaft \u0111\u1ea7u t\u1eeb ng\xe0y 01/ 7/ 2009, nh\u1eefng ng\u01b0\u1eddi \u0111\u0103ng k\xfd m\u1edbi tham gia \u0110i\u1ec7n tho\u1ea1i nh\xe0 gi\xe1 b\xecnh d\xe2n California ph\u1ea3i \u0111\u01b0\u1ee3c ch\u1ea5p thu\u1eadn tr\u01b0\u1edbc khi nh\u1eadn \u0111\u01b0\u1ee3c gi\xe1 c\u01b0\u1edbc gi\u1ea3m c\u1ee7a Ch\u01b0\u01a1ng tr\xecnh gi\xe1 b\xecnh d\xe2n California. N\u1ebfu qu\xfd v\u1ecb \u0111\u0103ng k\xfd tham gia Ch\u01b0\u01a1ng tr\xecnh gi\xe1 b\xecnh d\xe2n California, qu\xfd v\u1ecb s\u1ebd thanh to\xe1n m\u1ee9c ph\xed th\xf4ng th\u01b0\u1eddng cho d\u1ecbch v\u1ee5 \u0111i\u1ec7n tho\u1ea1i t\u01b0 gia c\u01a1 b\u1ea3n cho \u0111\u1ebfn khi \u0111\u01a1n \u0111\u0103ng k\xfd c\u1ee7a qu\xfd v\u1ecb \u0111\u01b0\u1ee3c ch\u1ea5p thu\u1eadn. Vui l\xf2ng ch\u1eafc ch\u1eafn trao \u0111\u1ed5i v\u1edbi c\xf4ng ty \u0111i\u1ec7n tho\u1ea1i nh\xe0 v\u1ec1 c\xe1c chi ph\xed \u0111\u1ec3 qu\xfd v\u1ecb bi\u1ebft \u0111\u01b0\u1ee3c c\xe1c m\u1ee9c ph\xed v\xe0 chi ph\xed n\xe0y. "),S(2,"br")(3,"br"),u(4," Nh\u1eb1m gi\xfap qu\xfd v\u1ecb thanh to\xe1n c\xe1c chi ph\xed tr\u1ea3 tr\u01b0\u1edbc thi\u1ebft l\u1eadp d\u1ecbch v\u1ee5 \u0111i\u1ec7n tho\u1ea1i t\u01b0 gia c\u1ee7a qu\xfd v\u1ecb nh\u01b0 ph\xed l\u1eafp \u0111\u1eb7t/k\u1ebft n\u1ed1i d\u1ecbch v\u1ee5, ph\xed chuy\u1ec3n \u0111\u1ed5i d\u1ecbch v\u1ee5, v\xe0 kho\u1ea3n \u0111\u1eb7t c\u1ecdc, qu\xfd v\u1ecb c\xf3 th\u1ec3 y\xeau c\u1ea7u \u0111\u01b0\u1ee3c \u0111\u01b0a v\xe0o ch\u01b0\u01a1ng tr\xecnh thanh to\xe1n kh\xf4ng c\xf3 l\xe3i su\u1ea5t. \u0110i\u1ec1u n\xe0y s\u1ebd chia \u0111\u1ec1u c\xe1c kho\u1ea3n thanh to\xe1n c\u1ee7a qu\xfd v\u1ecb th\xe0nh nh\u1eefng kho\u1ea3n c\xf3 th\u1ec3 ki\u1ec3m so\xe1t h\u01a1n trong khi ch\u1edd \u0111\u1ee3i \u0111i\u1ec1u ki\u1ec7n h\u1ed9i \u0111\u1ee7 c\u1ee7a qu\xfd v\u1ecb \u0111\u1ec3 \u0111\u01b0\u1ee3c ch\u1ea5p thu\u1eadn tham gia Ch\u01b0\u01a1ng tr\xecnh gi\xe1 b\xecnh d\xe2n California. C\xe1c ch\u01b0\u01a1ng tr\xecnh thanh to\xe1n c\xf3 th\u1ec3 thay \u0111\u1ed5i gi\u1eefa c\xe1c c\xf4ng ty \u0111i\u1ec7n tho\u1ea1i \u0111\u1ecba ph\u01b0\u01a1ng kh\xe1c nhau. Sau khi \u0111\u01b0\u1ee3c Nh\xe0 qu\u1ea3n l\xfd Ch\u01b0\u01a1ng tr\xecnh gi\xe1 b\xecnh d\xe2n California ch\u1ea5p thu\u1eadn, qu\xfd v\u1ecb s\u1ebd \u0111\u01b0\u1ee3c ho\xe0n tr\u1ea3 kho\u1ea3n ch\xeanh l\u1ec7ch gi\u1eefa c\xe1c m\u1ee9c gi\xe1 th\xf4ng th\u01b0\u1eddng v\xe0 gi\xe1 gi\u1ea3m c\u1ee7a Ch\u01b0\u01a1ng tr\xecnh gi\xe1 b\xecnh d\xe2n California \u0111\u1ed1i v\u1edbi c\xe1c chi ph\xed d\u1ecbch v\u1ee5 h\xe0ng th\xe1ng \xe1p d\u1ee5ng, ph\xed l\u1eafp \u0111\u1eb7t/k\u1ebft n\u1ed1i d\u1ecbch v\u1ee5, ph\xed chuy\u1ec3n \u0111\u1ed5i d\u1ecbch v\u1ee5, v\xe0 c\xe1c kho\u1ea3n \u0111\u1eb7t c\u1ecdc \u0111\u1ed1i v\u1edbi d\u1ecbch v\u1ee5 \u0111i\u1ec7n tho\u1ea1i t\u01b0 gia c\u01a1 b\u1ea3n. Qu\xfd v\u1ecb s\u1ebd nh\u1eadn \u0111\u01b0\u1ee3c h\xf3a \u0111\u01a1n v\u1edbi c\xe1c kho\u1ea3n gi\u1ea3m gi\xe1 c\u1ee7a Ch\u01b0\u01a1ng tr\xecnh gi\xe1 b\xecnh d\xe2n California c\xf3 hi\u1ec7u l\u1ef1c tr\u1edf v\u1ec1 tr\u01b0\u1edbc cho \u0111\u1ebfn ng\xe0y d\u1ecbch v\u1ee5 c\u1ee7a qu\xfd v\u1ecb b\u1eaft \u0111\u1ea7u hay ng\xe0y qu\xfd v\u1ecb y\xeau c\u1ea7u \u0111\u0103ng k\xfd tham gia, n\u1ebfu ng\xe0y n\xe0o \u0111\u1ebfn sau. N\u1ebfu h\xf3a \u0111\u01a1n c\xf3 gi\xe1 tr\u1ecb tr\xean $10.00, th\xec qu\xfd v\u1ecb c\xf3 th\u1ec3 \u0111\u1ec1 ngh\u1ecb ho\xe0n tr\u1ea3 ti\u1ec1n t\u1eeb c\xf4ng ty \u0111i\u1ec7n tho\u1ea1i c\u1ee7a qu\xfd v\u1ecb. N\u1ebfu kh\xf4ng, kho\u1ea3n ti\u1ec1n ho\xe0n tr\u1ea3 s\u1ebd \u0111\u01b0\u1ee3c ghi c\xf3 trong t\xe0i kho\u1ea3n c\u1ee7a qu\xfd v\u1ecb. "),l())}function zdt(e,n){1&e&&(c(0,"div"),u(1," Simula Hulyo 1,2009, ang mga bagong aplikante sa California LifeLine Tahanang diskwento sa Telepono ay kailangang maaprubahan bago makatanggap ng mga diskuwento sa California LifeLine. Kung ikaw ay mag-apply upang maging kasama sa California LifeLine, ikaw ay magbabayad ng mga regular na takdang halaga para sa basic na serbisyo ng telepono sa tirahan hanggang maaprubahan ang iyong aplikasyon. Mangyari lamang tiyakin na tanungin sa kumpanya ng telepono sa bahay kung anu-ano ang mga singilin upang magkaroon ka ng kaalaman ukol sa mga takdang halaga at singilin na ito. Upang makatulong sa iyo na bayaran ang mga isang buong halaga sa pagkakabit ng serbisyo ng telepono sa iyong tirahan tulad ng singil sa serbisyo ng pagkakabit/koneksyon, singil sa serbisyo ng pagpapalit, at mga deposito, maaari kang humiling na malagay sa isang walang interes na plan sa pagbabayad. Ikakalat nito ang iyong mga pagbabayad sa mas maraming mas mapapangasiwaan na mga halaga habang hinihintay ang iyong pagiging karapat-dapat na maaprubahan sa California LifeLine. Maaaring mag-iba iba ang mga plano sa pagbabayad sa pagitan ng iba't ibang mga kumpanya ng telepono. Makalipas na maaprubahan ng Administrator ng California LifeLine, ibabalik sa iyo ang bayad para sa kaibahan sa pagitan ng regular na takdang halaga at ng may diskuwentong takdang halaga ng California LifeLine para sa kahit na anong naaangkop na buwanang singili sa serbisyo, singil sa serbisyo ng pagkakabit/koneksyon, singil sa serbisyo ng pagpapalit, at mga deposito para sa basic na serbisyo ng telepono sa tirahan. Ikaw ay makakatanggap ng credit sa bill sa pamamagitan ng mga diskuwento sa California LifeLIne na ipinaiiral na sa petsa na nagsimula ang iyong serbisyo o sa petsa na hiniling mong matala, kung alinman ang mahuli. Kung ang iyong bill ay mayroong netong balanse sa kredito na $10.00 o higit pa, maaari kang humiling ng tseke na nagsasauli ng bayad mula sa iyong kumpanya ng telepono sa tirahan. O kaya\u2019y,ang pagsasauli ng bayad ay magiging isang kredito sa iyong account. "),l())}function Sdt(e,n){1&e&&(c(0,"div"),u(1," Beginning January 16, 2014, cell phone companies offering California LifeLine pre-paid cell phone discounts might not provide the handset until the cell phone company has received notification of the applicant\u2019s approved eligibility from the California LifeLine Administrator. While waiting for the discounted services to be approved and activated, we encourage applicants to find other ways to make and receive calls "),S(2,"br")(3,"br"),u(4," If approved by the California LifeLine Administrator, the California LifeLine discounts will start either on the date the California LifeLine Administrator notifies the cell phone company of the applicant\u2019s approved eligibility or on the date the discounted service was activated (i.e., the California LifeLine participant can make and receive calls with the handset provided by the California LifeLine cell phone service provider), "),c(5,"strong"),u(6,"whichever is later."),l(),S(7,"br")(8,"br"),u(9," Immediately after the discounted service is activated, we encourage California LifeLine participants to promptly check their signal and coverage adequacy at home and in areas they frequent. If a participant is dissatisfied with the signal and coverage, participants have the benefit of canceling their discounted service within 14 days of service activation without incurring early termination fees. "),S(10,"br")(11,"br"),u(12," All California LifeLine (home and cell phone service) providers are required to provide a voice-grade connection. However, weather, trees, mountains, terrain, buildings, call volumes, service outages, and signal gaps can make service infeasible or below a voice-grade connection. If California LifeLine participants fail to receive a voice-grade connection, we encourage them to inform their provider quickly. California LifeLine providers are required to promptly restore the voice-grade connection, to provide the phone service using a different technology if not possible with the existing technology, and to allow the participants to cancel their service within 14 days of service activation without incurring early termination fees. "),S(13,"br")(14,"br"),u(15," If California LifeLine participants cancel their California LifeLine cell phone service within three business days of service activation, excluding national holidays, California LifeLine providers are required to refund, in full, any and all applicable service activation fees and deposits to the participant. Additionally, California LifeLine providers cannot assess a restocking fee to participants if they return their cell phone handsets/devices within three business days of service activation, excluding national holidays. However, participants are still responsible for paying for any usage charges between the service activation date and the service cancellation date. "),l())}function Bdt(e,n){1&e&&(c(0,"div"),u(1," Empezando el 16 de enero del 2014 las compa\xf1\xedas telef\xf3nicas de celular que ofrecen el descuento pre-pagado para celular de California LifeLine podr\xe1n no ofrecer el tel\xe9fono hasta que la compa\xf1\xeda telef\xf3nica de celular haya recibido una notificaci\xf3n de que el solicitante fue aprobado por el Administrador de California LifeLine. Mientras se espera a que los servicios de descuento sean aprobados y activados, aconsejamos a los solicitantes que encuentren otras maneras de hacer y recibir llamadas. "),S(2,"br")(3,"br"),u(4," Luego de ser aprobado por el administrador de California LifeLine, los descuentos de California LifeLine comenzaran en la fecha que el Administrador de California LifeLine notifico a la compa\xf1\xeda de celular de la aprobaci\xf3n del solicitante o en la fecha en que el servicio se activ\xf3 (Los solicitantes de California LifeLine pueden hacer y recibir llamadas con el aparato de tel\xe9fono proporcionado por el California LifeLine proveedor de celulares), "),c(5,"strong"),u(6,"cual sea m\xe1s reciente. "),l(),S(7,"br")(8,"br"),u(9," Inmediatamente despu\xe9s de que el servicio es activado, les aconsejamos a los solicitantes de California LifeLine que revisen su se\xf1al y cobertura de servicio en el hogar y tambi\xe9n en \xe1reas que frecuenten. Si un solicitante no est\xe1 satisfecho con la se\xf1al y cobertura, solicitantes tienen el derecho de cancelar su servicio descontado dentro 14 d\xedas de la activaci\xf3n de servicio sin incurrir en recargos de temprano terminaci\xf3n. "),S(10,"br")(11,"br"),u(12," Todos los proveedores de California LifeLine (tel\xe9fono de casa y celular) est\xe1n requeridos proporcionar conexi\xf3n de voz de grado. Sin embargo, clima, arboles, montanas, terreno, edificios, cortes de servicio, se\xf1al hueco, pueden hacer el servicio inviable o un nivel abajo de conexi\xf3n de voz de grado. Si el solicitante de California LifeLine falla recibir una conexi\xf3n de voz de grado, les estimamos que informen su proveedor inmediatamente. Proveedores de California LifeLine est\xe1n requeridos restaurar la conexi\xf3n de voz de grado, para proporcionar el servicio de tel\xe9fono usando tecnolog\xeda diferente si no es posible con la tecnolog\xeda existente, y para permitir los solicitantes cancelen su servicio dentro 14 d\xedas de la activaci\xf3n de servicio sin incurrir en recargos de temprano terminaci\xf3n. "),S(13,"br")(14,"br"),u(15," Si los solicitantes de California LifeLine gustan cancelar su servicio celular de California LifeLine dentro tres d\xedas de negocio de la activaci\xf3n del servicio, excluyendo d\xedas festivos nacionales, los proveedores de California LifeLine est\xe1n requeridos reembolsar, en pleno, cualquier y todos recargos aplicables de la conexi\xf3n del servicio y dep\xf3sitos al solicitante. Adicionalmente, los proveedores de California LifeLine no pueden dar un recargo de repoblaci\xf3n a solicitantes si devuelven su conjunto de la mano celular/aparatos dentro tres d\xedas de negocio de la activaci\xf3n del servicio, excluyendo d\xedas festivos nacionales. Sin embargo, solicitantes son responsables en pagar cualquier recargo de uso entre la fecha de la conexi\xf3n del servicio y la fecha de cancelo de servicio. "),l())}function Fdt(e,n){1&e&&(c(0,"div"),u(1," \u5f9e2014\u5e741\u670816\u65e5\u8d77\uff0c\u624b\u6a5f\u516c\u53f8\u63d0\u4f9b\u52a0\u5dde\u666e\u6fdf\u96fb\u8a71\u9810\u4ed8\u8cbb\u624b\u6a5f\u6298\u6263\u8981\u5f97\u5230\u52a0\u5dde\u666e\u6fdf\u96fb\u8a71\u7ba1\u7406\u54e1\u901a\u77e5\u624b\u6a5f\u516c\u53f8\u7533\u8acb\u4eba\u7684\u8cc7\u683c\u5df2\u88ab\u6838\u51c6\u624d\u80fd\u63d0\u4f9b\u624b\u6a5f\u3002\u5728\u7b49\u5f85\u6298\u6263\u670d\u52d9\u5f97\u5230\u6279\u51c6\u4e26\u958b\u901a\u524d\uff0c\u6211\u5011\u5efa\u8b70\u7533\u8acb\u4eba\u627e\u5230\u5176\u4ed6\u65b9\u6cd5\u4f86\u64a5\u6253\u548c\u63a5\u807d\u96fb\u8a71\u3002 "),S(2,"br")(3,"br"),u(4," \u5982\u679c\u5be9\u6279\u5f97\u5230\u52a0\u5dde\u666e\u6fdf\u7ba1\u7406\u54e1\u7684\u6279\u51c6\uff0c\u52a0\u5dde\u666e\u6fdf\u96fb\u8a71\u6298\u6263\u5c07\u5f9e\u52a0\u5dde\u666e\u6fdf\u7ba1\u7406\u54e1\u6536\u5230\u901a\u77e5\u7533\u8acb\u901a\u77e5\u7684\u7576\u65e5\u6216\u670d\u52d9\u958b\u901a\u90a3\u5929\u958b\u59cb\u3002\uff08\u5373\u52a0\u5dde\u666e\u6fdf\u53c3\u52a0\u8005\u53ef\u4ee5\u4f7f\u7528\u548c\u63a5\u6536\u96fb\u8a71\u7531\u52a0\u5dde\u666e\u6fdf\u96fb\u8a71\u7684\u624b\u6a5f\u670d\u52d9\u4f9b\u61c9\u5546\u63d0\u4f9b\uff09\uff0c\u4ee5\u8f03\u9072\u8005\u70ba\u6e96\u3002 "),S(5,"br")(6,"br"),u(7," \u5728\u6298\u6263\u958b\u901a\u4e4b\u5f8c\uff0c\u6211\u5011\u5efa\u8b70\u52a0\u5dde\u666e\u6fdf\u7684\u7528\u6236\u7acb\u523b\u6aa2\u6e2c\u5bb6\u88e1\u548c\u4ed6\u5011\u7d93\u5e38\u51fa\u5165\u7684\u5730\u5340\u7684\u624b\u6a5f\u4fe1\u865f\u548c\u8986\u84cb\u7bc4\u570d\u662f\u5426\u8db3\u5920\u3002\u5982\u679c\u7528\u6236\u4e0d\u6eff\u610f\u670d\u52d9\u7684\u4fe1\u865f\u548c\u8986\u84cb\u7bc4\u570d\uff0c\u7528\u6236\u6709\u6b0a\u5229\u7d42\u6b62\u4ed6\u5011\u7684\u6298\u6263\u670d\u52d9\u5728\u958b\u901a\u5f8c\u768414\u5929\u5167\u514d\u9700\u627f\u64d4\u63d0\u524d\u7d42\u6b62\u8cbb\u3002 "),S(8,"br")(9,"br"),u(10," \u6240\u6709\u52a0\u5dde\u666e\u6fdf\u96fb\u8a71\uff08\u5bb6\u5ead\u548c\u624b\u6a5f\u670d\u52d9\uff09\u4f9b\u61c9\u5546\u5fc5\u9808\u63d0\u4f9b\u9ad8\u8cea\u91cf\u7684\u8a9e\u97f3\u9023\u63a5\u3002\u7136\u800c\uff0c\u5929\u6c23\uff0c\u6a39\uff0c\u5c71\uff0c\u5730\u5f62\uff0c\u5efa\u7bc9\u7269\uff0c\u547c\u53eb\u91cf\uff0c\u670d\u52d9\u4e2d\u65b7\u548c\u4fe1\u865f\u5dee\u8ddd\u53ef\u4ee5\u4f7f\u670d\u52d9\u4e0d\u53ef\u884c\u6216\u964d\u4f4e\u8a9e\u97f3\u9023\u63a5\u3002\u5982\u679c\u52a0\u5dde\u666e\u6fdf\u7684\u7528\u6236\u7121\u6cd5\u63a5\u6536\u9ad8\u8cea\u91cf\u7684\u8a9e\u97f3\u9023\u63a5\uff0c\u6211\u5011\u5efa\u8b70\u4ed6\u5011\u76e1\u5feb\u901a\u77e5\u4ed6\u5011\u7684\u4f9b\u61c9\u5546\u3002\u52a0\u5dde\u666e\u6fdf\u96fb\u8a71\u4f9b\u61c9\u5546\u662f\u5fc5\u9808\u53ca\u6642\u6062\u5fa9\u9ad8\u8cea\u91cf\u7684\u8a9e\u97f3\u9023\u63a5\uff0c\u63a1\u7528\u4e0d\u540c\u7684\u6280\u8853\uff0c\u5982\u679c\u4e0d\u80fd\u4f7f\u7528\u73fe\u6709\u7684\u6280\u8853\u63d0\u4f9b\u96fb\u8a71\u670d\u52d9\uff0c\u4e26\u5141\u8a31\u7528\u6236\u5728\u670d\u52d9\u958b\u901a\u5f8c\u768414\u5929\u5167\u53d6\u6d88\u670d\u52d9\uff0c\u800c\u4e14\u4e0d\u9700\u8981\u627f\u64d4\u63d0\u524d\u7d42\u6b62\u8cbb\u3002 "),S(11,"br")(12,"br"),u(13," \u5982\u679c\u52a0\u5dde\u666e\u6fdf\u7528\u6236\u5728\u670d\u52d9\u958b\u901a\u5f8c\u7684\u4e09\u500b\u71df\u696d\u65e5\u5167\u53d6\u6d88\u670d\u52d9\uff0c\u4e0d\u5305\u62ec\u7bc0\u5047\u65e5\uff0c\u52a0\u5dde\u666e\u6fdf\u96fb\u8a71\u7684\u4f9b\u61c9\u5546\u5fc5\u9808\u9000\u9084\uff0c\u5168\u90e8\uff0c\u4efb\u4f55\u548c\u6240\u6709\u9069\u7528\u7684\u670d\u52d9\u6fc0\u6d3b\u8cbb\u7528\u548c\u62bc\u91d1\u7d66\u7528\u6236\u3002\u6b64\u5916\uff0c\u52a0\u5dde\u666e\u6fdf\u96fb\u8a71\u7684\u4f9b\u61c9\u5546\u4e0d\u80fd\u5411\u7528\u6236\u5fb5\u6536\u91cd\u65b0\u5305\u88dd\u8cbb\uff0c\u5982\u679c\u4ed6\u5011\u9000\u9084\u4ed6\u5011\u7684\u624b\u6a5f/\u8a2d\u5099\u5728\u670d\u52d9\u958b\u901a\u5f8c\u4e09\u500b\u71df\u696d\u65e5\u5167\uff0c\u4e0d\u5305\u62ec\u7bc0\u5047\u65e5\u3002\u7136\u800c\uff0c\u7528\u6236\u4ecd\u9700\u8981\u8ca0\u8cac\u652f\u4ed8\u670d\u52d9\u958b\u901a\u65e5\u671f\u548c\u53d6\u6d88\u670d\u52d9\u65e5\u671f\u9593\u7684\u4efb\u4f55\u4f7f\u7528\u8cbb\u7528\u3002 "),l())}function Tdt(e,n){1&e&&(c(0,"div"),u(1," 2014\ub144 1\uc6d4 16\uc77c \ubd80\ud130 \uce98\ub9ac\ud3ec\ub2c8\uc544 \ub77c\uc774\ud504\ub77c\uc778 \uc120\ubd88 \ud734\ub300 \uc804\ud654 \ud560\uc778\uc744 \uc81c\uacf5\ud558\ub294 \ud734\ub300 \uc804\ud654 \ud68c\uc0ac\uc5d0\uc11c\ub294 \uce98\ub9ac\ud3ec\ub2c8\uc544 \ub77c\uc774\ud504\ub77c\uc778 \uad00\ub9ac\uc790\ub85c \ubd80\ud130 \uc2e0\uccad\uc790\uc758 \uc790\uaca9 \uc2b9\uc778\uc744 \ud1b5\uace0 \ubc1b\uae30 \uc804\uae4c\uc9c4 \ud578\ub4dc\uc14b\uc744 \uc81c\uacf5\ud558\uc9c0 \ubabb\ud558\uac8c \ub429\ub2c8\ub2e4. \uc2b9\uc778\uc744 \ubc1b\uc544 \uc804\ud654 \ud560\uc778 \uc11c\ube44\uc2a4\ub97c \uae30\ub2e4\ub9ac\ub294 \ub3d9\uc548\uc5d0 \uc2e0\uccad\uc790\uaed8\uc11c\ub294 \uc804\ud654\ub97c \uac78\uace0 \ubc1b\uc744 \uc218 \uc788\ub294 \ub2e4\ub978 \ubc29\ubc95\uc744 \uac04\uad6c\ud558\uae30\ub97c \uad8c\uc7a5\ud569\ub2c8\ub2e4. "),S(2,"br")(3,"br"),u(4," \ub9cc\uc57d \uce98\ub9ac\ud3ec\ub2c8\uc544 \ub77c\uc774\ud504\ub77c\uc778 \uad00\ub9ac\uc790\ub85c \ubd80\ud130 \uac00\uc785 \uc790\uaca9 \uc2b9\uc778\uc744 \ubc1b\uc73c\uc2dc\uba74, \uce98\ub9ac\ud3ec\ub2c8\uc544 \ub77c\uc774\ud504\ub77c\uc778 \ud560\uc778\uc740 \ud734\ub300 \uc804\ud654 \ud68c\uc0ac\uac00 \uce98\ub9ac\ud3ec\ub2c8\uc544 \ub77c\uc774\ud504\ub77c\uc778 \uad00\ub9ac\uc790\ub85c \ubd80\ud130 \uc2e0\uccad\uc790\uc758 \uac00\uc785 \uc790\uaca9 \uc2b9\uc778\uc744 \ud1b5\ubcf4\ub97c \ubc1b\uc740 \ub0a0\uc9dc \ubd80\ud130 \uc544\ub2c8\uba74 \ud560\uc778 \uc11c\ube44\uc2a4\uac00 \uc2dc\uc791\ud558\uac8c \ub41c \ub0a0\uc9dc \uc911\uc5d0\uc11c \ub098\uc911\uc744 \uae30\uc900\uc73c\ub85c \uce98\ub9ac\ud3ec\ub2c8\uc544 \ub77c\uc774\ud504\ub77c\uc778 \ud560\uc778\uc744 \ubc1b\uac8c \ub429\ub2c8\ub2e4. "),S(5,"br")(6,"br"),u(7," \uce98\ub9ac\ud3ec\ub2c8\uc544 \ub77c\uc774\ud504\ub77c\uc778 \uad00\ub9ac\uc790\ub294 \ud560\uc778 \uc11c\ube44\uc2a4\uac00 \uc2dc\uc791 \ub418\uba74, \ubc14\ub85c \uce98\ub9ac\ud3ec\ub2c8\uc544 \ub77c\uc774\ud504\ub77c\uc778 \ucc38\uac00\uc790\uc758 \uc0ac\ub294 \uc9d1\uacfc \uc9c0\uc5ed\uc5d0\uc11c \uc804\ud654 \uc2e0\ud638\uc640 \uc11c\ube44\uc2a4 \uc801\uc6a9 \ubc94\uc704 \ud0c0\ub2f9\uc131\uc744 \ud655\uc778\ud558\uc2dc\uae30\ub97c \ub2f9\ubd80 \ud569\ub2c8\ub2e4. \ub9cc\uc57d \ucc38\uac00\uc790\uaed8\uc11c \uc804\ud654 \uc2e0\ud638\uc640 \uc801\uc6a9 \ubc94\uc704 \uc0c1\ud0dc\uac00 \ub098\ube60\uc11c \uc11c\ube44\uc2a4\uc5d0 \ub9cc\uc871\ud558\uc790 \uc54a\uc73c\uc2dc\uba74, \ucc38\uac00\uc790\ub294 \uc11c\ube44\uc2a4 \uc5f0\uacb0 \uc2dc\uc791 \ud6c4 14 \uc77c \uc774\ub0b4\uc5d0 \uc870\uae30 \ud574\uc9c0 \ube44\uc6a9\uc744 \ub4e4\uc774\uc9c0 \uc54a\uace0 \uc790\uc2e0\uc758 \ud560\uc778 \uc11c\ube44\uc2a4\ub97c \ucde8\uc18c\ud560 \uc218 \uc788\ub294 \uc774\uc810\uc774 \uc788\uc2b5\ub2c8\ub2e4. "),S(8,"br")(9,"br"),u(10," \ubaa8\ub4e0 \uce98\ub9ac\ud3ec\ub2c8\uc544 \ub77c\uc774\ud504\ub77c\uc778 (\uc9d1 \uacfc \ud734\ub300 \uc804\ud654 \uc11c\ube44\uc2a4) \uacf5\uae09\uc5c5\uccb4\ub294 \uc74c\uc131 \ub4f1\uae09 \uc5f0\uacb0\uc744 \uc81c\uacf5\ud574\uc57c \ud569\ub2c8\ub2e4. \uadf8\ub7f0\ub370, \ub0a0\uc528, \ub098\ubb34, \uc0b0, \uc9c0\ud615, \uac74\ubb3c, \ud1b5\ud654\ub7c9, \uc11c\ube44\uc2a4 \uc911\ub2e8, \uadf8\ub9ac\uace0 \uc2e0\ud638 \uac04\uaca9 \ub4f1\uc740 \uc11c\ube44\uc2a4\uac00 \ubd88\uac00\ub2a5\ud558\uac8c \ud558\uac70\ub098 \ud639\uc740 \uc74c\uc131 \ub4f1\uae09 \uc5f0\uacb0 \uc0c1\ud0dc\ub97c \uc800\ud558 \uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub9cc\uc57d \uce98\ub9ac\ud3ec\ub2c8\uc544 \ub77c\uc774\ud504\ub77c\uc778 \ucc38\uac00\uc790\uaed8\uc11c \uc74c\uc131 \ub4f1\uae09 \uc5f0\uacb0\uc744 \uc218\uc2e0 \ubc1b\uc9c0 \ubabb\ud558\uac8c \ub418\uba74, \uc989\uc2dc \uc804\ud654 \uc11c\ube44\uc2a4 \uacf5\uae09\uc5c5\uccb4\uc5d0\uac8c \ubcf4\uace0\ud558\uae30\ub97c \ub2f9\ubd80\ud569\ub2c8\ub2e4. \uce98\ub9ac\ud3ec\ub2c8\uc544 \ub77c\uc774\ud504\ub77c\uc778 \uacf5\uae09\uc5c5\uccb4\ub294 \uc2e0\uc18d\ud558\uac8c \uc74c\uc131 \ub4f1\uae09\uc744 \ubcf5\uc6d0\ud574\uc57c \ud558\ub294\ub370, \ub9cc\uc57d \uae30\uc874\uc758 \uae30\uc220\uc774 \uac00\ub2a5\ud558\uc9c0 \uc54a\uc73c\uba74, \ub2e4\ub978 \uae30\uc220\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc804\ud654 \uc11c\ube44\uc2a4\ub97c \uc81c\uacf5\ud574\uc57c \ud558\uba70, \uc544\ub2c8\uba74 \ucc38\uac00\uc790\ub4e4\uc5d0\uac8c \uc870\uae30 \ud574\uc9c0 \ube44\uc6a9\uc744 \ub4e4\uc774\uc9c0 \uc54a\uace0 \uc11c\ube44\uc2a4 \uc5f0\uacb0 \uc2dc\uc791 \ud6c414\uc77c \uc774\ub0b4\uc5d0 \ucde8\uc18c\ud560 \uc218 \uc788\ub3c4\ub85d \ud5c8\uc6a9\ud574\uc57c \ud569\ub2c8\ub2e4. "),S(11,"br")(12,"br"),u(13," \uc57d \uce98\ub9ac\ud3ec\ub2c8\uc544 \ub77c\uc774\ud504\ub77c\uc778 \ucc38\uac00\uc790\uaed8\uc11c \uce98\ub9ac\ud3ec\ub2c8\uc544 \ub77c\uc774\ud504\ub77c\uc778 \ud734\ub300 \uc804\ud654 \uc11c\ube44\uc2a4\ub97c \ucde8\uc18c \ud558\ub824\uba74, \uacf5\ud734\uc77c\uc744 \uc81c\uc678\ud55c, \uc11c\ube44\uc2a4 \uc5f0\uacb0 \uc2dc\uc791 \ud6c4 \uc601\uc5c5\uc77c 3\uc77c\uc774\ub0b4\uc5d0 \uc5f0\ub77d\ud574\uc57c \ub418\uba70, \uce98\ub9ac\ud3ec\ub2c8\uc544 \ub77c\uc774\ud504\ub77c\uc778 \uacf5\uae09\uc5c5\uccb4\ub294 \uc801\uc6a9\ud55c \ubaa8\ub4e0 \uc11c\ube44\uc2a4 \uc5f0\uacb0 \ube44\uc6a9 \ubc0f \ubcf4\uc99d\uae08 \ub4f1\uc744 \ucc38\uac00\uc790\uc5d0\uac8c \uc804\uc561 \ud658\ubd88 \ud574\uc57c \ud569\ub2c8\ub2e4. \uadf8\ub9ac\uace0, \uce98\ub9ac\ud3ec\ub2c8\uc544 \ub77c\uc774\ud504\ub77c\uc778 \uacf5\uae09\uc5c5\uccb4\ub294 \ucc38\uac00\uc790\ub4e4\uc774 \uc11c\ube44\uc2a4 \uc5f0\uacb0 \uc2dc\uc791 \ud6c4 \uc601\uc5c5\uc77c 3\uc77c \uc774\ub0b4\uc5d0 \ud734\ub300 \uc804\ud654 \ud578\ub4dc\uc14b/\ub2e8\ub9d0\uae30 \uc7a5\uce58\ub97c \ubc18\ud658\ud558\ub294 \uacbd\uc6b0, \ucc38\uac00\uc790\ub4e4\uc5d0\uac8c \ubc18\ud488 \uc7ac\uace0 \ube44\uc6a9\uc744 \ubd80\uacfc \ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \uadf8\ub7ec\ub098, \ucc38\uac00\uc790\ub294 \uc5ec\uc804\ud788 \uc11c\ube44\uc2a4 \uc5f0\uacb0 \ub0a0\uc9dc\uc640 \ucde8\uc18c \ub0a0\uc9dc \uc0ac\uc774\uc758 \uc0ac\uc6a9\ud55c \uc694\uae08\uc744 \uc9c0\ubd88 \ud560 \ucc45\uc784\uc774 \uc788\uc2b5\ub2c8\ub2e4. "),l())}function Ldt(e,n){1&e&&(c(0,"div"),u(1," 2014\u5e741\u670816\u65e5\u4ee5\u964d\u3001\u643a\u5e2f\u96fb\u8a71\u4f1a\u793e\u304c\u30ab\u30ea\u30d5\u30a9\u30eb\u30cb\u30a2\u30e9\u30a4\u30d5\u30e9\u30a4\u30f3\u7ba1\u7406\u8005\u304b\u3089\u7533\u8acb\u8005\u306e\u627f\u8a8d\u8cc7\u683c\u306e\u901a\u77e5\u3092\u53d7\u4fe1\u3059\u308b\u307e\u3067\u3001\u30ab\u30ea\u30d5\u30a9\u30eb\u30cb\u30a2\u306e\u30e9\u30a4\u30d5\u30e9\u30a4\u30f3\u306e\u30d7\u30ea\u30da\u30a4\u30c9\u643a\u5e2f\u96fb\u8a71\u306e\u5272\u5f15\u3092\u63d0\u4f9b\u3059\u308b\u643a\u5e2f\u96fb\u8a71\u4f1a\u793e\u306f\u643a\u5e2f\u96fb\u8a71\u3092\u63d0\u4f9b\u3057\u306a\u3044\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u3001\u5272\u5f15\u30b5\u30fc\u30d3\u30b9\u304c\u8a8d\u77e5\u3055\u308c\u308b\u306e\u3092\u5f85\u3063\u3066\u3044\u308b\u9593\u3001\u304a\u5ba2\u69d8\u304c\u96fb\u8a71\u306e\u53d7\u4fe1\u3092\u4ed6\u306e\u65b9\u6cd5\u3067\u884c\u3046\u3053\u3068\u3092\u5f37\u304f\u671b\u307f\u307e\u3059\u3002 "),S(2,"br")(3,"br"),u(4," \u30ab\u30ea\u30d5\u30a9\u30eb\u30cb\u30a2\u30e9\u30a4\u30d5\u30e9\u30a4\u30f3\u7ba1\u7406\u8005\u306b\u3088\u3063\u3066\u627f\u8a8d\u3055\u308c\u305f\u5834\u5408\u3001\u30ab\u30ea\u30d5\u30a9\u30eb\u30cb\u30a2\u30e9\u30a4\u30d5\u30e9\u30a4\u30f3\u306e\u5272\u5f15\u304c\u958b\u59cb\u3055\u308b\u65e5\u306f\u3001\u30ab\u30ea\u30d5\u30a9\u30eb\u30cb\u30a2\u30e9\u30a4\u30d5\u30e9\u30a4\u30f3\u7ba1\u7406\u8005\u304c\u3001\u7533\u8acb\u8005\u306e\u627f\u8a8d\u8cc7\u683c\u3084\u5272\u5f15\u30b5\u30fc\u30d3\u30b9\u304c\u643a\u5e2f\u96fb\u8a71\u4f1a\u793e\u306b\u901a\u77e5\u3055\u308c\u305f\u65e5\u3001\u307e\u305f\u306f\uff08\u30ab\u30ea\u30d5\u30a9\u30eb\u30cb\u30a2\u30e9\u30a4\u30d5\u30e9\u30a4\u30f3\u306e\u53c2\u52a0\u8005\u304c\u3001\u643a\u5e2f\u96fb\u8a71\u306e\u30b5\u30fc\u30d3\u30b9\u30d7\u30ed\u30d0\u30a4\u30c0\u304c\u63d0\u4f9b\u3059\u308b\u643a\u5e2f\u96fb\u8a71\u3067\u306e\u901a\u8a71\u306e\u53d7\u4fe1\u3092\u59cb\u3081\u305f\u6642\u3067\u3059\u3002\uff09\u3002\u3044\u305a\u308c\u304b\u9045\u3044\u65b9\u3067\u3059\u3002 "),S(5,"br")(6,"br"),u(7," \u5272\u5f15\u30b5\u30fc\u30d3\u30b9\u304c\u8d77\u52d5\u3055\u308c\u305f\u76f4\u5f8c\u3001\u6211\u3005\u306f\u30ab\u30ea\u30d5\u30a9\u30eb\u30cb\u30a2\u30e9\u30a4\u30d5\u30e9\u30a4\u30f3\u306e\u53c2\u52a0\u8005\u306b\u81ea\u5b85\u307e\u305f\u306f\u3001\u5206\u91ce\u3067\u306e\u4fe1\u53f7\u304a\u3088\u3073\u30ab\u30d0\u30ec\u30c3\u30b8\u59a5\u5f53\u6027\u3092\u901f\u3084\u304b\u306b\u30c1\u30a7\u30c3\u30af\u3057\u3066\u3044\u305f\u3060\u304f\u3088\u3046\u306b\u3001\u30a2\u30c9\u30d0\u30a4\u30b9\u3057\u3066\u3044\u307e\u3059\u3002\u53c2\u52a0\u8005\u304c\u3001\u4fe1\u53f7\u304a\u3088\u3073\u30ab\u30d0\u30ec\u30c3\u30b8\u306b\u4e0d\u670d\u304c\u3042\u308b\u5834\u5408\u306f\u3001\u53c2\u52a0\u8005\u304c\u65e9\u671f\u89e3\u7d04\u6599\u3092\u767a\u751f\u3055\u305b\u308b\u3053\u3068\u306a\u304f\u3001\u30b5\u30fc\u30d3\u30b9\u30a2\u30af\u30c6\u30a3\u30d9\u30fc\u30b7\u30e7\u30f3\u306e14\u65e5\u4ee5\u5185\u306b\u3001\u5272\u5f15\u30b5\u30fc\u30d3\u30b9\u3092\u30ad\u30e3\u30f3\u30bb\u30eb\u304c\u3067\u304d\u308b\u5229\u70b9\u3092\u6301\u3063\u3066\u3044\u307e\u3059\u3002\u3059\u3079\u3066\u306e\u30ab\u30ea\u30d5\u30a9\u30eb\u30cb\u30a2\u30e9\u30a4\u30d5\u30e9\u30a4\u30f3\uff08\u81ea\u5b85\u3068\u643a\u5e2f\u96fb\u8a71\u30b5\u30fc\u30d3\u30b9\uff09\u306e\u63d0\u4f9b\u8005\u306f\u3001\u97f3\u58f0\u30b0\u30ec\u30fc\u30c9\u306e\u63a5\u7d9a\u3092\u63d0\u4f9b\u3059\u308b\u306e\u3092\u5fc5\u8981\u3068\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u3057\u304b\u3057\u3001\u5929\u5019\u3001\u6728\u3001\u5c71\u3001\u5730\u5f62\u3001\u5efa\u7269\u3001\u30b3\u30fc\u30eb\u30dc\u30ea\u30e5\u30fc\u30e0\u3001\u30b5\u30fc\u30d3\u30b9\u306e\u505c\u6b62\u3001\u4fe1\u53f7\u306e\u30ae\u30e3\u30c3\u30d7\u306a\u3069\u306e\u30b5\u30fc\u30d3\u30b9\u304c\u5b9f\u884c\u4e0d\u53ef\u80fd\u306a\u3070\u3042\u3044\u306f\u3001\u97f3\u58f0\u30b0\u30ec\u30fc\u30c9\u306e\u63a5\u7d9a\u304c\u4e0b\u304c\u308b\u3053\u3068\u304c\u3042\u308a\u307e\u3059\u3002\u30ab\u30ea\u30d5\u30a9\u30eb\u30cb\u30a2\u30e9\u30a4\u30d5\u30e9\u30a4\u30f3\u306e\u53c2\u52a0\u8005\u306f\u3001\u97f3\u58f0\u30b0\u30ec\u30fc\u30c9\u306e\u63a5\u7d9a\u306e\u53d7\u4fe1\u306b\u5931\u6557\u3057\u305f\u5834\u5408\u3001\u3059\u3050\u306b\u81ea\u5206\u306e\u30d7\u30ed\u30d0\u30a4\u30c0\u30fc\u306b\u901a\u77e5\u3059\u308b\u3053\u3068\u3092\u5968\u52b1\u3002\u30ab\u30ea\u30d5\u30a9\u30eb\u30cb\u30a2\u30e9\u30a4\u30d5\u30e9\u30a4\u30f3\u306e\u30d7\u30ed\u30d0\u30a4\u30c0\u30fc\u306f\u3001\u97f3\u58f0\u30b0\u30ec\u30fc\u30c9\u306e\u63a5\u7d9a\u63d0\u4f9b\u3092\u901f\u3084\u304b\u306b\u5fa9\u5143\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u305d\u306e\u30b5\u30fc\u30d3\u30b9\u304c\u53ef\u80fd\u3067\u306a\u3044\u5834\u5408\u306f\u3001\u65e2\u5b58\u306e\u6280\u8853\u3068\u7570\u306a\u308b\u6280\u8853\u3092\u4f7f\u7528\u3057\u3066\u96fb\u8a71\u30b5\u30fc\u30d3\u30b9\u3092\u63d0\u4f9b\u3057\u3001\u30b5\u30fc\u30d3\u30b9\u30a2\u30af\u30c6\u30a3\u30d9\u30fc\u30b7\u30e7\u30f3\u306e14\u65e5\u4ee5\u5185\u306b\u3001\u53c2\u52a0\u8005\u306f\u65e9\u671f\u89e3\u7d04\u6599\u3092\u767a\u751f\u3055\u305b\u308b\u3053\u3068\u306a\u304f\u3001\u30b5\u30fc\u30d3\u30b9\u3092\u30ad\u30e3\u30f3\u30bb\u30eb\u3067\u304d\u307e\u3059\u3002 "),S(8,"br")(9,"br"),u(10," \u30ab\u30ea\u30d5\u30a9\u30eb\u30cb\u30a2\u30e9\u30a4\u30d5\u30e9\u30a4\u30f3\u306e\u53c2\u52a0\u8005\u304c\u3001\u30ab\u30ea\u30d5\u30a9\u30eb\u30cb\u30a2\u30e9\u30a4\u30d5\u30e9\u30a4\u30f3\u306e\u643a\u5e2f\u96fb\u8a71\u30b5\u30fc\u30d3\u30b9\u3092\u30ad\u30e3\u30f3\u30bb\u30eb\u3057\u305f\u5834\u5408\u3001\uff08\u30b5\u30fc\u30d3\u30b9\u30a2\u30af\u30c6\u30a3\u30d9\u30fc\u30b7\u30e7\u30f3\u5f8c3\u65e5\u5185\u3001\u56fd\u6c11\u306e\u795d\u65e5\u3092\u9664\u304f\uff09\u30ab\u30ea\u30d5\u30a9\u30eb\u30cb\u30a2\u30e9\u30a4\u30d5\u30e9\u30a4\u30f3\u306e\u30d7\u30ed\u30d0\u30a4\u30c0\u30fc\u306f\u3001\u53c2\u52a0\u8005\u306b\u95a2\u4fc2\u3059\u308b\u3059\u3079\u3066\u306e\u30b5\u30fc\u30d3\u30b9\u30a2\u30af\u30c6\u30a3\u30d9\u30fc\u30b7\u30e7\u30f3\u6599\u91d1\u307e\u305f\u306f\u30c7\u30dd\u30b8\u30c3\u30c8\u5168\u984d\u3092\u8fd4\u91d1\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30d7\u30ed\u30d0\u30a4\u30c0\u30fc\u306f\u56fd\u6c11\u306e\u795d\u65e5\u3092\u9664\u304f\u3001\u30b5\u30fc\u30d3\u30b9\u30a2\u30af\u30c6\u30a3\u30d9\u30fc\u30b7\u30e7\u30f3\u306e\u5f8c\u3001\uff13\u65e5\u4ee5\u5185\u306b\u81ea\u5206\u306e\u643a\u5e2f\u96fb\u8a71\u7aef\u672b/\u30c7\u30d0\u30a4\u30b9\u3092\u8fd4\u3059\u5834\u5408\u306f\u3001\u30ab\u30ea\u30d5\u30a9\u30eb\u30cb\u30a2\u306e\u30e9\u30a4\u30d5\u30e9\u30a4\u30f3\u30d7\u30ed\u30d0\u30a4\u30c0\u30fc\u306f\u53c2\u52a0\u8005\u306b\u8fd4\u54c1\u624b\u6570\u6599\u3092\u8981\u6c42\u3059\u308b\u3053\u3068\u306f\u3067\u304d\u307e\u305b\u3093\u3002\u3057\u304b\u3057\u3001\u53c2\u52a0\u8005\u306f\u3001\u30b5\u30fc\u30d3\u30b9\u306e\u30a2\u30af\u30c6\u30a3\u30d6\u3055\u308c\u305f\u65e5\u3068\u30b5\u30fc\u30d3\u30b9\u89e3\u9664\u65e5\u306e\u9593\u306e\u4f7f\u7528\u6599\u3092\u652f\u6255\u3046\u7fa9\u52d9\u304c\u3042\u308a\u307e\u3059\u3002 "),l())}function kdt(e,n){1&e&&(c(0,"div"),u(1," B\u1eaft \u0111\u1ea7u t\u1eeb ng\xe0y 16 th\xe1ng 1, 2014, c\xe1c h\xe3ng \u0111i\u1ec7n tho\u1ea1i di \u0111\u1ed9ng California LifeLine gi\u1ea3m gi\xe1 tr\u1ea3 ti\u1ec1n tr\u01b0\u1edbc c\xf3 th\u1ec3 s\u1ebd kh\xf4ng cung c\u1ea5p m\xe1y \u0111i\u1ec7n tho\u1ea1i cho \u0111\u1ebfn khi h\xe3ng \u0111i\u1ec7n tho\u1ea1i nh\u1eadn \u0111\u01b0\u1ee3c th\u01b0 b\xe1o tin l\xe0 \u1ee8ng vi\xean \u0111\xe3 \u0111\u01b0\u1ee3c ch\u1ea5p thu\u1eadn v\xe0o ch\u01b0\u01a1ng tr\xecnh t\u1eeb nh\xe0 qu\u1ea3n l\xfd California LifeLine. Trong khi ch\u1edd \u0111\u1ee3i d\u1ecbch v\u1ee5 gi\u1ea3m gi\xe1 \u0111\u01b0\u1ee3c ch\u1ea5p thu\u1eadn v\xe0 hi\u1ec7u l\u1ef1c, ch\xfang t\xf4i khuy\xean \u1ee9ng vi\xean n\xean t\xecm c\xe1ch kh\xe1c \u0111\u1ec3 g\u1ecdi v\xe0 nh\u1eadn cu\u1ed9c g\u1ecdi. "),S(2,"br")(3,"br"),u(4," N\u1ebfu \u0111\u01b0\u1ee3c ch\u1ea5p thu\u1eadn v\xe0o ch\u01b0\u01a1ng tr\xecnh b\u1edfi nh\xe0 Qu\u1ea3n L\xfd California LifeLine, Gi\u1ea3m gi\xe1 California LifeLine s\u1ebd b\u1eaft \u0111\u1ea7u v\xe0o ng\xe0y nh\xe0 Qu\u1ea3n L\xfd California LifeLine th\xf4ng b\xe1o cho h\xe3ng \u0110i\u1ec7n tho\u1ea1i di \u0111\u1ed9ng c\u1ee7a \u1ee9ng vi\xean ho\u1eb7c l\xe0 ng\xe0y D\u1ecbch v\u1ee5 b\u1eaft \u0111\u1ea7u hi\u1ec7u l\u1ef1c (i. e., \u1ee8ng vi\xean c\u1ee7a California LifeLine c\xf3 th\u1ec3 g\u1ecdi ho\u1eb7c nh\u1eadn cu\u1ed9c g\u1ecdi d\xf9ng m\xe1y \u0111i\u1ec7n tho\u1ea1i do h\xe3ng \u0111i\u1ec7n tho\u1ea1i di \u0111\u1ed9ng cung c\u1ea5p), hi\u1ec7u l\u1ef1c ch\u1ecdn theo ng\xe0y \u0111\u1ebfn sau. "),S(5,"br")(6,"br"),u(7," Ngay khi d\u1ecbch v\u1ee5 gi\u1ea3m gi\xe1 c\xf3 hi\u1ec7u l\u1ef1c, ch\xfang t\xf4i khuy\xean \u1ee9ng vi\xean California LifeLine h\xe3y c\u1ea9n th\u1eadn ki\u1ec3m so\xe1t s\xf3ng v\xe0 v\xf9ng ph\xf9 s\xf3ng t\u1ea1i nh\xe0 ho\u1eb7c trong v\xf9ng m\xecnh th\u01b0\u1eddng xuy\xean. N\u1ebfu \u1ee9ng vi\xean kh\xf4ng h\xe0i l\xf2ng v\u1edbi s\xf3ng v\xe0 v\xf9ng ph\u1ee7 s\xf3ng, \u1ee9ng vi\xean c\xf3 quy\u1ec1n h\u0169y b\u1ecf d\u1ecbch v\u1ee5 gi\u1ea3m gi\xe1 trong v\xf2ng 14 ng\xe0y d\u1ecbch v\u1ee5 hi\u1ec7u l\u1ef1c m\xe0 kh\xf4ng b\u1ecb t\xednh l\xe0 h\u1ee7y b\u1ecf h\u1ee3p \u0111\u1ed3ng s\u1edbm. "),S(8,"br")(9,"br"),u(10," T\u1ea5t c\u1ea3 h\xe3ng \u0111i\u1ec7n tho\u1ea1i California LifeLine( d\u1ecbch v\u1ee5 nh\xe0 v\xe0 di \u0111\u1ed9ng) \u0111\u1ec1u b\u1eaft bu\u1ed9c ph\u1ea3i cung c\u1ea5p m\u1ed9t \u0111\u1eeb\u01a1ng d\xe2y ch\u1ea5t l\u01b0\u1ee3ng. Tuy nhi\xean, kh\xed h\u1eadu, c\xe2y c\u1ed1i, n\xfai, s\xf4ng, cao \u1ed1c, l\u01b0\u1ee3ng cu\u1ed9c g\u1ecdi, d\u1ecbch v\u1ee5 n\u0103ng l\u01b0\u1ee3ng, v\xe0 s\xf3ng v\xf9ng c\xf3 th\u1ec3 l\xe0m d\u1ecbch v\u1ee5 tr\u1eafc tr\u1edf ho\u1eb7c l\xe0 d\u01b0\u1edbi m\u1ee9c ch\u1ea5t l\u01b0\u1ee3ng. N\u1ebfu \u1ee9ng vi\xean California LifeLine kh\xf4ng c\xf3 \u0111\u01b0\u1ee3c \u0111\u01b0\u1eddng d\xe2y ch\u1ea5t l\u01b0\u1ee3ng, ch\xfang t\xf4i khuy\xean \u1ee9ng vi\xean n\xean th\xf4ng b\xe1o ngay cho c\xf4ng ty \u0111i\u1ec7n tho\u1ea1i. C\xf4ng ty \u0111i\u1ec7n tho\u1ea1i c\u1ee7a California LifeLine \u0111\u01b0\u1ee3c b\u1eaft bu\u1ed9c ph\u1ea3i s\u1eeda ch\u1eeda \u0111\u01b0\u1eddng d\xe2y ch\u1ea5t l\u01b0\u1ee3ng, h\u1ea7u cung c\u1ea5p d\u1ecbch v\u1ee5 \u0111i\u1ec7n tho\u1ea1i b\u1eb1ng m\u1ed9t m\u1ed9t ph\u01b0\u01a1ng th\u1ee9c kh\xe1c m\xe0 h\u1ecd c\xf3 th\u1ec3 v\u1edbi khoa h\u1ecdc hi\u1ec7n \u0111\u1ea1i, v\xe0 \u0111\u1ec3 kh\xe1ch h\xe0ng \u0111\u01b0\u1ee3c h\u0169y b\u1ecf d\u1ecbch v\u1ee5 trong v\xf2ng 14 ng\xe0y \u0111\u1ea7u m\xe0 kh\xf4ng b\u1ecb t\xednh l\xe0 h\u0169y b\u1ecf h\u1ee3p \u0111\u1ed3ng s\u1edbm. "),S(11,"br")(12,"br"),u(13," N\u1ebfu \u1ee9ng vi\xean ch\u01b0\u01a1ng tr\xecnh California LifeLine h\u0169y b\u1ecf d\u1ecbch v\u1ee5 California LifeLine trong v\xf2ng 3 ng\xe0y l\xe0m vi\u1ec7c t\u1eeb ng\xe0y d\u1ecbch v\u1ee5 hi\u1ec7u l\u1ef1c, kh\xf4ng t\xednh ng\xe0y l\u1ec5, c\xe1c h\xe3ng \u0111i\u1ec7n tho\u1ea1i c\u1ee7a California LifeLine b\u1eaft bu\u1ed9c ph\u1ea3i ho\xe0n l\u1ea1i, \u0111\u1ea7y \u0111\u1ee7, t\u1ea5t c\u1ea3 l\u1ec7 ph\xed d\u1ecbch v\u1ee5 m\u1edf \u0111\u01b0\u1eddng d\xe2y, th\u1ebf ch\xe2n cho kh\xe1ch h\xe0ng. "),S(14,"br")(15,"br"),u(16," Th\xeam v\xe0o \u0111\xf3, c\xe1c h\xe3ng \u0111i\u1ec7n tho\u1ea1i c\u1ee7a California LifeLine kh\xf4ng \u0111\u01b0\u1ee3c t\xednh l\u1ec7 ph\xed gi\u1ea5y t\u1edd n\u1ebfu kh\xe1ch h\xe0ng tr\u1ea3 \u0111i\u1ec7n tho\u1ea1i l\u1ea1i trong v\xf2ng 3 ng\xe0y l\xe0m vi\u1ec7c t\u1eeb khi \u0111\u01b0\u1eddng d\xe2y hi\u1ec7u l\u1ef1c, kh\xf4ng \u0111\u01b0\u1ee3c t\xednh ng\xe0y l\u1ec5 c\u1ee7a qu\u1ed1c gia. Tuy nhi\xean, kh\xe1ch h\xe0ng ph\u1ea3i tr\u1ea3 l\u1ec7 ph\xed x\u1eed d\u1ee5ng trong th\u1eddi gian t\u1eeb l\xfac \u0111\u1eeb\u01a1ng d\xe2y hi\u1ec7u l\u1ef1c \u0111\u1ebfn ng\xe0y h\u0169y b\u1ecf. "),l())}function Rdt(e,n){1&e&&(c(0,"div"),u(1," Simula Enero 16, 2014, mga kumpanya ng cell phone na nag-aalok ng diskwento para California LifeLine pre-paid cell phone ay maaaring hindi magbigay ng handset hanggang ang kumpanya ng cell phone ay nakatanggap ng abiso ng aprubadong pagiging karapat-dapat ang aplikante mula sa California LifeLine Administrator. Habang naghihintay para ma-aprobahan at ma-activate, hinihikayat namin ang mga aplikante upang makahanap ng iba pang mga paraan upang gumawa at tumanggap ng mga tawag. "),S(2,"br")(3,"br"),u(4," Kung inaprobahan ng California LifeLine Administrator, ang diskwento ng California LifeLine ay magsisimula sa alinman sa mga petsang Inabisuhan ng California LifeLine Administrator ang kumpanya ng cell phone ng aprubadong pagiging karapat-dapat ang aplikante o sa mga petsa na ang serbisyo ay na-activate (ibig sabihin, ang kalahok ng California LifeLine ay maaaring gumawa ng at tumanggap ng mga tawag sa mga handset na ibinigay ng California LifeLine service provider ng cell phone), kung alinman ang mamaya. "),S(5,"br")(6,"br"),u(7," Agad-agad matapos ang diskwentong serbisyo ay isinaaktibo, hinihikayat namin ang mga kalahok ng California LifeLine upang agad na suriin ang kanilang signal at coverage kasapatan sa tahanan at sa mga lugar na sila ay madalas. Kung ang isang kalahok ay hindi nasiyahan sa signal at coverage, ang mga kalahok ay maaring kanselahin ang kanilang mga diskwento ng serbisyo sa loob ng 14 araw ng pag-activate ng serbisyo nang walang incurring bayarin ng pagwawakas ng serbisyo ng maaga. "),S(8,"br")(9,"br"),u(10," Lahat ng California LifeLine (home at cell phone na serbisyo) providers ay kinakailangan na magbigay ng isang koneksyon boses-grade. Gayunpaman, panahon, mga puno, bundok, lupain, mga gusali, mga volume na tawag, paghinto ng serbisyo, at gaps signal ay maaaring gumawa ng infeasible serbisyo o sa ibaba ng koneksyon ng boses-grade. Kung ang mga ng kalahok California LifeLine ay mabigong makatanggap ng isang koneksyon boses-grade, hinihikayat namin ang mga ito upang na mabilis na ipaalam sa kanilang provider. Ang California LifeLine providers ay kinakailangang agad na ibalik ang koneksyon boses-grade, upang magbigay ng serbisyo sa telepono gamit ang ibang teknolohiya kung hindi posible sa mga umiiral na teknolohiya, at upang payagan ang mga kalahok upang kanselahin ang kanilang serbisyo sa loob ng 14 araw ng pag-activate ng serbisyo nang walang incurring bayarin ng pagwawakas ng serbisyo ng maaga. "),S(11,"br")(12,"br"),u(13," Kung ang kalahok ng California LifeLine ay kanselahin ang kanilang mga serbisyo ng California LifeLine cell phone sa loob ng tatlong araw ng pag-activate ng serbisyo ng negosyo, hindi kasama ang mga pista opisyal, ang providers ng California LifeLine ay kailangang i-refund, sa buong, sa anuman at lahat ng naaangkop na mga bayad at deposito ng serbisyo sa pagsasaaktibo sa kalahok. Bukod pa rito, ang mga providers ng California LifeLine ay hindi maaaring tasahin restocking fee sa mga kalahok kung ibabalik nila ang kanilang mga cell phone handset / device sa loob ng tatlong araw ng negosyo ng pag-activate ng serbisyo, hindi kasama ang pista opisyal. Gayunpaman, ang mga kalahok ay responsable parin para sa pagbabayad sa anumang mga pagsingil sa paggamit sa pagitan ng petsa ng pag-activate ng serbisyo at ang petsa ng pagkansela serbisyo. "),l())}function Idt(e,n){1&e&&(c(0,"div",76)(1,"h2",10),u(2,"Starting the Application Process"),l()())}function xdt(e,n){1&e&&(c(0,"div"),u(1," There are two ways to qualify for the program. You may qualify for California LifeLine via Program-Based OR Income-Based. Documentation of proof of eligibility is required. "),S(2,"br")(3,"br"),u(4," Under Program-Based, you may qualify for the California LifeLine discounts if you or another person in your household is already enrolled in one or more of the eligible public-assistance programs. "),c(5,"a",77),u(6,"Check out Is California LifeLine Right for You?"),l(),u(7," to see the list of eligible public-assistance programs. "),l())}function Pdt(e,n){1&e&&(c(0,"div"),u(1," Existen dos maneras de reunir los requisitos para el programa. Puede reunir los requisitos para el programa California LifeLine basado en el programa o basado en los ingresos. "),S(2,"br")(3,"br"),u(4," Seg\xfan el opcion, basado en el programa, puede reunir los requisitos para recibir los descuentos de California LifeLine en el caso de que usted u otra persona de su grupo familiar se encuentre inscrito en uno o m\xe1s de los programas elegibles de asistencia p\xfablica. Vea"),c(5,"a",77),u(6,"\xbfEl programa California LifeLine es adecuado para usted?"),l(),u(7," para ver la lista de programas elegibles de asistencia p\xfablica. "),l())}function Ndt(e,n){1&e&&(c(0,"div"),u(1," \u53ef\u900f\u904e\u5169\u7a2e\u65b9\u5f0f\u53c3\u52a0\u52a0\u5dde\u666e\u6fdf\u96fb\u8a71\u670d\u52d9\u7684\u8a08\u5283\u3002 \u900f\u904e\u8a08\u5283\u578b\u6216\u6536\u5165\u578b\uff0c\u60a8\u53ef\u80fd\u7b26\u5408\u4eab\u6709\u52a0\u5dde\u666e\u6fdf\u96fb\u8a71\u670d\u52d9\u7684\u8cc7\u683c\u3002 "),S(2,"br")(3,"br"),u(4," \u5982\u679c\u60a8\u6216\u60a8\u5bb6\u4eba\u767b\u8a18\u4e86\u4e00\u9805\u6216\u591a\u9805\u5408\u683c\u7684\u516c\u5171\u88dc\u52a9\u8a08\u5283\uff0c\u6839\u64da\u8a08\u5283\u578b\uff0c\u5373\u53ef\u4eab\u6709\u52a0\u5dde\u666e\u6fdf\u96fb\u8a71\u670d\u52d9\u7684\u6298\u6263\u3002 \u8acb\u67e5\u95b1 "),c(5,"a",77),u(6,"\u52a0\u5dde\u666e\u6fdf\u96fb\u8a71\u670d\u52d9\u662f\u5426\u9069\u5408\u60a8\uff1f"),l(),u(7," \u4ee5\u53d6\u5f97\u7b26\u5408\u8cc7\u683c\u7684\u516c\u5171\u88dc\u52a9\u8a08\u5283\u6e05\u55ae\u3002 "),l())}function qdt(e,n){1&e&&(c(0,"div"),u(1," \uce98\ub9ac\ud3ec\ub2c8\uc544 \ub77c\uc774\ud504\ub77c\uc778 \ud504\ub85c\uadf8\ub7a8 \uac00\uc785 \uc790\uaca9\uc744 \uc5bb\ub294 \ubc29\ubc95\uc740 \ub450 \uac00\uc9c0\uac00 \uc788\uc2b5\ub2c8\ub2e4. \ud504\ub85c\uadf8\ub7a8 \uae30\uc900 \ub610\ub294 \uc18c\ub4dd \uae30\uc900\uc744 \ud1b5\ud574 \uce98\ub9ac\ud3ec\ub2c8\uc544 \ub77c\uc774\ud504\ub77c\uc778 \uc790\uaca9\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc0c8 \uc2e0\uccad\uc790\ub294 \uc790\uaca9\uc744 \uc99d\uba85\ud558\ub294 \ud574\ub2f9 \uc99d\ube59\uc11c\ub958 \uc0ac\ubcf8\uc744 \uc2e0\uccad\uc11c\uc640 \ud568\uaed8 \uc81c\ucd9c \ud574\uc57c \ud569\ub2c8\ub2e4. "),S(2,"br")(3,"br"),u(4," \ud504\ub85c\uadf8\ub7a8 \uae30\uc900\uc758 \uacbd\uc6b0, \uadc0\ud558 \ub610\ub294 \uadc0 \uac00\uc815 \ub0b4 \uad6c\uc131\uc6d0\uc774 \ud558\ub098 \uc774\uc0c1\uc758 \uacf5\uacf5 \ubcf4\uc870 \ud504\ub85c\uadf8\ub7a8 \ud61c\ud0dd\uc744 \ubc1b\uace0 \uc788\ub2e4\uba74 \uce98\ub9ac\ud3ec\ub2c8\uc544 \ub77c\uc774\ud504\ub77c\uc778 \ud560\uc778 \ud61c\ud0dd\uc744 \ubc1b\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud574\ub2f9\ub418\ub294 \uacf5\uacf5 \ubcf4\uc870 \ud504\ub85c\uadf8\ub7a8 \ubaa9\ub85d\uc744 \ubcf4\ub824\uba74 "),c(5,"a",77),u(6,"\uce98\ub9ac\ud3ec\ub2c8\uc544 \ub77c\uc774\ud504\ub77c\uc778 \ud504\ub85c\uadf8\ub7a8 \uac00\uc785 \uc790\uaca9"),l(),u(7," \uc744 \ud655\uc778\ud558\uc2ed\uc2dc\uc624. "),l())}function Wdt(e,n){1&e&&(c(0,"div"),u(1," \u30d7\u30ed\u30b0\u30e9\u30e0\u306e\u8cc7\u683c\u3092\u5f97\u308b\u305f\u3081\u306b\u306f2\u901a\u308a\u306e\u65b9\u6cd5\u304c\u3042\u308a\u307e\u3059\u3002\u30d7\u30ed\u30b0\u30e9\u30e0\u30d9\u30fc\u30b9\u307e\u305f\u306f\u6240\u5f97\u30d9\u30fc\u30b9\u3092\u901a\u3057\u3066\u30ab\u30ea\u30d5\u30a9\u30eb\u30cb\u30a2\u30e9\u30a4\u30d5\u30e9\u30a4\u30f3\u306e\u8cc7\u683c\u3092\u5f97\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u8cc7\u683c\u8a3c\u660e\u306e\u6587\u66f8\u304c\u5fc5\u8981\u3067\u3042\u3059\u3002 "),S(2,"br")(3,"br"),u(4," \u30d7\u30ed\u30b0\u30e9\u30e0\u30d9\u30fc\u30b9\u306e\u5834\u5408\u3001\u3042\u306a\u305f\u3084\u3042\u306a\u305f\u306e\u5bb6\u5ead\u5185\u306e\u4eba\u304c\u3059\u3067\u306b\u9069\u683c\u516c\u5171\u652f\u63f4\u30d7\u30ed\u30b0\u30e9\u30e0\u306e1\u3064\u4ee5\u4e0a\u306b\u52a0\u5165\u3057\u3066\u3044\u308b\u5834\u5408\u306b\u306f\u3001\u30ab\u30ea\u30d5\u30a9\u30eb\u30cb\u30a2\u306e\u30e9\u30a4\u30d5\u30e9\u30a4\u30f3\u306e\u5272\u5f15\u3092\u53d7\u3051\u3089\u308c\u308b\u8cc7\u683c\u304c\u3042\u308a\u307e\u3059\u3002 "),c(5,"a",77),u(6,"Check out Is California LifeLine Right for You?"),l(),u(7," \u3067\u9069\u683c\u516c\u5171\u652f\u63f4\u30d7\u30ed\u30b0\u30e9\u30e0\u3092\u4e00\u89a7\u3067\u53c2\u7167\u3067\u304d\u307e\u3059\u3002 "),l())}function Hdt(e,n){1&e&&(c(0,"div"),u(1," C\xf3 hai c\xe1ch h\u1ed9i \u0111\u1ee7 \u0111i\u1ec1u ki\u1ec7n tham gia ch\u01b0\u01a1ng tr\xecnh. Qu\xfd v\u1ecb c\xf3 th\u1ec3 \u0111\u1ee7 ti\xeau chu\u1ea9n tham gia ch\u01b0\u01a1ng tr\xecnh gi\xe1 b\xecnh d\xe2n California theo Ph\u01b0\u01a1ng th\u1ee9c 1 D\u1ef1a tr\xean ch\u01b0\u01a1ng tr\xecnh hay Ph\u01b0\u01a1ng th\u1ee9c 2 D\u1ef1a tr\xean thu nh\u1eadp. "),S(2,"br")(3,"br"),u(4," Theo Ph\u01b0\u01a1ng th\u1ee9c 1 D\u1ef1a tr\xean ch\u01b0\u01a1ng tr\xecnh, qu\xfd v\u1ecb c\xf3 th\u1ec3 \u0111\u1ee7 \u0111i\u1ec1u ki\u1ec7n \u0111\u01b0\u1ee3c gi\u1ea3m gi\xe1 c\u01b0\u1edbc c\u1ee7a ch\u01b0\u01a1ng tr\xecnh gi\xe1 b\xecnh d\xe2n California n\u1ebfu qu\xfd v\u1ecb ho\u1eb7c b\u1ea5t k\u1ef3 ng\u01b0\u1eddi n\xe0o trong gia \u0111\xecnh c\u1ee7a qu\xfd v\u1ecb \u0111\xe3 \u0111\u01b0\u1ee3c tham gia v\xe0o m\u1ed9t ho\u1eb7c nhi\u1ec1u ch\u01b0\u01a1ng tr\xecnh tr\u1ee3 c\u1ea5p x\xe3 h\u1ed9i \u0111\u1ee7 \u0111i\u1ec1u ki\u1ec7n. Ch\u1ecdn "),c(5,"a",77),u(6," Ch\u01b0\u01a1ng Tr\xecnh Gi\xe1 B\xecnh D\xe2n California c\xf3 ph\xf9 h\u1ee3p v\u1edbi qu\xfd v\u1ecb kh\xf4ng?"),l(),u(7," \u0111\u1ec3 xem danh s\xe1ch c\xe1c ch\u01b0\u01a1ng tr\xecnh tr\u1ee3 c\u1ea5p x\xe3 h\u1ed9i \u0111\u1ee7 \u0111i\u1ec1u ki\u1ec7n. "),l())}function Vdt(e,n){1&e&&(c(0,"div"),u(1," Mayroong dalawang paraan upang maging kuwalipikado para sa programa. Maaari kang maging karapat-dapat para sa California LifeLine sa pamamagitan ng unang paraan na Nakabatay-sa-Programa O ikalawang paraan na Nakabatay-sa-Kita. "),S(2,"br")(3,"br"),u(4," Sa ilalim ng unang paraan na Nakabatay sa Programa, maaari kang maging kuwalipikado para sa mga diskwento sa California LifeLine kung ikaw o ang iba pang tao sa iyong sambahayan ay nakatala na sa isa o higit pa na karapat-dapat na mga programang tumutulong sa publiko. Tingnan ang "),c(5,"a",77),u(6,"Nararapat ba para sa iyo ang California LifeLine?"),l(),u(7," upang makita ang listahan ng mga karapat-dapat na mga programa ng pampublikong tulong. "),l())}function Ydt(e,n){1&e&&(c(0,"div"),u(1," Under Income-Based, you may qualify for California LifeLine if your annual total household income is at or less than the California LifeLine income limits. "),S(2,"br")(3,"br"),u(4," Household income includes, but is not limited to: wages, salaries, interest, dividends, alimony and child support, grants, gifts, allowances, stipends, lottery winnings, inheritances, worker's compensation, unemployment and public assistance benefits, social security payments, pensions, rental income, income from self-employment, cash payments from other sources, and all employment-related non-cash income. "),S(5,"br")(6,"br"),u(7," Check out "),c(8,"a",77),u(9,"Is California LifeLine Right for You?"),l(),u(10," to see the annual income limits. "),l())}function Udt(e,n){1&e&&(c(0,"div"),u(1," Seg\xfan el opcion, basado en los ingresos, puede reunir los requisitos para el programa California LifeLine si los ingresos totales anuales de su grupo familiar se encuentran en el l\xedmite o por debajo de los ingresos l\xedmite estipulados por California LifeLine. "),S(2,"br")(3,"br"),u(4," Los ingresos del grupo familiar incluyen todos aquellos ingresos recibidos por todas las personas que viven en su hogar, si le cobran impuestos o no. Se encuentran incluidos, entre otros: salarios, sueldos, intereses, dividendos, manutenci\xf3n conyugal e infantil, becas, donaciones, bonificaciones, remuneraciones, pagos de asistencia p\xfablica, seguros sociales, pensiones, ingresos de alquiler, ingresos como trabajador independiente y pagos en efectivo de otras fuentes, adem\xe1s de todos los ingresos laborales que no sean en efectivo. "),S(5,"br")(6,"br"),u(7," Vea "),c(8,"a",77),u(9,"\xbfEl programa California LifeLine es adecuado para usted?"),l(),u(10," para ver los l\xedmites de ingresos anuales. "),l())}function jdt(e,n){1&e&&(c(0,"div"),u(1," \u6839\u64da\u65b9\u6cd5\u4e8c\u6536\u5165\u578b\uff0c\u82e5\u60a8\u7684\u5bb6\u5ead\u7e3d\u5e74\u6536\u5165\u7b49\u65bc\u6216\u4f4e\u65bc\u300c\u52a0\u5dde\u666e\u6fdf\u96fb\u8a71\u670d\u52d9\u300d\u7684\u6536\u5165\u9650\u5236\uff0c\u5373\u6709\u53ef\u80fd\u7b26\u5408\u300c\u52a0\u5dde\u666e\u6fdf\u96fb\u8a71\u670d\u52d9\u300d\u7684\u8cc7\u683c\u3002 "),S(2,"br")(3,"br"),u(4," \u5bb6\u5ead\u6536\u5165\u5305\u542b\u5bb6\u4e2d\u6bcf\u4e00\u500b\u4eba\u7684\u6240\u6709\u6536\u5165\uff0c\u7121\u8ad6\u5176\u70ba\u61c9\u7a05\u6216\u672a\u61c9\u7a05\uff0c\u5305\u62ec\uff08\u4f46\u4e0d\u9650\u65bc\uff09\uff1a \u5de5\u8cc7\u3001\u85aa\u91d1\u3001\u5229\u606f\u3001\u80a1\u606f\u3001\u914d\u5076\u8d0d\u990a\u8cbb\u53ca\u5b50\u5973\u64ab\u990a\u8cbb\u3001\u88dc\u52a9\u91d1\u3001\u8d08\u4e88\u3001\u6d25\u8cbc\u3001\u96f6\u7528\u91d1\u3001\u516c\u5171\u88dc\u52a9\u6b3e\u3001\u793e\u6703\u4fdd\u96aa\u8207\u9000\u4f11\u91d1\u3001\u79df\u91d1\u6536\u5165\u3001\u81ea\u96c7\u6536\u5165\u3001\u5176\u4ed6\u4f86\u6e90\u7684\u73fe\u91d1\u6536\u5165\uff0c\u4ee5\u53ca\u6240\u6709\u8207\u5de5\u4f5c\u76f8\u95dc\u4e4b\u975e\u73fe\u91d1\u6536\u5165\u3002 "),S(5,"br")(6,"br"),u(7," \u8acb\u67e5\u95b1 "),c(8,"a",77),u(9,"\u52a0\u5dde\u666e\u6fdf\u96fb\u8a71\u670d\u52d9\u662f\u5426\u9069\u5408\u60a8\uff1f"),l(),u(10," \u4ee5\u6aa2\u8996\u5e74\u6536\u5165\u9650\u5236\u3002 "),l())}function Gdt(e,n){1&e