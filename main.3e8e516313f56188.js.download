c\ub428\uc774 \uc5c6\uc774 \uc601\uc18d\uc801\uc778 \uac1c\uc778 \uc815\ubcf4 \ubcf4\ud638 \uc815\ucc45\uc744 \uaddc\uc815\ud558\uace0 \uc720\uc9c0\ud574\uc57c \ud569\ub2c8\ub2e4. "),S(5,"br")(6,"br"),u(7," (a) \uac1c\uc778\uc744 \uc2dd\ubcc4\ud560 \uc218 \uc788\ub294 \uc815\ubcf4\ub294 \uc801\ubc95\ud55c \uc218\ub2e8\uc744 \ud1b5\ud574\uc11c\ub9cc \uc218\uc9d1\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. "),S(8,"br")(9,"br"),u(10," (b) \uac1c\uc778\uc744 \uc2dd\ubcc4\ud560 \uc218 \uc788\ub294 \ub370\uc774\ud130\ub97c \uc218\uc9d1\ud558\ub294 \ubaa9\uc801\uc744 \ub370\uc774\ud130 \uc218\uc9d1 \uc2dc \ub610\ub294 \uadf8 \uc804\uc5d0 \ubc1d\ud600\uc57c \ud558\uba70 \uc218\uc9d1\ud55c \ub370\uc774\ud130\ub97c \uc0ac\uc6a9\ud568\uc5d0 \uc788\uc5b4 \uc55e\uc11c \uc9c0\uc815\ud55c \ubaa9\uc801\uc744 \uc218\ud589\ud560 \uc6a9\ub3c4\ub85c\ub9cc \uc81c\ud55c\ud558\uc5ec \uc0ac\uc6a9\ud574\uc57c \ud569\ub2c8\ub2e4. "),S(11,"br")(12,"br"),u(13," (c) \ud574\ub2f9 \ub370\uc774\ud130\uc758 \uc81c\uacf5\uc790\uac00 \uc774\uc5d0 \ub3d9\uc758\ud55c \uacbd\uc6b0 \ub610\ub294 \ubc95\uc774\ub098 \uaddc\uc815\uc5d0 \uc758\ud574 \uc694\uad6c\ub418\ub294 \uacbd\uc6b0\ub97c \uc81c\uc678\ud558\uace0 \uac1c\uc778 \ub370\uc774\ud130\ub294 \uc9c0\uc815\ub41c \uc6a9\ub3c4 \uc774\uc678\uc758 \ubaa9\uc801\uc73c\ub85c \uacf5\uac1c \ub610\ub294 \uc0ac\uc6a9\ub420 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. "),S(14,"br")(15,"br"),u(16," (d) \uc218\uc9d1\ub418\ub294 \uac1c\uc778 \ub370\uc774\ud130\ub294 \uadf8 \uc218\uc9d1 \ubaa9\uc801\uacfc \uad00\ub828\uc774 \uc788\uc5b4\uc57c \ud569\ub2c8\ub2e4. "),S(17,"br")(18,"br"),u(19," (e) \uc77c\ubc18\uc801\uc778 \uc218\ub2e8\uc758 \uacf5\uac1c\uac00 \uae30\uad00\uc758 \uc801\ubc95\ud55c \ubaa9\ud45c \uc218\ud589\uc774\ub098 \ubc95 \uc9d1\ud589 \ubaa9\ud45c\uc5d0 \ubc18\ud558\uc9c0 \uc54a\ub294 \ud55c, \ubd84\uc2e4, \ubb34\ub2e8 \uc561\uc138\uc2a4, \uc0ac\uc6a9, \uc218\uc815 \ub610\ub294 \uacf5\uac1c\ub85c\ubd80\ud130 \uac1c\uc778 \ub370\uc774\ud130\ub97c \ubcf4\ud638\ud558\ub294 \uc77c\ubc18\uc801\uc778 \uc218\ub2e8\uc744 \uacf5\uac1c\ud574\uc57c \ud569\ub2c8\ub2e4. "),S(20,"br")(21,"br"),u(22," \uac01 \ubd80\uc11c\ub294 \uac1c\uc778 \uc815\ubcf4 \ubcf4\ud638 \uc815\ucc45 \uc2e4\ud589\uc744 \uc704\ud574 \ub2e4\uc74c\uc744 \uc218\ud589\ud574\uc57c \ud569\ub2c8\ub2e4. "),c(23,"ul")(24,"li"),u(25,"\ubcf8 \uac1c\uc778 \uc815\ubcf4 \ubcf4\ud638 \uc815\ucc45 \uc900\uc218\uc640 \uc2e4\ud589\uc744 \ub2f4\ub2f9\ud560 \ubd80\uc11c \ub610\ub294 \uae30\uad00 \ub0b4 \ucc45\uc784 \uc9c1\ucc45\uc744 \uc9c0\uc815"),l(),c(26,"li"),u(27,"\uac1c\uc778 \uc815\ubcf4 \ubcf4\ud638 \uc815\ucc45\uc744 \uc0ac\ubb34\uc2e4\uacfc \uc778\ud130\ub137 \uc6f9\uc0ac\uc774\ud2b8\uc5d0 \ub208\uc5d0 \ub744\uac8c \uac8c\uc2dc"),l(),c(28,"li"),u(29,"\uac1c\uc778 \ub370\uc774\ud130\uc5d0 \uc561\uc138\uc2a4\ud560 \uc218 \uc788\ub294 \uc815\uc9c1\uc6d0\uacfc \uacc4\uc57d\uc9c1 \ubaa8\ub450\uc5d0\uac8c \uac1c\uc778 \uc815\ubcf4 \ubcf4\ud638 \uc815\ucc45\uc744 \ubc30\ud3ec"),l(),c(30,"li"),u(31,"\uc815\ubcf4 \uad00\ub840\ubc95(Information Practices Act)(\ubbfc\ubc95 \uc81c 1798\uc870 \uc774\ud558 \ucc38\uc870), \uacf5\uacf5 \uae30\ub85d\ubc95(Public Records Act)(\uc815\ubd80\ubc95 \uc81c 6250\uc870 \uc774\ud558 \ucc38\uc870), \uc815\ubd80\ubc95 \uc81c 11015.5\uc870 \ubc0f \uae30\ud0c0 \uc815\ubcf4 \uc815\ucc45 \uad00\ub828 \ubc95\uc744 \uc900\uc218"),l(),c(32,"li"),u(33,"\ubcf8 \uac1c\uc778 \uc815\ubcf4 \ubcf4\ud638 \uc815\ucc45\uc758 \uc131\uacf5\uc801\uc778 \uc2e4\ud589\uacfc \uc900\uc218\ub97c \uc704\ud574 \uc801\uc808\ud55c \uc218\ub2e8\uc744 \uc0ac\uc6a9."),l()()())}function Gct(e,n){1&e&&(c(0,"div")(1,"h1"),u(2,"\u30d7\u30e9\u30a4\u30d0\u30b7\u30fc\u898f\u7d04"),l(),S(3,"hr"),u(4," \u653f\u5e9c\u30b3\u30fc\u30c9\u7b2c11019.9\u9805\u306b\u6e96\u62e0\u3057\u3001\u30ab\u30ea\u30d5\u30a9\u30eb\u30cb\u30a2\u5dde\u306e\u3059\u3079\u3066\u306e\u90e8\u5c40\u306f\u30011977\u5e74\u306e\u60c5\u5831\u624b\u7d9a\u6cd5\uff08\u6c11\u6cd5\u7b2c1798\u9805\u3001\u304a\u3088\u3073\u4ee5\u9