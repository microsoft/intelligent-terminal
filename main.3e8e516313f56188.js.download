4c\u8a8d\u3081\u3089\u308c\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002 \u3057\u304b\u3057\u3001\u5dde\u306f\u30e6\u30fc\u30b6\u30fc\u304c\u4f7f\u7528\u3059\u308b\u524d\u306b\u3042\u3089\u305f\u3081\u3066\u8a31\u53ef\u304c\u5fc5\u8981\u3068\u306a\u308b\u8457\u4f5c\u6a29\u306b\u3088\u308a\u4fdd\u8b77\u3055\u308c\u305f\u30c7\u30fc\u30bf\uff08\u5199\u771f\u306a\u3069\uff09\u3092\u4f7f\u7528\u3057\u307e\u305b\u3093\u3002 \u307e\u305f\u3001\u30b5\u30a4\u30c8\u56fa\u6709\u306e\u30d6\u30e9\u30f3\u30c7\u30a3\u30f3\u30b0\u3001\u304a\u3088\u3073\u69d8\u3005\u306a\u516c\u7684\u306a\u5370\u7ae0\u3001\u516c\u7684\u306a\u8a18\u53f7\u306f\u3001\u5dde\u306e\u8a31\u53ef\u306a\u3057\u306b\u4f7f\u7528\u3067\u304d\u307e\u305b\u3093\u3002 \u3053\u306e\u30b5\u30a4\u30c8\u306b\u542b\u307e\u308c\u308b\u60c5\u5831\u306e\u3046\u3061\u3001\u5dde\u306b\u3088\u3063\u3066\u6240\u6709\u307e\u305f\u306f\u4f5c\u6210\u3055\u308c\u3066\u3044\u306a\u3044\u3082\u306e\u3092\u4f7f\u7528\u3059\u308b\u306b\u306f\u3001\u305d\u306e\u6240\u6709\u8005\uff08\u307e\u305f\u306f\u4fdd\u6709\u8005\uff09\u8005\u304b\u3089\u76f4\u63a5\u8a31\u53ef\u3092\u6c42\u3081\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002 \u5dde\u306f\u3001\u3053\u306e\u30b5\u30a4\u30c8\u3092\u901a\u3057\u3066\u63d0\u51fa\u3055\u308c\u305f\u3059\u3079\u3066\u306e\u60c5\u5831\u3092\u3001\u3044\u304b\u306a\u308b\u76ee\u7684\u306b\u3082\u7121\u6599\u3067\u4f7f\u7528\u3059\u308b\u7121\u5236\u9650\u306e\u6a29\u5229\u3092\u6301\u3064\u3082\u306e\u3068\u3057\u307e\u3059\u3002\u305f\u3060\u3057\u5225\u306e\u6cd5\u7684\u5951\u7d04\u306e\u4e0b\u306b\u63d0\u793a\u3055\u308c\u305f\u3082\u306e\u306f\u9664\u304d\u307e\u3059\u3002 \u5dde\u306f\u3001\u3053\u306e\u30b5\u30a4\u30c8\u3092\u901a\u3057\u3066\u63d0\u51fa\u3055\u308c\u305f\u60c5\u5831\u306b\u542b\u307e\u308c\u308b\u3044\u304b\u306a\u308b\u30a2\u30a4\u30c7\u30a2\u3001\u30b3\u30f3\u30bb\u30d7\u30c8\u3001\u3042\u308b\u3044\u306f\u6280\u8853\u3092\u3042\u3089\u3086\u308b\u76ee\u7684\u306b\u81ea\u7531\u306b\u4f7f\u7528\u3067\u304d\u308b\u3082\u306e\u3068\u3057\u307e\u3059\u3002 "),S(161,"br")(162,"br"),l())}function _dt(e,n){1&e&&(c(0,"div")(1,"h4",10),u(2,"Th\xf4ng Tin V\xe0 L\u1ef1a ch\u1ecdn C\xe1 nh\xe2n"),l(),u(3,' "Th\xf4ng tin c\xe1 nh\xe2n" l\xe0 nh\u1eefng th\xf4ng tin v\u1ec1 m\u1ed9t con ng\u01b0\u1eddi t\u1ef1 nhi\xean nh\u1eadn bi\u1ebft ho\u1eb7c m\xf4 t\u1ea3 m\u1ed9t c\xe1 nh\xe2n, bao g\u1ed3m nh\u01b0ng kh\xf4ng gi\u1edbi h\u1ea1n, t\xean, s\u1ed1 an ninh x\xe3 h\u1ed9i, mi\xeau t\u1ea3 h\xecnh th\u1ec3, \u0111\u1ecba ch\u1ec9 nh\xe0, s\u1ed1 \u0111i\u1ec7n tho\u1ea1i nh\xe0, h\u1ecdc v\u1ea5n, t\xecnh h\xecnh t\xe0i ch\xednh, b\u1ec7nh s\u1eed ho\u1eb7c qu\xe1 tr\xecnh l\xe0m vi\u1ec7c c\u1ee7a ng\u01b0\u1eddi \u0111\xf3, s\u1eb5n s\xe0ng \u0111\u1ec3 c\xf3 th\u1ec3 nh\u1eadn bi\u1ebft \u0111\u01b0\u1ee3c c\xe1 nh\xe2n c\u1ee5 th\u1ec3 \u0111\xf3. M\u1ed9t t\xean mi\u1ec1n ho\u1eb7c \u0111\u1ecba ch\u1ec9 Giao th\u1ee9c Internet kh\xf4ng \u0111\u01b0\u1ee3c xem l\xe0 th\xf4ng tin c\xe1 nh\xe2n, tuy nhi\xean, \u0111\u01b0\u1ee3c xem l\xe0 "th\xf4ng tin c\xe1 nh\xe2n \u0111\u01b0\u1ee3c thu th\u1eadp b\u1eb1ng \u0111i\u1ec7n t\u1eed". '),S(4,"br")(5,"br"),u(6,' Theo B\u1ed9 lu\u1eadt Ch\xednh ph\u1ee7 \xa7 11015.5, "Th\xf4ng tin c\xe1 nh\xe2n \u0111\u01b0\u1ee3c thu th\u1eadp b\u1eb1ng \u0111i\u1ec7n t\u1eed" c\xf3 ngh\u0129a l\xe0 b\u1ea5t k\u1ef3 th\xf4ng tin n\xe0o \u0111\u01b0\u1ee3c duy tr\xec b\u1edfi m\u1ed9t c\u01a1 quan nh\u1eadn bi\u1ebft ho\u1eb7c m\xf4 t\u1ea3 m\u1ed9t c\xe1 nh\xe2n s\u1eed d\u1ee5ng, bao g\u1ed3m, nh\u01b0ng kh\xf4ng gi\u1edbi h\u1ea1n, t\xean, s\u1ed1 an ninh x\xe3 h\u1ed9i, mi\xeau t\u1ea3 h\xecnh th\u1ec3, \u0111\u1ecba ch\u1ec9 nh\xe0, s\u1ed1 \u0111i\u1ec7n tho\u1ea1i nh\xe0, h\u1ecdc v\u1ea5n, t\xecnh h\xecnh t\xe0i ch\xednh, b\u1ec7nh s\u1eed ho\u1eb7c qu\xe1 tr\xecnh l\xe0m vi\u1ec7c, m\u1eadt kh\u1ea9u, \u0111\u1ecba ch\u1ec9 th\u01b0 \u0111i\u1ec7n t\u1eed, v\xe0 nh\u1eefng th\xf4ng tin ti\u1ebft l\u1ed9 b\u1ea5t k\u1ef3 v\u1ecb tr\xed hay nh\u1eadn d\u1ea1ng tr\xean m\u1ea1ng n\xe0o, nh\u01b0ng kh\xf4ng bao g\u1ed3m b\u1ea5t k\u1ef3 th\xf4ng tin n\xe0o \u0111\u01b0\u1ee3c ng\u01b0\u1eddi s\u1eed d\u1ee5ng \u0111\u1ec7 tr\xecnh b\u1eb1ng tay t\u1edbi m\u1ed9t c\u01a1 quan ch\xednh ph\u1ee7, cho d\xf9 d\u01b0\u1edbi d\u1ea1ng \u0111i\u1ec7n t\u1eed hay b\u1eb1ng v\u0103n b\u1ea3n, v\xe0 nh\u1eefng th\xf4ng tin v\u1ec1 hay li\xean quan t\u1edbi c\xe1c c\xe1 nh\xe2n l\xe0 nh\u1eefng ng\u01b0\u1eddi s\u1eed d\u1ee5ng, l\xe0m vi\u1ec7c trong l\u0129nh v\u1ef1c kinh doanh, bao g\u1ed3m, nh\u01b0ng kh\xf4ng gi\u1edbi h\u1ea1n, ch\u1ee7 doanh nghi\u1ec7p, ng\u01b0\u1eddi qu\u1ea3n l\xfd, ho\u1eb7c nh\u1eefng ng\u01b0\u1eddi \u0111\u1ee9ng \u0111\u1ea7u doanh nghi\u1ec7p \u0111\xf3. '),S(7,"br")(8,"br"),u(9,' "Th\xf4ng tin c\xe1 nh\xe2n \u0111\u01b0\u1ee3c thu th\u1eadp b\u1eb1ng \u0111i\u1ec7n t\u1eed" m\xe0 ch\xfang t\xf4i t\u1ef1 \u0111\u1ed9ng thu th\u1eadp bao g\u1ed3m t\xean mi\u1ec1n ho\u1eb7c \u0111\u1ecba ch\u1ec9 Giao th\u1ee9c Internet c\u1ee7a qu\xfd v\u1ecb, v\xe0 th\xf4ng tin th\u1ed1ng k\xea v\u1ec1 nh\u1eefng trang web n\xe0o m\xe0 qu\xfd v\u1ecb truy c\u1eadp. N\u1ebfu qu\xfd v\u1ecb t\u1ef1 nguy\u1ec7n tham gia v\xe0o m\u1ed9t ho\u1ea1t \u0111\u1ed9ng \u0111\xf2i h\u1ecfi th\xf4ng tin c\u1ee5 th\u1ec3 (v\xed d\u1ee5 nh\u01b0 ho\xe0n th\xe0nh m\u1ed9t y\xeau c\u1ea7u h\u1ed7 tr\u1ee3, c\xe1 nh\xe2n h\xf3a n\u1ed9i dung trang web, g\u1eedi e-mail ho\u1eb7c tham gia m\u1ed9t cu\u1ed9c \u0111i\u1ec1u tra) d\u1eef li\u1ec7u chi ti\u1ebft h\u01a1n s\u1ebd \u0111\u01b0\u1ee3c thu th\u1eadp. N\u1ebfu qu\xfd v\u1ecb ch\u1ecdn kh\xf4ng tham gia v\xe0o nh\u1eefng ho\u1ea1t \u0111\u1ed9ng n\xe0y, s\u1ef1 l\u1ef1a ch\u1ecdn c\u1ee7a qu\xfd v\u1ecb s\u1ebd kh\xf4ng h\u1ec1 \u1ea3nh h\u01b0\u1edfng \u0111\u1ebfn kh\u1ea3 n\u0103ng s\u1eed d\u1ee5ng b\u1ea5t k\u1ef3 \u0111\u1eb7c \u0111i\u1ec3m n\xe0o kh\xe1c tr\xean trang web n\xe0y c\u1ee7a qu\xfd v\u1ecb. '),S(10,"br")(11,"br"),u(12," N\u1ebfu ng\u01b0\u1eddi s\u1eed d\u1ee5ng y\xeau c\u1ea7u tr\xean trang web n\xe0y ho\u1eb7c \u0111\u01b0\u1ee3c t\u1ef1 nguy\u1ec7n b\u1ea5t k\u1ef3 lo\u1ea1i th\xf4ng tin c\xe1 nh\xe2n n\xe0o, th\xec lu\u1eadt ph\xe1p nh\xe0 n\u01b0\u1edbc, bao g\u1ed3m \u0110\u1ea1o lu\u1eadt Th\u1ef1c h\xe0nh Th\xf4ng tin 1977, B\u1ed9 lu\u1eadt Ch\xednh ph\u1ee7 \u0111i\u1ec1u 11015.5, v\xe0 \u0110\u1ea1o lu\u1eadt Quy\u1ec1n Ri\xeang t\u01b0 c\u1ee7a li\xean bang n\u0103m 1974 c\xf3 th\u1ec3 b\u1ea3o v\u1ec7 nh\u1eefng th\xf4ng tin \u0111\xf3. Tuy nhi\xean, nh\u1eefng th\xf4ng tin n\xe0y c\xf3 th\u1ec3 l\xe0 m\u1ed9t h\u1ed3 s\u01a1 c\xf4ng c\u1ed9ng khi qu\xfd v\u1ecb cung c\u1ea5p n\xf3, v\xe0 c\xf3 th\u1ec3 l\xe0 \u0111\u1ed1i t\u01b0\u1ee3ng \u0111i\u1ec1u tra c\xf4ng c\u1ed9ng v\xe0 b\u1ecb sao ch\xe9p n\u1ebfu kh\xf4ng \u0111\u01b0\u1ee3c b\u1ea3o v\u1ec7 b\u1edfi lu\u1eadt ph\xe1p c\u1ee7a li\xean bang hay ti\u1ec3u bang. "),S(13,"br")(14,"br"),u(15," Ngo\xe0i ra, c\xe1c s\u1edf v\xe0 c\u01a1 quan c\u1ee7a Ti\u1ec3u Bang California ph\u1ea3i tu\xe2n th\u1ee7 tri\u1ec7t \u0111\u1ec3 Ch\xednh s\xe1ch Quy\u1ec1n Ri\xeang t\u01b0 m\xe0 c\u0169ng c\xf3 th\u1ec3 truy c\u1eadp \u0111\u01b0\u1ee3c tr\xean trang web n\xe0y. Vui l\xf2ng xem B\u1ea3n ghi nh\u1edb 00 \u2013 14 c\u1ee7a S\u1edf Qu\u1ea3n l\xfd c\xe1c D\u1ecbch v\u1ee5 Chung, c\xf3 hi\u1ec7u l\u1ef1c t\u1eeb ng\xe0y 1/ 1/ 2001. "),S(16,"br")(17,"br")(18,"hr"),c(19,"h4",11),u(20,"Ch\xfa \xfd \u0110\u1eb7c bi\u1ec7t v\u1ec1 Tr\u1ebb em"),l(),u(21," Tr\u1ebb em kh\xf4ng \u0111\u1ee7 \u0111i\u1ec1u ki\u1ec7n s\u1eed d\u1ee5ng c\xe1c d\u1ecbch v\u1ee5 y\xeau c\u1ea7u n\u1ed9p th\xf4ng tin c\xe1 nh\xe2n v\xe0 ch\xfang t\xf4i y\xeau c\u1ea7u r\u1eb1ng c\xe1c tr\u1ebb v\u1ecb th\xe0nh ni\xean (d\u01b0\u1edbi 18 tu\u1ed5i) kh\xf4ng n\u1ed9p b\u1ea5t k\u1ef3 th\xf4ng tin c\xe1 nh\xe2n n\xe0o cho ch\xfang t\xf4i. \u0110i\u1ec1u n\xe0y bao g\u1ed3m vi\u1ec7c n\u1ed9p th\xf4ng tin c\xe1 nh\xe2n cho Ti\u1ec3u Bang nh\u01b0 m\u1ed9t ph\u1ea7n c\u1ee7a h\u1ed3 s\u01a1 ng\u01b0\u1eddi s\u1eed d\u1ee5ng ho\u1eb7c h\u1ed3 s\u01a1 c\xe1 nh\xe2n. N\u1ebfu qu\xfd v\u1ecb l\xe0 tr\u1ebb v\u1ecb th\xe0nh ni\xean, qu\xfd v\u1ecb c\xf3 th\u1ec3 s\u1eed d\u1ee5ng nh\u1eefng d\u1ecbch v\u1ee5 n\xe0y ch\u1ec9 khi \u0111\u01b0\u1ee3c s\u1eed d\u1ee5ng c\xf9ng cha m\u1eb9 ho\u1eb7c ng\u01b0\u1eddi b\u1ea3o tr\u1ee3 c\u1ee7a qu\xfd v\u1ecb. N\u1ebfu qu\xfd v\u1ecb l\xe0 tr\u1ebb v\u1ecb th\xe0nh ni\xean, qu\xfd v\u1ecb n\xean c\xf3 s\u1ef1 h\u01b0\u1edbng d\u1eabn t\u1eeb cha m\u1eb9 c\u1ee7a m\xecnh. "),S(22,"br")(23,"br"),u(24," N\u1ebfu Ti\u1ec3u bang quy\u1ebft \u0111\u1ecbnh b\u1eaft \u0111\u1ea7u thu th\u1eadp th\xf4ng tin c\xe1 nh\xe2n t\u1eeb tr\u1ebb em, Ti\u1ec3u bang s\u1ebd th\xf4ng b\xe1o cho c\xe1c b\u1eadc cha m\u1eb9 r\u1eb1ng \u0111\xe2y l\xe0 \u0111i\u1ec1u \u0111\u01b0\u1ee3c y\xeau c\u1ea7u, c\xf4ng b\u1ed1 nh\u1eefng l\xfd do cho vi\u1ec7c thu th\u1eadp n\xe0y, v\xe0 c\xf4ng b\u1ed1 m\u1ee5c \u0111\xedch s\u1eed d\u1ee5ng th\xf4ng tin \u0111\xf3. Ti\u1ec3u bang s\u1ebd h\u1ecfi \xfd ki\u1ebfn \u0111\u1ed3ng \xfd c\u1ee7a cha m\u1eb9 tr\u01b0\u1edbc khi thu th\u1eadp b\u1ea5t k\u1ef3 th\xf4ng tin nh\u1eadn di\u1ec7n c\xe1 nh\xe2n n\xe0o. N\u1ebfu Ti\u1ec3u bang thu th\u1eadp th\xf4ng tin \u0111\xf3, cha m\u1eb9 c\xf3 th\u1ec3 y\xeau c\u1ea7u th\xf4ng tin v\u1ec1 ki\u1ec3u d\u1eef li\u1ec7u \u0111ang \u0111\u01b0\u1ee3c thu th\u1eadp, xem th\xf4ng tin v\u1ec1 con c\u1ee7a h\u1ecd v\xe0, n\u1ebfu h\u1ecd ch\u1ecdn, kh\xf4ng cho ph\xe9p Ti\u1ec3u bang s\u1eed d\u1ee5ng th\xeam n\u1eefa th\xf4ng tin v\u1ec1 con c\u1ee7a h\u1ecd. Ti\u1ec3u bang s\u1ebd kh\xf4ng cung c\u1ea5p th\xf4ng tin c\xe1 nh\xe2n v\u1ec1 tr\u1ebb em cho c\xe1c b\xean th\u1ee9 ba. "),S(25,"hr"),c(26,"h4",12),u(27,"Th\xf4ng tin Thu th\u1eadp \u0111\u01b0\u1ee3c v\xe0 C\xe1ch S\u1eed d\u1ee5ng"),l(),u(28," Ch\xfang t\xf4i thu th\u1eadp th\xf4ng tin c\xe1 nh\xe2n tr\u1ef1c ti\u1ebfp t\u1eeb c\xe1c c\