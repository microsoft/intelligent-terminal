u6cd5\u5f8b\u306b\u5f93\u3046\u3002"),l(),c(32,"li"),u(33,"\u3053\u306e\u30d7\u30e9\u30a4\u30d0\u30b7\u30fc\u898f\u7d04\u3092\u9069\u6b63\u306b\u5b9f\u65bd\u30fb\u9806\u5b88\u3059\u308b\u305f\u3081\u306b\u9069\u5207\u306a\u624b\u6bb5\u3092\u7528\u3044\u308b\u3002"),l()()())}function Xct(e,n){1&e&&(c(0,"div")(1,"h1"),u(2,"Ch\xednh s\xe1ch Quy\u1ec1n Ri\xeang T\u01b0"),l(),S(3,"hr"),u(4," Chi\u1ebfu theo B\u1ed9 lu\u1eadt Ch\xednh ph\u1ee7 \u0111i\u1ec1u 11019.9, t\u1ea5t c\u1ea3 c\xe1c s\u1edf v\xe0 c\xe1c c\u01a1 quan thu\u1ed9c Ti\u1ec3u Bang California s\u1ebd ban h\xe0nh v\xe0 duy tr\xec m\u1ed9t ch\xednh s\xe1ch quy\u1ec1n ri\xeang t\u01b0 l\xe2u d\xe0i, tu\xe2n th\u1ee7 tri\u1ec7t \u0111\u1ec3 \u0110\u1ea1o lu\u1eadt Th\u1ef1c h\xe0nh Th\xf4ng tin 1977 (B\u1ed9 lu\u1eadt D\xe2n s\u1ef1 \u0111i\u1ec1u 1798 v\xe0 ti\u1ebfp theo) bao g\u1ed3m, nh\u01b0ng kh\xf4ng nh\u1ea5t thi\u1ebft gi\u1edbi h\u1ea1n \u1edf, c\xe1c nguy\xean t\u1eafc sau: "),S(5,"br")(6,"br"),u(7," (a) Th\xf4ng tin nh\u1eadn di\u1ec7n c\xe1 nh\xe2n ch\u1ec9 c\xf3 th\u1ec3 l\u1ea5y \u0111\u01b0\u1ee3c th\xf4ng qua c\xe1c ph\u01b0\u01a1ng ti\u1ec7n h\u1ee3p ph\xe1p. "),S(8,"br")(9,"br"),u(10," (b)C\xe1c m\u1ee5c \u0111\xedch m\xe0 theo \u0111\xf3 d\u1eef li\u1ec7u nh\u1eadn di\u1ec7n c\xe1 nh\xe2n \u0111\u01b0\u1ee3c thu th\u1eadp ph\u1ea3i \u0111\u01b0\u1ee3c n\xeau r\xf5 v\xe0o ho\u1eb7c tr\u01b0\u1edbc th\u1eddi \u0111i\u1ec3m thu th\u1eadp, v\xe0 b\u1ea5t c\u1ee9 vi\u1ec7c s\u1eed d\u1ee5ng d\u1eef li\u1ec7u n\xe0y sau \u0111\xf3 ph\u1ea3i b\u1ecb gi\u1edbi h\u1ea1n v\xe0 ph\xf9 h\u1ee3p v\u1edbi vi\u1ec7c th\u1ef1c hi\u1ec7n c\xe1c m\u1ee5c \u0111\xedch \u0111\xe3 \u0111\u01b0\u1ee3c n\xeau r\xf5 t\u1eeb tr\u01b0\u1edbc. "),S(11,"br")(12,"br"),u(13," (c)D\u1eef li\u1ec7u c\xe1 nh\xe2n c\xf3 th\u1ec3 kh\xf4ng \u0111\u01b0\u1ee3c ti\u1ebft l\u1ed9, chu\u1ea9n b\u1ecb s\u1eb5n, ho\u1eb7c \u0111\u01b0\u1ee3c s\u1eed d\u1ee5ng cho m\u1ed9t m\u1ee5c \u0111\xedch n\xe0o \u0111\xf3 kh\xe1c v\u1edbi nh\u1eefng m\u1ee5c \u0111\xedch \u0111\xe3 \u0111\u01b0\u1ee3c n\xeau r\xf5, tr\u1eeb khi \u0111\u01b0\u1ee3c s\u1ef1 ch\u1ea5p thu\u1eadn c\u1ee7a ch\u1ee7 th\u1ec3 c\u1ee7a d\u1eef li\u1ec7u \u0111\xf3, ho\u1eb7c khi \u0111\u01b0\u1ee3c y\xeau c\u1ea7u b\u1edfi lu\u1eadt ph\xe1p hay quy \u0111\u1ecbnh. "),S(14,"br")(15,"br"),u(16," (d) D\u1eef li\u1ec7u c\xe1 nh\xe2n thu th\u1eadp \u0111\u01b0\u1ee3c ph\u1ea3i li\xean quan \u0111\u1ebfn m\u1ee5c \u0111\xedch m\xe0 theo \u0111\xf3 d\u1eef li\u1ec7u n\xe0y c\u1ea7n \u0111\u1ebfn. "),S(17,"br")(18,"br"),u(19," (e) C\xe1c ph\u01b0\u01a1ng ti\u1ec7n chung m\xe0 qua \u0111\xf3 d\u1eef li\u1ec7u c\xe1 nh\xe2n \u0111\u01b0\u1ee3c b\u1ea3o v\u1ec7 \u0111\u1ec3 kh\u1ecfi b\u1ecb m\u1ea5t, b\u1ecb truy c\u1eadp, s\u1eed d\u1ee5ng, ch\u1ec9nh s\u1eeda tr\xe1i ph\xe9p, ho\u1eb7c b\u1ecb ti\u1ebft l\u1ed9 s\u1ebd \u0111\u01b0\u1ee3c \u0111\u0103ng t\u1ea3i, tr\u1eeb phi vi\u1ec7c ti\u1ebft l\u1ed9 c\xe1c ph\u01b0\u01a1ng ti\u1ec7n chung n\xe0y l\xe0m t\u1ed5n h\u1ea1i \u0111\u1ebfn c\xe1c m\u1ee5c ti\xeau c\u1ee7a c\xe1c c\u01a1 quan h\u1ee3p ph\xe1p ho\u1eb7c c\xe1c m\u1ee5c \u0111\xedch th\u1ef1c thi ph\xe1p lu\u1eadt. "),S(20,"br")(21,"br"),u(22," M\u1ed7i s\u1edf ph\u1ea3i th\u1ef1c hi\u1ec7n ch\xednh s\xe1ch quy\u1ec1n ri\xeang t\u01b0 n\xe0y b\u1eb1ng c\xe1ch: "),c(23,"ul")(24,"li"),u(25,"Ch\u1ec9 \u0111\u1ecbnh v\u1ecb tr\xed n\xe0o trong s\u1edf ho\u1eb7c c\u01a1 quan ch\u1ecbu tr\xe1ch nhi\u1ec7m th\u1ef1c hi\u1ec7n v\xe0 tu\xe2n th\u1ee7 tri\u1ec7t \u0111\u1ec3 ch\xednh s\xe1ch quy\u1ec1n ri\xeang t\u01b0 n\xe0y;"),l(),c(26,"li"),u(27,"\u0110\u0103ng n\u1ed5i b\u1eadt ch\xednh s\xe1ch n\xe0y trong c\xe1c v\u0103n ph\xf2ng v\xe0 tr\xean c\xe1c trang web c\u1ee7a m\xecnh, n\u1ebfu c\xf3;"),l(),c(28,"li"),u(29,"Ph\xe2n ph\xe1t ch\xednh s\xe1ch n\xe0y t\u1edbi t\u1eebng nh\xe2n vi\xean v\xe0 c\xe1c nh\xe0 th\u1ea7u \u0111\u01b0\u1ee3c truy c\u1eadp v\xe0o d\u1eef li\u1ec7u c\xe1 nh\xe2n;"),l(),c(30,"li"),u(31,"Tu\xe2n th\