\uc758\ub8cc \ub610\ub294 \uc9c1\uc7a5 \uae30\ub85d, \uc554\ud638, \uc774\uba54\uc77c \uc8fc\uc18c, \ub124\ud2b8\uc6cc\ud06c \uc704\uce58 \ub610\ub294 ID\ub97c \uacf5\uac1c\ud558\ub294 \uc815\ubcf4 \ub4f1\uc744 \ud3ec\ud568\ud558\ub098 \uc774\uc5d0 \ud55c\uc815\ub428\uc774 \uc5c6\uace0, \uc815\ubd80 \uae30\uad00\uc5d0 \uc758\ud574 \uad00\ub9ac\ub418\ub294, \uac1c\uc778 \uc0ac\uc6a9\uc790\ub97c \uc2dd\ubcc4\ud558\uac70\ub098 \uc124\uba85\ud558\ub294 \ubaa8\ub4e0 \uc815\ubcf4\ub97c \uc758\ubbf8\ud569\ub2c8\ub2e4. \ub2e8, \uc0ac\uc6a9\uc790\uac00 \uc815\ubd80 \uae30\uad00\uc5d0 \uc9c1\uc811 \uc804\uc790\uc801\uc73c\ub85c \ub610\ub294 \uc11c\uba74\uc73c\ub85c \uc81c\ucd9c\ud55c \uc591\uc2dd \ubc0f \uc815\ubcf4 \ub610\ub294 \uc0ac\uc5c5 \uc18c\uc720\uc8fc, \uc0ac\ubb34\uc6d0 \ub610\ub294 \ud574\ub2f9 \uc5c5\uccb4\uc758 \uc7a5\uc744 \ud3ec\ud568\ud558\ub098 \uc774\uc5d0 \ud55c\uc815\ub428\uc774 \uc5c6\uc774 \uc5c5\ubb34 \uc790\uaca9\uc73c\ub85c \uadfc\ubb34\ud558\uace0 \uc788\ub294 \uc0ac\uc6a9\uc790 \uac1c\uc778\uc5d0 \ub300\ud55c \uad00\ub828 \uc815\ubcf4\ub294 \uc81c\uc678\ub429\ub2c8\ub2e4. '),S(7,"br")(8,"br"),u(9,' \uc790\ub3d9\uc73c\ub85c \uc218\uc9d1\ub418\ub294 "\uc804\uc790\uc801\uc73c\ub85c \uc218\uc9d1\ub41c \uac1c\uc778 \uc815\ubcf4"\uc5d0\ub294 \ub3c4\uba54\uc778 \uc774\ub984 \ub610\ub294 \uc778\ud130\ub137 \ud504\ub85c\ud1a0\ucf5c \uc8fc\uc18c, \uadc0\ud558\uac00 \ubc29\ubb38\ud558\ub294 \uc6f9 \uc0ac\uc774\ud2b8\uc5d0 \ub300\ud55c \ud1b5\uacc4 \uc815\ubcf4 \ub4f1\uc774 \ud3ec\ud568\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uba74, \uc9c0\uc6d0 \uc694\uccad\uc11c \uc791\uc131, \uc6f9 \uc0ac\uc774\ud2b8 \ucee8\ud150\ud2b8 \uc0ac\uc6a9\uc790 \uc815\uc758, \uc774\uba54\uc77c \uc804\uc1a1 \ub610\ub294 \uc124\ubb38\uc870\uc0ac \ucc38\uc5ec \ub4f1 \ud2b9\uc815 \uc815\ubcf4\ub97c \uc694\uad6c\ud558\ub294 \ud65c\ub3d9\uc5d0 \uc790\ubc1c\uc801\uc73c\ub85c \ucc38\uc5ec\ud558\ub294 \uacbd\uc6b0\uc5d0\ub294 \ubcf4\ub2e4 \uc0c1\uc138\ud55c \ub370\uc774\ud130\uac00 \uc218\uc9d1\ub429\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ud65c\ub3d9\uc5d0 \ucc38\uc5ec\ud558\uc9c0 \uc54a\uae30\ub85c \uacb0\uc815\ud558\uc600\ub2e4 \ud574\ub3c4 \uc544\ubb34\ub7f0 \ubb38\uc81c \uc5c6\uc774 \ubcf8 \uc6f9\uc0ac\uc774\ud2b8\uc758 \ub2e4\ub978 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. '),S(10,"br")(11,"br"),u(12," \ubcf8 \uc6f9\uc0ac\uc774\ud2b8\uc5d0\uc11c \uc694\uccad\ud558\uc600\uac70\ub098 \uc0ac\uc6a9\uc790\uac00 \uc790\ubc1c\uc801\uc73c\ub85c \uc81c\uacf5\ud55c \ubaa8\ub4e0 \uac1c\uc778 \uc815\ubcf4\ub294 1977\ub144 \uc815\ubcf4 \uad00\ub840\ubc95(Information Practices Act), \uc815\ubd80\ubc95 \uc81c11015.5\uc870, 1974\ub144 \uc5f0\ubc29 \uac1c\uc778 \uc815\ubcf4 \ubcf4\ud638\ubc95(Federal Privacy Act) \ub4f1\uc744 \ube44\ub86f\ud55c \uc8fc\ubc95\uc5d0 \uc758\uac70\ud558\uc5ec \ubcf4\ud638 \ubc1b\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8, \ud574\ub2f9 \uc815\ubcf4\ub294 \uc77c\ub2e8 \uc81c\ucd9c\ub418\uace0 \ub098\uba74 \uacf5\uacf5 \uae30\ub85d\uc774 \ub418\uc5b4, \uc5f0\ubc29\ubc95 \ub610\ub294 \uc8fc\ubc95\uc5d0 \uc758\ud574 \ub2ec\ub9ac \ubcf4\ud638\ub418\uc9c0 \uc54a\ub294 \ud55c, \uacf5\uacf5 \uc5f4\ub78c \ubc0f \ubcf5\uc0ac \ub300\uc0c1\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. "),S(13,"br")(14,"br"),u(15," \ub610\ud55c, \uce98\ub9ac\ud3ec\ub2c8\uc544\uc8fc \uc0b0\ud558 \ubd80\uc11c \ubc0f \uc9c1\uc6d0\uc740 \uac1c\uc778 \uc815\ubcf4 \ubcf4\ud638 \uc815\ucc45\uc744 \uc900\uc218\ud574\uc57c \ud558\uba70 \ud574\ub2f9 \uc815\ucc45\uc740 \ubcf8 \uc6f9 \uc0ac\uc774\ud2b8\uc5d0\uc11c\ub3c4 \uc5f4\ub78c\ud558\uc2e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ucd1d\ubb34\ubd80 \uba54\ubaa8 00-14(2001\ub144 1\uc6d4 1\uc77c \ubc1c\ud6a8)\ub97c \ucc38\uc870\ud558\uc2ed\uc2dc\uc624. "),S(16,"br")(17,"br")(18,"hr"),c(19,"h4",11),u(20,"\uc5b4\ub9b0\uc774 \uad00\ub828 \ud2b9\ubcc4 \uc720\uc758 \uc0ac\ud56d"),l(),u(21," \uc5b4\ub9b0\uc774\uc758 \uacbd\uc6b0\ub294 \uac1c\uc778 \uc815\ubcf4 \uc81c\ucd9c\uc744 \uc694\uad6c\ud558\ub294 \uc11c\ube44\uc2a4\ub97c \uc0ac\uc6a9\ud560 \uc790\uaca9\uc774 \uc5c6\uc73c\uba70 18\uc138 \ubbf8\ub9cc\uc758 \ubbf8\uc131\ub144\uc790\ub294 \uac1c\uc778 \uc815\ubcf4\ub97c \uc81c\ucd9c\ud560 \uc218 \uc5c6\ub3c4\ub85d \uaddc\uc815\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uac1c\uc778 \uc815\ubcf4\ub97c \uc0ac\uc6a9\uc790 \ud504\ub85c\ud544 \ub610\ub294 \uc0ac\uc6a9\uc790 \uc815\uc758 \ud504\ub85c\ud544\uc758 \uc77c\ubd80\ub85c \uce98\ub9ac\ud3ec\ub2c8\uc544\uc8fc\uc5d0 \uc81c\ucd9c\ud558\ub294 \ud589\uc704\ub3c4 \uc774\uc5d0 \ud3ec\ud568\ub429\ub2c8\ub2e4. \ubbf8\uc131\ub144\uc790\uc758 \uacbd\uc6b0\uc5d0\ub294 \ubd80\ubaa8\ub098 \ubcf4\ud638\uc790\uc758 \ubcf4\ud638 \ud558\uc5d0\uc11c\ub9cc \ubcf8 \uc11c\ube44\uc2a4\ub97c \uc774\uc6a9\ud560 \uc218 \uc788\uc73c\ubbc0\ub85c \ubd80\ubaa8\ub2d8\uc758 \ub3d9\uc758\ub97c \uba3c\uc800 \ubc1b\uc544\uc57c \ud569\ub2c8\ub2e4. "),S(22,"br")(23,"br"),u(24," \uce98\ub9ac\ud3ec\ub2c8\uc544\uc8fc\ub294 \uc5b4\ub9b0\uc774\uc758 \uac1c\uc778 \uc815\ubcf4 \uc218\uc9d1\uc774 \ud544\uc694\ud55c \uacbd\uc6b0, \ubd80\ubaa8\uc5d0\uac8c \ud574\ub2f9 \uc815\ubcf4 \uc694\uccad\uc744 \ud1b5\uc9c0\ud558\uba70 \uc815\ubcf4 \uc218\uc9d1\uc758 \uc774\uc720\uc640 \uc815\ubcf4 \uc0ac\uc6a9 \ubaa9\uc801\uc744 \ubc1d\ud788\uac8c \ub429\ub2c8\ub2e4. \uce98\ub9ac\ud3ec\ub2c8\uc544\uc8fc\ub294 \uc5b4\ub9b0\uc774\uc758 \uc2e0\ubd84\uc744 \uc2dd\ubcc4\ud560 \uc218 \uc788\ub294 \uac1c\uc778 \uc815\ubcf4\ub97c \uc218\uc9d1\ud558\uae30 \uc804\uc5d0 \ubd80\ubaa8\ub85c\ubd80\ud130 \ub3d9\uc758\ub97c \uad6c\ud558\uac8c \ub429\ub2c8\ub2e4. \uc5b4\ub9b0\uc774\uc758 \uac1c\uc778 \uc815\ubcf4\ub97c \uc218\uc9d1\ud558\ub294 \uacbd\uc6b0, \uadf8 \ubd80\ubaa8\ub294 \uc218\uc9d1 \uc911\uc778 \ub370\uc774\ud130\uc5d0 \ub300\ud55c \uc815\ubcf4\ub97c \uc694\uccad\ud560 \uc218 \uc788\uc73c\uba70 \uc790\ub140\uc758 \uac1c\uc778 \uc815\ubcf4\ub97c \uc5f4\ub78c\ud560 \uc218 \uc788\uc73c\uba70 \uc6d0\ud558\ub294 \uacbd\uc6b0 \uce98\ub9ac\ud3ec\ub2c8\uc544\uc8fc\uac00 \uc790\ub140\uc758 \uc815\ubcf4\ub97c \ub354 \uc774\uc0c1 \uc0ac\uc6a9\ud558\uc9c0 \ubabb\ud558\ub3c4\ub85d \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uce98\ub9ac\ud3ec\ub2c8\uc544\uc8fc\ub294 \uc5b4\ub9b0\uc774\uc758 \uac1c\uc778 \uc815\ubcf4\ub97c \uc81c3\uc790\uc5d0\uac8c \uc81c\uacf5\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. "),S(25,"hr"),c(26,"h4",12),u(27,"\uc218\uc9d1\ub418\ub294 \uc815\ubcf4 \ubc0f \uc774\uc6a9 \ubc29\ubc95"),l(),u(28," \uc6b0\ub9ac\ub294 \uc790\ubc1c\uc801\uc73c\ub85c \ubcf8 \uc11c\ube44\uc2a4\ub97c \uc774\uc6a9\ud558\uace0\uc790 \ud558\ub294 \uac1c\uc778\uc73c\ub85c\ubd80\ud130 \uac1c\uc778 \uc815\ubcf4\ub97c \uc9c1\uc811 \uc218\uc9d1\ud569\ub2c8\ub2e4. \ud2b9\uc815 \uc11c\ube44\uc2a4\ub97c \uc81c\uacf5\ud558\ub824\uba74 \uac1c\uc778 \uc815\ubcf4\ub97c \uc218\uc9d1\ud574\uc57c \ud558\uc9c0\ub9cc \ud574\ub2f9 \uc11c\ube44\uc2a4\uc758 \uc0ac\uc6a9\uc740 \uc790\ubc1c\uc801\uc778 \uac83\uc785\ub2c8\ub2e4. "),S(29,"br")(30,"br"),u(31," \ubcf8 \uc6f9\uc0ac\uc774\ud2b8\ub97c \ubc29\ubb38\ud558\uace0 \uc788\ub294 \ub3d9\uc548 \uc544\ubb34\ub7f0 \uc791\uc5c5\ub3c4 \ud558\uc9c0 \uc54a\uace0 \uc815\ubcf4 \uac80\uc0c9\uc774\ub098 \ub2e4\uc6b4\ub85c\ub4dc\ub9cc \ud574\ub3c4, \uadc0\ud558\uc758 \ubc29\ubb38\uc5d0 \ub300\ud55c \ub2e4\uc74c \uc815\ubcf4\uac00 \uc790\ub3d9\uc73c\ub85c \uc218\uc9d1\ub418\uc5b4 \uc800\uc7a5\ub429\ub2c8\ub2e4. "),c(32,"ol")(33,"li"),u(34,"\uc0ac\uc6a9\ub41c \uc778\ud130\ub137 \ud504\ub85c\ud1a0\ucf5c \uc8fc\uc18c\uc640 \ub3c4\uba54\uc778 \uc774\ub984. \ub2e8, \uc774\uba54\uc77c \uc8fc\uc18c\ub294 \uc81c\uc678. \uc778\ud130\ub137 \ud504\ub85c\ud1a0\ucf5c \uc8fc\uc18c\ub294 \uadc0\ud558\uc758 \uc778\ud130\ub137 \uc11c\ube44\uc2a4 \uacf5\uae09\uc790\uc5d0\uac8c \ub610\ub294 \uadc0\ud558\uc758 \ucef4\ud4e8\ud130\uc5d0 \uc9c1\uc811 \ud560\ub2f9\ub41c \uc22b\uc790 ID\uc785\ub2c8\ub2e4. \ub2f9\uc0ac\ub294 \uc778\ud130\ub137 \ud504\ub85c\ud1a0\ucf5c \uc8fc\uc18c\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc0ac\uc6a9\uc790\uc5d0\uac8c \uc778\ud130\ub137 \ud2b8\ub798\ud53