 \uadc0\ud558\uc758 \uc694\uccad\uc744 \ubcf4\ub2e4 \ud6a8\uc728\uc801\uc73c\ub85c \ucc98\ub9ac\ud560 \uc218 \uc788\ub294 \uce98\ub9ac\ud3ec\ub2c8\uc544\uc8fc\uc758 \ub2e4\ub978 \uc9c1\uc6d0\uc5d0\uac8c \uadc0\ud558\uc758 \uc774\uba54\uc77c\uc744 \uc804\ub2ec\ud558\ub294 \uacbd\uc6b0\uac00 \ubc1c\uc0dd\ud558\ub294\ub370 \uadf8 \uc9c1\uc6d0\uc774 \uce98\ub9ac\ud3ec\ub2c8\uc544\uc8fc \ub0b4\uc758 \ub2e4\ub978 \uae30\uad00 \uc18c\uc18d\uc77c \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4. \ud5c8\uac00\ub41c \ubc95 \uc9d1\ud589 \uc218\uc0ac\uc774\uac70\ub098 \ubc95\uc5d0 \uc758\ud574 \uc694\uad6c\ub418\ub294 \uacbd\uc6b0\ub97c \uc81c\uc678\ud558\uace0, \uc6b0\ub9ac\ub294 \uc774\uba54\uc77c\uc744 \ud0c0 \uc870\uc9c1\uacfc \uacf5\uc720\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. "),S(94,"br")(95,"br"),u(96," \uc6b0\ub9ac\ub294 \uadc0\ud558\uc758 \uc694\uccad\uc5d0 \uc801\uc808\ud788 \ub300\uc751\ud558\uae30 \uc704\ud574 \uadc0\ud558\uc758 \uc774\uba54\uc77c\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc989, \uadc0\ud558\uc758 \uc694\uccad\uc5d0 \ud68c\uc2e0\ud558\uae30 \uc704\ud574, \uadc0\ud558\uac00 \uc9c0\uc801\ud55c \ubb38\uc81c\ub97c \uc81c\ucd9c\ud558\uae30 \uc704\ud574, \ubcf8 \uc6f9 \uc0ac\uc774\ud2b8\ub97c \ub354\uc6b1 \ud5a5\uc0c1\uc2dc\ud0a4\uae30 \uc704\ud574 \ub610\ub294 \uc801\uc808\ud55c \ucc98\ub9ac\ub97c \uc704\ud574 \ub2e4\ub978 \uae30\uad00\uc5d0 \uc804\ub2ec\ud558\uae30 \uc704\ud574 \uadc0\ud558\uc758 \uc774\uba54\uc77c\uc744 \uc0ac\uc6a9\ud560 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4. "),S(97,"hr"),c(98,"h4",17),u(99,"\uc8fc\ubb38 \uc591\uc2dd"),l(),u(100," \uc6b0\ub9ac\uc5d0\uac8c \uc8fc\ubb38\uc744 \ud558\ub294 \uacbd\uc6b0 \uc6b0\ub9ac\ub294 \uc8fc\ubb38 \uc591\uc2dd\uc5d0 \ud544\uc694\ud55c \uc815\ubcf4\ub97c \uc0ac\uc6a9\uc790\uc5d0\uac8c \uc694\uccad\ud558\uac8c \ub429\ub2c8\ub2e4. \uc0ac\uc6a9\uc790\ub294 \uc5f0\ub77d\ucc98 \uc815\ubcf4(\uc774\ub984 \ubc0f \ubc30\uc1a1 \uc8fc\uc18c)\uc640 \uae08\uc735 \uc815\ubcf4(\uc2e0\uc6a9 \uce74\ub4dc \ubc88\ud638, \ub9cc\ub8cc \uc77c\uc790)\ub97c \ubc18\ub4dc\uc2dc \uae30\uc785\ud574\uc57c \ud569\ub2c8\ub2e4. \uc774 \uc815\ubcf4\ub294 \uccad\uad6c \uc6a9\ub3c4\ub85c \uc0ac\uc6a9\ub418\uba70 \uadc0\ud558\uc758 \uc8fc\ubb38/\uc694\uccad \ucda9\uc871\uc744 \uc704\ud574 \uc0ac\uc6a9\ub429\ub2c8\ub2e4. \uc8fc\ubb38 \ucc98\ub9ac\uc5d0 \ubb38\uc81c\uac00 \uc788\ub294 \uacbd\uc6b0 \uc5f0\ub77d\ucc98 \uc815\ubcf4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uadc0\ud558\uc5d0\uac8c \uc5f0\ub77d\ud558\uac8c \ub429\ub2c8\ub2e4. "),S(101,"br")(102,"br")(103,"hr"),c(104,"h4",18),u(105,"\uc815\ubcf4 \uacf5\uac1c"),l(),u(106," \uce98\ub9ac\ud3ec\ub2c8\uc544\uc8fc\uc5d0\uc11c\ub294 \uc5f4\ub9b0 \uc815\ubd80\ub97c \ubcf4\uc7a5\ud558\uace0 \uce98\ub9ac\ud3ec\ub2c8\uc544\uc8fc\uac00 \uc18c\uc720\ud558\uace0 \uc788\ub294 \ud574\ub2f9 \uae30\ub85d \ubc0f \uc815\ubcf4\uc5d0 \uc811\uadfc\ud560 \uc218 \uc788\ub294 \uc8fc\ubbfc\uc758 \uad8c\ub9ac\ub97c \ubcf4\uc7a5\ud558\uae30 \uc704\ud55c \ubc95\uc774 \uc2dc\ud589\ub418\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ub3d9\uc2dc\uc5d0, \uacf5\uacf5 \uae30\ub85d\uc5d0 \uc811\uadfc\ud560 \uc218 \uc788\ub294 \uc8fc\ubbfc\uc758 \uad8c\ub9ac\uc5d0\ub294 \uc608\uc678\uac00 \uc801\uc6a9\ub429\ub2c8\ub2e4. \uac1c\uc778 \uc815\ubcf4 \uad00\ub9ac \ub4f1\uc744 \uc704\ud574 \uc774\ub7ec\ud55c \uc608\uc678\uac00 \uc0ac\uc6a9\ub418\uba70 \uc8fc\ubc95 \ubc0f \uc5f0\ubc29\ubc95 \ubaa8\ub450 \uc608\uc678\ub97c \uaddc\uc815\ud569\ub2c8\ub2e4. "),S(107,"br")(108,"br"),u(109," \ubcf8 \uc0ac\uc774\ud2b8\uc5d0\uc11c \uc218\uc9d1\ub41c \ubaa8\ub4e0 \uc815\ubcf4\ub294 \uacf5\uacf5 \uae30\ub85d\uc774 \ub418\uc5b4, \ubc95\uc5d0 \uc608\uc678\uac00 \uc788\uc9c0 \uc54a\ub294 \ud55c, \uacf5\uacf5 \uc5f4\ub78c \ubc0f \ubcf5\uc0ac \ub300\uc0c1\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ubcf8 \uc774\uc6a9 \uc815\ucc45\uc758 \ub0b4\uc6a9\uc774 \uacf5\uacf5 \uae30\ub85d\ubc95(Public Records Act), \uc815\ubcf4 \uad00\ub840\ubc95(Information Practices Act ) \ub610\ub294 \uae30\ud0c0 \uae30\ub85d\uc758 \uacf5\uac1c\ub97c \uc815\ud558\ub294 \ubc95\uacfc \uc0c1\ucda9\ub418\ub294 \uacbd\uc6b0\uc5d0\ub294 \uacf5\uacf5 \uae30\ub85d\ubc95(Public Records Act), \uc815\ubcf4 \uad00\ub840\ubc95(Information Practices Act ) \ub610\ub294 \uae30\ud0c0 \uad00\ub828\ubc95\uc5d0 \ub530\ub974\uac8c \ub429\ub2c8\ub2e4. "),S(110,"hr"),c(111,"h4",19),u(112,"\uac1c\uc778 \uc815\ubcf4"),l(),u(113," \uc6b0\ub9ac\uc5d0\uac8c \uc801\uc2dc\uc5d0 \uc5f0\ub77d\ud558\ub294 \uacbd\uc6b0 \uc815\ubd80\ubc95 \uc81c11015.5\uc870\uc5d0 \ub530\ub77c, \uc218\uc9d1\ub41c \uadc0\ud558\uc758 \uac1c\uc778 \uc815\ubcf4\ub97c \ub2e4\uc2dc \uc0ac\uc6a9\ud558\uac70\ub098 \ubc30\ud3ec\ud558\uc9c0 \uc54a\uace0 \ud30c\uae30\ud558\ub3c4\ub85d \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. "),S(114,"br")(115,"br")(116,"hr"),c(117,"h4",20),u(118,"\uc815\ubcf4/\ucfe0\ud0a4 \uc790\ub3d9 \uc218\uc9d1"),l(),u(119," \ucfe0\ud0a4\ub780 \uc6f9 \ube0c\ub77c\uc6b0\uc800\uc5d0 \uc758\ud574 \ucef4\ud4e8\ud130\uc5d0 \uc800\uc7a5\ub41c \uac04\ub2e8\ud55c \ud14d\uc2a4\ud2b8 \ud30c\uc77c\uc785\ub2c8\ub2e4. \uce98\ub9ac\ud3ec\ub2c8\uc544\uc8fc\uc758 \uc8fc\ud3ec\ud138\uc740 \uc0ac\uc6a9\uc790 \uc815\uc758 \uad00\ub9ac\uc5d0 \ucfe0\ud0a4\ub97c \uc0ac\uc6a9\ud558\uc9c0 \uc54a\uc9c0\ub9cc \uc77c\ubd80 \ubd80\uc11c \uc751\uc6a9 \ud504\ub85c\uadf8\ub7a8\uc740 \ucfe0\ud0a4\ub97c \uc0ac\uc6a9\ud560 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4. "),S(120,"br")(121,"br"),u(122," \uce98\ub9ac\ud3ec\ub2c8\uc544\uc8fc\ub294 \ucfe0\ud0a4\uc758 \uc0ac\uc6a9\uc744 \ud53c\ud558\uae30 \uc704\ud574 \ubaa8\ub4e0 \ubc29\ubc95\uc744 \uac15\uad6c\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uce98\ub9ac\ud3ec\ub2c8\uc544\uc8fc\ub294 \uc751\uc6a9 \ud504\ub85c\uadf8\ub7a8\uc758 \uae30\ub2a5\uc744 \uc720\uc9c0\ud558\uae30 \uc704\ud574 \ud544\uc694\ud55c \uacbd\uc6b0, \ucfe0\ud0a4\uc758 \uc77c\ubc18\uc801\uc778 \uc0ac\uc6a9\uacfc\ub294 \ub2ec\ub9ac, \uadc0\ud558\uac00 \uc0c1\ud638 \uc791\uc6a9 \uc751\uc6a9 \ud504\ub85c\uadf8\ub7a8\uc5d0 \uc561\uc138\uc2a4\ud55c \uc138\uc158 \ub3d9\uc548\uc5d0\ub9cc \ucfe0\ud0a4\ub97c \uc0ac\uc6a9\ud569\ub2c8\ub2e4. "),S(123,"br")(124,"br"),u(125,' \ubcf8 \uc6f9 \uc0ac\uc774\ud2b8\ub97c \ud1b5\ud574 \ucef4\ud4e8\ud130\uc5d0 \ub9cc\ub4e4\uc5b4\uc9c4 \ucfe0\ud0a4\uc5d0\ub294 "\uac1c\uc778 \uc815\ubcf4"\uac00 \ud3ec\ud568\ub418\uc9c0 \uc54a\uc73c\uba70 \uadc0\ud558\uc758 \uac1c\uc778 \uc815\ubcf4 \ub610\ub294 \ubcf4\uc548\uc744 \uc704\ud0dc\ub86d\uac8c \ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc6b0\ub9ac\ub294 \ucfe0\ud0a4 \uae30\ub2a5\uc744 \uadc0\ud558\uc758 \ucef4\ud4e8\ud130\uc5d0 \uc784\uc758\ub85c \uc0dd\uc131\ub41c \uc784\uc2dc \uc2dd\ubcc4 \ud0dc\uadf8\ub97c \uc800\uc7a5\ud558\uae30 \uc704\ud574\uc11c\ub9cc \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \ub110\ub9ac \uc0ac\uc6a9\ub418\ub294 \uc77c\ubc18\uc801\uc778 \ubc29\ubc95 \uc911 \ud558\ub098\ub97c \uc0ac\uc6a9\ud558\uc5ec \ucef4\ud4e8\ud130\uc5d0\uc11c \ucfe0\ud0a4\ub97c \uac70\uc808\ud558\uac70\ub098 \ucfe0\ud0a4 \ud30c\uc77c\uc744 \uc0ad\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uadf8\ub7ec\ub098, \ucfe0\ud0a4 \uc635\uc158\uc744 \ud574\uc81c\ud558\uba74 \ubcf8 \uc0ac\uc774\ud2b8\uc758 \uc0c1\ud638 \uc791\uc6a9 \uc751\uc6a9 \ud504\ub85c\uadf8\ub7a8\uc758 \uc77c\ubd80 \uae30\ub2a5\uc5d0 \uc561\uc138\uc2a4\ud558\uc9c0 \ubabb\ud560 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4. '),S(126,"br")(127,"br")(128,"hr"),c(129,"h4",21),u(130,"\ubcf4\uc548"),l(),u(131," \uce98\ub9ac\ud3ec\ub2c8\uc544\uc8fc\ub294 \ubcf8 \uc6f9 \uc0ac\uc774\ud2b8\uc758 \uac1c\ubc1c\uc790 \ubc0f \uad00\ub9ac\uc790\ub85c\uc11c, \uc778\uc99d, \ubaa8\ub2c8\ud130\ub9c1, \uac10\uc0ac, \uc554\ud638\ud654 \ub4f1\uc744 \ud3ec\ud568\ud558\ub098 \uc774\uc5d0 \ud55c\uc815\ub418\uc9c0 \uc54a\ub294 \uc804\uc790 \ud1b5\uc2e0 \ubc0f \ucef4\ud4e8\ud305 \uc778\ud504\ub77c\uc758 \ubb34\uacb0\uc131\uc744 \uc9c0\ud0a4\uae30 \uc704\ud55c \uc5ec\ub7ec \uc870\uce58\ub97c \ucde8\ud55c \ubc14 \uc788\uc2b5\ub2c8\ub2e4. \ubcf4\uc548 \ubc29\uc548\uc740 \uc9c0\uc18d\uc801\uc778 \uc704\uae30 \uad00\ub9ac \uc57d\uc18d\uc758 \uc77c\ud658\uc73c\ub85c \uce98\ub9ac\ud3ec\ub2c8\uc544\uc8fc \uc804\uccb4 \uc6b4\uc601 \ud658\uacbd\uc758 \uc124\uacc4, \uad6c\ud604 \ubc0f \uc2e4\ud589\uc5d0 \ud1b5\ud569\ub418\uc5b4 \uc654\uc2b5\ub2c8\ub2e4. \ubcf8 \uc815\ubcf4\ub294 \uc0ac\uc5c5\uc801, \ubc95\uc801 \ub610\ub294 \uae30\ud0c0 \uc790\ubb38\uc758 \uc81c\uacf5 \ub610\ub294 \uce98\ub9ac\ud3ec\ub2c8\uc544\uc8fc\uac00 \uc9c0\uc6d0\ud558\ub294 \uc6f9 \uc0ac\uc774\ud2b8\ub97c \ud1b5\ud574 \uc81c\uacf5\ub41c \uc815\ubcf4\uc758 \ubcf4\uc548 \ubcf4\uc7a5\uc73c\ub85c \ud574\uc11d\ub420 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \ubcf4\uc548\uc744 \uaddc\uc815\ud558\ub294 \uae30\uc220 \ud45c\uc900\uc740 \uc815\ubcf4\uae30\uc220\ubd80\uc5d0\uc11c \uc2dc\ud589\ud569\ub2c8\ub2e4. "),S(132,"br")(133,"br")(134,"hr"),c(135,"h4",22),u(136,"\ub2e4\ub978 \uc0ac\uc774\ud2b8 \ub9c1\ud06c"),l(),u(137," \ubcf8 \uc6f9 \uc0ac\uc774\ud2b8\uc5d0\uc11c\ub294 \uadc0\ud558\uc5d0\uac8c \uc720\uc6a9\ud560 \uac83\uc73c\ub85c \ud310\ub2e8\ub418\ub294 \uc0ac\uc774\ud2b8\uc640 \uc11c\ube44\uc2a4\ub97c \uc81c\uacf5\ud560 \uc218 \uc788\ub294 \uc0ac\uc774\ud2b8\uc758 \ub9c1\ud06c\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \ub2e4\ub978 \uc0ac\uc774\ud2b8\ub85c \ub9c1\ud06c\ub418\uba74 \ub354 \uc774\uc0c1 \ubcf8 \uc6f9 \uc0ac\uc774\ud2b8\uc5d0 \uba38\ubb34\ub294 \uac83\uc774 \uc544\ub2c8\uba70 \uc0c8\ub85c\uc6b4 \uc0ac\uc774\ud2b8\uc758 \uac1c\uc778 \uc815\ubcf4 \ubcf4\ud638 \uc815\ucc45\uc774 \uc801\uc6a9\ub429\ub2c8\ub2e4. "),S(138,"br")(139,"br"),u(140," \ubcf8 \uc6f9 \uc0ac\uc774\ud2b8 \ubc0f \ubcf8 \uc6f9 \uc0ac\uc774\ud2b8\uc5d0 \ub4e4\uc5b4\uc788\ub294 \uc815\ubcf4\ub294 \uce98\ub9ac\ud3ec\ub2c8\uc544\uc8fc\uac00 \uacf5\uacf5 \uc11c\ube44\uc2a4\uc758 \uc77c\ud658\uc73c\ub85c \uc81c\uacf5\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ubcf8 \uc2dc\uc2a4\ud15c\uc740 \uc801\uc808\ud55c \uc6b4\uc601\uc744 \ud655\ubcf4\ud558\uace0, \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 \ubcf4\uc548 \uae30\ub2a5\uc758 \uae30\ub2a5\uc744 \ud655\uc778\ud558\uace0, \ube44\uad50\ud560 \ubaa9\uc801\uc73c\ub85c \ubaa8\ub2c8\ud130\ub9c1\ub418\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ubcf8 \uc2dc\uc2a4\ud15c\uc744 \uc0ac\uc6a9\ud558\ub294 \ubaa8\ub4e0 \uc0ac\uc6a9\uc790\ub294 \uc774\ub7ec\ud55c \ubaa8\ub2c8\ud130\ub9c1\uc5d0 \uba85\ubc31\ud558\uac8c \ub3d9\uc758\ud569\ub2c8\ub2e4. \ubcf8 \uc2dc\uc2a4\ud15c\uc5d0 \uc800\uc7a5\ub41c \uc815\ubcf4\ub97c \ubb34\ub2e8\uc73c\ub85c \uc218\uc815\ud558\ub824 \ud558\uac70\ub098 \ubcf4\uc548 \uae30\ub2a5\uc744 \uacf5\uaca9 \ub610\ub294 \ud68c\ud53c\ud558\ub824 \ud558\uac70\ub098 \ubcf8 \uc2dc\uc2a4\ud15c\uc744 \uc758\ub3c4\ub41c \ubaa9\uc801 \uc774\uc678\uc758 \uc6a9\ub3c4\ub85c \uc0ac\uc6a9\ud558\ub294 \ud589\uc704\ub294 \uae08\uc9c0\ub418\uc5b4 \uc788\uc73c\uba70 \uc704\ubc18 \uc2dc \ud615\uc0ac \ucc98\ubc8c\uc744 \ubc1b\uc744 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4. "),S(141,"br")(142,"br")(143,"hr"),c(144,"h4",23),u(145,"\ucc45\uc784\uc758 \uc81c\ud55c"),l(),u(146," \uce98\ub9ac\ud3ec\ub2c8\uc544\uc8fc\ub294 \ubcf8 \uc6f9 \uc0ac\uc774\ud2b8 \ucee8\ud150\ud2b8\uc758 \uc815\ud655\uc131\uc744 \uc720\uc9c0\ud558\uae30 \uc704\ud574 \ub178\ub825\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uc624\ub958 \ub610\ub294 \uc0dd\ub7b5\ub41c \ub0b4\uc6a9\uc774 \uc788\ub294 \uacbd\uc6b0 \uc870\uc0ac\ud560 \uc218 \uc788\ub3c4\ub85d \uc2e0\uace0\ud574 \uc8fc\uc2ed\uc2dc\uc624. "),S(147,"br")(148,"br"),u(149," \uce98\ub9ac\ud3ec\ub2c8\uc544\uc8fc\ub294 \ubcf8 \uc6f9 \uc0ac\uc774\ud2b8 \ucee8\ud150\ud2b8\uc758 \uc808\ub300\uc801 \uc815\ud655\uc131, \uc644\uc804\uc131 \ub610\ub294 \uc801\ud569\uc131\uc5d0 \ub300\ud55c \uc5b4\ub5a0\ud55c \uc8fc\uc7a5, \uc57d\uc18d \ub610\ub294 \ubcf4\uc7a5\uc744 \ud558\uc9c0 \uc54a\uc73c\uba70 \ubcf8 \uc6f9 \uc0ac\uc774\ud2b8\uc758 \ucee8\ud150\ud2b8 \uc0c1\uc758 \uc624\ub958 \ub610\ub294 \uc0dd\ub7b5\ub41c \ub0b4\uc6a9\uc5d0 \ub300\ud55c \ucc45\uc784\uc744 \uba85\ubc31\ud788 \ubd80\uc778\ud569\ub2c8\ub2e4. \ubcf8 \uc6f9 \uc0ac\uc774\ud2b8\uc758 \ucee8\ud150\ud2b8 \ub610\ub294 \ub2e4\ub978 \uc778\ud130\ub137 \ub9ac\uc18c\uc2a4\ub8