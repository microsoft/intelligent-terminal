gSwitch",t.translate.currentLang),g(2),m("ngSwitchCase","es"),g(),m("ngSwitchCase","zh"),g(),m("ngSwitchCase","ko"),g(),m("ngSwitchCase","ja"),g(),m("ngSwitchCase","vi"),g(),m("ngSwitchCase","tl"),g(),m("ngSwitch",t.translate.currentLang),g(2),m("ngSwitchCase","es"),g(),m("ngSwitchCase","zh"),g(),m("ngSwitchCase","ko"),g(),m("ngSwitchCase","ja"),g(),m("ngSwitchCase","vi"),g(),m("ngSwitchCase","tl"),g(),m("ngSwitch",t.translate.currentLang),g(2),m("ngSwitchCase","es"),g(),m("ngSwitchCase","zh"),g(),m("ngSwitchCase","ko"),g(),m("ngSwitchCase","ja"),g(),m("ngSwitchCase","vi"),g(),m("ngSwitchCase","tl"),g(284),m("ngIf",!1),g(),m("ngIf",!1),g(),m("ngIf",!1),g(92),m("ngIf",!1),g(),m("ngIf",!1),g(),m("ngIf",!1),g(),m("ngIf",!1),g(),m("ngIf",!1),g(),m("ngIf",!1),g(),m("ngIf",!1),g(),m("ngIf",!1),g(),m("ngIf",!1),g(),m("ngIf",!1)}}function Qpt(e,n){1&e&&(c(0,"div"),u(1," Consumers who meet California LifeLine's eligibility rules can qualify for the discounts. There are two ways to qualify, Program-Based OR Income-Based. "),S(2,"br")(3,"br"),u(4," Under Program-Based, you may qualify for the California LifeLine discounts if you or another person in your household is already enrolled in one or more of the eligible public-assistance programs. Check out "),c(5,"a",246),u(6,"Is California LifeLine Right for You?"),l(),u(7," to see the list of eligible public-assistance programs. "),S(8,"br")(9,"br"),c(10,"strong"),u(11,"OR"),l(),S(12,"br")(13,"br"),u(14," Under Income-Based you may qualify for California LifeLine if your annual total household income is at or less than the California LifeLine income limits. "),S(15,"br")(16,"br"),u(17," Household income includes all incomes received by everyone in your household, whether taxable or non-taxable, including, but not limited to: wages, salaries, interest, dividends, spousal support and child support, grants, gifts, allowances, stipends, public-assistance payments, social security and pensions, rental income, income from self-employment and cash payments from other sources, and all employment-related, non-cash income. Check out "),c(18,"a",246),u(19,"Is California LifeLine Right for You?"),l(),u(20," to see the annual income limits. "),l())}function Zpt(e,n){1&e&&(c(0,"div"),u(1," Los consumidores que cumplan con las reglas de elegibilidad del programa California LifeLine pueden recibir los descuentos. Existen dos formas de reunir los requisitos, seg\xfan el m\xe9todo basado en el programa O seg\xfan el m\xe9todo basado e los ingresos. "),S(2,"br")(3,"br"),u(4," Bajo el m\xe9todo basado en el programa, puede reunir los requisitos para recibir los descuentos del programa California LifeLine en caso de que usted u otra persona de su grupo familiar se encuentre inscrito en uno o m\xe1s de los programas elegibles de asistencia p\xfablica. Vea "),c(5,"a",246),u(6,"\xbfEl programa California LifeLine es adecuado para usted?"),l(),u(7," para ver la lista de programas elegibles de asistencia p\xfablica. "),S(8,"br")(9,"br"),c(10,"strong"),u(11,"O"),l(),S(12,"br")(13,"br"),u(14," Bajo el m\xe9todo basado en los ingresos, puede reunir los requisitos para el programa California LifeLine si los ingresos totales anuales de su grupo familiar se encuentran en el l\xedmite o por debajo de los ingresos l\xedmite estipulados por California LifeLine. "),S(15,"br")(16,"br"),u(17," Los ingresos del grupo familiar incluyen todos aquellos ingresos recibidos por todas las personas que viven en su hogar, si le cobran o no impuestos. Se encuentran incluidos, entre otros: salarios, sueldos, intereses, dividendos, manutenci\xf3n conyugal e infantil, becas, donaciones, bonificaciones, remuneraciones, pagos de asistencia p\xfablica, seguros sociales, pensiones, ingresos de alquiler, ingresos como trabajador independiente y pagos en efectivo de otras fuentes, adem\xe1s de todos los ingresos laborales que no sean en efectivo. Vea "),c(18,"a",246),u(19,"\xbfEl programa California LifeLine es adecuado para usted?"),l(),u(20," para ver los l\xedmites de ingresos anuales. "),l())}function Jpt(e,n){1&e&&(c(0,"div"),u(1," \u7b26\u5408\u52a0\u5dde\u666e\u6fdf\u96fb\u8a71\u670d\u52d9\u8cc7\u683c\u898f\u5b9a\u7684\u5ba2\u6236\u53ef\u7372\u5f97\u6298\u6263\u3002 \u53ef\u900f\u904e\u5169\u7a2e\u65b9\u5f0f\u53c3\u52a0\u8a72\u8a08\u5283\u3002 "),S(2,"br")(3,"br"),u(4," \u6839\u64da\u65b9\u6cd5\u4e00\u300c\u8a08\u5283\u578b\u300d\u6216\u65b9\u6cd5\u4e8c\u300c\u6536\u5165\u578b\u300d\uff0c\u5982\u679c\u60a8\u6216\u5bb6\u4eba\u767b\u8a18\u4e86\u4e00\u6216\u9805\u591a\u9805\u5408\u683c\u7684\u516c\u5171\u88dc\u52a9\u8a08\u5283\uff0c\u6839\u64da\u65b9\u6cd5\u4e00\uff08\u8a08\u5283\u578b\uff09\uff0c\u5373\u53ef\u4eab\u6709\u52a0\u5dde\u666e\u6fdf\u96fb\u8a71\u670d\u52d9\u7684\u6298\u6263\u3002 \u8acb\u67e5\u95b1 "),c(5,"a",246),u(6,"\u52a0\u5dde\u666e\u6fdf\u96fb\u8a71\u670d\u52d9\u662f\u5426\u9069\u5408\u60a8\uff1f"),l(),u(7," \u4ee5\u53d6\u5f97\u7b26\u5408\u8cc7\u683c\u7684\u516c\u5171\u88dc\u52a9\u8a08\u5283\u6e05\u55ae\u3002 "),S(8,"br")(9,"br"),c(10,"strong"),u(11,"OR"),l(),S(12,"br")(13,"br"),u(14," \u6839\u64da\u65b9\u6cd5\u4e8c\uff08\u6536\u5165\u578b\uff09\uff0c\u82e5\u60a8\u7684\u5bb6\u5ead\u7e3d\u5e74\u6536\u5165\u7b49\u65bc\u6216\u4f4e\u65bc\u300c\u52a0\u5dde\u666e\u6fdf\u7247\u5316\u670d\u52d9\u300d\u7684\u6536\u5165\u9650\u5236\uff0c\u5373\u6709\u53ef\u80fd\u7b26\u5408\u300c\u52a0\u5dde\u666e\u6fdf\u96fb\u8a71\u670d\u52d9\u300d\u7684\u8cc7\u683c\u3002 "),S(15,"br")(16,"br"),u(17," \u5bb6\u5ead\u6536\u5165\u5305\u542b\u5bb6\u4e2d\u6bcf\u4e00\u500b\u4eba\u7684\u6240\u6709\u6536\u5165\uff0c\u7121\u8ad6\u5176\u70ba\u61c9\u7a05\u6216\u672a\u61c9\u7a05\uff0c\u5305\u62ec\uff08\u4f46\u4e0d\u9650\u65bc\uff09\uff1a \u5de5\u8cc7\u3001\u85aa\u8cc7\u3001\u5229\u606f\u3001\u80a1\u606f\u3001\u914d\u5076\u8d0d\u990a\u8cbb\u53ca\u5b50\u5973\u64ab\u990a\u8cbb\u3001\u88dc\u52a9\u91d1\u3001\u8d08\u4e88\u3001\u6d25\u8cbc\u3001\u96f6\u7528\u91d1\u3001\u516c\u5171\u88dc\u52a9\u6b3e\u3001\u793e\u6703\u4fdd\u96aa\u82