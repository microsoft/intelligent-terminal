1eefng ly' do sau \u0111\xe2y: "),c(66,"ol")(67,"li"),u(68,"Kh\xf4ng th\u1ec3 ch\u1ee9ng minh b\u1ea3n s\u1eafc c\xe1 nh\xe2n c\u1ee7a kh\xe1ch h\xe0ng d\xf9ng nh\u1eefng d\u1eef ki\u1ec7n \u0111\xe3 \u0111\u01b0\u1ee3c cung c\u1ea5p b\u1edfi nh\xe0 qu\u1ea3n ly' California LifeLine;"),l(),c(69,"li"),u(70,"gi\u1ea5y Th\u1ebb c\u0103n c\u01b0\u1edbc ch\u1ee9ng minh c\xe1 nh\xe2n cung c\u1ea5p kh\xf4ng tr\xf9ng v\u1edbi kh\xe1ch h\xe0ng"),l(),c(71,"li"),u(72,"Th\u1ebb c\u0103n c\u01b0\u1edbc ch\u1ee9ng minh c\xe1 nh\xe2n cung c\u1ea5p b\u1edfi kh\xe1ch h\xe0ng kh\xf4ng c\xf3 li\u1ec7t k\xea d\u01b0\u1edbi danh s\xe1ch l\xe0 nh\u1eefng lo\u1ea1i gi\u1ea5y ch\u1ee9ng minh \u0111\u01b0\u1ee3c ch\u1ea5p nh\u1eadn; v\xe0"),l(),c(73,"li"),u(74,"nh\xe0 qu\u1ea3n ly' California LifeLine kh\xf4ng c\xf3 b\u1eb1ng c\u1edb l\xe0 m\u1eabu Ch\u1ee9ng th\u1ef1c c\xe1 nh\xe2n l\xe0 th\u1ebb c\u0103n c\u01b0\u1edbc ch\u1ee9ng minh c\xe1 nh\xe2n \u0111\xe3 n\u1ed9p v\xe0o."),l()(),u(75," Nh\xe0 qu\u1ea3n l California LifeLine s\u1ebd g\u1eedi th\xf4ng b\xe1o h\u1ed9i \u0111\u1ee7 \u0111i\u1ec1u ki\u1ec7n \u0111\u1ebfn ng\u01b0\u1eddi n\u1ed9p \u0111\u01a1n ho\u1eb7c ng\u01b0\u1eddi tham gia. "),S(76,"br")(77,"br"),c(78,"h3",53),u(79,"CH\u1ec8 C\xd3 M\u1ed8T GI\u1ea2M GI\xc1 CALIFORNIA CHO M\u1ed6I H\u1ed8 GIA \u0110\xccNH"),l(),u(80," R\u1ea5t quan tr\u1ecdng m\xe0 nh\u1edb r\u1eb1ng ch\u1ec9 c\xf3 m\u1ed9t gi\xe3m gi\xe1 \u0111i\u1ec7n tho\u1ea1i cho m\u1ed7i h\u1ed9 gia \u0111\xecnh \u0111\u01b0\u1ee3c ch\u1ea5p nh\xe2n. Ch\u01b0\u01a1ng tr\xecnh gi\u1ea3m gi\xe1 California LifeLine ch\u1ec9 c\xf3 th\u1ec3 cho n\u01a1i \u0111ang c\u01b0 ng\u1ee5 ch\xednh c\u1ee7a m\u1ed9t c\xe1 nh\xe2n. M\u1ed7i c\xe1 nh\xe2n ch\u1ec9 c\xf3 th\u1ec3 c\xf3 m\u1ed9t \u0111\u1ecba ch\u1ec9 c\u01b0 ng\u1ee5 ch\xednh. "),S(81,"br")(82,"br"),u(83," M\u1ed7i h\u1ed9 gia \u0111\xecnh ph\u1ea3i ch\u1ecdn gi\u1ea3m gi\xe1 ho\u1eb7c l\xe0 cho \u0111i\u1ec7n tho\u1ea1i nh\xe0 ho\u1eb7c cho \u0111i\u1ec7n tho\u1ea1i di \u0111\u1ed9ng. H\u1ed9 gia \u0111\xecnh kh\xf4ng th\u1ec3 nh\u1eadn gi\xe3m gi\xe1 t\u1eeb nhi\u1ec1u h\xe3ng \u0111i\u1ec7n tho\u1ea1i kh\xe1c nhau. H\u1ed9 gia \u0111\xecnh kh\xf4ng tu\xe2n theo l\u1ec7 m\u1ed9t gi\xe3m gi\xe1 cho m\u1ed7i gia \u0111\xecnh s\u1ebd b\u1ecb m\u1ea5t gi\u1ea3m gi\xe1, v\xe0 c\xf3 th\u1ec3 b\u1ecb bu\u1ed9c t\u1ed9i b\u1edfi ch\xednh ph\u1ee7 Hoa ky`. Nh\u1eadn nhi\u1ec1u gi\xe3m gi\xe1 \u0111i\u1ec7n tho\u1ea1i l\xe0 ph\u1ea1m lu\u1eadt c\u1ee7a ch\u01b0\u01a1ng tr\xecnh. "),S(84,"br")(85,"br"),u(86," H\xecnh ph\u1ea1t cho vi\u1ec7c vi ph\u1ea1m \u0111i\u1ec1u l\u1ec7 c\u1ee7a ch\u01b0\u01a1ng tr\xecnh California LifeLine c\xf3 th\u1ec3 bao g\u1ed3m t\xf9 t\u1ed9i, m\u1ea5t gi\u1ea3m gi\xe1, ph\u1ea1t ti\u1ec1n, v\xe0 b\u1ecb c\u1ea5m tham gia ch\u01b0\u01a1ng tr\xecnh California lifeline. Ch\u01b0\u01a1ng tr\xecnh California LifeLine c\xf3 th\u1ec3 \u0111\xf2i l\u1ea1i ti\u1ec1n c\u1ee7a gi\u1ea3m gi\xe1 m\xe0 \u0111\xe3 nh\u1eadn kh\xf4ng \u0111\xfang t\u1eeb ch\u01b0\u01a1ng tr\xecnh. "),S(87,"br")(88,"br"),l())}function uCt(e,n){1&e&&(c(0,"div"),u(1," Sinusuri ng Programa California LifeLine ang mga personal na identipikasyon (PI) na isinusumite ng mga aplikante at mga kalahok sa California LifeLine Adminstrator upang malaman kung ang (PI) impormasyon na isinumite ay tutugma sa pagkakakilanlan ng isang tao. Ang mga indibidwal ay maaaring parusahan sa pag bibigay ng pekeng impormasyon sa kanilang mga aplikasyon o renewal form upang makuha ang mga diskwento. "),S(2,"br")(3,"br"),u(4," Kapag ang California LifeLine Administrator ay hindi mapatunayan ang (PI) impormasyon na isinumite, ang Programa California LifeLine ay nangangailangan ng mga aplikante o kalahok na magsumite ng adisyunal na impormasyon tulad ng ID Authentication form at isang kopya sa isa o higit pa na uri ng mga dokumentong pagkakakilanlan. "),S(5,"br")(6,"br"),u(7," Ang mga mamimili ay dapat mag sumite sa California LifeLine Administrator ng parehong nakumpleto at nilagdaang ID Authentication Form at ang KOPYA ng dokumentasyon ng pagkakakilanlan sa takdang petsa na isinaad sa form. "),S(8,"br")(9,"br"),u(10," Ang dokumentong identipikasyon ay kailangan ng litrato na tumutugma sa dalawang personal na impormasyon (e.g., pangalan, home address, araw ng kapanganakan, at huling apat na numero ng social security number), na ibinigay na ng kalahok sa California LifeLine Administrator, at dapat kasalukuyang malinaw, at isa sa mga uri ng mga dokumentong identipikasyon na nakalista sa baba. "),S(11,"br")(12,"br"),u(13," Ang katanggap-tanggap ng mga uri ng mga dokumentong pagkakakilanlan ay: "),c(14,"ul")(15,"li"),u(16,"U.S. Lisensya ng Pagmamaneho"),l(),c(17,"li"),u(18,"Sertipiko ng U.S. Pagkamamamayan"),l(),c(19,"li"),u(20,"Sertipiko ng Naturalization o Pagkamamamayan"),l(),c(21,"li"),u(22,"U.S. Pasaporte/U.S. Lupain Pasaporte"),l(),c(23,"li"),u(24,"Dayuhang Pasaporte"),l(),c(25,"li"),u(26,"Identipikasyon ng Gobyerno ng US, militar, estado, o pang Tribu, kasama ang petsa ng kapanganakan, at/o numero ng social security at/o identipikasyon pang Tribu"),l(),c(27,"li"),u(28,"US Military ID cards (aktibo o reserve duty, umaasa ng isang miyembro ng militar, nagretiro na miyembro, pinalabas mula sa serbisyo, / relihiyon tauhan medikal)"),l(),c(29,"li"),u(30,"Karaniwang Access Kard (kapag lamang itinalagang bilang Active Military o Active Reserve o Active Napiling Reserve)"),l(),c(31,"li"),u(32,"Dokumentasyon ng Military discharge, kung saan kabilang ang mga petsa ng kapanganakan at / o Numero ng Social Security at / o Tribal ID"),l(),c(33,"li"),u(34,"Northern Mariana kard"),l(),c(35,"li"),u(36,"Kard ng Permanenteng Residente"),l(),c(37,"li"),u(38,"Kard ng Permanenteng Dayuhang Residente"),l(),c(39,"li"),u(40,"Permanenteng Residente Re-Entry Permit"),l(),c(41,"li"),u(42,"Permanenteng Residente Re-Entry Permit"),l(),c(43,"li"),u(44,"Kard ng Awtorisasyon sa Trabaho"),l(),c(45,"li"),u(46,"Kard ng Konsulado ng Mexico (2006, 2014, 2015, at mga bagong bersyon)"),l(),c(47,"li"),u(48,"Parolee Identification card na inisyu ng California Division Audit Parole Operations, kung ang card ay nasa loob ng anim (6) na buwan ng petsa sa baba ng litrato"),l(),c(49,"li"),u(50,"Visa na ibinigay ng Estados Unidos"),l(),c(51,"li"),u(52,"Card ng Pagkakakilanlan ng California, na inisyu ng Departamento ng Mga Sasakyan ng Motor (DMV)"),l()(),u(53," Maaring kailanganin ng pagsusuri ng ID ang mga mamimili na magsusumite ng Form ng Pagpapatunay ng ID ng may kulay na litrato ng isa o mas katanggap-tangap na mga dokumento ng pagpapakilanlan upang magpatunay ang pagpapakilanlan ng isang mamimili. Isang itim at puting photocopy ay tinatanggap lamang sa pamamagitan ng koreo ng USPS, hindi elektroniko. "),S(54,"br")(55,"br"),u(56," Ang California LifeLine Administrator ay dapat mapatunayan ng wasto ang pagkakakilanlan ng aplikante o ng kalahok. Kung ang aplikante o kalahok ay bumagsak sa ID Check, ang California LifeLine Administrator ay HINDI aaprubahan ang enrollment sa Programa. "),S(57,"br")(58,"br"),u(59," Mangyaring tandaan na ang tanging identipikasyon na inisyu ng isang opisyal na ahensiya ng pamahalaan ang pinahihintulutan ng California LifeLine Administrator (maliban sa ID ng militar at ID pang Tribu). "),S(60,"br")(61,"br"),u(62," Ang mga uri na dokumento ng identipikasyon na inisyu ng anumang ahensiya ng pamahalaan o entity na maaaring hindi tanggapin ay ang mga sumusunod: "),c(63,"ul")(64,"li"),u(65,"ID ng bilangguan"),l(),c(66,"li"),u(67,"ID ng empleado"),l(),c(68,"li"),u(69,"ID sa eskuwelahan"),l()(),u(70," Tatanggihan ng California LifeLine Administrator ang partisipasyon sa programa kung hindi pumasa ang kalahok sa ID Check. Maaari hindi pumasa ang kalahok sa ID Check dahil sa mga sumusunod na dahilan: "),c(71,"ol")(72,"li"),u(73,"hindi mapatunayan ang identipikasyon ng kalahok gamit ang impormasyon na ibinigay ng California LifeLine Administrator;"),l(),c(74,"li"),u(75,"ang dokumentong identipikasyon ay hindi tumutugma sa kalahok;"),l(),c(76,"li"),u(77,"ang dokumentong identipikasyon na isinumite ng kalahok ay hindi kasama sa lista ng mga dokumento na tinatanggap; at"),l(),c(78,"li"),u(79,"ang California LifeLine Administrator ay walang ebidenysa na natanggap ang inyong ID Authentication Form at ang dokumentong identipikasyon"),l()(),u(80," Ang California LifeLine Administrator ay magpapadala ng desisyon ng eligibidad nito sa aplikante o kalahok. "),S(81,"br")(82,"br"),c(83,"h3",53),u(84,"ISANG LAMANG CALIFORNIA LIFELINE DISKWENTO SERBISYO ANG PINAPAYAGAN KADA SAMBAHAYAN"),l(),u(85," Mahalagang tandaan na isa lamang California LifeLine diskwentong serbisyo ang pinapayagan kada sambahayan. Ang California LifeLine diskuwento ay maaari lamang para sa pangunahing paninirahan ng indibidwal. Ang isang indibidwal ay maaari lamang magkaroon ng isa sa mga pangunahing paninirahan. "),S(86,"br")(87,"br"),u(88," Ang bawat sambahayan ay dapat mamili sa alinman sa isang telepono sa bahay o sa isang cell phone upang makuha ang diskwento, ngunit hindi dapat pareho. Ang sambahayan ay hindi maaring makakuha ng diskwento galing sa iba\u2019t ibang kumpanya ng telepono. Ang sambahayan na hindi sumunod sa isang diskwento serbisyo bawat sambahayan ay mawawalan ng kanilang diskwento, at maaring usigin ng gobyerno ng U.S. Ang pagtanggap ng maramihang diskwento sa serbisyo ng telepono ay lumalabag sa patakaran ng programa. "),S(89,"br")(90,"br"),u(91," Ang mga parusa sa paglabag sa patakaran ng California LifeLine Program maaring isama ang pagkakulong, pagwala ng diskwento, multa ng salapi, at pagbabawal sa pagsali sa California LifeLine Program. Ang California LifeLine Program ay maari din humingi ng pagbabayad sa mga diskwentong hindi dapat natanggap galing sa programa. "),S(92,"br")(93,"br"),l())}let lse=(()=>{class e{constructor(t,i,o,r,a,s,d,p,h){this.app=t,this.title=i,this.elementRef=o,this.router=r,this._global=s,this.utils=d,this.translate=p,this.contactService=h,this.contactddltype="con