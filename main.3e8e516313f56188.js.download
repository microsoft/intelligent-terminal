,10)(38,"h4",11),u(39,"Makakatanggap ba ako ng mensahe o liham na nagsasabi sa akin na mayroon akong bagong tagapagbigay."),l(),u(40," Oo. Ipapaalam sa iyo ng iyong provider kapag natapos na ang paglipat. Makakatanggap ka rin ng liham mula sa programang California LifeLine. "),l(),c(41,"div",10)(42,"h4",11),u(43,"Ano ang 24 na oras na freeze?"),l(),c(44,"div",12),u(45,"Pagkatapos mong lumipat ng kumpanya, kailangan mong maghintay ng 1 araw sa kalendaryo bago ka muling lumipat. Kung nagkamali ka o nagbago ang iyong isipan, kakailanganin mo pa ring maghintay ng 1 araw ng kalendaryo."),l(),c(46,"div"),u(47,"Gayundin, kung nabigyan mo ang iyong tagapagbigay ng maling pangalan ng iyong dating tagapagbigay, maaaring naka-freeze ka pa rin at kailangang maghintay ng 1 araw ng kalendaryo bago gumawa ng isa pang pagbabago."),l()(),c(48,"div",10)(49,"h4",11),u(50,"Maaari ba akong lumipat kung ipinaalam sa akin na ako ay naka-freeze?"),l(),u(51," Hindi. Kailangan mong maghintay ng 1 araw ng kalendaryo bago gumawa ng isa pang pagbabago. "),l(),c(52,"div",10)(53,"h4",11),u(54,"Paano kung ipinaalam sa akin na ako ay naka-freeze."),l(),u(55," Oo. Ipapaalam sa iyo ng iyong tagapagbigay kung hindi ka makalipat dahil sa freeze. "),l(),c(56,"div",10)(57,"h4",11),u(58,"Ipapaalam ba sa akin bago isagawa ang paglipat?"),l(),u(59," Oo. Kailangan mo munang lagdaan ang form na magpapakitang nagbigay ka ng pahintulot na baguhin ang tagapagbigay ng iyong phone. "),l(),c(60,"div",10)(61,"h4",11),u(62,"Paano kung may nagtangkang baguhin ang aking account nang hindi humihingi sa akin ng pahintulot?"),l(),u(63," Kung sa tingin mo ay may nagtangkang baguhin ang iyong account nang wala ang iyong pahintulot, tawagan ang iyong kumpanya ng telepono o agad na "),c(64,"a",13),u(65,"makipag-ugnayan"),l(),u(66," sa amin. "),l(),c(67,"div",10)(68,"h4",11),u(69,"Kung ipinaalam sa akin ng tagapagbigay na hindi ako makakalipat dahil sa freeze, maaari ba akong lumipat kung ito ay isang emerhensya?"),l(),u(70," Hindi. Kailangan mong maghintay ng 1 araw ng kalendaryo. "),l(),c(71,"div",10)(72,"h4",11),u(73,"Maaari ko bang hindian ang lahat ng paglipat?"),l(),u(74," Hindi. Hindi mo maaaring i-block ang lahat ng paglipat, ngunit kailangan mong magbigay ng pahintulot bago mangyari ito. "),l(),c(75,"div",10)(76,"h4",11),u(77,"Ano ang mangyayari kung hindi ako magbibigay ng pahintulot na ilipat ang aking benepisyo sa bagong tagapagbigay?"),l(),u(78," Mananatili ang iyong serbisyo sa kasalukuyan mong provider. Walang magbabago. "),l(),c(79,"div",10)(80,"h4",11),u(81,"Mawawala ko ba ang serbisyo sa dati kong kumpanya?"),l(),c(82,"div",12),u(83,"Oo. Kapag lumipat ka sa bagong tagapagbigay, titigil ang iyong serbisyo sa dati mong tagapagbigay."),l(),c(84,"div"),u(85,"Kung gusto mong mapanatili ang iyong numero ng telepono, siguraduhing ipinaalam sa bago mong tagapagbigay bago lumipat."),l()(),c(86,"div",10)(87,"h4",11),u(88,"Maaari ba akong makatanggap ng kopya ng form ng aking pahintulot na lumipat?"),l(),u(89," Maaari kang humiling ng kopya mula sa iyong bagong tagapagbigay. "),l()())}let G3t=(()=>{class e{constructor(t){this.app=t,this.hideRemoveMe=!1}ngOnInit(){}langChange(t){}static{this.\u0275fac=function(i){return new(i||e)(ge(Ti))}}static{this.\u0275cmp=vt({type:e,selectors:[["transfer-faq"]],standalone:!1,decls:14,vars:8,consts:[["translate","",4,"ngIf"],["title","Frequently Asked Questions"],[1,"my-4"],[1,"container"],[1,"row","my-4"],[1,"col-12"],[3,"ngSwitch"],[4,"ngSwitchDefault"],[4,"ngSwitchCase"],["translate",""],[1,"mb-4"],[1,"fw-bold"],[1,"mb-2"],["langhref","contact"],["langhref","contact","translate",""]],template:function(i,o){1&i&&(ee(0,N3t,2,0,"div",0),S(1,"blade-hero",1),c(2,"section",2)(3,"div",3)(4,"div",4)(5,"div",5)(6,"div",6),ee(7,q3t,90,0,"div",7)(8,W3t,90,0,"div",8)(9,H3t,90,0,"div",8)(10,V3t,90,0,"div",8)(11,Y3t,90,0,"div",8)(12,U3t,90,0,"div",8)(13,j3t,90,0,"div",8),l()()()()()),2&i&&(m("ngIf",!1),g(6),m("ngSwitch",o.app.translate.currentLang),g(2),m("ngSwitchCase","es"),g(),m("ngSwitchCase","zh"),g(),m("ngSwitchCase","ko"),g(),m("ngSwitchCase","ja"),g(),m("ngSwitchCase","vi"),g(),m("ngSwitchCase","tl"))},dependencies:[zn,Po,rr,za,Zn,Gi,Vl],encapsulation:2})}}return e})();function X3t(e,n){1&e&&(c(0,"div",46)(1,"div",47)(2,"h3",48),u(3,"Want to chat instead?"),l(),c(4,"div",37),u(5,"Live chat is available Monday-Friday from 7:00 a.m. to 7:00 p.m., except on "),c(6,"a",49),u(7,"State holidays"),l(),u(8," observed by the California LifeLine program."),l(),S(9,"app-chat"),l()())}function $3t(e,n){1&e&&(c(0,"div")(1,"h3",50),u(2,"Important information for California LifeLine subscribers who have received a text message or automated call from California LifeLine saying that no action is required to complete the annual LifeLine benefit renewal process."),l(),u(3," California LifeLine subscribers must annually renew their LifeLine benefit. "),S(4,"br")(5,"br"),u(6," If you received a text message or an automated phone call informing you that California LifeLine has enough information to process the renewal of your LifeLine benefit, then your annual renewal process is complete. and no further actions are required of you. "),c(7,"h4",51),u(8,"How did the California LifeLine Program Administrator obtain information to complete my renewal process?"),l(),u(9," 105 days before a subscriber\u2019s California LifeLine anniversary date, the California LifeLine Program Administrator checks the available eligibility databases. When the subscriber\u2019s information matches in an eligibility database, and the Program Administrator does not require any additional information from the subscriber to renew the subscriber\u2019s LifeLine benefit, then the Program Administrator sends a text or makes an automated phone call to the subscriber to inform the subscriber that the Program Administrator has enough information to complete the annual renewal of the subscriber\u2019s California LifeLine benefit. "),S(10,"br")(11,"br"),u(12," When a subscriber\u2019s renewal process is completed this way, the subscriber will not receive a renewal form in the mail because the annual renewal process is complete. The subscriber will be mailed official notification of the LifeLine renewal decision on the subscriber\u2019s anniversary date. "),S(13,"br")(14,"br"),u(15," If you have additional questions, you may call us at "),c(16,"strong"),u(17,"877-858-7463"),l(),u(18," or you can chat with us by clicking "),c(19,"a",52),u(20,"https://www.californialifeline.com/en/contact"),l(),u(21," and then click the CHAT button. Our hours of operation are Monday through Friday, 7AM to 7PM Pacific Time. "),c(22,"h4",51),u(23,"General Notes and Tips"),l(),u(24," It is important that California LifeLine participants keep their service and billing (mailing) addresses updated with their California LifeLine service providers, so they receive all mailings from California LifeLine. "),S(25,"br")(26,"br"),l())}function K3t(e,n){1&e&&(c(0,"div")(1,"h3",50),u(2,"Informacion importante para los suscriptores de California LifeLine que han recibido un mensaje de texto o una llamada automatica de California LifeLine diciendo que no se requiere ninguna accion para completar el proceso de renovacion anual de beneficios de LifeLine."),l(),u(3," Los suscriptores de California LifeLine deben renovar anualmente su beneficio de LifeLine. "),S(4,"br")(5,"br"),u(6," Si recibio un mensaje de texto o una llamada telef\xf3nica automatizada informandole que California LifeLine tiene suficiente informaci\xf3n para procesar la renovacion de su beneficio LifeLine, entonces su proceso de renovacion anual esta completo. y no se requieren mas acciones por su parte. "),c(7,"h4",51),u(8,"C\xf3mo obtuvo el administrador del programa California LifeLine informaci\xf3n para completar mi proceso de renovaci\xf3n?"),l(),u(9," 105 d\xedas antes de la fecha de aniversario de California LifeLine del suscriptor, el administrador del programa California LifeLine verifica las bases de datos de elegibilidad disponibles. Cuando la informaci\xf3n del suscriptor coincide con una base de datos de elegibilidad, y el administrador del programa no requiere ninguna informacion adicional del suscriptor para renovar el beneficio de LifeLine del suscriptor, entonces el administrador del programa env\xeda un mensaje de texto o hace una llamada telef\xf3nica automatica al suscriptor para informar al suscriptor. que el administrador del programa tiene suficiente informacion para completar la renovacion anual del beneficio de California LifeLine del suscriptor. "),S(10,"br")(11,"br"),u(12," Cuando el proceso de renovacion de un suscriptor se completa de esta manera, el suscriptor no recibira un formulario de renovacion por correo porque el proceso de renovacion anual esta completo. Al suscriptor se le enviara por correo una notificacion oficial de la decision de renovacion de LifeLine en la fecha de aniversario del suscriptor. "),S(13,"br")(14,"br"),u(15," Si tiene preguntas adicionales, puede llamarnos al "),c(16,"strong"),u(17,"877-858-7463"),l(),u(18," o puede chatear con nosotros haciendo clic en "),c(19,"a",52),u(20,"https://www.californialifeline.com/es/contact"),l(),u(21," y luego haga clic en el boton CHAT. Nuestro horario de atencion es de lunes a viernes, de 7 AM a 7 PM, Hora del Pac\xedfico. "),c(22,"h4",51),u(23,"Notas y consejos generales"),l(),u(24," Es importante que los participantes de California LifeLine mantengan sus direcciones de servicio y facturacion (de correo) actualizadas con sus proveedores de servicios de California LifeLine, para que reciban todos los correos de California LifeLine. "),S(25,"br")(26,"br"),l())}function Q3t(e,n){1&e&&(c(0,"div")(1,"h3",50),u(2,"\u5c0d\u65bc\u6536\u5230\u4f86\u81eaCalifornia LifeLine\u7684\u7c21\u8a0a\u6216\u81ea\u52d5\u547c\u53eb\u7684California LifeLine\u8a02\u95b1\u8005\u7684\u91cd\u8981\u8cc7\u8a0a\uff0c\u8a72\u4f7f\u7528\u8005\u8868\u793a\u7121\u9700\u63a1\u53d6\u4efb\u4f55\u884c\u5