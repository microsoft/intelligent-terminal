u(19,"California c\xf3 ph\xf9 h\u1ee3p v\u1edbi qu\xfd v\u1ecb kh\xf4ng?"),l(),u(20," \u0111\u1ec3 xem c\xe1c m\u1ee9c thu nh\u1eadp t\u1ed1i \u0111a h\xe0ng n\u0103m. "),l())}function spt(e,n){1&e&&(c(0,"div"),u(1," Ang mga mamimili na nakakatugon sa mga patakaran sa pagiging karapat-dapat ng California LifeLine ay maaaring maging kuwalipikado para sa mga diskuwento. Mayroong dalawang paraan upang maging kuwalipikado, Paraan 1 Nakabatay sa Programa O Paraan 2 Nakabatay sa Kita. "),S(2,"br")(3,"br"),u(4," Sa ilalim ng Paraan 1 Nakabatay sa Programa, maaari kang maging kuwalipikado para sa mga diskuwento sa California LifeLine kung ikaw o may ibang tao sa iyong sambahayan na nakatala na sa isa o higit pang mga karapat-dapat na programang pantulong sa publiko. Tingnan ang "),c(5,"a",246),u(6," Nararapat ba para sa iyo ang California LifeLine? "),l(),u(7," upang makita ang listahan ng mga karapat-dapat na programang pantulong sa publiko. "),S(8,"br")(9,"br"),c(10,"strong",67),u(11,"OR"),l(),S(12,"br")(13,"br"),u(14," Sa ilalim ng Paraan 2 Nakabatay sa Kita ay maaari kang maging kuwalipikado para sa California LifeLine kung ang iyong taunang kabuuang kita ng sambahayan ay nasa o mas kaunti kaysa sa mga limitasyon sa kita ng California LifeLine. "),S(15,"br")(16,"br"),u(17," Kabilang sa kita ng sambahayan ang lahat ng mga kita na natanggap ng lahat sa iyong sambahayan, kung nabubuwisan man o hindi nabubuwisan, kabilang na, ngutni hindi limitado sa: mga sahod, suweldo, interes, dividendo, suporta sa asawa at suporta sa anak, mga ipinagkaloob na halaga (grant), regalo, sustento, pensiyon, halagang tulong sa publiko, social security at mga pensiyon, upa, tubo mula sa sariling negosyo at perang kabayaran mula sa ibang pagkakakitaan at lahat ng mga may kaugnayan sa trabaho, kitang hindi salapi. Tingnan ang "),c(18,"a",246),u(19,"Nararapat ba para sa iyo ang California LifeLine?"),l(),u(20," upang makita ang taunang limitasyon ng kita. "),S(21,"br")(22,"br"),l())}function upt(e,n){1&e&&(c(0,"div"),u(1," Please go to "),c(2,"a",247),u(3,"Check Your Status"),l(),u(4," to find out your status online. You may also "),c(5,"a",100),u(6,"Contact Us"),l(),u(7," to find out about your application's status. You can check your status 24 hours a day, or customer service representatives are available Monday to Friday 7 a.m. to 7 p.m. except during state holidays. "),l())}function lpt(e,n){1&e&&(c(0,"div"),u(1," Por favor, vaya a "),c(2,"a",248),u(3,"(Verificar Estado De Aplicaci\xf3n / Renovaci\xf3n)"),l(),u(4," para averiguar su estado en l\xednea. Usted puede tambi\xe9n comun\xedquese con nosotros para conocer el estado de su solicitud. Puede verificar su estado las 24 horas al d\xeda; adem\xe1s, los representantes de servicio al cliente se encuentran disponibles de lunes a viernes de 7:00 a.m. a 7:00 p.m., excepto durante los d\xedas festivos estatales. "),l())}function cpt(e,n){1&e&&(c(0,"div"),u(1," \u8acb\u5230\u6aa2\u67e5\u6838\u51c6\u72c0\u614b\uff0c\u5728\u7dab\u4e0a\u627e\u51fa\u4f60\u7684\u6838\u51c6\u72c0\u614b\u3002\u4f60\u9084\u53ef\u4ee5\u806f\u7d61\u6211\u5011\u4ee5\u77ad\u89e3\u60a8\u7684\u7533\u8acb\u72c0\u614b\u3002\u60a8\u53ef\u5168\u5929 24 \u5c0f\u6642\u6aa2\u67e5\u60a8\u7684\u72c0\u614b\uff0c\u6216\u65bc\u661f\u671f\u4e00\u81f3\u661f\u671f\u4e94\uff0c\u65e9\u4e0a 7 \u9ede\u5230\u665a\u4e0a 7 \u9ede\uff08\u5dde\u5b9a\u5047\u65e5\u9664\u5916\uff09\u6d3d\u8a62\u5ba2\u670d\u4eba\u54e1\u3002 "),l())}function dpt(e,n){1&e&&(c(0,"div"),u(1," \uace0\uac1d\ub2d8\uc758 \uc2e0\uccad/\uac31\uc2e0 \uc790\uaca9\uc5ec\ubd80 \uc9c4\ud589\uc0c1\ud0dc\uc5d0 \ub300\ud574\uc11c\ub294 \uc628\ub77c\uc778\uc73c\ub85c \ud655\uc778\ud558\uc2dc\ub358\uc9c0, \uc544\ub2c8\uba74 \uc800\ud76c \ucf5c\uc13c\ud130\ub85c \ubb38\uc758 \ud574 \uc8fc\uc2ed\uc2dc\uc624. \uace0\uac1d\ub2d8\uc758 \uc2e0\uccad/\uac31\uc2e0 \uc790\uaca9\uc5ec\ubd80 \uc9c4\ud589\uc0c1\ud0dc\ub294 \ud558\ub8e8 24\uc2dc\uac04 \uc5b8\uc81c\ub4e0\uc9c0 \ud655\uc778\ud560 \uc218 \uc788\uc2b5