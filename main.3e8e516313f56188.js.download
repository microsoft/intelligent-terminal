,67),u(225,"If you did not get the annual renewal form, please "),c(226,"a",100),u(227,"Contact Us"),l(),u(228," so we can arrange for you to receive it"),c(229,"span"),u(230,"."),l()()()()(),c(231,"div",116)(232,"h3",73)(233,"button",117,8),u(235," It\u2019s time for me to renew my California LifeLine enrollment, and I don\u2019t remember if I enrolled based on the eligibility of someone who was a member of my household. How do I check? "),l()(),c(236,"div",274)(237,"div",76)(238,"div",67),u(239,"If you enrolled for California LifeLine because a member of your household was participating in a qualifying public assistance program, your renewal form will display that person\u2019s name in the relevant section. If you need help, Contact Us. Our customer service representatives are available Monday through Friday from 7 a.m. to 7 p.m. except on state holidays."),l()()()(),c(240,"div",119)(241,"h3",73)(242,"button",120,9),u(244," California LifeLine now requires subscribers to submit proof of continuing eligibility when renewing their benefits. How does this change impact you? "),l()(),c(245,"div",275)(246,"div",76)(247,"div",77),u(248,"If you qualify through a public assistance program like CalFresh or Medi-Cal, you need to include, with your completed renewal form, a document like a benefit verification letter."),l(),c(249,"div",77),u(250,"If you qualify based on your yearly income, you will need to include with your completed renewal form a document such as pay stubs, tax returns, or benefit statements."),l(),c(251,"div",77),u(252,"California LifeLine now requires subscribers to submit proof of continuing eligibility when renewing their benefits. How does this change impact you?"),l(),c(253,"div",77),u(254,"If you qualify through a public assistance program like CalFresh or Medi-Cal, you need to include, with your completed renewal form, a document like a benefit verification letter."),l(),c(255,"div",77),u(256,"If you qualify based on your yearly income, you will need to include with your completed renewal form a document such as pay stubs, tax returns, or benefit statements."),l(),c(257,"div",67),u(258,"You can renew:"),l(),c(259,"ul",122)(260,"li",67),u(261,"Online by navigating to "),c(262,"a",123),u(263,"\u201cMy Account\u201d"),l(),u(264," and either Log-in to your account or Register if you have not previously created an account"),l(),c(265,"li",67),u(266,"By mail sent to: California LifeLine Administrator PO Box 138014 Sacramento, CA 95813-8014"),l()(),c(267,"div",77),u(268,"If you miss your renewal deadline, you will lose your California LifeLine benefits\u2014but you can always reapply if you are still eligible."),l(),c(269,"div",67),u(270,"Do you need help? "),c(271,"a",124),u(272,"Contact Us"),l(),u(273,"."),l(),ee(274,dht,2,0,"a",125),l()()()()()()(),c(275,"div",276)(276,"h2",73)(277,"button",277,50),u(279," Benefit Qualifying Person (BQP) Eligibility and Renewal "),l()(),c(280,"div",278)(281,"div",264)(282,"div",279)(283,"div",126)(284,"h3",73)(285,"button",127,10),u(287," What is a Benefit Qualifying Person (BQP)? "),l()(),c(288,"div",280)(289,"div",76)(290,"div",77),u(291,"Benefit Qualifying Person (BQP) is a member of a household\u2014other than the applicant\u2014who participates in a qualifying public assistance program, making the household eligible for the California LifeLine program."),l(),c(292,"div",67),u(293,"A BQP can be a child or dependent if they receive benefits from a qualifying public assistance program. However, the applicant (adult household member) must apply for the California LifeLine discount on behalf of the household."),l()()()(),c(294,"div",129)(295,"h3",73)(296,"button",130,11),u(298," How does a child or dependent help a household qualify for California LifeLine? "),l()(),c(299,"div",281)(300,"div",76)(301,"div",67),u(302,"If a child or dependent in the household receives benefits from a qualifying public assistance program (such as CalFresh, Medi-Cal, or SSI), the household may be eligible for California LifeLine even if the applicant themselves is not enrolled in these programs."),l()()()(),c(303,"div",132)(304,"h3",73)(305,"button",133,12),u(307," What public assistance programs qualify under this eligibility option? "),l()(),c(308,"div",282)(309,"div",76)(310,"div",67),u(311,"A child or dependent can qualify a household for California LifeLine if they are enrolled in an approved program:"),l(),c(312,"ul")(313,"li",67)(314,"b",67),u(315,"Medi-Cal"),l(),u(316," [Medicaid Program]"),l(),c(317,"li",67)(318,"b",67),u(319,"CalFresh"),l(),u(320," [Supplemental Nutrition Assistance Program (SNAP)]"),l(),c(321,"li",67)(322,"b",67),u(323,"SSI"),l(),u(324," [Supplemental Security Income Program]"),l(),c(325,"li",67)(326,"b",67),u(327,"Section 8"),l(),u(328," [Public Housing Assistance Program]"),l(),c(329,"li",67)(330,"b",67),u(331,"Tribal TANF"),l(),u(332," [Tribal Temporary Assistance for Needy Families]"),l(),c(333,"li",67)(334,"b",67),u(335,"Tribal Head Start Program"),l()(),c(336,"li",67)(337,"b",67),u(338,"Bureau of Indian Affairs General Assistance"),l()(),c(339,"li",67)(340,"b",67),u(341,"FDPIR"),l(),u(342," [Food Distribution Program on Indian Reservations]"),l(),c(343,"li",67)(344,"b",67),u(345,"VA Pension/Veterans Survivor Pension"),l(),u(346," [Federal Veterans and Survivors Pension Benefit Program]"),l(),c(347,"li",67)(348,"b",67),u(349,"LIHEAP"),l(),u(350," [Low Income Home Energy Assistance Program]"),l(),c(351,"li",67)(352,"b",67),u(353,"NSLP"),l(),u(354," [National School Lunch Program]"),l(),c(355,"li",67)(356,"b",67),u(357,"WIC"),l(),u(358," [Women, Infants, and Children Program]"),l(),c(359,"li",67)(360,"b",67),u(361,"TANF"),l(),u(362," [Temporary Assistance for Needy Families]"),l(),c(363,"li",67)(364,"b",67),u(365,"CalWORKs"),l(),u(366," [California Work Opportunity and Responsibility to Kids]"),l(),c(367,"li",67)(368,"b",67),u(369,"StanWORKs"),l(),u(370," [Stanislaus Work Opportunity and Responsibility to Kids]"),l(),c(371,"li",67)(372,"b",67),u(373,"WTW"),l(),u(374," [Welfare-to-Work]"),l(),c(375,"li",67)(376,"b",67),u(377,"GAIN"),l(),u(378," [Greater Avenues for Independence]"),l()()()()(),c(379,"div",135)(380,"h3",73)(381,"button",136,13),u(383," How do I apply for California LifeLine using a child or dependent\u2019s eligibility? "),l()(),c(384,"div",283)(385,"div",76)(386,"div",67),u(387,"During the application process, you will need to:"),l(),c(388,"ul")(389,"li",67),u(390,"Identify the child or dependent in your household."),l(),c(391,"li",67),u(392,"Provide proof of the child or dependent\u2019s enrollment in a qualifying public assistance program."),l(),c(393,"li",67),u(394,"Ensure that the household does not already have an active California LifeLine subscription."),l()()()()(),c(395,"div",138)(396,"h3",73)(397,"button",139,14),u(399," Does the child or dependent need to be the primary account holder for phone service? "),l()(),c(400,"div",284)(401,"div",76)(402,"div",67),u(403,"No, the child or dependent does not need to be the primary account holder. The California LifeLine applicant (the person applying for the discount) can be a different household member as long as they reside at the same address as the child or dependent who qualifies."),l()()()(),c(404,"div",141)(405,"h3",73)(406,"button",142,15),u(408," What documentation is required to verify eligibility through a child or dependent? "),l()(),c(409,"div",285)(410,"div",76)(411,"div",67),u(412,"You may need to provide:"),l(),c(413,"ul")(414,"li",67),u(415,"Proof of the child or dependent\u2019s participation in a qualifying program (such as an award letter or benefits card)."),l()()()()(),c(416,"div",144)(417,"h3",73)(418,"button",145,16),u(420," Can I change the Benefit Qualifying Person (BQP) information during my renewal? "),l()(),c(421,"div",286)(422,"div",76)(423,"div",67),u(424,"No, you cannot change the information for your Benefit Qualifying Person. If your Benefit Qualifying Person is no longer a member of your household or if your Benefit Qualifying Person is no longer eligible for the California LifeLine Program, you need to remove yourself from the Program and then re-apply. If you need help, Contact Us. Our customer service representatives are available Monday through Friday from 7 a.m. to 7 p.m. except on state holidays."),l()()()(),c(425,"div",147)(426,"h3",73)(427,"button",148,17),u(429," What happens if my Benefit Qualifying Person (BQP) is no longer receiving benefits from a qualifying public assistance program? "),l()(),c(430,"div",287)(431,"div",76)(432,"div",67),u(433,"If your Benefit Qualifying Person is not receiving benefits from a qualifying public assistance program that qualifies for California LifeLine, you need to remove yourself from the Program and then re-apply. If you need help, Contact Us. Our customer service representatives are available Monday through Friday from 7 a.m. to 7 p.m. except on state holidays."),l()()()(),c(434,"div",150)(435,"h3",73)(436,"button",151,18),u(438," Can I remove my Benefit Qualifying Person (BQP) by crossing out the Benefit Qualifying Person information on my renewal form? "),l()(),c(439,"div",288)(440,"div",76)(441,"div",67),u(442,"No, you cannot change the information for your Benefit Qualifying Person. If your Benefit Qualifying Person is no longer a member of your household or if your Benefit Qualifying Person is no longer eligible for the California LifeLine Program, you need to remove yourself from the Program and then re-apply. If you need help, Contact Us. Our customer service representatives are available Monday through Friday from 7 a.m. to 7 p.m. except on state holidays."),l()()()()()()()(),c(443,"div",289)(444,"h2",73)(445,"button",290,51),u(447," Denials "),l()(),c(448,"div",291)(449,"div",264)(450,"div",292)(451,"div",153)(452,"h3",73)(453,"button",154,19),u(455," Why was my application or renewal denied? "),l()(),c(456,"div",293)(457,"div",76)(458,"div",77),u(459,"If you received a letter denying your participation in California LifeLine, there are many possible reasons for your disqualification. The most common reason is an applicant did not complete and submit the application form by the due date. So please remember to meet the due date."),l(),c(460,"span",77),u(461,"Here are some possible reasons for a denial:"),l(),c(462,"ul")(463,"li",67),u(464,"The applicant does not return the form or register online by the due date."),l(),c(465,"li",67),u(466,"The form is incomplete."),l(),c(467,"li",67),u(468,"The applicant does not meet the California LifeLine\u2019s eligibility rules."),l(),c(469,"li",67),u(470,"The form is incorrect (and is not considered correctible)."),l(),c(471,"li",67),u(472,"The applicant did not provide the appropriate documentation to prove eligibility."),l(),c(473,"li",67),u(474,"The applicant was claimed on someone else\u2019s income tax return as a dependent."),l(),c(475,"li",67),u(476,"The applicant was already receiving the California LifeLine discounts, and was not eligible for a second phone line with the California LifeLine discounts."),l(),c(477,"li",67),u(478,"The form did not have the applicant\u2019s signature."),l()()()()(),c(479,"div",156)(480,"h3",73)(481,"button",157,20),u(483," What can I do if the California LifeLine Program denies my enrollment application, household worksheet, identity verification form or renewal form? "),l()(),c(484,"div",294)(485,"div",76)(486,"div",159),ee(487,pht,4,0,"div",86)(488,hht,4,0,"div",87)(489,fht,4,0,"div",87)(490,ght,5,0,"div",87)(491,mht,5,0,"div",87)(492,bht,4,0,"div",87)(493,Cht,4,0,"div",87),l(),c(494,"div",159),ee(495,_ht,2,0,"div",86)(496,Mht,2,0,"div",87)(497,vht,2,0,"div",87)(498,Aht,2,0,"div",87)(499,yht,2,0,"div",87)(500,Eht,2,0,"div",87)(501,Oht,2,0,"div",87),l(),c(502,"div",159),ee(503,Dht,6,0,"div",86)(504,wht,6,0,"div",87)(505,zht,6,0,"div",87)(506,Sht,6,0,"div",87)(507,Bht,6,0,"div",87)(508,Fht,6,0,"div",87)(509,Tht,6,0,"div",87),l(),c(510,"ul")(511,"li",67),u(512,"Your signature was missing on the form"),l(),c(513,"li",67),u(514,"You did not print your first and last name in the space provided by the form for printing your name"),l(),c(515,"li",67),u(516,"You did not print your initials in the box provided by the form for the certification that your household is not already receiving a California LifeLine discount"),l(),c(517,"li",67),u(518,"You did not provide the last four digits of your Social Security Number"),l(),c(519,"li",67),u(520,"You did not provide your date of birth"),l(),c(521,"li",67),u(522,"You did not return the required form by the assigned due date"),l(),c(523,"li",67),u(524,"You returned the required form, but your form was received by the California LifeLine Administrator after the assigned due date"),l(),c(525,"li",67),u(526,"You did not complete the Household Worksheet when the Worksheet was required"),l()(),c(527,"div",67),u(528,"Your written appeal request must include the following information:"),l(),c(529,"ul")(530,"li",67),u(531,"Your name and the name on your telephone bill (if the name is different from your name)"),l(),c(532,"li",67),u(533,"Your home address"),l(),c(534,"li",67),u(535,"Your mailing address"),l(),c(536,"li",67),u(537,"Your phone number"),l(),c(538,"li",67),u(539,"A copy of your disqualification letter"),l(),c(540,"li",67),u(541,"A brief description of the reason for your appeal. Please limit your appeal request to two pages or less. You can use the back of your disqualification letter to write your appeal"),l(),c(542,"li",67),u(543,"Proof that shows you qualify for California LifeLine enrollment"),l()(),c(544,"div",67),u(545,"Your appeal can be faxed to 415-703-1158 or it can be mailed to:"),l(),c(546,"div",160),u(547," California Public Utilities Commission"),S(548,"br"),u(549," Consumer Affairs Branch"),S(550,"br"),u(551," 505 Van Ness Ave."),S(552,"br"),u(553," San Francisco, CA 94102 "),l(),c(554,"div",67),u(555,"If you wish to speak to a Consumer Affairs Branch representative, call 800-649-7570.Please Note: Consumer Affairs Branch is open Monday-Friday 8:30am-4:30pm, except on state holidays."),l()()()()()()()(),c(556,"div",295)(557,"h2",73)(558,"button",296,52),u(560," Phone Discounts "),l()(),c(561,"div",297)(562,"div",264)(563,"div",298)(564,"div",161)(565,"h3",73)(566,"button",162,21),u(568," How much can I save on my home or cell phone bill? "),l()(),c(569,"div",299)(570,"div",76)(571,"div",67),u(572,"If you qualify for California LifeLine, you will receive discounts on your basic home or cell phone service. Check out the "),c(573,"a",164),u(574,"Types of Discounted Services Available"),l(),u(575," to learn about the program's benefits"),c(576,"span"),u(577,"."),l()()()()(),c(578,"div",165)(579,"h3",73)(580,"button",166,22),u(582," Are there any restrictions for being on California LifeLine? "),l()(),c(583,"div",300)(584,"div",76)(585,"div",77),u(586,"Yes, there are rules stating who can qualify for California LifeLine. Check out "),c(587,"a",168),u(588,"Is California LifeLine Right for You?"),l(),u(589," to learn if you and your household qualify"),c(590,"span"),u(591,"."),l()(),c(592,"div",77),u(593,"Also, only one discount per household for each residential address is allowed (except for teletypewriter users and for Deaf and Disabled Telecommunications Program participants). Each household must choose to get the discount either on a home phone or on a cell phone, but not on both. Households cannot get the discount from multiple phone companies. Households that do not follow the one discount per household rule will lose their discounts."),l(),c(594,"div",77),u(595,"The applicant cannot be claimed as a dependent on someone else's income tax returns."),l(),c(596,"div",67),u(597,"The primary home or cell phone line with the California LifeLine discount must be at the applicant's main residence."),l()()()(),c(598,"div",169)(599,"h3",73)(600,"button",170,23),u(602," Are there any additional benefits if I or a member of my household is hearing impaired and uses TTY equipment? "),l()(),c(603,"div",301)(604,"div",76)(605,"div",67),u(606,"Yes, if someone in your household is hearing impaired and uses TTY equipment, your household may be eligible for two separate phone lines with the California LifeLine discount. To qualify for the second California LifeLine discount, either you must certify on your form that the TTY was provided to your household by the Deaf and Disabled Telecommunications Program or you must submit a medical certificate demonstrating the need of a TTY by one of the members in your household."),l()()()(),c(607,"div",172)(608,"h3",73)(609,"button",173,24),u(611," Are there any additional benefits if I live in a federally recognized tribal land? "),l()(),c(612,"div",302)(613,"div",76)(614,"div",175),u(615,"Yes, there are additional benefits if your household is located on federally recognized tribal land through the federal government's Enhanced Lifeline program. You can receive local home phone service for $1.00 per month plus more savings on service installation charges. For more information, visit:"),l(),c(616,"a",176),u(617,"https://www.fcc.gov/consumers/guides/lifeline-support-affordable-communications"),l()()()(),c(618,"div",177)(619,"h3",73)(620,"button",178,25),u(622," How many discounts can I have? "),l()(),c(623,"div",303)(624,"div",76)(625,"div",77),u(626,"Only one discount per household is allowed. Households must choose to get the discount either on a home phone or a cell phone, but not on both. Households cannot get the discount from multiple phone companies."),l(),c(627,"div",77),u(628,"A HOUSEHOLD includes adults and children who are living together at the same address as one economic unit. An economic unit consists of all adults (persons at least 18 years old unless emancipated) contributing to and sharing in the household's income and expenses."),l(),c(629,"div",67),u(630,"Multiple discounts are only allowed if there are TTY users, Deaf and Disabled Telecommunications Program participants, or if there are multiple households at the same home address. Individuals who do not follow the one discount per household rule will lose their discount, and may be prosecuted by the U.S. government."),l()()()(),c(631,"div",180)(632,"h3",73)(633,"button",181,26),u(635," When will I receive the California LifeLine benefits? "),l()(),c(636,"div",304)(637,"div",76)(638,"div",77),u(639,"You will receive the California LifeLine benefits once the California LifeLine Administrator has approved your application. New applicants for the California LifeLine Program must be approved before the California LifeLine discounts are received."),l(),c(640,"div",77),u(641,"After submitting the application form and any required documents, the California LifeLine Administrator must determine whether the applicant completed the form correctly and completely, and submitted the required documents. The Administrator must also find out if the applicant is eligible for the program based on his/her responses in the application form."),l(),c(642,"div",77),u(643,"If you have home phone service, once you are approved to receive the California LifeLine discounts, you will be on California LifeLine as of the date your service began or the date you requested to be enrolled, whichever is later. The discounts will be applied directly to your account."),l(),c(644,"div",67),u(645,"Beginning January 16, 2014, cell phone companies offering California LifeLine pre-paid cell phone discounts might not provide the handset until the cell phone company has received notification of the applicant's approved eligibility from the California LifeLine Administrator. While waiting for the discounted services to be approved and activated, we encourage applicants to find other ways to make and receive calls. If approved by the California LifeLine Administrator, the California LifeLine discounts will start either on the date the California LifeLine Administrator notifies the cell phone company of the applicant's approved eligibility or on the date the discounted service was activated (i.e., the California LifeLine participant can make and receive calls with the handset provided by the California LifeLine cell phone service provider)"),c(646,"span"),u(647,", "),l(),c(648,"strong",67),u(649,"whichever is later"),l(),u(650,"."),l()()()(),c(651,"div",183)(652,"h3",73)(653,"button",184,27),u(655," Once I start getting the California LifeLine discounts, will I always receive them on my home or cell phone bill? "),l()(),c(656,"div",305)(657,"div",76)(658,"div",77),u(659,"The California LifeLine discounts are only good for one year unless you renew your participation. You must renew your participation each year. The California LifeLine Administrator will contact you when you need to renew your participation in California LifeLine. If you do not renew your participation you will be removed from the program and no longer receive the monthly discount on your home or cell phone bill."),l(),c(660,"div",77),u(661,"Check out "),c(662,"a",186),u(663,"Annual Renewal Process"),l(),u(664," for details"),c(665,"span"),u(666,"."),l()(),c(667,"div",77),u(668,"If you did not get the annual renewal form, please "),c(669,"a",100),u(670,"Contact Us"),l(),u(671," so we can arrange for you to receive it"),c(672,"span"),u(673,"."),l()(),c(674,"div",67),u(675,"Your California LifeLine discounts can also be discontinued when you no longer meet the eligibility requirements or if your renewal form is not received within 45 days from the date it was sent to your household. If you do not return the completed and signed renewal form, or if you are determined as ineligible, your home or cell phone company will remove you from the program along with your California LifeLine discount on your monthly bill"),c(676,"span"),u(677,"."),l()()()()(),c(678,"div",187)(679,"h3",73)(680,"button",188,28),u(682," Are there other ways that can help me save money on my telephone bill? "),l()(),c(683,"div",306)(684,"div",76)(685,"div",67),u(686,"There are options that can help you save money, including a voluntary limit on long distance calling (free toll restriction) and free toll blocking. Speak with your home phone company for further money saving options. You can also choose the calling plan that fits your lifestyle and needs. Phone companies offer various calling plans with limited or unlimited local calling."),l()()()()()()()(),c(687,"div",307)(688,"h2",73)(689,"button",308,53),u(691," Phone Service Provider Billing & Refunds Requestions "),l()(),c(692,"div",309)(693,"div",264)(694,"div",310)(695,"div",190)(696,"h3",73)(697,"button",191,29),u(699," Are there any payment plan options available for me to spread the up-front costs of setting up my home phone service? "),l()(),c(700,"div",311)(701,"div",76)(702,"div",67),u(703,"Yes, the home or cell phone companies providing basic home or cell phone service and California LifeLine will have interest-free payment plans for you to take advantage of. Please remember to ask the telephone company to put you on an interest-free payment plan if you need help with the payments. This will spread out your payments in more manageable amounts while you wait to be approved for California LifeLine."),l()()()(),c(704,"div",193)(705,"h3",73)(706,"button",194,30),u(708," Will I get the money back I spent while waiting for my California LifeLine discounts if I have home phone service? "),l()(),c(709,"div",312)(710,"div",76)(711,"div",77),u(712,"Yes, but only once your application is approved. You will be refunded the difference between the regular rates and the California LifeLine discounted rates for any applicable monthly service charges, service installation/connection fee, service conversion fee, and deposits for basic home phone service."),l(),c(713,"div",67),u(714,"The refund will be a credit on your next phone bill for the regular rates you paid and any applicable monthly service charges, service installation/connection fee, service conversion fee, and deposits for your basic home phone service. If you have a net credit balance of at least $10.00, you may request a refund check from your home phone company. Otherwise, the refund will appear as a credit on your account."),l()()()(),c(715,"div",196)(716,"h3",73)(717,"button",197,31),u(719," How will I get the money back I spent while waiting for my California LifeLine discounts if I have home phone service? "),l()(),c(720,"div",313)(721,"div",76)(722,"div",67),u(723,"The refund will be a credit on your next phone bill for the regular rates you paid and any applicable monthly service charges, service installation/connection fee, service conversion fee, and deposits for your basic home phone service. If you have a net credit balance of at least $10.00, you may request a refund check from your home phone company. Otherwise, the refund will appear as a credit on your account."),l()()()()()()()(),c(724,"div",314)(725,"h2",73)(726,"button",315,54),u(728," Broadband Pilot Information "),l()(),c(729,"div",316)(730,"div",264)(731,"div",317)(732,"div",199)(733,"h3",73)(734,"button",200,32),u(736," What is broadband and what is the Home Broadband Pilot program? How does it differ from the California LifeLine Program? "),l()(),c(737,"div",318)(738,"div",76)(739,"div",77),u(740,"Broadband is high speed internet that connects through a device in your home. It either uses a fixed line (like cable or fiber) or a wireless signal to a receiver, and shares Wi-Fi to all of your devices. Unlike mobile data, it stays in one place and is meant for everyone in the home. On February 1st, 2026 California LifeLine expanded it's ways to help Californian's stay connected by offering a discount on fixed broadband services for qualifying families."),l(),c(741,"div",67),u(742,"Qualifying households receive a discount on their monthly broadband bill and can bundle phone service with either cell phone or home phone with their broadband service, if the chosen service provider offers both."),l()()()(),c(743,"div",202)(744,"h3",73)(745,"button",203,33),u(747," Who is eligible, when does enrollment start, and how do I apply for the Home Broadband Pilot program? "),l()(),c(748,"div",319)(749,"div",76)(750,"div",67),u(751,"Eligibilty for the Broadband Pilot program is the same as our other LifeLine services. Check "),c(752,"a",115),u(753,"Is California LifeLine Right For Me"),l(),u(754," to see if you qualify."),l()()()(),c(755,"div",205)(756,"h3",73)(757,"button",206,34),u(759," If I\u2019m already enrolled in California LifeLine, can I also join the Pilot program? Do I need a new application? "),l()(),c(760,"div",320)(761,"div",76)(762,"div",77),u(763,"There is only one benefit allowed per household, so you cannot add the Pilot Program benefit on top of the California LifeLine benefit you are already receiving. However, if you wish to transition to the Broadband Pilot, reach out to your service provider and let them know you want to transfer your California LifeLine benefit to the broadband pilot."),l(),c(764,"div",67),u(765,"If your service provider doesn't offer broadband yet, visit the Service Provider page to find one in your area that offers broadband and phone service under the California LifeLine Broadband Pilot."),l()()()(),ee(766,Lht,9,0,"div",321),c(767,"div",211)(768,"h3",73)(769,"button",212,36),u(771," What services and discount amount will I receive? If I still can\u2019t pay after the discount, can my provider disconnect me? "),l()(),c(772,"div",322)(773,"div",76)(774,"div",67),u(775,"California LifeLine Broadand Pilot participants can receive $20/month discount for broadband only services, and $30/month if they bundle and have both broadband + voice service (from same provider). If you do not pay your phone or internet bill, your service provider may disconnect your services until you have paid your bill."),l()()()(),c(776,"div",214)(777,"h3",73)(778,"button",215,37),u(780," What happens if the Home Broadband Pilot program ends in the future? "),l()(),c(781,"div",323)(782,"div",76)(783,"div",67),u(784,"If the Broadband Pilot services end, your service provider will notify you in advance of any changes and help you understand any available options for alternative discounts they may offer in it's stead. You will need to pay the full broadband service bill if the LifeLine benefit ends."),l()()()()()()()(),c(785,"div",324)(786,"h2",73)(787,"button",325,55),u(789," Service Provider Issues "),l()(),c(790,"div",326)(791,"div",264)(792,"div",327)(793,"div",217)(794,"h3",73)(795,"button",218,38),u(797," If I change service providers, can I still get the California LifeLine discounts? "),l()(),c(798,"div",328)(799,"div",76)(800,"div",67),u(801,"Yes, you can remain on California LifeLine and keep getting the discounts even if you change your service provider. You have 30 days from when you disconnect your phone service from your existing phone company to let your new service Pprovider know that you would like to keep your California LifeLine discounts. The California LifeLine Administrator will simply transfer your California LifeLine discount to your new provider."),l()()()(),c(802,"div",220)(803,"h3",73)(804,"button",221,39),u(806," My current Service Provider said they do not offer California LifeLine, what should I do? "),l()(),c(807,"div",329)(808,"div",76)(809,"div",67),u(810,"Not all service providers are required to provide California LifeLine. Please contact the "),c(811,"a",80),u(812,"California LifeLine Call Center"),l(),u(813," or click on "),c(814,"a",223),u(815,"Provider Search"),l(),u(816," to determine the available service providers in your area."),l()()()(),ee(817,kht,7,0,"div",224)(818,Rht,7,0,"div",225)(819,Iht,7,0,"div",226),l()()()(),c(820,"div",330)(821,"h2",73)(822,"button",331,56),u(824," Communication & Language "),l()(),c(825,"div",332)(826,"div",264)(827,"div",333)(828,"div",227)(829,"h3",73)(830,"button",228,40),u(832," How can I receive letters, forms, and instructions in a language dif