14),u(27,"hotline"),l(),u(28,". "),l())}function Tct(e,n){1&e&&(c(0,"div"),u(1," California LifeLine es un programa estatal que provee servicio telef\xf3nico b\xe1sico con descuento para servicio telef\xf3nico b\xe1sico y servicio de tel\xe9fono celular para grupos familiares elegibles. Los descuentos de California LifeLine ayudan a los consumidores a reducir el costo de sus facturas de tel\xe9fono. S\xf3lo un descuento por hogar est\xe1 permitido (excepto para los usuarios de teletipo y para personas sordas y con discapacidad Telecommunications Program participantes). Cada hogar debe elegir obtener el descuento o de un tel\xe9fono o en un tel\xe9fono celular, pero no en ambos. Vea los "),c(2,"a",9),u(3,"Tipos de descuentos disponibles"),l(),u(4," para informarse sobre los beneficios del programa. Existen dos formas de reunir los requisitos para participar del programa. "),S(5,"br")(6,"br"),u(7," Vea "),c(8,"a",10),u(9,"\xbfEl programa California LifeLine es adecuado para usted?"),l(),u(10," para saber si su grupo familiar y usted re\xfanen los requisitos. "),S(11,"br")(12,"br"),u(13," Si considera que re\xfane los requisitos para el programa California LifeLine, comun\xedquese con su compa\xf1\xeda telef\xf3nica o compa\xf1\xeda de celular e inf\xf3rmele que desea enviar una solicitud para el programa California LifeLine. La compa\xf1\xeda de tel\xe9fono o Compa\xf1\xeda celular debe ser un proveedor aprobado de servicio de tel\xe9fono de California LifeLine. Una vez que le informe a su compa\xf1\xeda telef\xf3nica o compa\xf1\xeda de celular que usted re\xfane los requisitos, comenzar\xe1 su proceso de solicitud. Oprima en B\xfasqueda de proveedores para averiguar si hay compa\xf1\xeda de tel\xe9fono o compa\xf1\xeda de celular aprobadas en su \xe1rea. Vea "),c(14,"a",12),u(15,"Instrucciones de solicitud"),l(),u(16," para obtener m\xe1s informaci\xf3n. "),S(17,"br")(18,"br"),u(19," Si actualmente no tiene servicio telef\xf3nico o servicio de celular, puede comunicarse con el "),c(20,"a",13),u(21,"centro de atenci\xf3n al cliente del programa California LifeLine"),l(),u(22," para determinar las compa\xf1\xedas telef\xf3nicas disponibles en su \xe1rea. Si tiene alguna pregunta con respecto a su solicitud, el estado o los plazos, comun\xedquese con el administrador de California LifeLine a trav\xe9s de la "),c(23,"a",14),u(24,"l\xednea directa"),l(),u(25,". "),l())}function Lct(e,n){1&e&&(c(0,"div"),u(1," \u52a0\u5dde\u666e\u6fdf\u96fb\u8a71\u8a08\u5283\uff08\u52a0\u5dde\u666e\u6fdf\u96fb\u8a71\uff09\u662f\u4e00\u500b\u5dde\u653f\u5e9c\u8a08\u5283\uff0c\u5411\u5408\u8cc7\u683c\u4f4f\u6236\u63d0\u4f9b\u6298\u6263\u7d66\u5bb6\u5ead\u96fb\u8a71\u548c\u624b\u6a5f\u670d\u52d9\u3002\u52a0\u5dde\u666e\u6fdf\u96fb\u8a71\u6298\u6263\u5e6b\u52a9\u6d88\u8cbb\u8005\u6e1b\u5c11\u4ed6\u5011\u7684\u96fb\u8a71\u8cbb\u3002\u6bcf\u500b\u5bb6\u5ead\u53ea\u80fd\u6709\u4e00\u500b\u6298\u6263\uff08\u9664\u4e86\u96fb\u50b3\u6253\u5b57\u6a5f\u7d66\u807e\u4eba\u548c\u6b98\u75be\u4eba\u7684\u96fb\u4fe1\u8a08\u5283\u53c3\u8207\u8005\uff09\u3002\u6bcf\u5bb6\u6bcf\u6236\u5fc5\u9808\u9078\u64c7\u5bb6\u5ead\u96fb\u8a71\u6216\u624b\u6a5f\u96fb\u8a71\u670d\u52d9\u7684\u6298\u6263\uff0c\u4f46\u4e0d\u80fd\u5169\u8005\u90fd\u64c1\u6709\u3002\u8acb\u67e5\u95b1"),c(2,"a",9),u(3,"\u53ef\u7528\u6298\u6263\u985e\u578b"),l(),u(4,"\uff0c\u4ee5\u77ad\u89e3\u66f4\u591a\u8a08\u5283\u798f\u5229\u7684\u76f8\u95dc\u8cc7\u8a0a\u3002 "),S(5,"br")(6,"br"),u(7," \u53ef\u900f\u904e\u5169\u7a2e\u65b9\u5f0f\u53c3\u52a0\u8a72\u8a08\u5283\u3002 \u8acb\u67e5\u95b1 "),c(8,"a",10),u(9,"\u52a0\u5dde\u666e\u6fdf\u96fb\u8a71\u670d\u52d9\u662f\u5426\u9069\u5408\u60a8\uff1f"),l(),u(10," \u77ad\u89e3\u60a8\u8207\u60a8\u7684\u5bb6\u5ead\u662f\u5426\u7b26\u5408\u8cc7\u683c\u7684\u76f8\u95dc\u8cc7\u8a0a\u3002 "),S(11,"br")(12,"br"),u(13," \u5982\u679c\u60a8\u8a8d\u70ba\u81ea\u5df1\u7b26\u5408\u300c\u52a0\u5dde\u666e\u6fdf\u96fb\u8a71\u670d\u52d9\u300d\u7684\u8cc7\u683c\uff0c\u8acb\u6d3d\u8a62\u4e