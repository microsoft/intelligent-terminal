ma. Tingnan ang "),c(8,"a",10),u(9,"Nararapat ba para sa iyo ang California LifeLine?"),l(),u(10," upang malaman kung ikaw at ang iyong sambahayan ay kuwalipikado. "),S(11,"br")(12,"br"),u(13," Kung sa iyong palagay ay kuwalipikado ka para sa California LifeLine, makipag-ugnayan at ipagbigay-alam sa kumpanya ng iyong telepono o kumpanya ng iyong cell phone na nais mong mag-apply para sa California LifeLine. Ang kumpanya ng tahanang telepono o cell phone ay dapat isa sa mga aprubadong California LifeLine na nagbibigay serbisyo ng telepono. Sa sandaling ipinaalam mo sa kumpanya ng iyong telepono sa bahay o kumpanya ng iyong cell phone na ikaw ay kuwalipikado, sisimulan na nito ang proseso para iyong aplikasyon. Tingnan ang "),c(14,"a",12),u(15," Mga Tagubilin sa Aplikasyon"),l(),u(16," tpara sa karagdagang mga detalye. "),S(17,"br")(18,"br"),u(19," Kung sa kasalukuyan ay wala kang serbisyo ng telepono sa bahay, maaari kang makipag-ugnayan sa "),c(20,"a",13),u(21,"California LifeLine Call Center"),l(),u(22," upang matiyak ang handang magamit na mga kompanya ng telepono sa iyong lugar. Kung mayroon kang mga katanungan tungkol sa iyong aplikasyon ,katayuan ng aplikasyon, o mga takdang petsa, mangyari lamang na tumawag sa Administrator ng California LifeLine na "),c(23,"a",14),u(24,"hotline"),l(),u(25,". "),S(26,"br")(27,"br"),u(28," Mag-apply upang Makilahok sa California LifeLIne o Ipabago ang iyong Pakikilahok Online! "),l())}function Pct(e,n){if(1&e&&(c(0,"div",1)(1,"h2",2),u(2,"The California LifeLine Program"),l(),c(3,"div",6),ee(4,Fct,29,0,"div",7)(5,Tct,26,0,"div",8)(6,Lct,26,0,"div",8)(7,kct,26,0,"div",8)(8,Rct,28,0,"div",8)(9,Ict,26,0,"div",8)(10,xct,29,0,"div",8),l()()),2&e){const t=k();g(3),m("ngSwitch",t.app.translate.currentLang),g(2),m("ngSwitchCase","es"),g(),m("ngSwitchCase","zh"),g(),m("ngSwitchCase","ko"),g(),m("ngSwitchCase","ja"),g(),m("ngSwitchCase","vi"),g(),m("ngSwitchCase","tl")}}let ise=(()=>{class e{constructor(t){this.app=t}ngOnInit(){}ngAfterV