<script type="text/javascript">
document.addEventListener("click", function (event) {
    const optionElement = event.target.closest(".product-watch-ultra-2 .swatch-attribute.watch_band_type .swatch-option.text");

    if (optionElement) {
        const isOceanBand = optionElement.getAttribute("data-option-label") === "Ocean Band";
        const watchBandSize = document.querySelector(".swatch-attribute.watch_band_size");
        optionElement.classList.remove('disabled');
        if (!watchBandSize) {
            return;
        }

        const options = watchBandSize.querySelectorAll(".swatch-option.text");
        options.forEach(option => {
            const isOneSize = option.getAttribute("data-option-label") === "One Size";
            if (option.classList.contains('selected')) {
                option.classList.remove('selected');
                watchBandSize.removeAttribute('data-option-selected');
            }


            if (isOceanBand) {
                option.style.display = isOneSize ? "block" : "none";
            } else {
                option.style.display = isOneSize ? "none" : "block";
            }
        });
    }
}, true);
</script>
